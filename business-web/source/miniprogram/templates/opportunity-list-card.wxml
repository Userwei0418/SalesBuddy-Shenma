<template name="opportunity-list-card">
      <view class="card-view workbench-opportunity-card-top"><view class="card-view"><view class="card-view workbench-opportunity-name"><text class="card-text workbench-opportunity-title">{{item.name}}</text><label wx:if="{{item.gradeLabel}}" class="card-label opportunity-grade grade-{{item.gradeCode}}">{{item.gradeLabel}}</label></view><label class="card-label">{{item.customer_name}}</label></view><view wx:if="{{item.canEdit}}" class="opportunity-card-edit" hover-class="opportunity-card-edit-active" role="button" aria-label="编辑商机" data-customer-id="{{item.customer_id}}" data-opportunity-id="{{item.id}}" catchtap="editOpportunity">编辑</view></view>
      <view class="card-view workbench-status"><text class="card-text traffic-badge traffic-{{item.signal.tone}}">{{item.signal.label}} · {{item.signal.detail}}</text></view><view class="card-view workbench-opportunity-stage traffic-text-{{item.signal.tone}}"><text class="card-text">{{item.stageName}}</text><label class="card-label">{{item.probabilityText}}</label></view>
      <view class="card-view workbench-opportunity-progress"><text class="card-text" style="width:{{item.progressPercent}}%"></text></view>
      <view class="card-view workbench-opportunity-meta"><view class="card-view"><text class="card-text">累计确收</text><label class="card-label">{{item.recognizedLabel}}</label></view><view class="card-view"><text class="card-text">累计回款</text><label class="card-label">{{item.collectionLabel}}</label></view><view class="card-view"><text class="card-text">预计关单</text><label class="card-label">{{item.closeLabel}}</label></view><view class="card-view"><text class="card-text">产品线</text><label class="card-label">{{item.productLineLabel}}</label></view></view>
      <view class="card-view workbench-opportunity-owner">{{item.team}} · {{item.owner}}<text class="card-text">查看此商机 ›</text></view>
</template>
