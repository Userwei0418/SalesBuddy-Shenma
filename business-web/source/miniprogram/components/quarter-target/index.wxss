.quarter-target-bar{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:18rpx 0 8rpx}.target-period{font-size:20rpx;color:#7b91a5}.target-edit-button.target-edit-button{display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;width:auto;height:48rpx;min-height:0;box-sizing:border-box;white-space:nowrap;margin:0;padding:0 14rpx;border:0;border-radius:12rpx;line-height:1.3;font-size:20rpx;font-weight:500;background:#eef7ff;color:#217bc3}.target-edit-button::after,.target-footer-button::after{border:0}.target-notice{padding:16rpx;margin-top:12rpx;border-radius:16rpx;background:#fff7e7;color:#946827;font-size:21rpx;line-height:1.65}.pending-row{display:flex;justify-content:space-between;gap:12rpx;font-size:20rpx}.target-load-error,.form-error{color:#b55046;font-size:22rpx;line-height:1.6;margin-top:12rpx}.sheet-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:1200;display:flex;align-items:flex-end;background:rgba(19,43,66,.38)}.target-sheet{display:flex;flex-direction:column;width:100%;max-height:88vh;border-radius:32rpx 32rpx 0 0;background:#f6faff;box-shadow:0 -12rpx 60rpx rgba(20,56,88,.12);padding:0 28rpx;box-sizing:border-box}.sheet-grip{flex-shrink:0;display:flex;justify-content:center;align-items:center;height:42rpx}.sheet-grip-line{width:66rpx;height:7rpx;background:#c4d3df;border-radius:10rpx}.sheet-heading{flex-shrink:0;padding:10rpx 0 22rpx}.sheet-title{display:block;font-size:32rpx;font-weight:700;color:#25445f}.sheet-subtitle{display:block;margin-top:10rpx;font-size:23rpx;color:#8195a8}.target-form{flex-shrink:1;min-height:0;height:58vh;max-height:58vh}.form-note{font-size:23rpx;line-height:1.7;color:#6e8499;background:#eaf3fb;padding:18rpx;border-radius:16rpx}.form-field{margin-top:24rpx}.field-title{font-size:25rpx;font-weight:600;color:#304f68;margin-bottom:12rpx}.field-unit{margin-left:12rpx;font-size:21rpx;font-weight:400;color:#859aad}.amount-input{background:white;border:1rpx solid #d9e6f1;border-radius:16rpx;height:84rpx;padding:0 22rpx;font-size:28rpx;color:#244861}.reason-input{width:100%;box-sizing:border-box;height:158rpx;padding:20rpx;border:1rpx solid #d9e6f1;border-radius:16rpx;background:#fff;font-size:24rpx;color:#304f68}.field-hint{margin-top:9rpx;font-size:20rpx;color:#8297aa}.sheet-footer{flex-shrink:0;display:flex;gap:16rpx;padding:24rpx 0 calc(24rpx + env(safe-area-inset-bottom))}.target-footer-button{margin:0;flex:1;border-radius:18rpx;font-size:26rpx;line-height:82rpx;font-weight:600}.target-cancel{color:#4f7598;background:#e9f1f8}.target-submit{color:#fff;background:linear-gradient(120deg,#225a88,#2189da)}
.target-decision{padding:14rpx 18rpx;margin-top:12rpx;border-radius:14rpx;color:#507c70;background:#edf7f2;font-size:21rpx;line-height:1.7}.decision-rejected{background:#fff3ed;color:#ac735a}.decision-cancelled{background:#edf2f7;color:#7c8da0}.decision-detail{margin-left:12rpx;font-size:19rpx;color:#8b9caa}
