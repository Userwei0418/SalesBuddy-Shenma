<view class="fde-board">
<block wx:if="{{!recordsOnly}}">
  <view class="page-head"><view class="page-heading"><text class="page-title">{{memberId ? (memberLabel || '成员') + '的看板' : '协作看板'}}</text><text class="page-subtitle">项目进展与工作记录</text></view><view class="quarter-picker {{filterOpen?'quarter-picker-open':''}}" bindtap="toggleFilter" role="button" aria-label="选择统计周期"><text class="quarter-picker-value">{{periodLabel}}</text><view class="quarter-picker-caret"></view></view></view>
  <view wx:if="{{filterOpen}}" class="period-filter"><view class="filter-head"><text>统计周期</text><picker range="{{yearOptions}}" value="{{draftYearIndex}}" bindchange="year"><view class="year-picker">{{yearOptions[draftYearIndex]}}年 ⌄</view></picker></view><view class="quarter-options"><view wx:for="{{quarterOptions}}" wx:key="value" class="quarter-option {{item.selected?'selected':''}}" data-q="{{item.value}}" bindtap="quarter">Q{{item.value}}</view></view><view class="filter-footer"><text class="filter-reset" data-q="0" bindtap="quarter">全年</text><text class="filter-hint">可选多个季度</text><view class="filter-confirm" bindtap="applyPeriod">确定</view></view></view>
  <view class="metrics-section">
    <view class="metrics-heading">
      <text class="metrics-title">经营数据</text>
      <view wx:if="{{canViewTeam && !personal && !memberId}}" class="metrics-controls">
        <view class="metrics-scope-switch">
          <button size="mini" class="metrics-scope-option {{scope==='team'?'selected':''}}" data-scope="team" bindtap="scope">团队</button>
          <button size="mini" class="metrics-scope-option {{scope==='self'?'selected':''}}" data-scope="self" bindtap="scope">个人</button>
        </view>
        <view wx:if="{{scope==='self'}}" class="metrics-picker"><dashboard-picker title="选择成员" subtitle="选择本人或授权范围内的 FDE" label="{{memberOptions[memberIndex].name}}" options="{{pickerOptions}}" selected="{{pickerSelected}}" bind:change="selectMember"/></view>
      </view>
    </view>
    <view class="metrics-meta"><text class="metrics-context">{{memberLabel || scopeLabel}} · {{periodLabel}}</text></view>
  </view>
  <view wx:if="{{loading}}" class="loading-card">正在更新看板…</view><view wx:elif="{{error}}" class="loading-card error" bindtap="load">{{error}} · 点击重试</view>
  <block wx:elif="{{ready}}">
    <view class="hero-card" bindtap="openProjects"><text class="hero-eyebrow">{{memberLabel || scopeLabel}} · 当前协助商机</text><view class="hero-value">{{summary.opportunities}}<text class="hero-unit">个商机</text></view><view class="hero-foot"><text>{{summary.customers}} 个客户</text><text>{{summary.open_opportunities}} 个在推</text><text class="hero-link">查看项目 ›</text></view></view>
    <view class="kpi-grid">
      <view class="kpi-card tone-blue" bindtap="openProjects"><text class="kpi-label">在推商机金额</text><text class="kpi-value">{{summary.openAcvText}}<text wx:if="{{summary.open_acv!==null}}" class="value-unit">万</text></text><text class="kpi-note">当前参与项目</text></view>
      <view class="kpi-card tone-mint" bindtap="openActivity"><text class="kpi-label">跟进记录</text><text class="kpi-value">{{summary.period_visits}}<text class="value-unit">条</text></text><text class="kpi-note">{{summary.active_recorders}} 人填报 · 查看记录 ›</text></view>
      <view class="kpi-card" bindtap="openProjects"><text class="kpi-label">确收金额</text><text class="kpi-value">{{summary.recognizedText}}<text wx:if="{{summary.recognized_amount!==null}}" class="value-unit">万</text></text><text class="kpi-note">所选周期 · 协助项目</text></view>
      <view class="kpi-card"><text class="kpi-label">Demo 数量</text><text class="kpi-value">{{summary.demo_scene_count}}<text class="value-unit">个</text></text><text class="kpi-note">所选周期 · 场景登记</text></view>
    </view>
    <view class="chart-card task-card"><view class="section-head"><text class="section-title">任务进展</text><text class="section-note">{{periodLabel}}</text></view><view class="task-metrics"><view class="task-metric" data-status="completed" bindtap="openTasks"><text class="task-value">{{summary.completed_tasks}}</text><text class="task-label">已完成 ›</text></view><view class="task-metric" data-status="pending" bindtap="openTasks"><text class="task-value">{{summary.pending_tasks}}</text><text class="task-label">待完成 ›</text></view><view class="task-metric" data-status="pending" bindtap="openTasks"><text class="task-value attention">{{summary.overdue_tasks}}</text><text class="task-label">已逾期 ›</text></view></view></view>
    <view wx:if="{{!compact}}" class="chart-card"><view class="section-head"><view><text class="section-title">商机阶段</text><text class="section-subtitle">当前参与商机 · 按数量</text></view><text class="section-link" bindtap="openProjects">全部 ›</text></view><view class="funnel-list"><view wx:for="{{stages}}" wx:key="code" class="funnel-row" bindtap="openProjects"><view class="funnel-copy"><text class="funnel-name">{{item.label}}</text><text class="funnel-amount">{{item.amountText}} 万元</text><text class="funnel-count">{{item.count}} 个</text></view><view class="funnel-track"><view class="funnel-bar tone-{{item.tone}}" style="width:{{item.width}}%"></view></view></view></view><view wx:if="{{!stages.length}}" class="empty">参与商机后，在这里查看项目进展</view></view>
    <view wx:if="{{!compact}}" class="chart-card"><view class="section-head"><view><text class="section-title">拜访节奏</text><text class="section-subtitle">{{rhythmMode==='day'?'最近 7 天':'最近 12 周'}} · {{summary.period_customers}} 个客户</text></view><text class="section-link" bindtap="openActivity">明细 ›</text></view><view class="rhythm-switch"><button class="rhythm-mode {{rhythmMode==='day'?'selected':''}}" data-mode="day" bindtap="changeRhythmMode" aria-label="日进展{{rhythmMode==='day'?'，已选中':''}}">日进展</button><button class="rhythm-mode {{rhythmMode==='week'?'selected':''}}" data-mode="week" bindtap="changeRhythmMode" aria-label="周进展{{rhythmMode==='week'?'，已选中':''}}">周进展</button></view><text wx:if="{{rhythmMode==='week'}}" class="rhythm-note">周一至周日 · 仅统计所选周期内记录</text><scroll-view wx:if="{{rhythm.length}}" scroll-x enhanced show-scrollbar="false" class="rhythm-scroll"><view class="visit-bars"><view wx:for="{{rhythm}}" wx:key="date" class="visit-day" bindtap="openActivity"><text class="bar-value">{{item.visits===null?'—':item.visits}}</text><view class="bar-space"><view class="visit-bar" style="height:{{item.height}}%"></view></view><text class="bar-date">{{item.dateLabel}}</text><text wx:if="{{rhythmMode==='week'}}" class="bar-week-end">至 {{item.endLabel}}</text></view></view></scroll-view><view wx:else class="empty">本人确认归档后，将形成拜访节奏</view></view>
    <view wx:if="{{scope==='team' && !compact}}" class="chart-card ranking-card"><view class="section-head"><view class="ranking-heading"><view class="ranking-symbol">协</view><view><text class="section-title">团队工作分布</text><text class="section-subtitle">{{rankingPeriodLabel || periodLabel}}</text></view></view><picker range="{{sortOptions}}" range-key="name" value="{{sortIndex}}" bindchange="sortRanking"><view class="ranking-picker">{{sortOptions[sortIndex].name}} ⌄</view></picker></view><view class="team-periods"><button class="team-period {{rankingPeriod==='week'?'selected':''}}" data-period="week" bindtap="changeRankingPeriod">周</button><button class="team-period {{rankingPeriod==='month'?'selected':''}}" data-period="month" bindtap="changeRankingPeriod">月</button><button class="team-period {{rankingPeriod==='quarter'?'selected':''}}" data-period="quarter" bindtap="changeRankingPeriod">季度</button></view><view wx:if="{{rankingPeriodLoading}}" class="empty">正在加载团队统计…</view><view wx:elif="{{rankingPeriodError}}" class="empty error">{{rankingPeriodError}}</view><button wx:for="{{ranking}}" wx:key="user_id" class="ranking-row" data-id="{{item.user_id}}" bindtap="openMember" hover-class="none" aria-label="查看{{item.name}}的协作看板{{item.is_active===false?'，已离组':''}}"><view class="rank-badge rank-{{item.rank}}">{{item.rank}}</view><view class="rank-person"><text class="rank-name">{{item.name}}{{item.is_active===false?' · 已离组':''}}</text><text class="rank-meta">{{item.team}} · {{item.opportunities}} 个商机</text><view class="rank-track"><view class="rank-progress" style="width:{{item.width}}%"></view></view></view><view class="rank-result"><text class="rank-value">{{item.value}} ›</text><text class="rank-unit">{{sortOptions[sortIndex].name}}</text></view></button><view wx:if="{{!ranking.length && !rankingPeriodLoading && !rankingPeriodError}}" class="empty">当前范围暂无成员记录</view></view>
    <block wx:if="{{!compact}}"><view class="public-rankings-heading"><text class="metrics-title">公共排名</text></view><dashboard-ranking wx:for="{{companyCards}}" wx:key="key" title="{{item.title}}" subtitle="{{rankingCohort}}" period="{{periodLabel}}" symbol="{{item.symbol}}" tone="{{item.tone}}" rows="{{item.rows}}" summary-ids="{{ownIds}}" empty-summary="所选对象暂未纳入当前榜单" error="{{item.error}}" bind:retry="load"/></block>
  </block>
</block>
  <view wx:if="{{activityOpen}}" class="activity-layer">
    <view class="activity-head"><view class="activity-heading"><view class="activity-title-line"><text class="activity-title">跟进记录</text><text class="activity-count">{{activityTotal}} 条</text></view><text class="activity-subtitle">{{periodLabel}} · {{memberLabel || scopeLabel}}</text></view></view>
    <scroll-view scroll-y enhanced show-scrollbar="false" class="activity-scroll">
      <view class="activity-list">
        <view wx:for="{{activity}}" wx:key="id" class="activity-card" data-id="{{item.id}}" bindtap="openVisit" hover-class="activity-card-active">
          <view class="activity-card-head"><view class="activity-icon" aria-hidden="true"><view class="activity-paper"><view class="activity-paper-line"></view><view class="activity-paper-line"></view><view class="activity-paper-line short"></view></view></view><view class="visit-copy"><text class="activity-customer">{{item.customer_name}}</text><text class="activity-project">{{item.opportunity_name || '未关联商机'}}</text></view><text wx:if="{{item.can_read_detail}}" class="activity-arrow">›</text></view>
          <view class="activity-card-foot"><text class="activity-date">{{item.dateText}}</text><text class="activity-recorder">{{item.recorder_name || '未记录填报人'}}</text><text wx:if="{{!item.can_read_detail}}" class="activity-history">历史摘要</text></view>
        </view>
        <view wx:if="{{activityLoading}}" class="activity-state">正在加载跟进记录…</view>
        <view wx:elif="{{activityError}}" class="activity-state error"><text>{{activityError}}</text><button class="activity-more" bindtap="loadActivity">重新加载</button></view>
        <button wx:elif="{{activityMore}}" class="activity-more" bindtap="loadActivity">加载更多记录</button>
        <view wx:elif="{{!activity.length}}" class="activity-state activity-empty"><text class="activity-empty-title">暂无跟进记录</text><text class="activity-empty-copy">所选周期内的已归档记录会显示在这里</text></view>
      </view>
    </scroll-view>
  </view>
</view>
