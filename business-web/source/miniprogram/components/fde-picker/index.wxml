<view class="fde-picker-view field {{compactForm ? 'compact-form' : ''}}"><view class="fde-picker-view heading"><text class="fde-picker-text">{{title}}</text><label wx:if="{{!hideOptional}}" class="fde-picker-label">选填</label></view><view class="fde-picker-view chosen {{disabled?'disabled':''}}" bindtap="open"><view wx:if="{{selected.length}}" class="fde-picker-view tags"><text wx:for="{{selectedRows}}" wx:key="id" class="fde-picker-text">{{item.name}}{{item.locked?' · 只读':''}}</text></view><text wx:else class="fde-picker-text">暂未选择</text><label wx:if="{{!disabled}}" class="fde-picker-label">选择 ›</label></view><view class="fde-picker-view hint">{{hint}}</view></view>
<view wx:if="{{open}}" class="fde-picker-view layer"><view class="fde-picker-view mask" bindtap="cancel"></view><view class="fde-picker-view sheet"><view class="sheet-handle"></view><view class="fde-picker-view title">{{title}}<text bindtap="cancel" class="fde-picker-text">取消</text></view><input class="search" maxlength="100" value="{{query}}" placeholder="搜索姓名，支持多选" bindinput="search"/><scroll-view wx:if="{{draft.length}}" scroll-x class="selected"><view class="fde-picker-view tags selected-tags"><text wx:for="{{draft}}" wx:key="id" data-id="{{item.id}}" bindtap="toggle" class="fde-picker-text">{{item.name}}{{item.locked?' · 只读':' ×'}}</text></view></scroll-view><scroll-view class="results" scroll-y style="height: {{rows.length > 5 ? 560 : rows.length * 112 + (loading || error || !rows.length || offset < total ? 88 : 0)}}rpx;"><view wx:for="{{rows}}" wx:key="id" class="fde-picker-view person {{item.excluded || item.locked?'disabled':''}}" data-id="{{item.id}}" bindtap="toggle"><view class="fde-picker-view"><text class="fde-picker-text">{{item.name}}</text><label class="fde-picker-label">{{item.team || '未标注部门'}} · {{item.role==='fde_lead'?'FDE主管':'FDE'}}</label></view><text class="fde-picker-text check {{item.selected?'checked':''}}">{{item.locked?'其他部门，只读':item.excluded?'已作普通协同人':item.selected?'✓':'○'}}</text></view><view wx:if="{{loading}}" class="fde-picker-view status">正在读取成员…</view><view wx:elif="{{error}}" class="fde-picker-view status error" bindtap="load">{{error}} · 点击重试</view><view wx:elif="{{!rows.length}}" class="fde-picker-view status">没有匹配的 FDE 成员</view><view wx:elif="{{offset<total}}" class="fde-picker-view status more" data-more="true" bindtap="load">加载更多</view></scroll-view><view class="fde-picker-view footer"><text class="fde-picker-text">已选 {{draft.length}} 人</text><button bindtap="confirm" class="fde-picker-button" hover-class="confirm-pressed">确认选择</button></view></view></view>
