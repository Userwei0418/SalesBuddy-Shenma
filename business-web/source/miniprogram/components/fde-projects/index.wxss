@import "../../styles/role-controls.wxss";
@import "../../styles/opportunity-list-header.wxss";
@import "../../styles/opportunity-list-card.wxss";
.fde-member-filter{flex:0 0 auto;width:188rpx;height:50rpx;min-width:0}
.projects{padding:28rpx 24rpx 50rpx;background:#f4f8fc;color:#29445f}.heading{font-size:36rpx;font-weight:700}.sub{color:#899caf;font-size:22rpx;margin:12rpx 0 22rpx;line-height:1.6}.filters{display:flex;flex-wrap:wrap;gap:12rpx}.picker{background:#fff;border:1rpx solid #e0e9f1}.active{color:#1677ff!important;background:#e4f0ff!important}.search{display:block;width:100%;height:80rpx;min-height:80rpx;box-sizing:border-box;line-height:normal;padding:0 20rpx;margin:22rpx 0;background:#fff;color:#29445f;border-radius:18rpx;font-size:26rpx;border:1rpx solid #e3ebf2}.search-placeholder{color:#899caf}.stage-scroll{white-space:nowrap}.stage-options{display:inline-flex;gap:12rpx;padding:8rpx 0}.stage-options .fde-projects-text{font-size:22rpx;color:#8496a8;padding:11rpx 17rpx;border-radius:14rpx;background:#fff}.quarters{display:flex;align-items:center;gap:6rpx;margin:20rpx 0}.quarters .fde-projects-text{padding:10rpx 10rpx;font-size:22rpx;color:#7790a6;border-radius:12rpx}.summary{padding:25rpx;border-radius:24rpx;color:#fff;background:linear-gradient(125deg,#153b61,#1b639d);margin:22rpx 0}.summary>.fde-projects-label{font-size:23rpx;opacity:.8}.summary>.fde-projects-text{display:block;font-size:42rpx;font-weight:650;margin:12rpx 0}.summary>.fde-projects-text>.fde-projects-label{font-size:23rpx;font-weight:400}.summary>.fde-projects-view{font-size:21rpx;opacity:.7}.state{margin:30rpx 0;padding:35rpx;text-align:center;color:#8397a9;font-size:25rpx;line-height:1.7;background:#fff;border-radius:22rpx}.error{color:#b7664d}
.workbench-opportunity-card{margin-top:16rpx;box-sizing:border-box}

.projects{min-height:100vh;box-sizing:border-box;padding:24rpx 28rpx 50rpx;background:linear-gradient(160deg,#fbfdff 0%,#eff6fd 52%,#e8f2fc 100%)}
.heading{font-size:38rpx;font-weight:750;color:#20374d}.sub{font-size:22rpx;line-height:1.5;margin:8rpx 0 20rpx;color:#77889b}
.search{height:64rpx;min-height:64rpx;margin:12rpx 0 0;padding:0 16rpx;font-size:25rpx;border-radius:14rpx;background:#f6f9fc}
.fde-summary-note{margin-top:14rpx;color:#bfd7eb;font-size:16rpx;line-height:1.6}.fde-summary-error{color:#ffe2b4}.fde-result-note{display:flex;justify-content:space-between;gap:16rpx;margin:12rpx 4rpx;color:#7b91a5;font-size:17rpx;line-height:1.5}.fde-result-note .fde-ui-text:last-child{color:#176fb7}
.filters{margin:0 0 16rpx}.workbench-filter-control .fde-ui-label{white-space:nowrap}
