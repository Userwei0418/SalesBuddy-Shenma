<import src="../../templates/opportunity-list-card.wxml"/>
<view class="fde-ui-view fde-projects-view projects"><view class="fde-ui-view fde-projects-view heading">商机</view><view class="fde-ui-view fde-projects-view sub">{{customerId?'当前客户业务全景，包含本人未参与项目':'有效协助商机，按项目去重'}} · {{count}} 个项目</view>
<view wx:if="{{membersLoading}}" class="fde-ui-view fde-projects-view sub">正在加载团队成员…</view><view wx:elif="{{membersError}}" class="fde-ui-view fde-projects-view sub error" bindtap="retryMembers">{{membersError}} · 重试成员目录</view>
<view wx:if="{{!customerId}}" class="fde-ui-view overview-board opportunity-overview opportunity-summary-card">
  <view class="fde-ui-view opportunity-summary-head"><view class="fde-ui-view opportunity-summary-title">商机总览</view><view class="fde-ui-view opportunity-summary-scope">{{memberId ? memberContextLabel : scope === 'team' ? '团队' : '本人'}}</view></view>
  <view class="fde-ui-view opportunity-summary-metrics">
    <view class="fde-ui-view opportunity-summary-metric opportunity-summary-won"><view class="fde-ui-view opportunity-summary-label">已成单商机</view><view class="fde-ui-view opportunity-summary-value">{{overviewReady ? overview.won : '—'}}<text class="fde-ui-text">个</text></view></view>
    <view class="fde-ui-view opportunity-summary-metric"><view class="fde-ui-view opportunity-summary-label">全部商机</view><view class="fde-ui-view opportunity-summary-value">{{overviewReady ? overview.total : '—'}}<text class="fde-ui-text">个</text></view></view>
    <view class="fde-ui-view opportunity-summary-metric"><view class="fde-ui-view opportunity-summary-label">活跃商机</view><view class="fde-ui-view opportunity-summary-value">{{overviewReady ? overview.active : '—'}}<text class="fde-ui-text">个</text></view></view>
    <view class="fde-ui-view opportunity-summary-metric"><view class="fde-ui-view opportunity-summary-label">Demo 场景</view><view class="fde-ui-view opportunity-summary-value">{{overviewReady ? overview.demo_scene_count : '—'}}<text class="fde-ui-text">个</text></view></view>
  </view>
  <view class="fde-ui-view fde-summary-note">全部商机为当前存量（含丢单）；成单、活跃和 Demo 按所选时间统计。</view>
  <view class="fde-ui-view quarter-filter quarter-filter-summary">
    <view class="fde-ui-view quarter-filter-head"><view class="fde-ui-view"><text class="fde-ui-text quarter-filter-title">统计时间</text><text class="fde-ui-text quarter-selection-label">{{summaryQuarter.label}}</text></view><picker range="{{years}}" value="{{summaryYearIndex}}" bindchange="summaryYear"><view class="fde-ui-view quarter-year">{{summaryQuarter.quarters.length ? summaryQuarter.year + '年' : '选择年份'}} ⌄</view></picker></view>
    <view class="fde-ui-view quarter-options"><view class="fde-ui-view quarter-option {{!summaryQuarter.quarters.length?'selected':''}}" data-q="0" bindtap="summaryQuarterChange">全部时间</view><view wx:for="{{summaryQuarter.options}}" wx:key="value" class="fde-ui-view quarter-option {{item.selected?'selected':''}}" data-q="{{item.value}}" bindtap="summaryQuarterChange">{{item.selected?'✓ ':''}}{{item.label}}</view></view>
    <view class="fde-ui-view quarter-filter-foot"><text class="fde-ui-text">季度可多选 · 全部商机不随季度变化</text><text class="fde-ui-text metric-help" bindtap="showOpportunityMetricHelp">统计口径 ⓘ</text></view>
  </view>
  <view wx:if="{{overviewLoading}}" class="fde-ui-view fde-summary-note">正在更新商机总览…</view>
  <view wx:if="{{overviewError}}" class="fde-ui-view fde-summary-note fde-summary-error" bindtap="loadOverview">商机总览暂不可用 · 点击重试</view>
  <view wx:if="{{overviewReady && summaryQuarter.quarters.length && (overview.missingWonDates || overview.missingCreatedDates)}}" class="fde-ui-view fde-summary-note"><view class="fde-ui-view" wx:if="{{overview.missingWonDates}}">{{overview.missingWonDates}} 个已成单商机缺少实际成单日期，未计入季度统计</view><view class="fde-ui-view" wx:if="{{overview.missingCreatedDates}}">{{overview.missingCreatedDates}} 个商机缺少原始建单日期，未计入新增的季度统计</view></view>
</view>
<view class="fde-ui-view workbench-opportunity-tools"><view class="fde-ui-view workbench-opportunity-filter">
  <view class="fde-ui-view workbench-filter-line"><text class="fde-ui-text workbench-filter-title">列表筛选</text><scroll-view class="workbench-filter-scroll" scroll-x enhanced show-scrollbar="false"><view class="fde-ui-view workbench-filter-row">
    <view wx:if="{{canViewTeam && !customerId && !memberId}}" class="fde-ui-view fde-member-filter"><member-scope-filter members="{{members}}" selected="{{memberIds}}" bind:change="member"/></view>
    <view class="fde-ui-view workbench-filter-item {{selectedStages.length?'active':''}}" bindtap="toggleStages"><view class="fde-ui-view workbench-filter-control"><label class="fde-ui-label">商机阶段</label><text class="fde-ui-text">{{selectedStages.length?'已选 '+selectedStages.length+' 项':'全部'}}</text><text class="fde-ui-text workbench-filter-chevron">⌄</text></view></view>
    <view class="fde-ui-view workbench-filter-item {{quarters.length?'active':''}}" bindtap="toggleQuarters"><view class="fde-ui-view workbench-filter-control"><label class="fde-ui-label">关单时间</label><text class="fde-ui-text">{{quarters.length?'已选 '+quarters.length+' 季度':'全部时间（跨年）'}}</text><text class="fde-ui-text workbench-filter-chevron">⌄</text></view></view>
    <picker class="workbench-filter-item" range="{{gradeOptions}}" value="{{gradeIndex}}" bindchange="grade"><view class="fde-ui-view workbench-filter-control"><label class="fde-ui-label">商机等级</label><text class="fde-ui-text">{{gradeOptions[gradeIndex]}}</text><text class="fde-ui-text workbench-filter-chevron">⌄</text></view></picker>
    <picker class="workbench-filter-item" range="{{productOptions}}" value="{{productIndex}}" bindchange="product"><view class="fde-ui-view workbench-filter-control"><label class="fde-ui-label">产品线</label><text class="fde-ui-text">{{productOptions[productIndex]}}</text><text class="fde-ui-text workbench-filter-chevron">⌄</text></view></picker>
  </view></scroll-view><text wx:if="{{memberIds.length || query || selectedStages.length || quarters.length || gradeIndex || productIndex}}" class="fde-ui-text workbench-filter-reset" bindtap="resetFilters">重置</text></view>
  <view wx:if="{{showStages}}" class="fde-ui-view workbench-stage-panel"><view class="fde-ui-view workbench-stage-option {{!selectedStages.length?'selected':''}}" data-code="all" bindtap="stage"><text class="fde-ui-text">{{!selectedStages.length?'✓':''}}</text><label class="fde-ui-label">全部阶段</label></view><view wx:for="{{stages}}" wx:key="code" class="fde-ui-view workbench-stage-option {{item.selected?'selected':''}}" data-code="{{item.code}}" bindtap="stage"><text class="fde-ui-text">{{item.selected?'✓':''}}</text><label class="fde-ui-label">{{item.label}}</label></view></view>
  <view wx:if="{{showQuarters}}" class="fde-ui-view quarter-filter quarter-filter-list"><view class="fde-ui-view quarter-filter-head"><view class="fde-ui-view"><text class="fde-ui-text quarter-filter-title">关单时间</text><text class="fde-ui-text quarter-selection-label">{{quarters.length ? year + '年 · 季度可多选' : '全部时间（跨年）'}}</text></view><picker range="{{years}}" value="{{yearIndex}}" bindchange="year"><view class="fde-ui-view quarter-year">{{quarters.length ? year + '年' : '选择年份'}} ⌄</view></picker></view><view class="fde-ui-view quarter-options"><view class="fde-ui-view quarter-option {{!quarters.length?'selected':''}}" data-q="0" bindtap="quarter">全部时间</view><view wx:for="{{quarterOptions}}" wx:key="value" class="fde-ui-view quarter-option {{item.selected?'selected':''}}" data-q="{{item.value}}" bindtap="quarter">{{item.selected?'✓ ':''}}Q{{item.value}}</view></view><view class="fde-ui-view quarter-filter-foot"><text class="fde-ui-text">按预计关单时间 · {{count}} 个筛选结果</text><view class="fde-ui-view quarter-filter-done" bindtap="toggleQuarters">完成</view></view></view>
  <input class="search" value="{{query}}" maxlength="100" placeholder="搜索客户、商机或产品线" placeholder-class="search-placeholder" aria-label="搜索客户、商机或产品线" bindinput="search"/>
</view></view>
<view class="fde-ui-view fde-result-note"><text class="fde-ui-text">当前筛选 · {{count}} 个商机</text><text class="fde-ui-text">在推项目 ACV {{acv}} 万元</text></view>
<view wx:if="{{loading}}" class="fde-ui-view fde-projects-view state">正在读取真实协助商机…</view><view wx:elif="{{error}}" class="fde-ui-view fde-projects-view state error" bindtap="load">{{error}} · 点击重试</view><view wx:elif="{{!filtered.length}}" class="fde-ui-view fde-projects-view state">{{query || selectedStages.length || quarters.length || productIndex ? '当前筛选没有匹配项目' : customerId ? '当前客户暂无商机' : '尚无有效协助项目，由有权销售或负责人加入名单后显示'}}</view>
<view wx:else class="fde-ui-view fde-projects-view"><view wx:for="{{filtered}}" wx:key="id" class="fde-ui-view workbench-opportunity-card" data-id="{{item.id}}" bindtap="open"><template is="opportunity-list-card" data="{{item: item}}"/></view></view><view wx:if="{{loadingMore}}" class="fde-ui-view fde-projects-view state">正在加载更多…</view><view wx:elif="{{moreError}}" class="fde-ui-view fde-projects-view state error" bindtap="loadMore">{{moreError}} · 点击重试</view><view wx:elif="{{hasMore}}" class="fde-ui-view fde-projects-view state" bindtap="loadMore">已显示 {{filtered.length}} / {{count}} 个项目 · 加载更多</view></view>
