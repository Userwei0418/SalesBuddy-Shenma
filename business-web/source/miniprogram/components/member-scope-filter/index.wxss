.member-trigger.member-trigger{display:flex;align-items:center;gap:6rpx;width:188rpx;max-width:100%;min-width:0;height:50rpx;min-height:0;box-sizing:border-box;margin:0;padding:0 10rpx;border:1rpx solid #dfe9f2;border-radius:12rpx;background:#f6f9fc;color:#304e68;font-size:17rpx;font-weight:500;line-height:1.3;text-align:left;white-space:nowrap}
.member-trigger-label{flex:0 0 auto;color:#8a99a8;font-size:15rpx;font-weight:400}
.member-trigger-value{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:17rpx;font-weight:650}
.member-trigger-caret{flex:0 0 auto;color:#86a0b7;font-size:15rpx;font-weight:400}
.member-trigger.member-trigger-selected{border-color:#99c8ef;background:#eaf5ff}.member-trigger-pressed{opacity:.7}
.member-clear.member-clear,.member-apply.member-apply{display:flex;align-items:center;justify-content:center;width:0;min-width:0;height:80rpx;min-height:0;margin:0;padding:0 16rpx;border-radius:16rpx;font-size:26rpx;font-weight:600;line-height:1.3;box-sizing:border-box}
.member-option.member-option{width:100%;max-width:100%;min-width:0;height:auto;min-height:0;margin:0;box-sizing:border-box;white-space:normal}
.member-trigger:after,.member-option:after,.member-clear:after,.member-apply:after{border:0}.member-mask{position:fixed;inset:0;z-index:1500;background:rgba(23,45,67,.36);display:flex;align-items:flex-end}.member-sheet{width:100%;background:#fff;border-radius:32rpx 32rpx 0 0;padding:32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box}.member-title{display:flex;justify-content:space-between;font-size:32rpx;font-weight:600;color:#244664}.member-close{font-size:26rpx;font-weight:400;color:#6685a1}.member-search{margin:24rpx 0;background:#f3f7fc;border-radius:16rpx;padding:16rpx 22rpx;font-size:28rpx;height:48rpx}.member-options{max-height:48vh;height:480rpx}.member-option{display:flex;gap:20rpx;align-items:center;width:100%;text-align:left;font-size:30rpx;background:#fff;color:#2d4a67;padding:22rpx 8rpx;line-height:1.5}.member-check{width:34rpx;height:34rpx;border:2rpx solid #c7d8e9;border-radius:10rpx;text-align:center;line-height:34rpx;font-size:23rpx}.checked{background:#2384df;color:#fff;border-color:#2384df}.member-actions{display:flex;gap:20rpx;padding-top:24rpx}.member-clear{flex:1;background:#f0f6fc;color:#456586}.member-apply{flex:2;background:#197de0;color:#fff}.member-empty{padding:40rpx;text-align:center;color:#849bb2}
