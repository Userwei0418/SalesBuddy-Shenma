<button class="member-trigger {{selected.length ? 'member-trigger-selected' : ''}}" bindtap="toggle" disabled="{{disabled}}" hover-class="member-trigger-pressed" aria-label="筛选团队成员，{{label}}"><text class="member-trigger-label">人员</text><text class="member-trigger-value">{{label}}</text><text class="member-trigger-caret">⌄</text></button>
<root-portal wx:if="{{open}}"><view class="member-mask" catchtap="cancel" catchtouchmove="noop"><view class="member-sheet" catchtap="noop"><view class="member-title"><text>筛选团队成员</text><text class="member-close" bindtap="cancel">取消</text></view><input class="member-search" value="{{query}}" placeholder="搜索同事姓名" bindinput="search"/><scroll-view scroll-y class="member-options"><button class="member-option" wx:for="{{options}}" wx:key="id" data-id="{{item.id}}" bindtap="select"><view class="member-check {{item.checked?'checked':''}}">{{item.checked?'✓':''}}</view><text>{{item.name}}</text></button><view wx:if="{{!options.length}}" class="member-empty">没有匹配的成员</view></scroll-view><view class="member-actions"><button class="member-clear" bindtap="clear">全部成员</button><button class="member-apply" bindtap="apply">确定{{draft.length?'（'+draft.length+'人）':''}}</button></view></view></view></root-portal>
