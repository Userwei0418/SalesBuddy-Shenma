<view class="scope-toolbar"><view class="role-scope-switch"><button wx:for="{{modes}}" wx:key="value" size="mini" class="role-scope-option {{mode===item.value?'role-scope-selected':''}}" data-mode="{{item.value}}" bindtap="switchMode">{{item.label}}</button></view><button wx:if="{{mode==='person' || (mode==='team' && teams.length>1)}}" size="mini" class="subject-trigger" bindtap="show">{{mode==='person'?'选择成员':'选择团队'}}<text>⌄</text></button></view><view class="subject-caption">{{label}}</view>
<view wx:if="{{open}}" class="selector-mask" catchtap="close" catchtouchmove="noop"><view class="selector-sheet" catchtap="noop"><view class="selector-grip" bindtap="close"><view class="selector-grip-line"></view></view><view class="selector-heading">{{selecting==='team'?'选择团队':'选择成员'}}</view><input wx:if="{{selecting==='person'}}" class="selector-search" placeholder="搜索成员姓名" value="{{search}}" bindinput="search"/>
<scroll-view wx:if="{{selecting==='person' && teams.length>1}}" scroll-x class="selector-team-scroll"><view class="selector-team-list"><button size="mini" class="team-chip {{!filterTeam?'selected':''}}" data-id="" bindtap="teamFilter">全部团队</button><button wx:for="{{teams}}" wx:key="id" size="mini" class="team-chip {{filterTeam===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="teamFilter">{{item.name}}</button></view></scroll-view>
<scroll-view scroll-y class="selector-rows" style="height: {{(selecting==='team'?teams.length:visibleMembers.length)*124+40}}rpx"><button wx:for="{{selecting==='team'?teams:visibleMembers}}" wx:key="id" class="subject-row {{(selecting==='team'?teamId:memberId)===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="select"><view class="subject-avatar">{{item.initial || (selecting==='team'?'团':'人')}}</view><view class="subject-copy"><text class="subject-name">{{item.name}}</text><label class="subject-team" wx:if="{{item.teamLabel}}">{{item.teamLabel}}</label></view><text class="subject-check">{{(selecting==='team'?teamId:memberId)===item.id?'✓':''}}</text></button><view wx:if="{{selecting==='person' && !visibleMembers.length}}" class="selector-empty">没有匹配的成员</view></scroll-view><view class="selector-bottom">仅显示当前账号可查看的对象</view></view></view>
