/* Match the sales profile's glass identity card, pills and six-axis portrait. */
/* Native buttons retain the existing cards and pills while exposing each action to readers. */
.action-button{margin:0;padding:0;border:0;border-radius:0;background:transparent;color:inherit;font-size:inherit;font-weight:inherit;line-height:inherit;text-align:left;white-space:normal;overflow:visible;box-sizing:border-box}.action-button::after{border:0}.full-button{width:100%}
.profile-page{padding:26rpx 24rpx 60rpx;color:#24374e;background:linear-gradient(180deg,#f4f8ff 0,#eef4fb 100%);min-height:100vh;box-sizing:border-box}.surface{border:1rpx solid rgba(215,227,239,.8);border-radius:24rpx;background:rgba(255,255,255,.86);box-shadow:0 8rpx 26rpx rgba(37,75,112,.055)}.profile-card{display:flex;align-items:center;gap:18rpx;padding:28rpx;background:linear-gradient(145deg,rgba(255,255,255,.76),rgba(235,245,255,.66))}.avatar{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:28rpx;background:linear-gradient(145deg,#173551,#1677ff);box-shadow:0 12rpx 28rpx rgba(19,86,172,.2),inset 0 1rpx 1rpx rgba(255,255,255,.35);color:#fff;font-size:34rpx;font-weight:800}.profile-main{flex:1;min-width:0}.name{display:block;font-size:32rpx;font-weight:750;line-height:1.35;word-break:break-all}.meta{display:block;margin-top:8rpx;color:#718097;font-size:21rpx;line-height:1.5;word-break:break-all}.status{display:flex;align-items:center;gap:8rpx;flex-shrink:0;padding:8rpx 12rpx;border-radius:999rpx;background:rgba(229,247,239,.8);color:#16875b;font-size:18rpx}.status-dot{width:9rpx;height:9rpx;border-radius:50%;background:#35a477}
.profile-insight-tabs{display:flex;gap:8rpx;margin-top:18rpx;padding:7rpx;background:#eaf1f8;border-radius:22rpx}.profile-tab{flex:1;min-width:0;box-sizing:border-box;padding:18rpx 6rpx;border-radius:16rpx;color:#728197;font-size:24rpx;font-weight:650;text-align:center;white-space:nowrap}.profile-tab.active{color:#fff;background:linear-gradient(135deg,#245da6,#1685e7);box-shadow:0 6rpx 16rpx rgba(26,101,174,.18)}
.capability-card,.ai-advice-card,.records-card{margin-top:18rpx;padding:26rpx;background:linear-gradient(150deg,rgba(238,247,255,.88),rgba(255,255,255,.94) 42%)}.capability-top,.records-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.capability-eyebrow{display:block;color:#82a0bd;font-size:17rpx;font-weight:700;letter-spacing:1rpx}.capability-title{display:block;color:#254361;font-size:29rpx;font-weight:780;line-height:1.4;margin-top:6rpx}.sample-badge{flex-shrink:0;text-align:right;padding:12rpx 16rpx;border-radius:17rpx;background:rgba(231,243,255,.8)}.sample-count{display:block;color:#216dab;font-size:36rpx;font-weight:850}.sample-label{display:block;margin-top:3rpx;color:#8195a8;font-size:17rpx}.radar-canvas{display:block;width:100%;height:440rpx;margin:10rpx 0 0}.sample-note{padding:16rpx;border-radius:14rpx;background:#f2f5f8;color:#8a99aa;font-size:21rpx;line-height:1.6}.review-summary{margin-top:8rpx;color:#526b82;font-size:23rpx;line-height:1.75}.review-meta{display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap;margin-top:14rpx;color:#8e9dae;font-size:18rpx;line-height:1.6}.dimension-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:24rpx}.dimension-item{padding:18rpx;border:1rpx solid #e1ebf5;border-radius:17rpx;background:rgba(245,249,254,.82);min-width:0}.dimension-top{display:flex;justify-content:space-between;align-items:center;gap:8rpx;flex-wrap:wrap}.dimension-name{color:#354f68;font-size:22rpx;font-weight:700}.dimension-score{color:#2275ba;font-size:23rpx;font-weight:750}.unassessed{color:#96a4b3;font-size:20rpx;font-weight:500}.score-track{height:7rpx;border-radius:999rpx;background:#e3edf6;overflow:hidden;margin-top:13rpx}.score-progress{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#1d73c3,#42a6f2)}.dimension-assessment{display:block;margin-top:12rpx;color:#7d91a4;font-size:19rpx;line-height:1.65}
.advice-entry{display:flex;align-items:center;gap:16rpx;margin-top:18rpx;padding:24rpx}.ai-mark{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;flex-shrink:0;border-radius:18rpx;background:linear-gradient(145deg,#1b61af,#369df0);color:#fff;font-size:24rpx;font-weight:800;box-shadow:0 6rpx 16rpx rgba(32,110,180,.15)}.advice-entry-copy{flex:1;min-width:0}.advice-entry-title{display:block;color:#2e4a65;font-size:25rpx;font-weight:750}.advice-entry-note{display:block;margin-top:7rpx;color:#8497a9;font-size:20rpx;line-height:1.5}.entry-arrow{font-size:32rpx;color:#9aadc0;flex-shrink:0}.ai-advice-head{display:flex;align-items:center;gap:16rpx}.ai-heading{min-width:0;flex:1}.advice-title{display:block;color:#2e4a65;font-size:28rpx;font-weight:780}.advice-subtitle{display:block;margin-top:7rpx;color:#8497a9;font-size:20rpx;line-height:1.5}.advice-status{padding:18rpx 0 6rpx;color:#71899e;font-size:22rpx;line-height:1.65}.advice-item{display:flex;align-items:flex-start;gap:15rpx;padding:24rpx 0;border-bottom:1rpx solid #e5eef6}.advice-item:last-child{border:0}.advice-number{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;flex-shrink:0;border-radius:11rpx;background:#e5f0fc;color:#287bbc;font-size:20rpx;font-weight:800}.advice-copy{flex:1;min-width:0}.advice-item-title{display:block;color:#365670;font-size:24rpx;font-weight:700;line-height:1.5}.advice-content{display:block;margin-top:8rpx;color:#6f879b;font-size:22rpx;line-height:1.8;white-space:pre-wrap;word-break:break-all}.review-button{margin-top:24rpx;padding:5rpx 16rpx;border:0;border-radius:16rpx;background:linear-gradient(135deg,#245da6,#1685e7);color:#fff;font-size:24rpx}.review-button::after,.logout-button::after{border:0}.advice-footnote{display:block;margin-top:18rpx;color:#97a6b6;font-size:19rpx;line-height:1.65}.review-error{margin-top:12rpx;color:#b97159;font-size:22rpx;line-height:1.5}
.records-count{color:#7b96ad;font-size:21rpx;flex-shrink:0}.records-note{display:block;color:#92a2b2;font-size:20rpx;margin-top:12rpx;line-height:1.6}.visit-row{display:flex;align-items:center;gap:14rpx;padding:24rpx 0;border-bottom:1rpx solid #e7eff6}.visit-row:last-child{border:0}.visit-copy{flex:1;min-width:0}.visit-name{display:block;color:#38536d;font-size:25rpx;font-weight:700;line-height:1.5;word-break:break-all}.visit-project{display:block;margin-top:7rpx;color:#708ba2;font-size:22rpx;line-height:1.5;word-break:break-all}.visit-date{display:block;margin-top:9rpx;color:#96a6b5;font-size:19rpx}.history-pill{display:inline-block;margin-top:10rpx;padding:4rpx 10rpx;border-radius:8rpx;background:#eef2f6;color:#8496a8;font-size:18rpx}.state{margin-top:18rpx;padding:36rpx 20rpx;color:#8b9bae;font-size:23rpx;line-height:1.7;text-align:center}.error{color:#b97159}.load-more{padding:26rpx 12rpx;text-align:center;color:#287bbc;font-size:23rpx}.account-card{padding:4rpx 24rpx;margin-top:22rpx}.account-row{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx;padding:22rpx 0;border-bottom:1rpx solid #e6eef5}.account-row:last-child{border:0}.account-label{color:#8496a8;font-size:22rpx;flex-shrink:0}.account-value{text-align:right;color:#49637b;font-size:22rpx;word-break:break-all;line-height:1.5}.logout-button{display:flex;align-items:center;justify-content:center;min-height:84rpx;margin-top:26rpx;border:1rpx solid rgba(208,83,100,.15);border-radius:22rpx;background:rgba(255,255,255,.5);color:#cf5967;font-size:25rpx}.version{margin-top:32rpx;text-align:center;color:#94a0af;font-size:20rpx}

/* Inline coaching follows the sales profile hierarchy. */
.ai-advice-card { border: 1rpx solid #cee4f7; background: linear-gradient(145deg,#eff8ff,#f8fcff); }
.ai-mark { width: 40rpx; height: 40rpx; border-radius: 13rpx; font-size: 18rpx; }
.advice-title { font-size: 25rpx; }
.advice-subtitle { font-size: 18rpx; }
.advice-item { gap: 12rpx; padding: 18rpx 0; }
.advice-content { font-size: 22rpx; line-height: 1.8; }
.review-button { width: 100%; min-height: 64rpx; line-height: 64rpx; }
.task-metrics { display: flex; margin-top: 24rpx; }
.task-metric { flex: 1; text-align: center; border-right: 1rpx solid #e4edf6; }
.task-metric:last-child { border: 0; }
.task-metric-value { display: block; color: #2468a1; font-size: 36rpx; font-weight: 750; }
.task-metric-label { display: block; margin-top: 8rpx; color: #8899aa; font-size: 21rpx; }

.embedded-profile { padding: 0; min-height: 0; background: transparent; }

.fde-metrics {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:24rpx}
.fde-metric {padding:22rpx;background:#f4f9ff;border:1rpx solid #dfebf6;border-radius:18rpx}
.fde-metric-name {font-size:23rpx;color:#506d86}
.fde-metric-main {display:flex;align-items:baseline;gap:6rpx;margin:12rpx 0}
.fde-metric-value {font-size:37rpx;font-weight:750;color:#235e91}
.fde-metric-unit,.fde-metric-note {font-size:19rpx;color:#869aac}
.fde-metric-note {display:block;line-height:1.6}
.fde-stage {margin-top:22rpx}
.fde-rhythm {display:flex;gap:14rpx;padding-top:24rpx}
.fde-rhythm-item {flex:0 0 70rpx;display:flex;flex-direction:column;align-items:center;gap:8rpx}
.fde-bar-track {height:140rpx;width:48rpx;display:flex;align-items:flex-end;background:#eff5fa;border-radius:8rpx}
.fde-bar {width:100%;background:linear-gradient(#5bcaa4,#269b7c);border-radius:8rpx}
.fde-date {font-size:17rpx;color:#8298aa}

/* Sales portrait composition with FDE-owned dimensions and coaching. */
.sales-layout-portrait {margin-top:14rpx;padding:25rpx 22rpx;background:rgba(255,255,255,.86)}
.sales-layout-portrait .capability-top {align-items:flex-start;gap:16rpx}
.sales-layout-portrait .capability-eyebrow {font-size:16rpx;letter-spacing:2rpx;color:#6f88a6}
.sales-layout-portrait .capability-title {margin-top:7rpx;font-size:29rpx;font-weight:760}
.sales-layout-portrait .radar-canvas {height:430rpx;margin-top:8rpx}
.sales-layout-portrait .review-summary {padding:18rpx;border-radius:18rpx;background:rgba(235,244,253,.72);color:#41536a;font-size:21rpx;line-height:1.6}
.sales-layout-portrait .review-meta {margin-top:15rpx;font-size:17rpx;gap:15rpx}
.sales-layout-portrait .dimension-grid {gap:12rpx;margin-top:18rpx}
.sales-layout-portrait .dimension-item {padding:15rpx;border-radius:17rpx;background:rgba(247,250,254,.78);border-color:rgba(92,125,162,.09)}
.sales-layout-portrait .dimension-name {font-size:20rpx;font-weight:680}
.sales-layout-portrait .dimension-score {font-size:21rpx;font-weight:750}
.sales-layout-portrait .dimension-assessment {margin-top:9rpx;font-size:16rpx;line-height:1.4;color:#8693a4}
.portrait-coaching {margin-top:14rpx;padding:19rpx;border-radius:22rpx;box-shadow:none}
.portrait-coaching .advice-title {font-size:20rpx;font-weight:730}
.portrait-coaching .advice-subtitle {font-size:14rpx;margin-top:3rpx}
.portrait-coaching .ai-mark {width:43rpx;height:43rpx;font-size:14rpx;border-radius:14rpx}
.portrait-coaching .advice-item {gap:10rpx;padding:11rpx 0}
.portrait-coaching .advice-number {width:31rpx;height:31rpx;font-size:14rpx;border-radius:10rpx}
.portrait-coaching .advice-item-title {font-size:18rpx;line-height:1.6}
.portrait-coaching .advice-content {font-size:18rpx;line-height:1.6;margin-top:5rpx}
.portrait-coaching .advice-status,.portrait-coaching .advice-footnote {font-size:17rpx}
.growth-heading {display:flex;justify-content:space-between;align-items:center;margin:32rpx 0 20rpx}
.growth-period {padding:7rpx 12rpx;border-radius:999rpx;background:#e0efff;color:#3577bc;font-size:18rpx}
.portrait-growth {padding:25rpx 22rpx}
.portrait-growth-tabs {width:100%;white-space:nowrap}
.portrait-growth-options {display:inline-flex;gap:10rpx}
.portrait-growth-empty {display:flex;align-items:center;justify-content:center;min-height:220rpx;color:#8795a7;font-size:20rpx;line-height:1.7;text-align:center}

/* Match the sales maturity layout while retaining FDE project facts. */
.project-performance-card {padding:25rpx 22rpx;background:rgba(255,255,255,.86)}
.project-score {flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;padding:9rpx 12rpx;border-radius:16rpx;background:#fff5e4}
.project-score-value {font-size:43rpx;color:#b78532;font-weight:800;line-height:1.1}
.project-score-unit {font-size:18rpx;font-weight:400}
.project-score-note {margin-top:6rpx;font-size:16rpx;color:#9c8b71}
.project-performance-board {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-top:18rpx}
.project-performance-metric {padding:18rpx;border:1rpx solid #dce9f4;border-radius:19rpx;background:linear-gradient(145deg,#f8fbff,#eef6fd)}
.project-metric-title {color:#2c4b66;font-size:22rpx;font-weight:750}
.project-rate {font-size:14rpx;color:#8696a8}
.project-value-label {display:block;margin-top:16rpx;font-size:18rpx;color:#8696a8}
.project-completed {margin-top:8rpx;color:#1f527d;font-size:34rpx;font-weight:750}
.project-money-unit {font-size:20rpx;font-weight:500}
.project-target {margin-top:12rpx}
.project-target-value {display:block;margin-top:8rpx;font-size:23rpx;color:#71869b}
.project-progress-track {height:7rpx;margin-top:15rpx;border-radius:999rpx;background:#dfeaf4}
.project-facts {display:flex;flex-direction:column;gap:20rpx;margin-top:24rpx}
.project-fact {padding:24rpx;border:1rpx solid #e0ebf5;border-radius:20rpx;background:#f6faff}
.project-fact-name {font-size:24rpx;color:#5e748b}
.project-fact-value {margin:12rpx 0;color:#20496e;font-size:38rpx;font-weight:750}
.project-fact-note {font-size:21rpx;color:#71869b}

/* Match the effective sales profile-compact rules, including its two-column facts. */
.project-performance-card {margin-top:14rpx;padding:25rpx 23rpx 27rpx}
.project-performance-card .capability-title {margin-top:7rpx;font-size:28rpx}
.project-performance-card .records-head {align-items:flex-start}
.project-performance-board {gap:14rpx;margin-top:18rpx}
.project-performance-metric {min-width:0;padding:18rpx 18rpx 16rpx;border-radius:18rpx}
.project-metric-title {font-size:20rpx;line-height:1.35}
.project-rate {max-width:116rpx;padding:4rpx 8rpx;border-radius:999rpx;color:#3776aa;background:#e8f3fc;font-size:13rpx;line-height:1.3;text-align:center}
.project-value-label {margin-top:14rpx;color:#8293a4;font-size:15rpx;line-height:1.3}
.project-completed {display:block;margin-top:5rpx;overflow:hidden;color:#174f7c;font-size:29rpx;font-weight:780;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}
.project-target {display:flex;align-items:baseline;gap:7rpx;min-width:0;margin-top:13rpx;padding-top:11rpx;border-top:1rpx solid #dfebf4;border-radius:8rpx}
.project-target .project-value-label {flex:0 0 auto;margin:0;color:#8192a3;font-size:14rpx}
.project-target-value {min-width:0;margin:0;overflow:hidden;color:#315d80;font-size:17rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.project-progress-track {height:6rpx;margin-top:11rpx}
.project-facts {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:15rpx}
.project-fact {min-width:0;padding:18rpx 19rpx;border-radius:18rpx}
.project-fact-name {font-size:19rpx;line-height:1.35}
.project-fact-value {margin:9rpx 0 6rpx;font-size:27rpx;font-weight:760;line-height:1.25;overflow-wrap:break-word}
.project-fact-note {display:block;font-size:16rpx;line-height:1.45}

.portrait-score-unit{font-size:18rpx;font-weight:500}.sales-layout-portrait .sample-count{font-size:42rpx;line-height:1.1}.sales-layout-portrait .sample-label{font-size:16rpx}

.project-progress-fill{height:100%;background:linear-gradient(90deg,#246baf,#1b95ef);border-radius:inherit;}.fde-target-notice{margin:12rpx 0;color:#8297aa;font-size:20rpx;}

.project-target{align-items:center;justify-content:space-between;gap:8rpx;}
.project-target-copy{display:flex;align-items:baseline;min-width:0;gap:7rpx;}
.project-target-edit{flex:0 0 auto;color:#1675bd;font-size:14rpx;font-weight:700;}
.project-target-editable:active{background:#e2f0fb;}

.history-canvas{width:100%;height:320rpx}

.text-link.text-link{display:inline-flex;align-items:center;justify-content:flex-start;width:auto;min-width:0;min-height:44rpx;margin:0;padding:6rpx 0;border:0;border-radius:0;background:transparent;color:#287bbc;font-size:20rpx;font-weight:500;line-height:1.5;text-align:left;box-sizing:border-box}
.text-link::after{border:0}.text-link-disabled{color:#93a4b6}
.rhythm-controls{display:flex;gap:6rpx;padding:5rpx;border-radius:14rpx;background:#eaf1f8}
.rhythm-option.rhythm-option{display:flex;align-items:center;justify-content:center;width:auto;min-width:0;min-height:40rpx;margin:0;padding:8rpx 12rpx;border-radius:10rpx;background:transparent;color:#72899d;font-size:19rpx;font-weight:500;line-height:1.3}
.rhythm-option.chosen{color:#fff;background:linear-gradient(135deg,#2367aa,#268ce0)}.rhythm-option::after{border:0}
.portrait-growth-option.portrait-growth-option{display:flex;align-items:center;justify-content:center;flex:0 0 auto;width:auto;min-width:0;min-height:44rpx;margin:0;padding:10rpx 17rpx;border:0;border-radius:999rpx;background:rgba(236,242,249,.86);color:#718097;font-size:19rpx;font-weight:500;line-height:1.3;white-space:nowrap;box-sizing:border-box}
.portrait-growth-option.portrait-growth-selected{background:#1677ff;color:#fff}.portrait-growth-option::after{border:0}

.project-rate{max-width:none;flex-shrink:0;white-space:nowrap}
