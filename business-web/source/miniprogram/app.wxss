@import "pages/customer-assets/opportunity-view.wxss";
@import "pages/profile/profile-compact.wxss";

page {
  background: #f3f7fc;
  color: #182233;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, scroll-view, input, button { box-sizing: border-box; }
button { background: transparent; margin: 0; padding: 0; line-height: normal; }
button::after { border: 0; }
.retry-button { width: 100%; height: 92rpx; border: 0; border-radius: 24rpx; color: #fff; font-size: 29rpx; font-weight: 700; background: linear-gradient(100deg,#175b98,#1687dd); }

.page-shell { min-height: 100vh; padding: 24rpx 28rpx 40rpx; background: linear-gradient(150deg, #fbfdff 0%, #f1f6fc 52%, #eaf2fb 100%); }
.surface { background: rgba(255,255,255,.68); border: 1rpx solid rgba(255,255,255,.92); border-radius: 28rpx; box-shadow: 0 18rpx 52rpx rgba(29,66,114,.09), inset 0 1rpx 0 rgba(255,255,255,.75); -webkit-backdrop-filter: blur(30rpx) saturate(145%); backdrop-filter: blur(30rpx) saturate(145%); }
.eyebrow { color: #7c899b; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.section-title { margin: 36rpx 0 20rpx; font-size: 32rpx; font-weight: 700; }
.tag { display: inline-flex; align-items: center; padding: 8rpx 16rpx; border-radius: 999rpx; background: rgba(228,240,255,.82); color: #1677ff; font-size: 23rpx; }
.muted { color: #748298; }
.primary-button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 28rpx; border-radius: 22rpx; background: linear-gradient(135deg,#172a46,#1677ff); color: #fff; box-shadow: 0 12rpx 28rpx rgba(22,86,174,.22); font-size: 29rpx; font-weight: 600; }
.secondary-button { display: flex; align-items: center; justify-content: center; min-height: 80rpx; padding: 0 24rpx; border: 1rpx solid rgba(90,112,141,.16); border-radius: 20rpx; background: rgba(255,255,255,.72); color: #24334a; }
.ai-advice-card{margin-top:20rpx;padding:19rpx;border:1rpx solid rgba(110,185,239,.4);border-radius:22rpx;background:linear-gradient(145deg,rgba(245,251,255,.96),rgba(226,242,255,.86))}.ai-advice-head{display:flex;align-items:center;gap:12rpx}.ai-advice-head>view:first-child{width:43rpx;height:43rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:14rpx;color:#fff;background:linear-gradient(145deg,#174f83,#1684e9);font-size:14rpx;font-weight:800}.ai-advice-head>view:nth-child(2){flex:1}.ai-advice-head text,.ai-advice-head label{display:block}.ai-advice-head text{color:#2c4864;font-size:20rpx;font-weight:730}.ai-advice-head label{margin-top:3rpx;color:#7c8fa2;font-size:14rpx}.ai-advice-head .readonly{padding:5rpx 9rpx;border-radius:999rpx;color:#4c7da9;background:rgba(255,255,255,.72);font-size:13rpx}.ai-advice-list{margin-top:14rpx}.ai-advice-list>view{display:flex;align-items:flex-start;gap:10rpx;padding:11rpx 0;border-top:1rpx solid rgba(63,115,160,.09)}.ai-advice-list>view>text{width:31rpx;height:31rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:10rpx;color:#1677cf;background:#dcefff;font-size:14rpx;font-weight:750}.ai-advice-list label{color:#4c6379;font-size:17rpx;line-height:1.55}
.manual-agent-tip{display:grid;grid-template-columns:42rpx 1fr;gap:7rpx 11rpx;margin-top:18rpx;padding:15rpx;border:1rpx solid rgba(112,188,240,.36);border-radius:17rpx;background:#edf7ff}.manual-agent-tip>view{grid-row:1/3;width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;border-radius:13rpx;color:#fff;background:#167bd7;font-size:13rpx;font-weight:800}.manual-agent-tip text{color:#3c5b78;font-size:16rpx;line-height:1.5}.manual-agent-tip label{color:#8293a4;font-size:14rpx;line-height:1.45}
.response-card textarea{width:100%;min-height:150rpx;margin-top:16rpx;padding:17rpx;border:1rpx solid rgba(79,112,146,.14);border-radius:18rpx;background:#f7fafe;color:#344a60;font-size:21rpx}.response-button-row{display:grid;grid-template-columns:1fr 1.6fr;gap:13rpx}.response-button-row button{height:78rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;font-size:22rpx;font-weight:700}.reject-button{border:1rpx solid rgba(211,91,74,.24);color:#c85545;background:#fff2ef}.accept-button{color:#fff;background:linear-gradient(145deg,#218561,#36ae7d)}.rejected-card{display:flex;gap:14rpx;border-color:rgba(224,120,99,.24)!important;background:#fff4f1!important}.rejected-icon{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:15rpx;color:#fff;background:#dc6955;font-size:28rpx}.rejected-card>view:last-child>text,.rejected-card>view:last-child>label{display:block}.rejected-card>view:last-child>text{color:#7b4036;font-weight:750}.rejected-card>view:last-child>label{margin-top:5rpx;color:#a8786f;font-size:17rpx}.rejected-card>view:last-child>view{margin-top:12rpx;color:#704c44;font-size:20rpx;line-height:1.55}

/* Unified health, reminder and alert states. */
.traffic-badge{border-radius:10rpx;padding:5rpx 10rpx}
.traffic-badge.traffic-green,.traffic-surface-green{color:#238c68!important;background:#e4f6ee!important}.traffic-text-green,.module-total.traffic-surface-green text,.module-total.traffic-surface-green label,.score.traffic-surface-green text{color:#238c68!important}.traffic-fill-green{background:#238c68!important}
.task-card.traffic-green,.risk-card.traffic-green{border-color:#238c6855!important}.traffic-green .task-status>text,.traffic-green .risk-state>text,.traffic-green .hero-status>text,.traffic-green .hero-state>text,.customer-task-item.traffic-green .customer-task-rail>view{background:#238c68!important}
.detail-page.traffic-green .detail-hero{background:linear-gradient(135deg,#e4f6ee,#fff)!important;color:#238c68!important}.detail-page.traffic-green .hero-title,.detail-page.traffic-green .hero-customer,.detail-page.traffic-green .hero-stage,.detail-page.traffic-green .hero-meta{color:#238c68!important}.detail-page.traffic-green .hero-progress>view{background:#238c68!important}
.traffic-badge.traffic-yellow,.traffic-surface-yellow{color:#a77722!important;background:#fff4d9!important}.traffic-text-yellow,.module-total.traffic-surface-yellow text,.module-total.traffic-surface-yellow label,.score.traffic-surface-yellow text{color:#a77722!important}.traffic-fill-yellow{background:#a77722!important}
.task-card.traffic-yellow,.risk-card.traffic-yellow{border-color:#a7772255!important}.traffic-yellow .task-status>text,.traffic-yellow .risk-state>text,.traffic-yellow .hero-status>text,.traffic-yellow .hero-state>text,.customer-task-item.traffic-yellow .customer-task-rail>view{background:#a77722!important}
.detail-page.traffic-yellow .detail-hero{background:linear-gradient(135deg,#fff4d9,#fff)!important;color:#a77722!important}.detail-page.traffic-yellow .hero-title,.detail-page.traffic-yellow .hero-customer,.detail-page.traffic-yellow .hero-stage,.detail-page.traffic-yellow .hero-meta{color:#a77722!important}.detail-page.traffic-yellow .hero-progress>view{background:#a77722!important}
.traffic-badge.traffic-red,.traffic-surface-red{color:#bc5149!important;background:#ffebe8!important}.traffic-text-red,.module-total.traffic-surface-red text,.module-total.traffic-surface-red label,.score.traffic-surface-red text{color:#bc5149!important}.traffic-fill-red{background:#bc5149!important}
.task-card.traffic-red,.risk-card.traffic-red{border-color:#bc514955!important}.traffic-red .task-status>text,.traffic-red .risk-state>text,.traffic-red .hero-status>text,.traffic-red .hero-state>text,.customer-task-item.traffic-red .customer-task-rail>view{background:#bc5149!important}
.detail-page.traffic-red .detail-hero{background:linear-gradient(135deg,#ffebe8,#fff)!important;color:#bc5149!important}.detail-page.traffic-red .hero-title,.detail-page.traffic-red .hero-customer,.detail-page.traffic-red .hero-stage,.detail-page.traffic-red .hero-meta{color:#bc5149!important}.detail-page.traffic-red .hero-progress>view{background:#bc5149!important}
.traffic-badge.traffic-gray,.traffic-surface-gray{color:#8091a0!important;background:#eef2f5!important}.traffic-text-gray,.module-total.traffic-surface-gray text,.module-total.traffic-surface-gray label,.score.traffic-surface-gray text{color:#8091a0!important}.traffic-fill-gray{background:#8091a0!important}
.task-card.traffic-gray,.risk-card.traffic-gray{border-color:#8091a055!important}.traffic-gray .task-status>text,.traffic-gray .risk-state>text,.traffic-gray .hero-status>text,.traffic-gray .hero-state>text,.customer-task-item.traffic-gray .customer-task-rail>view{background:#8091a0!important}
.detail-page.traffic-gray .detail-hero{background:linear-gradient(135deg,#eef2f5,#fff)!important;color:#8091a0!important}.detail-page.traffic-gray .hero-title,.detail-page.traffic-gray .hero-customer,.detail-page.traffic-gray .hero-stage,.detail-page.traffic-gray .hero-meta{color:#8091a0!important}.detail-page.traffic-gray .hero-progress>view{background:#8091a0!important}

.access-empty{margin:50rpx 28rpx;padding:40rpx;border-radius:24rpx;background:#fff;color:#526880;line-height:1.7}.access-empty>text{display:block;font-size:30rpx;font-weight:600;color:#243f59}.access-empty>label{display:block;margin-top:16rpx;font-size:25rpx}.fde-note{margin:14rpx 0;padding:16rpx 20rpx;border-radius:16rpx;background:#edf5ff;color:#53708c;font-size:23rpx;line-height:1.6}.fde-tags{display:flex;flex-wrap:wrap;gap:10rpx}.fde-tags text{padding:6rpx 14rpx;border-radius:12rpx;background:#eaf3ff;color:#216ab0;font-size:23rpx}
