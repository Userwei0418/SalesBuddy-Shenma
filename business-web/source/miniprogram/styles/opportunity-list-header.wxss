.overview-board.opportunity-overview{margin-top:8rpx;padding:26rpx 27rpx;color:#fff;border-color:rgba(255,255,255,.16);border-radius:30rpx;background:radial-gradient(ellipse at top right,rgba(63,154,229,.34),transparent 62%),linear-gradient(125deg,#153b61,#176dad);box-shadow:0 15rpx 38rpx rgba(20,64,104,.18),inset 0 1rpx 1rpx rgba(255,255,255,.2)}
.opportunity-summary-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
.opportunity-summary-title{font-size:29rpx;font-weight:720;letter-spacing:.5rpx}
.opportunity-summary-scope{padding:8rpx 16rpx;border-radius:999rpx;color:#d6e9f8;background:rgba(4,43,83,.28);font-size:19rpx;white-space:nowrap}
.opportunity-summary-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:24rpx 0 0}
.opportunity-summary-metric{min-width:0}
.opportunity-summary-metric+.opportunity-summary-metric{padding-left:14rpx;border-left:1rpx solid rgba(221,238,255,.18)}
.opportunity-summary-label{display:flex;align-items:center;gap:7rpx;color:#d7e8f5;font-size:18rpx;white-space:nowrap}
.opportunity-summary-label .fde-ui-text{font-size:23rpx;opacity:.68}
.opportunity-summary-value{margin-top:8rpx;overflow-wrap:anywhere;font-size:38rpx;font-weight:790;line-height:1.2;font-variant-numeric:tabular-nums}
.opportunity-summary-value>.fde-ui-text{margin-left:6rpx;color:#c8deef;font-size:17rpx;font-weight:450}
.workbench-opportunity-tools{margin-top:14rpx}
.workbench-opportunity-filter{margin-bottom:18rpx;padding:8rpx 10rpx;border:1rpx solid rgba(73,111,148,.1);border-radius:20rpx;background:rgba(255,255,255,.9)}
.workbench-filter-line{display:flex;align-items:center;gap:8rpx;min-width:0}
.workbench-filter-title{flex:0 0 auto;color:#405d76;font-size:19rpx;font-weight:700}
.workbench-filter-scroll{width:0;min-width:0;flex:1;white-space:nowrap}
.workbench-filter-row{display:inline-flex;align-items:center;gap:7rpx;padding-right:6rpx}
.workbench-filter-item{width:188rpx;height:50rpx;box-sizing:border-box;flex:0 0 auto;overflow:hidden;border:1rpx solid #dfe9f2;border-radius:12rpx;background:#f6f9fc}
.workbench-filter-control{display:flex;align-items:center;gap:6rpx;height:48rpx;min-width:0;padding:0 10rpx}
.workbench-filter-control>.fde-ui-label{flex:0 0 auto;color:#8a99a8;font-size:15rpx}
.workbench-filter-control>.fde-ui-text:nth-child(2){min-width:0;flex:1;overflow:hidden;color:#304e68;font-size:17rpx;font-weight:650;white-space:nowrap;text-overflow:ellipsis}
.workbench-filter-chevron{flex:0 0 auto;color:#86a0b7;font-size:15rpx}
.workbench-filter-reset{flex:0 0 auto;padding:8rpx 4rpx;color:#2477b9;font-size:18rpx}
.workbench-filter-item.filter-stage.active{border-color:#8fc8f2;background:#eaf5ff}
.workbench-stage-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9rpx;margin-top:11rpx;padding-top:12rpx;border-top:1rpx solid #e6edf4}
.workbench-stage-option{display:flex;align-items:center;gap:8rpx;min-width:0;min-height:50rpx;padding:0 12rpx;border:1rpx solid #dfe8f1;border-radius:14rpx;color:#557087;background:#f8fafc;font-size:16rpx}
.workbench-stage-option>.fde-ui-text{width:15rpx;flex:0 0 auto;color:#1778ca}
.workbench-stage-option>.fde-ui-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.workbench-stage-option.selected{border-color:#92c9f1;color:#176fb7;background:#eaf5ff;font-weight:680}
.opportunity-summary-won .opportunity-summary-label,.opportunity-summary-won .opportunity-summary-value,.opportunity-summary-won .opportunity-summary-value>.fde-ui-text{color:#8af0bd}
.quarter-filter{min-width:0}
.quarter-filter-summary{margin-top:24rpx;padding-top:18rpx;border-top:1rpx solid rgba(221,238,255,.2)}
.quarter-filter-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:12rpx}
.quarter-filter-head>.fde-ui-view{display:flex;align-items:center;gap:12rpx;min-width:0}
.quarter-filter-title{flex:0 0 auto;font-size:19rpx;font-weight:700}
.quarter-selection-label{font-size:17rpx;opacity:.76}
.quarter-year{display:flex;align-items:center;gap:10rpx;padding:8rpx 12rpx;border-radius:10rpx;background:rgba(255,255,255,.1);font-size:19rpx;white-space:nowrap}
.quarter-options{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10rpx}
.quarter-option{display:flex;align-items:center;justify-content:center;min-height:54rpx;box-sizing:border-box;border:1rpx solid rgba(216,237,255,.22);border-radius:12rpx;background:rgba(255,255,255,.07);color:#d8ebfa;font-size:20rpx;font-weight:600}
.quarter-option.selected{border-color:#dcefff;background:#e9f5ff;color:#125c96;box-shadow:0 3rpx 10rpx rgba(0,25,50,.06)}
.quarter-option:active{opacity:.75}
.quarter-filter-foot{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-top:12rpx;color:#bfd7eb;font-size:16rpx;line-height:1.5}
.quarter-filter-list{margin-top:13rpx;padding:16rpx 6rpx 5rpx;border-top:1rpx solid #e6edf4;color:#405d76}
.quarter-filter-list .quarter-year{background:#f0f6fc;color:#305d82}
.quarter-filter-list .quarter-option{border-color:#dde8f2;color:#587188;background:#f7fafc}
.quarter-filter-list .quarter-option.selected{border-color:#9ecbf0;background:#e6f3ff;color:#126caf}
.quarter-filter-list .quarter-filter-foot{color:#7e91a4}
.quarter-filter-list .quarter-selection-label{color:#6d87a0;opacity:1}
.workbench-filter-item.active{border-color:#99c8ef;background:#eaf5ff}
.quarter-filter-done{padding:10rpx 28rpx;border-radius:12rpx;color:#fff;background:#1679cb;font-size:19rpx;font-weight:700}
.quarter-filter-list .quarter-filter-head>.fde-ui-view{flex-wrap:wrap;gap:5rpx 10rpx}
.quarter-filter-list .quarter-year{flex-shrink:0}
