@import "./opportunity-edit-entry.wxss";
/* Match customer-list typography: 29rpx titles, 22rpx body, 19–20rpx tags. */
.workbench-opportunity-card{padding:24rpx;border:1rpx solid rgba(75,110,145,.1);border-radius:25rpx;background:rgba(255,255,255,.88);box-shadow:0 10rpx 30rpx rgba(31,72,112,.07)}
.workbench-opportunity-card:active{transform:scale(.994)}
.workbench-opportunity-card-top>.card-view>.card-text,.workbench-opportunity-card-top>.card-view>.card-label{display:block}
.workbench-opportunity-card-top>.card-view>.card-text{color:#2d435a;font-size:29rpx;font-weight:700;line-height:1.4}
.workbench-opportunity-card-top>.card-view>.card-label{margin-top:7rpx;color:#748297;font-size:22rpx;line-height:1.4;overflow-wrap:break-word}
.workbench-opportunity-stage{display:flex;align-items:center;justify-content:space-between;margin-top:17rpx;color:#1675bd}
.workbench-opportunity-stage>.card-text{font-size:20rpx;font-weight:680}
.workbench-opportunity-stage>.card-label{font-size:22rpx;font-weight:780}
.workbench-opportunity-progress{height:8rpx;margin:8rpx 0 17rpx;overflow:hidden;border-radius:999rpx;background:#e6edf4}
.workbench-opportunity-progress>.card-text{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#1979ca,#40afe5)}
.workbench-opportunity-meta{display:grid;grid-template-columns:1fr 1fr 1.3fr 1.1fr;padding:15rpx 0;border-top:1rpx solid #edf1f5}
.workbench-opportunity-meta>.card-view{border-right:1rpx solid #edf1f5}
.workbench-opportunity-meta>.card-view:last-child{border:0}
.workbench-opportunity-meta>.card-view>.card-text,.workbench-opportunity-meta>.card-view>.card-label{display:block;text-align:center}
.workbench-opportunity-meta>.card-view>.card-text{color:#748297;font-size:20rpx}
.workbench-opportunity-meta>.card-view>.card-label{margin-top:7rpx;color:#344b62;font-size:22rpx;font-weight:680}
.workbench-opportunity-owner{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8rpx 16rpx;margin-top:14rpx;color:#748297;font-size:22rpx;line-height:1.5}
.workbench-opportunity-owner>.card-text{flex:0 0 auto;margin-left:auto;color:#1675bd}
.workbench-opportunity-name{display:flex;align-items:flex-start;gap:10rpx;min-width:0}
.workbench-opportunity-title{min-width:0;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:#2d435a;font-size:29rpx;font-weight:700;line-height:1.4;overflow-wrap:break-word;white-space:normal}
.opportunity-grade{flex:0 0 auto;margin-top:5rpx;padding:4rpx 9rpx;border-radius:9rpx;color:#176fbd;background:#e8f3fd;font-size:19rpx;font-weight:650;line-height:1.3}
.opportunity-grade.grade-A{color:#a6651d;background:#fff0db}
.opportunity-grade.grade-B{color:#21745c;background:#e6f5ee}
.workbench-opportunity-meta>.card-view{min-width:0;padding:0 6rpx;box-sizing:border-box;}
.workbench-opportunity-meta .card-label{overflow-wrap:break-word;word-break:break-word;line-height:1.4;}
.workbench-status{margin-top:14rpx;font-size:20rpx;line-height:1.5}
.traffic-badge{border-radius:10rpx;padding:5rpx 10rpx}
.traffic-badge.traffic-green{color:#238c68;background:#e4f6ee}.traffic-text-green{color:#238c68}
.traffic-badge.traffic-yellow{color:#a77722;background:#fff4d9}.traffic-text-yellow{color:#a77722}
.traffic-badge.traffic-red{color:#bc5149;background:#ffebe8}.traffic-text-red{color:#bc5149}
.traffic-badge.traffic-gray{color:#8091a0;background:#eef2f5}.traffic-text-gray{color:#8091a0}
