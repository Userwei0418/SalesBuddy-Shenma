/* Shared compact scope controls: same scale as the sales dashboard. */
.role-scope-bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12rpx;margin:18rpx 0}
.role-scope-switch{display:inline-flex;align-items:center;flex:0 0 auto;gap:6rpx;padding:5rpx;border-radius:16rpx;background:#e3ebf4;box-sizing:border-box}
.role-scope-option.role-scope-option{display:flex;align-items:center;justify-content:center;min-width:73rpx;min-height:40rpx;box-sizing:border-box;margin:0;padding:9rpx 15rpx;border:0;border-radius:12rpx;background:transparent;color:#75879a;font-size:18rpx;font-weight:500;line-height:1.3;text-align:center;white-space:nowrap}
.role-scope-option.role-scope-selected{color:#fff;background:linear-gradient(135deg,#2367aa,#268ce0);box-shadow:0 5rpx 13rpx rgba(32,112,183,.2)}
.role-scope-option::after{border:0}
.role-scope-full{display:flex;width:100%}.role-scope-full .role-scope-option{flex:1;min-width:0}
.role-member-value{display:flex;align-items:center;gap:8rpx;min-width:0;height:50rpx;padding:0 12rpx;box-sizing:border-box;border:1rpx solid #dfe9f2;border-radius:12rpx;background:#f6f9fc;font-size:18rpx;color:#30506b;white-space:nowrap}
.role-member-label{flex:0 0 auto;font-size:16rpx;color:#8797a6}
.role-member-name{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;font-size:18rpx;font-weight:600}
.role-member-caret{flex:0 0 auto;font-size:16rpx;color:#7f9ab1}
