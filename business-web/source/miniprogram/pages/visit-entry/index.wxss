.visit-entry-page{min-height:100vh;padding:24rpx 28rpx 52rpx;background:linear-gradient(160deg,#fbfdff 0%,#eff6fd 52%,#e8f2fc 100%)}
.first-visit-field{display:block}.first-visit-option{display:flex;align-items:center;gap:8rpx}.first-visit-option checkbox{transform:scale(.72)}
.first-visit-copy{display:flex;min-width:0;flex:1;align-items:center;gap:10rpx}.first-visit-copy text{flex:0 0 auto;color:#203b56;font-size:20rpx;font-weight:700}.first-visit-copy label{min-width:0;flex:1;color:#7c8fa3;font-size:16rpx;line-height:1.35}
.entry-hero{padding:30rpx;border-radius:30rpx;background:linear-gradient(135deg,#173f67,#167fe5);box-shadow:0 22rpx 50rpx rgba(20,87,155,.21);color:#fff}.hero-eyebrow{font-size:17rpx;font-weight:700;letter-spacing:2.6rpx;opacity:.66}.hero-title{margin-top:11rpx;font-size:39rpx;font-weight:800}.hero-copy{margin-top:8rpx;font-size:20rpx;line-height:1.6;opacity:.82}.customer-context{display:flex;align-items:center;gap:12rpx;margin-top:22rpx;padding:13rpx 16rpx;border:1rpx solid rgba(255,255,255,.18);border-radius:16rpx;background:rgba(255,255,255,.1)}.customer-context text{font-size:16rpx;opacity:.7}.customer-context label{font-size:20rpx;font-weight:700}
.note-card,.voice-card{margin-top:22rpx;border:1rpx solid rgba(255,255,255,.95);border-radius:28rpx;background:rgba(255,255,255,.8);box-shadow:0 17rpx 44rpx rgba(24,69,116,.09);-webkit-backdrop-filter:blur(24rpx);backdrop-filter:blur(24rpx)}.note-card{padding:25rpx}.note-head{display:flex;align-items:flex-start;justify-content:space-between}.note-head>view>text{display:block;color:#203850;font-size:25rpx;font-weight:760}.note-head>view>label{display:block;margin-top:6rpx;color:#8796a8;font-size:17rpx}.note-head>text{color:#9aa8b8;font-size:16rpx}.note-input{width:100%;height:440rpx;margin-top:20rpx;padding:23rpx;border:1rpx solid rgba(55,111,167,.13);border-radius:20rpx;background:rgba(244,249,254,.9);color:#263d55;font-size:22rpx;line-height:1.72}.note-footer{margin-top:13rpx;padding-top:13rpx;border-top:1rpx solid #e6eef6}.transcript-state{display:flex;align-items:center;gap:8rpx;margin-top:10rpx;color:#3f8b73;font-size:16rpx}.transcript-state>text{width:9rpx;height:9rpx;border-radius:50%;background:#44bb8e}.transcript-state.error{color:#c9674b}.transcript-state.error>text{background:#eb7958}
.process-card{display:flex;align-items:center;justify-content:center;gap:12rpx;margin-top:25rpx;padding:20rpx 12rpx;border-radius:22rpx;background:rgba(255,255,255,.55)}.process-card>view{display:flex;align-items:center;gap:6rpx;color:#5f7185;font-size:15rpx}.process-card>view>text{width:29rpx;height:29rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#2477c4;background:#e0effe;font-size:14rpx;font-weight:800}.process-card>text{color:#a4b0bd}.safe-tip{margin:17rpx 8rpx 23rpx;color:#8090a2;font-size:16rpx;line-height:1.55;text-align:center}.submit-button{height:88rpx;display:flex;align-items:center;justify-content:center;gap:12rpx;border-radius:23rpx;color:#fff;background:linear-gradient(135deg,#173f67,#1684e8);box-shadow:0 14rpx 32rpx rgba(22,102,182,.25);font-size:28rpx;font-weight:700}.visit-entry-page .submit-button.disabled{opacity:1;color:#425971;background:#dfe9f4;border:1rpx solid #cad8e7;box-shadow:none}
@keyframes wave{from{transform:scaleY(.55)}to{transform:scaleY(1.25)}}


.note-input{box-sizing:border-box;max-width:100%;}
.capture-card{position:relative;margin-top:22rpx;padding:22rpx;border:1rpx solid #e0ebf6;border-radius:28rpx;background:rgba(255,255,255,.94);box-shadow:0 14rpx 38rpx rgba(24,69,116,.06)}
.capture-head{display:flex;align-items:center;gap:20rpx}.input-segment{display:flex;flex:1;max-width:420rpx;gap:6rpx;padding:6rpx;background:#edf4fb;border-radius:999rpx}.input-tab{display:flex;align-items:center;justify-content:center;flex:1;margin:0;padding:0;height:58rpx;min-height:0;line-height:1.3;border-radius:999rpx;font-size:24rpx;font-weight:600;color:#73879b;background:transparent}.input-tab::after,.input-help::after,.capture-primary::after,.help-heading button::after{border:0}.input-tab.selected{background:white;color:#176fb9;box-shadow:0 3rpx 12rpx rgba(45,92,136,.1)}.input-tab[disabled]{opacity:.6}.input-tab.selected[disabled]{background:white;color:#176fb9}.input-help{display:flex;justify-content:center;align-items:center;flex:0 0 42rpx;width:42rpx;height:42rpx;min-height:0;margin:0 0 0 auto;padding:0;border:2rpx solid #b4c6d8;border-radius:50%;font-size:25rpx;line-height:1;font-weight:600;color:#839bb3;background:transparent}.input-help.open{color:#177ad0;border-color:#177ad0;background:#edf6ff}
.capture-body{display:flex;align-items:center;gap:16rpx;margin-top:22rpx}.voice-icon,.file-icon{display:flex;align-items:center;justify-content:center;flex:0 0 60rpx;width:60rpx;height:60rpx;border-radius:18rpx;background:linear-gradient(145deg,#235781,#1985e5)}.voice-icon{gap:4rpx}.voice-icon>text{width:4rpx;height:16rpx;border-radius:8rpx;background:white}.voice-icon>text:nth-child(2),.voice-icon>text:nth-child(4){height:26rpx}.voice-icon>text:nth-child(3){height:36rpx}.file-outline{box-sizing:border-box;width:28rpx;height:34rpx;border:2rpx solid white;border-radius:4rpx;padding:7rpx 4rpx}.file-outline text{display:block;height:2rpx;margin-bottom:5rpx;background:white}.file-outline text:last-child{width:65%}.capture-copy{flex:1;min-width:0}.capture-copy>text{display:block;font-size:24rpx;color:#2c455e;font-weight:650}.capture-copy>label{display:block;margin-top:5rpx;font-size:19rpx;color:#8899ac;line-height:1.5}.capture-primary{display:flex;align-items:center;justify-content:center;flex:0 0 230rpx;height:76rpx;min-height:0;margin:0;padding:0 12rpx;line-height:1.4;border-radius:18rpx;background:linear-gradient(130deg,#1d5987,#1786e9);color:white;font-size:25rpx;font-weight:650}.capture-primary[disabled]{background:#e0eaf4;color:#92a7bc}.recording .capture-primary,.recording .voice-icon{background:linear-gradient(135deg,#cf604e,#ed8a6c)}.recording .voice-icon>text{animation:wave .7s ease-in-out infinite alternate}
.customer-picker-card{margin-top:22rpx;padding:23rpx;border:1rpx solid rgba(255,255,255,.96);border-radius:25rpx;background:rgba(255,255,255,.9);box-shadow:0 13rpx 34rpx rgba(24,69,116,.08)}.customer-picker-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.customer-picker-head>view>text{display:flex;align-items:center;gap:10rpx;color:#203a54;font-size:25rpx;font-weight:750}.customer-picker-head>view>text>label{padding:4rpx 8rpx;border-radius:8rpx;color:#c25d45;background:#fff0ec;font-size:13rpx;font-weight:650}.customer-picker-head>view>view{margin-top:5rpx;color:#8797a9;font-size:17rpx}.customer-picker-head>text{padding:7rpx 12rpx;border-radius:999rpx;color:#176fc5;background:#e7f2fd;font-size:17rpx}.customer-search{height:78rpx;box-sizing:border-box;display:flex;align-items:center;gap:12rpx;margin-top:17rpx;padding:0 18rpx;border:1rpx solid rgba(55,111,167,.17);border-radius:18rpx;background:#f5f9fd}.customer-search>text{position:relative;width:22rpx;height:22rpx;box-sizing:border-box;flex:0 0 auto;border:3rpx solid #6e91b2;border-radius:50%}.customer-search>text::after{content:"";position:absolute;right:-7rpx;bottom:-5rpx;width:9rpx;height:3rpx;border-radius:99rpx;background:#6e91b2;transform:rotate(45deg)}.customer-search input{min-width:0;flex:1;color:#294159;font-size:22rpx}.customer-search-state{margin:10rpx 3rpx 0;color:#8a99aa;font-size:16rpx}.customer-results{max-height:300rpx;margin-top:13rpx;border-top:1rpx solid #e8eff6}.customer-result{display:flex;align-items:center;gap:13rpx;padding:15rpx 3rpx;border-bottom:1rpx solid #e8eff6}.customer-result>view,.selected-customer>view{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:16rpx;color:#176fc5;background:#e4f1fe;font-size:19rpx;font-weight:750}.customer-result>text{min-width:0;flex:1;overflow:hidden;color:#2b425a;font-size:20rpx;font-weight:680;white-space:nowrap;text-overflow:ellipsis}.customer-result>text>label{display:block;margin-top:4rpx;color:#8a98a8;font-size:15rpx;font-weight:400}.customer-result>label{color:#1775ca;font-size:17rpx;font-weight:650}.customer-empty{margin-top:14rpx;padding:22rpx;border-radius:16rpx;color:#8b99a8;background:#f5f8fb;font-size:17rpx;text-align:center}.selected-customer{display:flex;align-items:center;gap:14rpx;margin-top:17rpx;padding:15rpx 17rpx;border:1rpx solid rgba(45,143,104,.2);border-radius:18rpx;background:linear-gradient(135deg,#f4fcf8,#e8f7f0)}.selected-customer>view{color:#fff;background:linear-gradient(145deg,#26775c,#43ad82)}.selected-customer>text{min-width:0;flex:1;overflow:hidden;color:#28513f;font-size:22rpx;font-weight:700;white-space:nowrap;text-overflow:ellipsis}.selected-customer>label{padding:6rpx 10rpx;border-radius:999rpx;color:#27805f;background:#daf1e6;font-size:15rpx}
.selected-material{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #e9eff6}.material-line{display:flex;gap:16rpx;align-items:center;font-size:22rpx}.material-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#4c657e}.material-status{color:#428f78;font-size:20rpx;white-space:nowrap}.material-status.failed{color:#c17352}.upload-track{height:6rpx;margin-top:14rpx;border-radius:99rpx;background:#e9f1f8;overflow:hidden}.upload-track view{height:100%;background:#2584d6;border-radius:99rpx}.material-actions{display:flex;justify-content:flex-end;gap:26rpx;margin-top:14rpx;font-size:22rpx;color:#297eba}
.input-help-popover{position:absolute;z-index:30;bottom:calc(100% + 16rpx);right:20rpx;left:20rpx;padding:24rpx;border:1rpx solid #d9e7f3;border-radius:22rpx;background:white;box-shadow:0 16rpx 50rpx rgba(31,70,109,.18)}.help-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx;font-size:26rpx;font-weight:650;color:#284561}.help-heading button{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;min-height:0;margin:0;padding:0;line-height:1;font-size:32rpx;color:#8ba0b5;background:transparent}.help-row{margin-top:17rpx}.help-row>text{display:block;color:#47617b;font-size:23rpx;font-weight:600}.help-row>label{display:block;margin-top:6rpx;font-size:22rpx;line-height:1.7;color:#7c90a4}.help-foot{padding-top:18rpx;margin-top:20rpx;border-top:1rpx solid #edf2f7;color:#6788a5;font-size:21rpx;line-height:1.6}

.customer-load-error{color:#a46132}.customer-retry{margin:16rpx auto 0;padding:0 24rpx;width:fit-content;line-height:2.4;border:1rpx solid #c9dced;border-radius:16rpx;background:#f4f9ff;color:#287ac2;font-size:24rpx}

/* Match the existing pale navigation and rounded, low-emphasis card controls. */
.entry-navigation{position:fixed;top:0;left:0;right:0;z-index:50;background:#f7fafe}.entry-navigation-row{position:relative;display:flex;align-items:center;justify-content:center}.entry-navigation-row>text{font-size:32rpx;font-weight:600;color:#203850}.entry-back{position:absolute;left:12rpx;top:0;bottom:0;width:88rpx;min-height:0;margin:0;padding:0;display:flex;align-items:center;justify-content:center;background:transparent}.entry-back::after{border:0}.entry-back>view{width:18rpx;height:18rpx;border-left:4rpx solid #203850;border-bottom:4rpx solid #203850;transform:rotate(45deg)}
.note-head{gap:16rpx}.note-head>.note-tools{display:flex;flex-direction:column;align-items:center;gap:6rpx;min-width:130rpx;flex-shrink:0}.note-head>.note-tools>.note-count{width:100%;text-align:center;white-space:nowrap;color:#9aa8b8;font-size:16rpx;font-weight:400;line-height:1.3}.note-clear{display:flex;align-items:center;justify-content:center;box-sizing:border-box;height:44rpx;min-height:44rpx;margin:0;padding:0 12rpx;border:1rpx solid #d7e9fa;border-radius:999rpx;background:#e7f2fd;color:#176fc5;line-height:1.3;font-size:20rpx;font-weight:500}.note-clear-pressed{background:#d9ebfc;border-color:#bddbf6}.note-clear::after{border:0}.note-clear[disabled]{color:#aab6c2;border-color:#e4ebf2;background:#f5f8fb}
.draft-state{margin-top:12rpx;color:#738da7;font-size:18rpx;line-height:1.5}.draft-state.error{color:#bf654c}.draft-state.undo{display:flex;align-items:center;gap:14rpx}.draft-state.undo button{margin:0;padding:0 12rpx;min-height:44rpx;line-height:44rpx;border-radius:10rpx;color:#176fc5;background:#e7f2fd;font-size:20rpx}.draft-state.undo button::after{border:0}

/* style:v2 gives default buttons a fixed width; these controls stay compact. */
.entry-navigation .entry-back{width:88rpx;min-width:0;padding:0;max-width:88rpx}.note-tools .note-clear{width:130rpx;min-width:0;padding:0 12rpx;max-width:130rpx}.draft-state.undo button{width:auto;min-width:0;max-width:130rpx}

.recording-guide{margin-top:24rpx;border-top:1rpx solid #e4edf5}
.recording-guide-toggle{display:flex;align-items:center;justify-content:space-between;gap:16rpx;width:100%;min-height:76rpx;margin:0;padding:18rpx 0;text-align:left;white-space:normal;line-height:1.5;font-size:26rpx;font-weight:600;color:#345b7a;background:transparent;border-radius:0}
.recording-guide-toggle::after{border:0}
.recording-guide-action{flex-shrink:0;color:#1677c8;font-size:24rpx;font-weight:500}
.recording-guide-content{padding:0 0 8rpx}
.recording-guide-section{margin-top:16rpx;padding:20rpx;background:#f5f9fd;border-radius:16rpx}
.recording-guide-section:first-child{margin-top:0}
.recording-guide-title{display:block;margin-bottom:10rpx;font-size:26rpx;line-height:1.5;font-weight:600;color:#2b4e6b}
.recording-guide-line{display:block;margin-top:8rpx;font-size:25rpx;line-height:1.7;color:#536f88;overflow-wrap:break-word}
.recording-guide-note{margin-top:20rpx;font-size:23rpx;line-height:1.7;color:#71879c}
