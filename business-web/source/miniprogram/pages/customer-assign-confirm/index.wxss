ze:20rpx;line-height:1.6}.section-heading{display:flex;align-items:center;justify-content:space-between;margin:29rpx 2rpx 15rpx}.section-heading text{font-size:24rpx;font-weight:720}.section-heading label{color:#8795a7;font-size:18rpx}.field-list{overflow:hidden}.field-row{padding:19rpx 21rpx;border-bottom:1rpx solid rgba(76,104,137,.1)}.field-row:last-child{border:0}.field-label{display:flex;align-items:center;gap:7rpx;color:#78869a;font-size:20rpx}.field-label>text{color:#e15c50}.field-label label{padding:3rpx 8rpx;border-radius:999rpx;color:#4b7dac;background:rgba(226,240,255,.86);font-size:14rpx}.field-value{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;margin-top:7rpx}.field-value>text{flex:1;color:#26384e;font-size:23rpx;line-height:1.5}.field-value>label{flex:0 0 auto;color:#99a5b3;font-size:17rpx}.field-row.missing{background:rgba(255,248,243,.7)}.field-row.missing .field-value>text,.field-row.missing .field-value>label{color:#d66737}.field-row.system{background:rgba(242,249,246,.65)}.field-row.edited{box-shadow:inset 5rpx 0 0 #65b894}.field-row:active{background:rgba(229,240,252,.56)}.bottom-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 1.55fr;gap:14rpx;padding:15rpx 24rpx calc(17rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(255,255,255,.9);background:rgba(248,251,255,.86);box-shadow:0 -10rpx 32rpx rgba(29,61,101,.08);backdrop-filter:blur(28rpx)}.bottom-bar button{width:100%;height:84rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;font-size:23rpx;font-weight:680}.secondary{border:1rpx solid rgba(80,108,139,.15);color:#5f7187;background:rgba(255,255,255,.8)}.primary{color:#fff;background:linear-gradient(135deg,#174a78,#1683ee);box-shadow:0 12rpx 26rpx rgba(18,94,176,.2)}.disabled{opacity:.45}.editor-layer{position:fixed;z-index:100;inset:0}.editor-mask{position:absolute;inset:0;background:rgba(11,25,43,.38);backdrop-filter:blur(6rpx)}.editor-sheet{position:absolute;left:0;right:0;bottom:0;max-height:78vh;overflow-y:auto;padding:14rpx 28rpx calc(env(safe-area-inset-bottom) + 26rpx);border:1rpx solid rgba(255,255,255,.92);border-radius:34rpx 34rpx 0 0;background:rgba(250,252,255,.97);box-shadow:0 -24rpx 60rpx rgba(16,48,87,.18);backdrop-filter:blur(34rpx)}.sheet-handle{width:70rpx;height:7rpx;margin:0 auto 23rpx;border-radius:999rpx;background:#cbd6e2}.editor-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.editor-eyebrow{color:#7d8da2;font-size:17rpx;letter-spacing:2rpx}.editor-title{margin-top:6rpx;color:#17273c;font-size:31rpx;font-weight:750}.editor-close{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;border-radius:19rpx;color:#6f8095;background:#edf3f8;font-size:37rpx}.editor-control{display:flex;align-items:center;min-height:92rpx;padding:0 22rpx;border:1rpx solid rgba(70,111,153,.15);border-radius:22rpx;background:#fff}.editor-control input{flex:1;height:92rpx;color:#213249;font-size:25rpx}.editor-textarea{padding:20rpx 22rpx 13rpx;border:1rpx solid rgba(70,111,153,.15);border-radius:22rpx;background:#fff}.editor-textarea textarea{width:100%;min-height:180rpx;color:#213249;font-size:24rpx;line-height:1.65}.editor-textarea>view{margin-top:9rpx;color:#9aa6b5;font-size:17rpx;text-align:right}.option-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12rpx}.option-item{display:flex;align-items:center;justify-content:space-between;min-height:76rpx;padding:0 17rpx;border:1rpx solid rgba(73,107,144,.13);border-radius:19rpx;color:#53657b;background:#fff;font-size:21rpx}.option-item>view{width:28rpx;height:28rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #cbd6e2;border-radius:50%;color:#fff;font-size:16rpx}.option-item.selected{border-color:rgba(22,119,255,.4);color:#176ab9;background:rgba(231,243,255,.84);font-weight:650}.option-item.selected>view{border-color:#1683ee;background:#1683ee}.editor-helper{margin-top:21rpx;color:#8795a7;font-size:18rpx;line-height:1.5}.editor-actions{display:grid;grid-template-columns:1fr 1.6fr;gap:13rpx;margin-top:22rpx}.editor-actions button{width:100%;height:84rpx;display:flex;align-items:center;justify-content:center;border-radius:21rpx;font-size:23rpx;font-weight:650}.editor-cancel{border:1rpx solid rgba(80,108,139,.15);color:#5f7187;background:#eef3f8}.editor-save{color:#fff;background:linear-gradient(135deg,#174a78,#1683ee);box-shadow:0 12rpx 26rpx rgba(18,94,176,.2)}
