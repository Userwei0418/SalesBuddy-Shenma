.first-visit-heading>text{font-size:14rpx}.first-visit-section .muted{font-size:16rpx}.v-button{font-size:22rpx;font-weight:650}.archive-hint{font-size:19rpx}.notice{font-size:19rpx;line-height:1.5}

.opportunity-mask{position:fixed;inset:0;z-index:110;display:flex;align-items:flex-end;background:rgba(19,42,65,.4)}
.opportunity-sheet{width:100%;max-height:82vh;padding:18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#f8fbff;box-shadow:0 -12rpx 50rpx rgba(25,57,87,.12);display:flex;flex-direction:column;box-sizing:border-box}
.opportunity-grip{width:64rpx;height:8rpx;flex-shrink:0;margin:0 auto 26rpx;border-radius:8rpx;background:#c8d7e3}
.opportunity-sheet-header{display:flex;align-items:center;justify-content:space-between;gap:24rpx;color:#29445e;font-size:32rpx;font-weight:700}
.opportunity-sheet-customer{max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:23rpx;color:#8396a8;font-weight:400}
.opportunity-sheet .opportunity-search{flex-shrink:0;margin:24rpx 0 20rpx;height:80rpx;border-radius:18rpx;background:#fff;font-size:26rpx}
.opportunity-results{height:480rpx;max-height:44vh;min-height:0}
.opportunity-result{display:flex;align-items:center;gap:20rpx;min-height:96rpx;padding:22rpx 20rpx;border-bottom:1rpx solid #e6eef6;color:#2a435b;font-size:27rpx;line-height:1.6}
.opportunity-result-name{flex:1;min-width:0;word-break:break-word}
.opportunity-result-selected{background:#e9f3fd;border-radius:18rpx;color:#225e91;border-bottom-color:transparent}
.opportunity-choice{width:36rpx;height:36rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border:2rpx solid #c7d6e4;border-radius:50%;font-size:24rpx;line-height:1}
.opportunity-choice.checked{background:#225e91;color:#fff;border-color:#225e91}
.opportunity-result-unverified{color:#91a0ae}.opportunity-result-unverified .opportunity-choice{width:auto;border:0;font-size:22rpx}
.opportunity-sheet-hint{padding:24rpx 20rpx;color:#8396a8;font-size:23rpx;line-height:1.6}
.opportunity-sheet .opportunity-more{width:100%;min-height:76rpx;margin:16rpx 0 0;border-radius:16rpx;font-size:25rpx;color:#225e91;background:#edf4fb;line-height:3}
.opportunity-error{color:#b5583c;font-size:24rpx;line-height:1.7;margin-top:14rpx}
.opportunity-sheet-actions{display:flex;flex-shrink:0;gap:20rpx;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #e1ebf4}
.opportunity-sheet-actions button{display:flex;align-items:center;justify-content:center;flex:1;min-width:0;width:100%;height:88rpx;margin:0;padding:0 20rpx;border-radius:20rpx;font-size:28rpx;font-weight:600;line-height:1.4}
.opportunity-sheet-actions .opportunity-cancel{color:#627a90;background:#edf3f8;border:1rpx solid #dbe6f0}
.opportunity-sheet-actions .opportunity-confirm{color:#fff;background:#225e91}
.opportunity-sheet-actions button[disabled]{opacity:.45}

/* Visit steps share the existing sales card, blue gradient and button scale. */
.flow-steps{display:flex;align-items:center;justify-content:space-between;margin:8rpx 4rpx 28rpx;gap:12rpx}.flow-step{display:flex;align-items:center;gap:10rpx;font-size:23rpx;color:#899db0;white-space:nowrap}.flow-step>text{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;border-radius:50%;background:#e1ebf4;font-size:21rpx}.flow-step.active{color:#1a75bd;font-weight:650}.flow-step.active>text{background:#197dce;color:#fff}.flow-step.done>text{background:#dceefc;color:#1975bb}.step-line{height:2rpx;background:#dbe7f2;flex:1}
.analyzing-card{padding:76rpx 30rpx;text-align:center}.analysis-orbit{height:156rpx;width:156rpx;margin:0 auto 44rpx;border:2rpx solid #dcecfb;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative}.analysis-orbit::before{content:'';position:absolute;inset:-2rpx;border:4rpx solid transparent;border-top-color:#2a94e1;border-radius:50%;animation:visit-orbit 2s linear infinite}.analysis-core{height:102rpx;width:102rpx;line-height:102rpx;border-radius:30rpx;background:linear-gradient(135deg,#1b456b,#1989e2);color:#fff;font-size:34rpx;font-weight:700;box-shadow:0 12rpx 30rpx rgba(29,121,193,.18)}.analysis-caption{font-size:26rpx;line-height:1.7;color:#48718f;min-height:88rpx;margin-top:24rpx}@keyframes visit-orbit{to{transform:rotate(360deg)}}
.v-button[disabled]{background:#e3ecf4!important;color:#94a8b9!important;border-color:#e3ecf4!important}.footer-actions{display:flex;gap:18rpx}.footer-actions>.secondary{flex:0 0 36%}.advice-mask{position:fixed;inset:0;background:rgba(19,42,65,.35);z-index:100;display:flex;align-items:flex-end}.advice-sheet{width:100%;box-sizing:border-box;padding:32rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:#f7fbff;border-radius:32rpx 32rpx 0 0;box-shadow:0 -12rpx 50rpx rgba(25,57,87,.12)}.sheet-header{display:flex;justify-content:space-between;align-items:flex-start;gap:18rpx;margin-bottom:24rpx}.sheet-grip-area{height:52rpx;margin:-20rpx -28rpx 12rpx;display:flex;align-items:center;justify-content:center}.sheet-grip{width:68rpx;height:8rpx;border-radius:999rpx;background:#bdcddd}.advice-scroll{height:56vh}.sheet-status{padding:28rpx 8rpx;color:#718aa0;font-size:26rpx;line-height:1.7}.sheet-status .v-button{margin-top:20rpx}.advice-summary{font-size:26rpx;color:#526f88;line-height:1.7;margin-bottom:22rpx}.advice-item{padding:26rpx;background:#fff;border:1rpx solid #deebf5;border-radius:22rpx;margin-bottom:20rpx}.advice-action{font-size:26rpx;line-height:1.75;color:#355c7b;margin:18rpx 0}.sheet-later{margin-top:22rpx}
