.draft{flex:0 0 30%}
.v-button.is-disabled{background:#e6edf4;color:#98aabc}
.text-button{background:transparent;min-height:60rpx;color:#2679b8;font-size:25rpx}
.create-customer{margin:16rpx auto 0}
.success-card{margin-top:28rpx;text-align:center;padding:38rpx 28rpx}
.success-icon{display:flex;align-items:center;justify-content:center;width:90rpx;height:90rpx;margin:0 auto;border-radius:50%;background:#e3f6ed;color:#339977;font-size:50rpx}
.metrics{display:flex;padding:28rpx 0;margin:28rpx 0;border-top:1rpx solid #e6efeb;border-bottom:1rpx solid #e6efeb}
.metric-cell{flex:1;border-right:1rpx solid #e6efeb}
.metrics .metric-cell:last-child{border:0}
.metric-number{display:block;font-size:38rpx;font-weight:700;color:#247e64}
.metric-label{font-size:23rpx;color:#80958c;display:block;margin-top:10rpx}
.success-card .section-title,.success-card .body-text{text-align:left}
.success-card .body-text{margin:18rpx 0 0;line-height:1.75}
.success-actions{display:flex;flex-direction:column;gap:18rpx;margin-top:30rpx;padding-top:26rpx;border-top:1rpx solid #e6eef5}.success-actions .v-button{width:100%;justify-content:space-between;flex:none}.success-next{padding:4rpx 0 0}.page.archived-page{padding-bottom:calc(36rpx + env(safe-area-inset-bottom))}.page .success-card{padding:28rpx 24rpx 30rpx}


.footer-actions{display:flex;gap:18rpx;width:100%}
.archive-hint{font-size:24rpx;line-height:1.5;color:#92653f;text-align:center}
.page .footer .archive-button.is-disabled{background:#dfe9f4;color:#425971;opacity:1}
.page .footer .archive-button{background:#187bc8;color:#fff;opacity:1}
.chosen-details{flex:1;min-width:0}
.chosen .strong{font-size:30rpx;line-height:1.6;word-break:break-all}
.chosen .text-button{flex:0 0 108rpx;width:108rpx;margin-left:20rpx;padding:0}
.customer-type{display:inline-block;margin-top:12rpx;padding:6rpx 14rpx;background:#edf5ff;border-radius:10rpx;color:#4479a6;font-size:22rpx}
.record-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:24rpx 20rpx;margin-top:26rpx;padding-top:26rpx;border-top:1rpx solid #edf2f7}
.meta-label{display:block;font-size:22rpx;color:#8193a5;margin-bottom:8rpx}
.meta-value{display:block;font-size:26rpx;line-height:1.5;color:#2a435b}
.seven-help{font-size:21rpx;margin-top:22rpx}
.date-clear{font-size:22rpx;color:#778ea3;text-align:right;padding-top:12rpx}
.meta-row{display:flex;justify-content:space-between;gap:20rpx;margin-top:24rpx;font-size:26rpx}

/* Compact review form: keep long evidence readable while reducing navigation distance. */
