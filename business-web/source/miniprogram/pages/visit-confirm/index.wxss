.page{background:#eef5fb;color:#20354a;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.page{padding:24rpx 24rpx calc(210rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.card{background:#fff;border-radius:28rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 10rpx 35rpx rgba(31,70,109,.05)}
