.quality .v-button{margin-top:18rpx}.audit-status{padding:6rpx 11rpx;font-size:18rpx}.notice{padding:14rpx 17rpx;margin-bottom:14rpx;font-size:21rpx}.quality .notice,.next-audit .notice{margin-top:12rpx}.v-button{min-height:74rpx;font-size:24rpx}.collaborator-row{margin-top:16rpx;padding-top:16rpx}.seven-help{margin-top:10rpx;font-size:18rpx}.date-clear{padding-top:8rpx;font-size:18rpx}

