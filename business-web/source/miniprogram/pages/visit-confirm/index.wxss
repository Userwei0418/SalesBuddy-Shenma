.quality .notice{margin-top:20rpx}
.footer{position:fixed;bottom:0;left:0;right:0;display:flex;flex-direction:column;gap:14rpx;padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(246,250,254,.98);border-top:1rpx solid #e4edf5;z-index:10}
