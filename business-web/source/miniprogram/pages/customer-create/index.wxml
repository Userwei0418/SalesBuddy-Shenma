<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view class="create-page">
  <view wx:if="{{canViewRequests}}" class="creation-tabs">
    <view class="creation-tab {{activeTab === 'form' ? 'selected' : ''}}" bindtap="showForm">填写申请</view>
    <view class="creation-tab {{activeTab === 'requests' ? 'selected' : ''}}" bindtap="showRequests">我的申请</view>
  </view>
  <view wx:if="{{activeTab === 'requests'}}" class="creation-requests">
    <view class="creation-list-head"><text>我的建档申请 · {{requestsTotal}} 条</text><view bindtap="showRequests">刷新</view></view>
    <view wx:if="{{requestsError}}" class="creation-state creation-error" bindtap="showRequests">{{requestsError}} · 点击重试</view>
    <view wx:if="{{requestsLoading}}" class="creation-state">正在加载申请…</view>
    <view wx:elif="{{!requests.length && !requestsError}}" class="creation-state">暂无建档申请，可在“填写申请”提交新客户。</view>
    <view wx:for="{{requests}}" wx:key="id" class="creation-request-card">
      <view class="creation-request-head"><text>{{item.customerName}}</text><label class="creation-status status-{{item.status}}">{{item.statusLabel}}</label></view>
      <view class="creation-request-meta">编号 / 审批单号：{{item.companyReference || '未填写'}}</view>
      <view class="creation-request-meta">提交时间：{{item.requestedLabel}}</view>
      <view wx:if="{{item.reviewedLabel}}" class="creation-request-meta">处理时间：{{item.reviewedLabel}} {{item.reviewer_name || ''}}</view>
      <view wx:if="{{item.decision_reason}}" class="creation-request-reason">{{item.status === 'rejected' ? '驳回原因' : '处理说明'}}：{{item.decision_reason}}</view>
      <view wx:if="{{item.status === 'approved'}}" class="creation-request-note">客户已建档。客户归属需另行申请认领，审批通过后生效。</view>
      <button wx:if="{{item.status === 'approved' && canClaimCustomer}}" class="creation-request-action" bindtap="openCustomerClaim">前往客户认领</button>
      <button wx:if="{{item.status === 'pending'}}" class="creation-request-action" disabled="{{!!withdrawingId}}" data-id="{{item.id}}" bindtap="withdrawRequest">{{withdrawingId === item.id ? '处理中…' : '撤回申请'}}</button>
    </view>
    <button wx:if="{{requestsHasMore}}" class="creation-load-more" loading="{{requestsLoading}}" disabled="{{requestsLoading}}" bindtap="loadMoreRequests">加载更多</button>
  </view>
  <block wx:if="{{activeTab === 'form'}}">

  <view class="create-hero">
    <view class="hero-copy">
      <view class="hero-eyebrow">NEW CUSTOMER PROFILE</view>
      <view class="hero-title">{{requestMode ? '申请新客户' : '创建新客户'}}</view>
      <view class="hero-subtitle">{{requestMode ? '填写后提交运营审批，审批通过才进入客户主档' : role === 'sales' ? '手动填写或语音生成草案，创建后仅归属本人' : '手动填写或语音生成草案，确认后进入待分配客户池'}}</view>
    </view>
    <view class="progress-orb"><text>{{progressPercent}}</text><label>%</label></view>
    <view class="hero-progress"><view style="width: {{progressPercent}}%"></view></view>
    <view class="hero-meta"><text>{{roleName}} · {{creatorName}}</text><text>必填 {{completedRequiredCount}} / {{requiredCount}}</text></view>
  </view>

  <view class="create-body">
    <view wx:if="{{draftRestored}}" class="notice blue">已恢复你上次保存的建档草稿，可继续编辑。</view>
    <view wx:if="{{voiceParsed}}" class="notice green">语音草案已填入，请重点核对客户名称、客户类型和联系人信息。</view>
    <view wx:elif="{{missingCount}}" class="notice orange">还有 {{missingCount}} 个必填项待补充，所有内容提交前均可修改。</view>

    <view wx:if="{{canVoiceCreate}}" class="voice-card {{isRecording ? 'recording' : ''}} {{isParsing ? 'parsing' : ''}}" bindtap="toggleVoice">
      <view class="voice-icon"><view class="wave"><text></text><text></text><text></text><text></text><text></text></view></view>
      <view class="voice-copy">
        <view>{{isStarting ? '正在启动录音' : isStopping ? '正在结束录音' : isParsing ? '正在识别并填充字段' : isRecording ? '正在语音录入 ' + recordingTime : voiceParsed ? '重新语音填写客户信息' : '语音填写客户信息'}}</view>
        <text>{{isRecording ? '再次点击即可结束录入' : isParsing ? '请稍候，识别结果只会生成待确认草案' : '点击开始，描述客户、行业、来源和联系人'}}</text>
      </view>
      <view class="voice-action">{{isRecording ? '结束' : isParsing ? '识别中' : '开始'}}</view>
    </view>

    <view class="section-heading"><view><text>客户基本信息</text><label>点击任一字段手动编辑</label></view><text>{{fields.length}} 项</text></view>
    <view class="field-list glass-card">
      <view wx:for="{{fields}}" wx:key="key" class="field-row {{item.missing ? 'missing' : ''}} {{item.system ? 'system' : ''}} {{item.edited ? 'edited' : ''}} {{item.voiceFilled ? 'voice-filled' : ''}}" data-index="{{index}}" bindtap="openEditor">
        <view class="field-label"><text>{{item.label}}</text><label wx:if="{{item.required}}">必填</label><label wx:elif="{{item.system}}">自动</label><label wx:else>选填</label></view>
        <view class="field-value"><text>{{item.value || (item.required ? '待补充' : '未填写')}}</text><view>{{item.readonly ? (role === 'sales' ? '仅本人' : '本团队') : item.missing ? '补充' : '编辑'}} <label>›</label></view></view>
      </view>
    </view>
  </view>

  <view class="bottom-bar"><button class="secondary" disabled="{{submitting}}" bindtap="saveDraft">保存草稿</button><button class="primary {{missingCount ? 'disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitCustomer">{{submitting ? '提交中…' : requestMode ? '提交建档申请' : '创建客户'}}</button></view>

  <view wx:if="{{editorVisible}}" class="editor-layer">
    <view class="editor-mask" bindtap="closeEditor"></view>
    <view class="editor-sheet" catchtap="stopPropagation">
      <view class="sheet-handle"></view>
      <view class="editor-head"><view><view class="editor-eyebrow">MANUAL INPUT</view><view class="editor-title">{{editorTitle}}</view></view><view class="editor-close" bindtap="closeEditor">×</view></view>
      <view wx:if="{{editorType === 'text'}}" class="editor-control"><input value="{{editorValue}}" placeholder="{{editorPlaceholder}}" focus bindinput="inputEditor" /></view>
      <view wx:if="{{editorType === 'textarea'}}" class="editor-textarea"><textarea value="{{editorValue}}" placeholder="{{editorPlaceholder}}" maxlength="500" auto-height focus bindinput="inputEditor" /><view>{{editorValue.length}} / 500</view></view>
      <view wx:if="{{editorType === 'select'}}" class="option-grid"><view wx:for="{{editorOptions}}" wx:key="label" class="option-item {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectOption"><text>{{item.label}}</text><view>{{item.selected ? '✓' : ''}}</view></view></view>
      <view class="editor-helper">{{requestMode ? '提交后由运营审批；审批通过才会写入客户主档。' : role === 'sales' ? '修改只会更新当前草案；创建后客户负责人自动设为本人。' : '修改只会更新当前草案，点击“创建客户”后才会写入待分配客户池。'}}</view>
      <view class="editor-actions"><button class="editor-cancel" bindtap="closeEditor">取消</button><button class="editor-save" bindtap="saveEditor">保存修改</button></view>
    </view>
  </view>
  </block>
</view>

</block>
