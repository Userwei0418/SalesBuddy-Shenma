page{background:#edf4fb}.tasks-page{min-height:100vh;padding-bottom:48rpx;color:#1b2c40;background:radial-gradient(circle at 92% 0,rgba(58,151,236,.19),transparent 29%),linear-gradient(155deg,#f9fcff,#eef5fc 58%,#e9f1fa)}.tasks-hero{padding:38rpx 30rpx 30rpx;color:#fff;background:radial-gradient(circle at 94% 0,rgba(92,185,255,.7),transparent 34%),linear-gradient(145deg,#102d4c,#147bd9);box-shadow:0 20rpx 48rpx rgba(26,91,162,.2)}.hero-eyebrow{color:rgba(255,255,255,.63);font-size:18rpx;letter-spacing:2.5rpx}.hero-title{margin-top:9rpx;font-size:43rpx;font-weight:800}.hero-subtitle{margin-top:8rpx;color:rgba(255,255,255,.76);font-size:20rpx}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:27rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:20rpx;background:rgba(255,255,255,.08)}.hero-stats view{padding:17rpx 20rpx;border-right:1rpx solid rgba(255,255,255,.12)}.hero-stats view:last-child{border:0}.hero-stats text{display:block;font-size:31rpx;font-weight:770}.hero-stats label{display:block;margin-top:4rpx;color:rgba(255,255,255,.62);font-size:16rpx}.task-tabs{position:sticky;z-index:5;top:0;display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx;padding:18rpx 27rpx;background:rgba(241,247,253,.9);backdrop-filter:blur(24rpx)}.task-tab{height:61rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;border:1rpx solid rgba(67,105,145,.1);border-radius:17rpx;color:#6d7f92;background:rgba(255,255,255,.62);font-size:20rpx}.task-tab.active{border-color:rgba(21,121,215,.25);color:#126dc1;background:#e4f2ff;font-weight:700}.task-tab text{min-width:29rpx;height:29rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:#1b7ed8;font-size:14rpx}.task-list{display:flex;flex-direction:column;gap:16rpx;padding:4rpx 27rpx 40rpx}.task-card{position:relative;display:flex;overflow:hidden;border:1rpx solid rgba(255,255,255,.95);border-radius:26rpx;background:rgba(255,255,255,.82);box-shadow:0 14rpx 36rpx rgba(31,72,116,.08)}.task-card:active{transform:scale(.992)}.task-stripe{width:7rpx;background:linear-gradient(#165485,#1687ed)}.status-completed .task-stripe{background:linear-gradient(#398267,#6ac39b)}.task-main{min-width:0;flex:1;padding:20rpx 21rpx 18rpx}.task-top{display:flex;align-items:center;justify-content:space-between}.task-status{display:flex;align-items:center;gap:8rpx;color:#40759f;font-size:17rpx;font-weight:700}.task-status text{width:9rpx;height:9rpx;border-radius:50%;background:#258be8;box-shadow:0 0 12rpx rgba(37,139,232,.55)}.status-completed .task-status{color:#4b8b70}.status-completed .task-status text{background:#58b589}.priority{padding:6rpx 11rpx;border-radius:999rpx;color:#5a7690;background:#edf3f8;font-size:15rpx}.priority-high,.priority-urgent{color:#bd6546;background:#fff0e9}.task-title{margin-top:13rpx;color:#24394f;font-size:25rpx;font-weight:760;line-height:1.4}.task-description{display:-webkit-box;margin-top:7rpx;overflow:hidden;color:#718196;font-size:19rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.task-meta{display:grid;grid-template-columns:1fr 1.35fr;gap:10rpx;margin-top:17rpx;padding:13rpx 14rpx;border-radius:17rpx;background:#f4f8fc}.task-meta text{display:block;color:#95a2b1;font-size:14rpx}.task-meta label{display:block;margin-top:3rpx;overflow:hidden;color:#41576e;font-size:18rpx;font-weight:650;white-space:nowrap;text-overflow:ellipsis}.task-source{display:flex;align-items:center;gap:9rpx;margin-top:15rpx;color:#75869a;font-size:16rpx}.task-source text{max-width:42%;overflow:hidden;color:#3878af;white-space:nowrap;text-overflow:ellipsis}.task-source label{flex:1}.task-source view{color:#1676cc;font-weight:650}.empty-state{display:flex;flex-direction:column;align-items:center;padding:130rpx 30rpx;color:#7a8b9f}.empty-state view{width:85rpx;height:85rpx;display:flex;align-items:center;justify-content:center;border-radius:28rpx;color:#fff;background:linear-gradient(145deg,#3e8c70,#73c7a2);box-shadow:0 15rpx 30rpx rgba(61,142,109,.18);font-size:34rpx}.empty-state text{margin-top:23rpx;color:#3b5067;font-size:25rpx;font-weight:720}.empty-state label{margin-top:8rpx;font-size:18rpx}

.sort-toolbar { padding: 20rpx 28rpx 18rpx; }
.sort-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.sort-count { flex-shrink: 0; color: #6e8096; font-size: 22rpx; }
.sort-select { display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 60rpx; padding: 10rpx 18rpx; border: 1rpx solid #cfdfef; border-radius: 17rpx; color: #315b81; background: #fff; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 20rpx; font-weight: 500; }
.sort-select text { font: inherit; letter-spacing: 0; }
.sort-chevron { width: 12rpx; height: 12rpx; margin-top: -6rpx; border-right: 2rpx solid #6f91af; border-bottom: 2rpx solid #6f91af; transform: rotate(45deg); }
.sort-hint { margin-top: 10rpx; color: #8393a6; font-size: 20rpx; line-height: 1.4; text-align: right; }
.task-opportunity{display:flex;align-items:center;justify-content:space-between;gap:15rpx;margin-top:14rpx;padding:13rpx 15rpx;border:1rpx solid #d8e8f6;border-radius:16rpx;background:#f0f7fd}.task-opportunity>view{min-width:0;flex:1}.task-opportunity>view text,.task-opportunity>view label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.task-opportunity>view text{color:#8a9aac;font-size:14rpx}.task-opportunity>view label{margin-top:3rpx;color:#315775;font-size:18rpx;font-weight:680}.task-opportunity>text{flex:0 0 auto;color:#1675c7;font-size:17rpx;font-weight:680}

.task-pagination{display:flex;align-items:center;justify-content:center;gap:16rpx;padding:12rpx 28rpx 36rpx;color:#6e8096;font-size:22rpx}.task-pagination button{margin:0;border-radius:16rpx;color:#126dc1;background:#e4f2ff;font-size:22rpx}
