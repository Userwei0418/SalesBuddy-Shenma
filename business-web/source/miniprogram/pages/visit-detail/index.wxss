page{background:#edf5fc}.visit-page{min-height:100vh;box-sizing:border-box;padding:24rpx 26rpx calc(52rpx + env(safe-area-inset-bottom));color:#263b51;background:radial-gradient(circle at 94% 1%,rgba(67,160,241,.16),transparent 28%),linear-gradient(155deg,#f9fcff,#edf5fc 58%,#e8f1fa)}
.state-card{padding:70rpx 24rpx;border-radius:25rpx;background:#fff;color:#74869a;text-align:center}.state-card.error text{display:block}.state-card button{width:190rpx;margin:24rpx auto 0;border:0;border-radius:999rpx;color:#fff;background:#1677d2;font-size:20rpx}.state-card button::after{display:none}
.visit-hero{padding:28rpx;border-radius:29rpx;color:#fff;background:radial-gradient(circle at 92% 0,rgba(79,180,251,.72),transparent 37%),linear-gradient(145deg,#143a5f,#147ecf);box-shadow:0 18rpx 42rpx rgba(23,84,147,.18)}.hero-eyebrow{color:rgba(255,255,255,.64);font-size:16rpx;letter-spacing:2.2rpx}.hero-title{margin-top:10rpx;font-size:32rpx;font-weight:780;line-height:1.4}.hero-meta{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:18rpx}.hero-meta text{padding:7rpx 12rpx;border-radius:999rpx;background:rgba(255,255,255,.13);color:#e0f0ff;font-size:16rpx}
.section-card{margin-top:17rpx;padding:23rpx;border:1rpx solid rgba(255,255,255,.94);border-radius:26rpx;background:rgba(255,255,255,.88);box-shadow:0 12rpx 32rpx rgba(31,73,116,.07)}.section-title{color:#263d55;font-size:24rpx;font-weight:760}.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rpx;margin-top:17rpx;overflow:hidden;border:1rpx solid #e5edf5;border-radius:18rpx;background:#e5edf5}.field-grid>view{min-width:0;padding:14rpx;background:#f9fbfd}.field-grid>.wide{grid-column:1/-1}.field-grid text,.content-row text,.next-action text{display:block;color:#8796a7;font-size:15rpx}.field-grid label{display:block;margin-top:5rpx;overflow-wrap:anywhere;color:#344c64;font-size:18rpx;font-weight:650;line-height:1.45}.opportunity-link{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:16rpx;padding:14rpx 16rpx;border:1rpx solid #cfe3f4;border-radius:16rpx;background:#eef7fe}.opportunity-link text{min-width:0;overflow:hidden;color:#315775;font-size:18rpx;font-weight:680;text-overflow:ellipsis;white-space:nowrap}.opportunity-link label{flex:0 0 auto;color:#1674c5;font-size:17rpx}.opportunity-link-active{opacity:.68}
.first-visit{border-color:rgba(74,174,135,.2);background:linear-gradient(145deg,rgba(255,255,255,.92),rgba(237,249,244,.88))}.content-row{padding:16rpx 0;border-bottom:1rpx solid rgba(72,104,138,.09)}.content-row:last-child{border-bottom:0}.content-row label,.next-action label{display:block;margin-top:7rpx;color:#425a71;font-size:19rpx;line-height:1.65}.narrative .content-row:first-of-type{margin-top:8rpx}.next-action{margin-top:17rpx;padding:17rpx 18rpx;border-left:5rpx solid #2a9872;border-radius:7rpx 18rpx 18rpx 7rpx;background:#eaf7f1}.next-action label{color:#376a58}.readonly-note{padding:22rpx 10rpx;color:#8b98a7;font-size:16rpx;text-align:center}

.visit-health{margin:18rpx 0;font-size:23rpx}.visit-health>label{display:block;margin-top:10rpx;font-size:21rpx;line-height:1.6;opacity:.9}
