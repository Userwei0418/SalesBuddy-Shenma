.edit-page{min-height:100vh;box-sizing:border-box;padding:24rpx 28rpx 150rpx;background:linear-gradient(155deg,#fbfdff,#eef6fd 58%,#e7f1fb);color:#21364c}.hero{padding:30rpx;border-radius:30rpx;color:#fff;background:radial-gradient(circle at 90% 5%,rgba(86,183,255,.65),transparent 35%),linear-gradient(145deg,#173e65,#167fdc);box-shadow:0 20rpx 46rpx rgba(20,83,147,.2)}.eyebrow{font-size:15rpx;font-weight:700;letter-spacing:2.3rpx;opacity:.66}.title{margin-top:9rpx;font-size:36rpx;font-weight:800}.subtitle{margin-top:10rpx;font-size:19rpx;line-height:1.55;opacity:.8}.loading{margin-top:22rpx;padding:70rpx;border-radius:28rpx;background:rgba(255,255,255,.84);color:#7c8c9e;text-align:center}.agent-card,.form-card{margin-top:22rpx;padding:22rpx;border:1rpx solid rgba(255,255,255,.94);border-radius:28rpx;background:rgba(255,255,255,.84);box-shadow:0 15rpx 40rpx rgba(28,72,118,.08)}.agent-card{background:linear-gradient(145deg,rgba(247,252,255,.97),rgba(228,242,255,.9))}.agent-head{display:flex;align-items:center;gap:12rpx}.agent-head>view:first-child{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;border-radius:15rpx;color:#fff;background:linear-gradient(145deg,#184f84,#1684ed);font-size:14rpx;font-weight:750}.agent-head>view:nth-child(2){flex:1}.agent-head text,.agent-head label{display:block}.agent-head text{font-size:22rpx;font-weight:730}.agent-head label{margin-top:3rpx;color:#8292a4;font-size:15rpx}.lock{padding:6rpx 10rpx;border-radius:999rpx;color:#5f7892;background:#e4edf5;font-size:15rpx}.agent-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:18rpx;border:1rpx solid rgba(70,109,149,.1);border-radius:19rpx;background:rgba(255,255,255,.56)}.agent-grid>view{display:flex;flex-direction:column;align-items:center;padding:16rpx 5rpx;border-right:1rpx solid rgba(70,109,149,.1)}.agent-grid>view:last-child{border:0}.agent-grid text{color:#176fc7;font-size:26rpx;font-weight:780}.agent-grid label{margin-top:4rpx;color:#8493a4;font-size:14rpx}.agent-risk{margin-top:14rpx;color:#687c90;font-size:16rpx}.form-card{padding-top:7rpx}.section-head{padding:16rpx 0 4rpx}.section-head text,.section-head label{display:block}.section-head text{font-size:24rpx;font-weight:750}.section-head label{margin-top:4rpx;color:#8997a7;font-size:16rpx}.contact-head{margin-top:12rpx;border-top:1rpx solid rgba(67,103,140,.1)}.field{padding:19rpx 0;border-bottom:1rpx solid rgba(67,103,140,.1)}.field>text{display:block;margin-bottom:10rpx;color:#708196;font-size:18rpx;font-weight:680}.field input,.field textarea,.picker{width:100%;min-height:76rpx;box-sizing:border-box;padding:0 18rpx;border:1rpx solid rgba(63,108,153,.14);border-radius:18rpx;background:#f7fafe;color:#263d55;font-size:21rpx}.field textarea{min-height:118rpx;padding:18rpx;line-height:1.55}.picker{display:flex;align-items:center;justify-content:space-between}.picker label{color:#91a0b0;font-size:29rpx}.submit-bar{position:fixed;z-index:30;left:0;right:0;bottom:0;padding:14rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(255,255,255,.94);background:rgba(246,250,255,.9);backdrop-filter:blur(28rpx)}.submit-bar button{height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;color:#fff;background:linear-gradient(135deg,#174b77,#1678d3 55%,#2495ef);box-shadow:0 13rpx 30rpx rgba(20,96,176,.25);font-size:22rpx;font-weight:740}
.customer-name-readonly{gap:16rpx;background:#f0f4f8}.customer-name-readonly>text{min-width:0;flex:1;overflow-wrap:anywhere}.customer-name-readonly>label{flex-shrink:0;font-size:18rpx;color:#8b9aab}
