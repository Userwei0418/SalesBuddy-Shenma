page{background:#f8f2ee}.risk-page{min-height:100vh;padding-bottom:48rpx;color:#2e2928;background:radial-gradient(circle at 92% 0,rgba(240,144,91,.17),transparent 30%),linear-gradient(155deg,#fffdfb,#f8f3ef 58%,#f3eeeb)}.risk-hero{padding:38rpx 30rpx 30rpx;color:#fff;background:radial-gradient(circle at 94% 0,rgba(255,178,124,.58),transparent 34%),linear-gradient(145deg,#4b2e29,#b85f3e);box-shadow:0 20rpx 48rpx rgba(130,69,45,.2)}.hero-eyebrow{color:rgba(255,255,255,.62);font-size:18rpx;letter-spacing:2.5rpx}.hero-title{margin-top:9rpx;font-size:43rpx;font-weight:800}.hero-subtitle{margin-top:8rpx;color:rgba(255,255,255,.76);font-size:20rpx}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:27rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:20rpx;background:rgba(255,255,255,.08)}.hero-stats view{padding:17rpx 20rpx;border-right:1rpx solid rgba(255,255,255,.12)}.hero-stats view:last-child{border:0}.hero-stats text{display:block;font-size:31rpx;font-weight:770}.hero-stats label{display:block;margin-top:4rpx;color:rgba(255,255,255,.63);font-size:16rpx}.risk-tabs{position:sticky;z-index:5;top:0;display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;padding:18rpx 27rpx;background:rgba(249,244,240,.91);backdrop-filter:blur(24rpx)}.risk-tab{height:61rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;border:1rpx solid rgba(126,85,62,.1);border-radius:17rpx;color:#806f66;background:rgba(255,255,255,.65);font-size:20rpx}.risk-tab.active{border-color:rgba(187,91,54,.24);color:#aa5032;background:#ffebe1;font-weight:700}.risk-tab text{min-width:29rpx;height:29rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:#bf6745;font-size:14rpx}.risk-list{display:flex;flex-direction:column;gap:16rpx;padding:4rpx 27rpx 40rpx}.risk-card{padding:21rpx 22rpx 18rpx;border:1rpx solid rgba(255,255,255,.96);border-radius:26rpx;background:linear-gradient(145deg,rgba(255,255,255,.91),rgba(255,245,239,.82));box-shadow:0 14rpx 36rpx rgba(93,61,45,.08)}.risk-card:active{transform:scale(.992)}.risk-card.status-resolved{background:linear-gradient(145deg,rgba(252,255,253,.94),rgba(235,248,241,.84))}.risk-top{display:flex;align-items:center;justify-content:space-between}.risk-state{display:flex;align-items:center;gap:8rpx;color:#a3593b;font-size:17rpx;font-weight:700}.risk-state text{width:9rpx;height:9rpx;border-radius:50%;background:#d67550;box-shadow:0 0 12rpx rgba(214,117,80,.55)}.status-resolved .risk-state{color:#4b8a70}.status-resolved .risk-state text{background:#59b488}.risk-level{padding:6rpx 11rpx;border-radius:999rpx;color:#a66448;background:#ffebe2;font-size:15rpx}.level-critical,.level-high{color:#b74c35;background:#ffe4dc}.status-resolved .risk-level{color:#558470;background:#e7f3ed}.risk-customer{margin-top:14rpx;color:#25394d;font-size:26rpx;font-weight:780}.risk-title{margin-top:6rpx;color:#a05336;font-size:21rpx;font-weight:680}.risk-description{display:-webkit-box;margin-top:8rpx;overflow:hidden;color:#776b66;font-size:19rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.risk-meta{display:grid;grid-template-columns:1fr 1.2fr;gap:10rpx;margin-top:17rpx;padding:13rpx 14rpx;border-radius:17rpx;background:rgba(248,241,236,.85)}.status-resolved .risk-meta{background:rgba(237,247,242,.88)}.risk-meta text{display:block;color:#9c8d85;font-size:14rpx}.risk-meta label{display:block;margin-top:3rpx;color:#5b4d46;font-size:18rpx;font-weight:650}.risk-action{display:flex;align-items:center;justify-content:space-between;margin-top:15rpx;padding-top:14rpx;border-top:1rpx solid rgba(120,84,64,.09);color:#89786f;font-size:16rpx}.risk-action view{color:#b15939;font-weight:650}.risk-action label{margin-left:5rpx;font-size:25rpx}.empty-state{display:flex;flex-direction:column;align-items:center;padding:130rpx 30rpx;color:#8b7c73}.empty-state view{width:85rpx;height:85rpx;display:flex;align-items:center;justify-content:center;border-radius:28rpx;color:#fff;background:linear-gradient(145deg,#3f8569,#70c39c);box-shadow:0 15rpx 30rpx rgba(64,140,106,.18);font-size:34rpx}.empty-state text{margin-top:23rpx;color:#4f4540;font-size:25rpx;font-weight:720}.empty-state label{margin-top:8rpx;font-size:18rpx}
.risk-opportunity{display:flex;align-items:center;justify-content:space-between;gap:15rpx;margin-top:14rpx;padding:13rpx 15rpx;border:1rpx solid rgba(190,104,66,.18);border-radius:16rpx;background:rgba(255,239,231,.78)}.risk-opportunity>view{min-width:0;flex:1}.risk-opportunity>view text,.risk-opportunity>view label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.risk-opportunity>view text{color:#a49187;font-size:14rpx}.risk-opportunity>view label{margin-top:3rpx;color:#65483c;font-size:18rpx;font-weight:680}.risk-opportunity>text{flex:0 0 auto;color:#b15939;font-size:17rpx;font-weight:680}
