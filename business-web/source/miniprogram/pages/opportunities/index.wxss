.page{min-height:100vh;padding:25rpx 27rpx 55rpx;box-sizing:border-box;background:linear-gradient(155deg,#fbfdff,#edf5fd);color:#24394f}.hero{padding:29rpx;border-radius:29rpx;color:#fff;background:radial-gradient(circle at 90% 0,rgba(73,186,240,.7),transparent 34%),linear-gradient(145deg,#163c61,#147fc9)}.eyebrow{font-size:15rpx;letter-spacing:2rpx;opacity:.68}.title{margin-top:8rpx;font-size:39rpx;font-weight:800}.subtitle{margin-top:7rpx;font-size:18rpx;opacity:.76}.hero-summary{display:flex;gap:12rpx;margin-top:23rpx}.hero-summary>view{flex:1;padding:15rpx;border:1rpx solid rgba(255,255,255,.15);border-radius:17rpx;background:rgba(255,255,255,.1)}.hero-summary text,.hero-summary label{display:block}.hero-summary text{font-size:27rpx;font-weight:800}.hero-summary label{margin-top:3rpx;font-size:15rpx;opacity:.7}

.filter-card{margin:14rpx 0 20rpx;padding:8rpx 10rpx;border:1rpx solid rgba(73,111,148,.1);border-radius:20rpx;background:rgba(255,255,255,.9);box-shadow:0 9rpx 28rpx rgba(31,72,112,.06)}.filter-line{display:flex;align-items:center;gap:8rpx;min-width:0}.filter-title{flex:0 0 auto;color:#405d76;font-size:19rpx;font-weight:700}.filter-scroll{width:0;min-width:0;flex:1;white-space:nowrap}.filter-row{display:inline-flex;align-items:center;gap:7rpx;padding-right:6rpx}.filter-item{width:188rpx;flex:0 0 auto;overflow:hidden;box-sizing:border-box;height:50rpx;border:1rpx solid #dfe9f2;border-radius:12rpx;background:#f6f9fc}.filter-control{display:flex;align-items:center;gap:6rpx;height:48rpx;min-width:0;padding:0 10rpx}.filter-control label{flex:0 0 auto;color:#8a99a8;font-size:15rpx}.filter-control>text:nth-child(2){min-width:0;flex:1;overflow:hidden;color:#304e68;font-size:17rpx;font-weight:650;white-space:nowrap;text-overflow:ellipsis}.filter-control .chevron{flex:0 0 auto;color:#86a0b7;font-size:15rpx}.filter-reset{flex:0 0 auto;padding:8rpx 4rpx;color:#2477b9;font-size:18rpx}
.filter-item.active{border-color:#9bc9ee;background:#eaf5ff}.stage-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8rpx;margin-top:11rpx;padding-top:12rpx;border-top:1rpx solid #e7eef5}.stage-option{display:flex;align-items:center;justify-content:center;gap:5rpx;min-width:0;height:48rpx;border:1rpx solid #dfe9f2;border-radius:13rpx;color:#526b82;background:#f8fafc;font-size:15rpx}.stage-option text{width:13rpx;color:#1778ca}.stage-option label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.stage-option.selected{border-color:#93c9f1;color:#176fb7;background:#eaf5ff;font-weight:680}

.create-row{display:flex;justify-content:flex-end;margin:14rpx 2rpx 2rpx}.create-opportunity{display:flex;align-items:center;gap:8rpx;padding:12rpx 20rpx;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#1768b5,#1688e8);box-shadow:0 8rpx 20rpx rgba(20,113,197,.2)}.create-opportunity text{font-size:24rpx;line-height:1}.create-opportunity label{font-size:18rpx;font-weight:680}.create-opportunity-active{opacity:.82;transform:scale(.98)}

.list{display:flex;flex-direction:column;gap:16rpx}.card{padding:22rpx;border:1rpx solid rgba(75,110,145,.1);border-radius:25rpx;background:rgba(255,255,255,.88);box-shadow:0 10rpx 30rpx rgba(31,72,112,.07)}.card-top{display:flex;align-items:flex-start;justify-content:space-between}.card-top text,.card-top label{display:block}.card-top text{color:#2d435a;font-size:22rpx;font-weight:750;line-height:1.35}.card-top label{margin-top:5rpx;color:#8292a2;font-size:17rpx}.stage-progress-head{display:flex;align-items:center;justify-content:space-between;margin-top:17rpx;color:#1675bd}.stage-progress-head text{font-size:17rpx;font-weight:680}.stage-progress-head label{font-size:21rpx;font-weight:780}.progress{height:8rpx;margin:8rpx 0 17rpx;border-radius:999rpx;background:#e6edf4;overflow:hidden}.progress text{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#1979ca,#40afe5)}.meta{display:grid;grid-template-columns:1fr 1fr 1.3fr 1.1fr;padding:15rpx 0;border-top:1rpx solid #edf1f5}.meta>view{border-right:1rpx solid #edf1f5}.meta>view:last-child{border:0}.meta text,.meta label{display:block;text-align:center}.meta text{color:#8a98a7;font-size:14rpx}.meta label{margin-top:5rpx;color:#344b62;font-size:17rpx;font-weight:680}.owner{display:flex;justify-content:space-between;margin-top:12rpx;color:#8392a2;font-size:16rpx}.owner text{color:#1675bd}.empty{padding:80rpx 20rpx;text-align:center;color:#8292a3;font-size:20rpx}

.opportunity-order-note{padding:0 4rpx;color:#7b91a5;font-size:17rpx;line-height:1.5}.opportunity-quarter-group{display:flex;flex-direction:column;gap:16rpx;margin-bottom:12rpx}.opportunity-quarter-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:12rpx 6rpx;color:#204f75}.opportunity-quarter-heading>text{padding-left:12rpx;border-left:6rpx solid #2d86c4;font-size:25rpx;font-weight:750;line-height:1.15}.opportunity-quarter-heading>label{padding:5rpx 13rpx;border-radius:999rpx;background:#e7f1fa;color:#507c9e;font-size:17rpx}

.meta>view{min-width:0;padding:0 6rpx;box-sizing:border-box;}
.meta label{overflow-wrap:break-word;word-break:break-word;line-height:1.4;}
