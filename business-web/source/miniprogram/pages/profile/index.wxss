.profile-subject-controls{margin:18rpx 3rpx 10rpx}.subject-loading{padding:12rpx 0;color:#8298aa;font-size:21rpx}.subject-error{color:#b96a58}.efficiency-ratio-card{margin-top:20rpx;padding:28rpx 24rpx;border-radius:22rpx;background:linear-gradient(135deg,#edf6ff,#f8fcff);border:1rpx solid #dfecf6}.ratio-title{font-size:25rpx;color:#466b87;font-weight:600}.ratio-value{margin-top:14rpx;color:#24577f;font-size:50rpx;font-weight:700;line-height:1.3;font-variant-numeric:tabular-nums}.ratio-track{height:9rpx;margin-top:22rpx;background:#dfeaf3;border-radius:10rpx;overflow:hidden}.ratio-track>view{height:100%;border-radius:inherit;background:linear-gradient(90deg,#277fbd,#58b4df)}.ratio-details{display:flex;flex-direction:column;gap:8rpx;margin-top:18rpx;color:#69869e;font-size:22rpx;line-height:1.5}.ratio-coverage{color:#ad8846}.efficiency-window{margin-top:18rpx;font-size:20rpx;color:#8a9daf;line-height:1.7}.followup-quality{display:flex;justify-content:space-between;padding:22rpx 18rpx;font-size:23rpx;color:#57758d}.followup-quality>text:last-child{font-weight:600;color:#277bb7}.profile-empty{padding:54rpx 20rpx;text-align:center;color:#8295a6;font-size:24rpx;line-height:1.7}.profile-page .performance-metric-head text{font-size:24rpx}.profile-page .performance-metric-head label{font-size:17rpx}.profile-page .performance-target label{font-size:18rpx}.profile-page .performance-target text{font-size:23rpx}.profile-page .growth-loading{height:auto;min-height:70rpx;padding:22rpx 10rpx;font-size:23rpx}.profile-page .capability-title{font-size:28rpx;font-weight:700}.profile-page .module-total{margin-left:18rpx;flex-shrink:0}

.profile-directory-state{margin-top:18rpx;padding:22rpx 24rpx}.profile-directory-loading{font-size:23rpx;line-height:1.7;color:#7891a7}.profile-directory-retry{width:100%;margin:0;padding:0;min-height:48rpx;line-height:1.7;text-align:left;font-size:23rpx;font-weight:500;color:#b36f57;background:transparent;border:0}.profile-directory-retry::after{border:0}

.profile-page .performance-metric-head>label{max-width:none;flex-shrink:0;white-space:nowrap}

.permission-perspectives{display:flex;gap:16rpx;padding:16rpx 32rpx}.permission-perspectives button{flex:1;background:#eef4fa;color:#50657d}.permission-perspectives .selected{background:#207ccc;color:#fff}
