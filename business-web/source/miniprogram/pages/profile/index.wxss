/* Account permission card and glass visual layer */
.profile-card { background: linear-gradient(145deg,rgba(255,255,255,.76),rgba(235,245,255,.66)); }
.avatar { background: linear-gradient(145deg,#173551,#1677ff); box-shadow: 0 12rpx 28rpx rgba(19,86,172,.2), inset 0 1rpx 1rpx rgba(255,255,255,.35); }
.meta { color: #718097; }
.status { display:flex;align-items:center;gap:8rpx;background:rgba(229,247,239,.8); }.status text{width:9rpx;height:9rpx;border-radius:50%;background:#35a477}
.permission-card{position:relative;padding:25rpx 22rpx}.permission-icon{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;border-radius:19rpx;background:rgba(226,240,255,.9);color:#1677ff;font-size:31rpx}.permission-copy{position:absolute;left:101rpx;top:25rpx;font-weight:700}.permission-copy text{display:block;margin-top:6rpx;color:#748298;font-size:20rpx;font-weight:400}.locked{position:absolute;right:22rpx;top:31rpx;padding:7rpx 12rpx;border-radius:999rpx;background:rgba(230,237,246,.84);color:#6b7b90;font-size:18rpx}.detail-row{display:flex;justify-content:space-between;gap:28rpx;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid rgba(76,104,137,.1);font-size:23rpx}.detail-row:first-of-type{margin-top:25rpx}.detail-row text{flex:0 0 auto;color:#748298}.detail-row label{text-align:right;color:#304057;line-height:1.45}.menu view{border-bottom-color:rgba(76,104,137,.1)}.menu label{color:#748298}.logout-button{display:flex;align-items:center;justify-content:center;height:84rpx;margin-top:26rpx;border:1rpx solid rgba(208,83,100,.15);border-radius:22rpx;background:rgba(255,255,255,.5);color:#cf5967;font-size:25rpx}.version{margin-top:32rpx;color:#94a0af}

.maturity-facts{display:flex;flex-direction:column;gap:20rpx;margin-top:24rpx}.maturity-fact{padding:24rpx;border:1rpx solid #e0ebf5;border-radius:20rpx;background:#f6faff}.maturity-fact>text{font-size:24rpx;color:#5e748b}.maturity-fact>view{margin:12rpx 0;color:#20496e;font-size:38rpx;font-weight:750}.maturity-fact>label{font-size:21rpx;color:#71869b}
.performance-board{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:18rpx}.performance-metric{padding:18rpx;border:1rpx solid #dce9f4;border-radius:19rpx;background:linear-gradient(145deg,#f8fbff,#eef6fd)}.performance-metric-head{display:flex;align-items:center;justify-content:space-between;gap:8rpx}.performance-metric-head>text{color:#2c4b66;font-size:22rpx;font-weight:750}.performance-metric-head>label{color:#2675b5;font-size:14rpx}.performance-values{display:grid;grid-template-columns:1fr 1fr;gap:9rpx;margin-top:16rpx}.performance-values>view{min-width:0}.performance-values text,.performance-values label{display:block}.performance-values text{overflow:hidden;color:#1f527d;font-size:20rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.performance-values label{margin-top:4rpx;color:#8696a8;font-size:14rpx}.performance-track{height:7rpx;margin-top:15rpx;overflow:hidden;border-radius:999rpx;background:#dfeaf4}.performance-track>view{height:100%;border-radius:inherit;background:linear-gradient(90deg,#1b70bd,#35a4e8)}

.insight-card-top,.capability-top{gap:16rpx}.insight-card-top>view:first-child,.capability-top>view:first-child{min-width:0;flex:1}.module-total{flex-shrink:0;min-width:116rpx;padding:9rpx 12rpx;border-radius:16rpx;background:#edf5ff}.module-total>view{display:flex;align-items:baseline;gap:5rpx}.module-total>view>label{font-size:18rpx;color:#5183b7}.module-total>label{font-size:16rpx;white-space:nowrap}.module-total text{font-size:43rpx}.maturity-card .module-total{background:#fff5e4}.maturity-card .module-total text{color:#b78532}

.efficiency-summary{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:16rpx;padding:15rpx 20rpx;border-radius:14rpx;background:#edf5fc}.efficiency-summary-label{display:flex;align-items:baseline;gap:12rpx;flex-wrap:wrap;min-width:0}.efficiency-summary-label>text{color:#365772;font-size:21rpx;font-weight:700}.efficiency-summary-label>label{color:#8296a8;font-size:16rpx}.efficiency-summary-value{display:flex;align-items:baseline;gap:5rpx;flex-shrink:0}.efficiency-summary-value>text{color:#226da9;font-size:32rpx;font-weight:800;line-height:1.2}.efficiency-summary-value>label{color:#7f95a9;font-size:16rpx}

.profile-page .metric-switch.fde-metric-switch{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));}.profile-page .fde-metric-switch>view{width:auto;min-width:0;text-align:center;}

