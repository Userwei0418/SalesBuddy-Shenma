[Unit]
Description=Sales Assistant API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sales-backend
Group=sales-backend
EnvironmentFile=/etc/sales-backend.env
WorkingDirectory=/www/wwwroot/salegent/current
ExecStart=/www/wwwroot/salegent/current/.venv/bin/python -m uvicorn sales_backend.main:app --host 127.0.0.1 --port 8080 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sales-backend

[Install]
WantedBy=multi-user.target
