/* 部门设计变量与 TDesign 桥接（scripts/vendor_ui.mjs 从 shandianT/desgin 同步，勿手改 ui/ 下文件） */
@import "ui/design-tokens.wxss";
@import "ui/bridge-tdesign.wxss";
@import "styles/theme-blue-black-white.wxss";
@import "pages/customer-assets/opportunity-view.wxss";
@import "pages/profile/profile-compact.wxss";

page {
  background:var(--ui-background);
  color:var(--ui-ink);
  font-family:-apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size:14px;
}

view, text, scroll-view, input, button { box-sizing:border-box; }
/* 去掉 style v2 后，页面里的原生 button 保留原来 v2 的字重、字号与圆角；组件里的 t-button 有样式隔离，不受这条影响 */
button { position:relative; display:block; overflow:hidden; background:transparent; margin:0; padding:0; line-height:normal; border-radius:4px; color:var(--ui-ink); font-size:17px; font-weight:600; text-align:center; }
button::after { border:0; }
/* 上一行会把 TDesign 按钮（apply-shared，app.wxss 能进组件）描边的 border-style 也清掉，描边按钮就没了边框；TDesign 只设宽度和颜色，这里给描边按钮还原实线（文字按钮 TDesign 自己清成 0） */
.t-button--outline::after { border-style:solid; }
.retry-button { width:100%; height:92rpx; border:0; border-radius:var(--ui-radius-panel); color:var(--ui-on-primary); font-size:14px; font-weight:600; background:var(--ui-primary); }

.page-shell { min-height:100vh; padding:24rpx 28rpx 40rpx; background:var(--ui-background); }
/* 飞书样式：白卡放在灰底上，不描边、不加阴影（规范 16 章） */
.surface { background:var(--ui-surface); border:0; border-radius:var(--ui-radius-panel); box-shadow:none; }
.eyebrow { color:var(--ui-secondary); font-size:var(--ui-text-small); font-weight:600; }
.section-title { margin:36rpx 0 20rpx; font-size:var(--ui-text-body); font-weight:600; }
.tag { display:inline-flex; align-items:center; padding:8rpx 16rpx; border-radius:999px; background:color-mix(in srgb, var(--ui-selected) 82%, transparent); color:var(--ui-primary); font-size:var(--ui-text-small); }
.muted { color:var(--ui-secondary); }
.primary-button { display:flex; align-items:center; justify-content:center; min-height:var(--ui-touch-target); padding:0 28rpx; border-radius:var(--ui-radius-control); background:var(--ui-primary); color:var(--ui-on-primary); box-shadow:none; font-size:var(--ui-text-body); font-weight:600; }
.secondary-button { display:flex; align-items:center; justify-content:center; min-height:80rpx; padding:0 24rpx; border:1px solid var(--ui-line); border-radius:var(--ui-radius-control); background:var(--ui-surface); color:var(--ui-ink); font-size:var(--ui-text-body); }
.ai-advice-card{margin-top:20rpx;padding:24rpx;border:0;border-radius:var(--ui-radius-control);background:var(--ui-selected)}.ai-advice-head{display:flex;align-items:center;gap:12rpx}.ai-advice-head>view:first-child{width:43rpx;height:43rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:var(--ui-radius-control);color:var(--ui-on-primary);background:var(--ui-primary);font-size:var(--ui-text-small);font-weight:600}.ai-advice-head>view:nth-child(2){flex:1}.ai-advice-head text,.ai-advice-head label{display:block}.ai-advice-head text{color:var(--ui-ink);font-size:14px;font-weight:600}.ai-advice-head label{margin-top:3rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}.ai-advice-head .readonly{padding:5rpx 9rpx;border-radius:999px;color:var(--ui-primary);background:var(--ui-surface);font-size:var(--ui-text-small)}.ai-advice-list{margin-top:14rpx}.ai-advice-list>view{display:flex;align-items:flex-start;gap:10rpx;padding:11rpx 0;border-top:1px solid var(--ui-line)}.ai-advice-list>view>text{width:31rpx;height:31rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:var(--ui-radius-control);color:var(--ui-primary);background:var(--ui-selected);font-size:var(--ui-text-small);font-weight:750}.ai-advice-list label{color:var(--ui-ink);font-size:14px;line-height:1.55}
.manual-agent-tip{display:grid;grid-template-columns:42rpx 1fr;gap:7rpx 11rpx;margin-top:18rpx;padding:20rpx;border:0;border-radius:var(--ui-radius-control);background:var(--ui-selected)}.manual-agent-tip>view{grid-row:1/3;width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;border-radius:var(--ui-radius-control);color:var(--ui-on-primary);background:var(--ui-primary);font-size:var(--ui-text-small);font-weight:600}.manual-agent-tip text{color:var(--ui-ink);font-size:14px;line-height:1.5}.manual-agent-tip label{color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.45}
/* 旧版任务详情的接受／拒绝按钮、拒绝卡全局规则已删：任务详情改用 sb-bottom-bar、sb-textarea，这些类名留着只会误伤 */

/* 统一的健康、提醒、告警状态：只给标签、圆点和进度条上色；卡片边框与详情头不涂色，状态由标签表达（14 章「红黄灯只在两处」） */
.traffic-badge{border-radius:var(--ui-radius-control);padding:5rpx 10rpx}
.traffic-badge.traffic-green,.traffic-surface-green{color:var(--ui-success)!important;background:var(--ui-success-soft)!important}.traffic-text-green,.module-total.traffic-surface-green text,.module-total.traffic-surface-green label,.score.traffic-surface-green text{color:var(--ui-success)!important}.traffic-fill-green{background:var(--ui-success)!important}
.traffic-green .task-status>text,.traffic-green .risk-state>text,.traffic-green .hero-status>text,.traffic-green .hero-state>text,.customer-task-item.traffic-green .customer-task-rail>view{background:var(--ui-success)!important}
.detail-page.traffic-green .hero-progress>view{background:var(--ui-success)!important}
.traffic-badge.traffic-yellow,.traffic-surface-yellow{color:var(--ui-warning)!important;background:var(--ui-warning-soft)!important}.traffic-text-yellow,.module-total.traffic-surface-yellow text,.module-total.traffic-surface-yellow label,.score.traffic-surface-yellow text{color:var(--ui-warning)!important}.traffic-fill-yellow{background:var(--ui-warning)!important}
.traffic-yellow .task-status>text,.traffic-yellow .risk-state>text,.traffic-yellow .hero-status>text,.traffic-yellow .hero-state>text,.customer-task-item.traffic-yellow .customer-task-rail>view{background:var(--ui-warning)!important}
.detail-page.traffic-yellow .hero-progress>view{background:var(--ui-warning)!important}
.traffic-badge.traffic-red,.traffic-surface-red{color:var(--ui-danger)!important;background:var(--ui-danger-soft)!important}.traffic-text-red,.module-total.traffic-surface-red text,.module-total.traffic-surface-red label,.score.traffic-surface-red text{color:var(--ui-danger)!important}.traffic-fill-red{background:var(--ui-danger)!important}
.traffic-red .task-status>text,.traffic-red .risk-state>text,.traffic-red .hero-status>text,.traffic-red .hero-state>text,.customer-task-item.traffic-red .customer-task-rail>view{background:var(--ui-danger)!important}
.detail-page.traffic-red .hero-progress>view{background:var(--ui-danger)!important}
.traffic-badge.traffic-gray,.traffic-surface-gray{color:var(--ui-secondary)!important;background:var(--ui-background)!important}.traffic-text-gray,.module-total.traffic-surface-gray text,.module-total.traffic-surface-gray label,.score.traffic-surface-gray text{color:var(--ui-secondary)!important}.traffic-fill-gray{background:var(--ui-neutral)!important}
.traffic-gray .task-status>text,.traffic-gray .risk-state>text,.traffic-gray .hero-status>text,.traffic-gray .hero-state>text,.customer-task-item.traffic-gray .customer-task-rail>view{background:var(--ui-neutral)!important}
.detail-page.traffic-gray .hero-progress>view{background:var(--ui-neutral)!important}

.access-empty{margin:50rpx 28rpx;padding:40rpx;border:0;border-radius:var(--ui-radius-panel);background:var(--ui-surface);color:var(--ui-ink);line-height:1.7}.access-empty>text{display:block;font-size:var(--ui-text-body);font-weight:600;color:var(--ui-ink)}.access-empty>label{display:block;margin-top:16rpx;font-size:var(--ui-text-small)}.fde-note{margin:14rpx 0;padding:16rpx 20rpx;border-radius:var(--ui-radius-control);background:var(--ui-selected);color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.6}.fde-tags{display:flex;flex-wrap:wrap;gap:10rpx}.fde-tags text{padding:6rpx 14rpx;border-radius:var(--ui-radius-control);background:var(--ui-selected);color:var(--ui-primary);font-size:var(--ui-text-small)}

/* Palette only: original geometry is preserved. */
/* Shared selections follow the department light-blue interaction palette. */
.sb-seg .sb-seg-item.on { color:var(--ui-primary); background:var(--ui-selected); }
.sb-seg .sb-seg-item.on.disabled,.sb-seg.is-disabled .sb-seg-item.on { color:var(--ui-muted); background:var(--ui-neutral-soft); }
.sb-lselect.on .sb-lselect-arrow,.sb-lselect.on .sb-lselect-clear { color:var(--ui-primary); }
.sb-lselect.on.disabled .sb-lselect-arrow,.sb-lselect.on.disabled .sb-lselect-clear { color:var(--ui-muted); }
/* Only existing abnormal labels receive black fill. Pending/unset stay neutral. */
.sb-tag.sb-tag-bad,.workbench-status .sb-tag-watch,.risk-state .sb-tag-watch,.customer-tags .risk .sb-tag-watch,.risk-head .sb-tag-watch,.status-open .detail-hero .sb-tag-watch { color:var(--sb-status-ink); background:var(--sb-status-bg); }
.traffic-badge.traffic-red,.sheet-status .traffic-badge.traffic-yellow,.detail-tags .detail-risk.traffic-yellow,.opportunity-status.traffic-yellow { --ui-warning:var(--sb-status-ink); --ui-warning-soft:var(--sb-status-bg); --ui-danger:var(--sb-status-ink); --ui-danger-soft:var(--sb-status-bg); }
