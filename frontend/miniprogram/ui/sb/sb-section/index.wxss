.sb-section { display: flex; flex-direction: column; gap: var(--ui-space-3); padding: var(--ui-card-padding); background: var(--ui-surface); border: 0; border-radius: var(--ui-radius-panel); }
.sb-section.is-plain { padding: 0; background: transparent; border: 0; border-radius: 0; }
.sb-section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--ui-space-3); }
.sb-section-titles { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.sb-section-title { font-size: var(--ui-text-section); font-weight: 600; line-height: 1.4; color: var(--ui-ink); }
.sb-section-desc { font-size: 14px; line-height: 1.5; color: var(--ui-secondary); }
.sb-pressed { opacity: .7; }
/* 右侧链接：点击区域补足 44px 高 */
.sb-section-extra { flex: none; min-height: 44px; display: flex; align-items: center; margin: -12px 0; padding: 0 0 0 var(--ui-space-3); font-size: 14px; color: var(--ui-primary); }
.sb-section.is-bordered { border: 1px solid var(--ui-line); }
