<scroll-view scroll-x scroll-into-view="{{activeId}}" scroll-with-animation class="sb-tabs {{size === 'small' ? 'small' : ''}} {{plain ? 'is-plain' : ''}} {{fit ? 'is-fit' : ''}} {{list.length >= 5 ? 'is-many' : ''}}" aria-role="tablist">
  <view class="sb-tabs-row">
    <view wx:for="{{list}}" wx:key="key" id="sbtab-{{index}}" class="sb-tabs-tab {{item.key === activeKey ? 'on' : ''}} {{item.disabled ? 'disabled' : ''}}" hover-class="{{item.disabled || item.key === activeKey ? 'none' : 'sb-tabs-hover'}}" data-key="{{item.key}}" data-disabled="{{item.disabled}}" bind:tap="onTap" aria-role="tab" aria-selected="{{item.key === activeKey}}">
      <text>{{item.label}}</text><text wx:if="{{item.countText}}" class="sb-tabs-count">{{item.countText}}</text>
    </view>
  </view>
</scroll-view>
