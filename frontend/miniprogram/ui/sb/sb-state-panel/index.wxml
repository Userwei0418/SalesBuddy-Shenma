<slot wx:if="{{state === 'normal'}}"></slot>
<view wx:elif="{{size === 'compact'}}" class="sb-state-line is-{{state}}" aria-role="{{state === 'error' ? 'alert' : 'status'}}"><t-loading wx:if="{{state === 'loading'}}" theme="circular" size="32rpx" /><text class="sb-state-line-text">{{title || (state === 'loading' ? '正在加载…' : state === 'error' ? '加载失败' : state === 'forbidden' ? '暂无查看权限' : '暂无内容')}}</text><view wx:if="{{state === 'error'}}" class="sb-state-hit" bind:tap="onRetry"><t-button size="small" variant="text" theme="primary" bind:tap="onRetry">{{retryLabel}}</t-button></view></view>
<view wx:elif="{{state === 'loading' && skeleton}}" class="sb-state-skel"><t-skeleton theme="paragraph" animation="gradient" /></view>
<view wx:elif="{{state === 'loading'}}" class="sb-state" aria-role="status"><t-loading theme="circular" size="40rpx" /><text class="sb-state-loading-text">{{title || '正在加载…'}}</text><text wx:if="{{description}}" class="sb-state-note">{{description}}</text></view>
<view wx:elif="{{state === 'empty'}}" class="sb-state"><view class="sb-state-title">{{title || '没有匹配的记录'}}</view><text class="sb-state-desc">{{description || '换一个条件试试，或清除全部条件。'}}</text><view wx:if="{{showClear}}" class="sb-state-hit" bind:tap="onClear"><t-button size="small" variant="outline" bind:tap="onClear">{{clearLabel}}</t-button></view></view>
<view wx:elif="{{state === 'error'}}" class="sb-state" aria-role="alert"><view class="sb-state-title">{{title || '加载失败'}}</view><text class="sb-state-desc">{{description || '网络或服务暂时不可用。'}}</text><view class="sb-state-hit" bind:tap="onRetry"><t-button size="small" theme="primary" bind:tap="onRetry">{{retryLabel}}</t-button></view><text wx:if="{{retryNote}}" class="sb-state-note">{{retryNote}}</text></view>
<view wx:elif="{{state === 'forbidden'}}" class="sb-state"><view class="sb-state-title">{{title || '暂无查看权限'}}</view><text class="sb-state-desc">{{description || '不在你的授权范围内，或权限已变化。这里不显示对象信息。'}}</text></view>
