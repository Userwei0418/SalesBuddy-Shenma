<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view class="page page-shell">
  <view class="opportunity-create-hero">
    <view class="hero-content">
      <view class="hero-title">{{existing ? '修改商机' : '新增商机'}}</view>
      <view class="hero-subtitle">{{customerName ? '补充关键信息，持续推进成交' : '先选择客户，再完善商机信息'}}</view>
      <view wx:if="{{customerName}}" class="customer-context">
        <view class="customer-context-copy">
          <text>关联客户</text>
          <view>{{customerName}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!customerId}}" class="surface customer-picker-card">
    <view class="section-head">
      <view>
        <view class="card-title">选择所属客户</view>
        <view class="card-description">商机将归档到所选客户名下</view>
      </view>
      <view class="step-chip">第 1 步</view>
    </view>
    <view class="search-shell">
      <t-icon name="search" size="40rpx" class="search-icon"/>
      <input class="search" placeholder="搜索公司客户名称" placeholder-class="search-placeholder" value="{{query}}" maxlength="100" confirm-type="search" bindinput="inputCustomer" disabled="{{busy || saveStatus === 'unknown' || saveStatus === 'checking' || saveStatus === 'succeeded'}}"/>
    </view>
    <view wx:if="{{customerSearchLoading}}" class="empty-hint">正在搜索公司客户…</view>
    <view wx:elif="{{customerSearchError}}" class="error-card customer-search-error" aria-role="alert"><text>{{customerSearchError}}</text><button class="search-retry" size="mini" bindtap="retryCustomerSearch">重新搜索</button></view>
    <view wx:elif="{{customerSearchDone && !customers.length}}" class="empty-hint">未找到可创建商机的匹配客户；公海客户请先认领</view>
    <view wx:elif="{{!customers.length}}" class="empty-hint">输入客户名称，从已认领且允许创建商机的客户中选择</view>
    <view wx:for="{{customers}}" wx:key="id" class="customer" hover-class="customer-pressed" data-id="{{item.id}}" bindtap="selectCustomer">
      <view class="customer-result-name">{{item.name}}</view>
      <t-icon name="chevron-right" size="36rpx" class="customer-arrow"/>
    </view>
  </view>

  <view wx:if="{{customerId && !existing && !loading && !customerName}}" class="surface"><button size="mini" bindtap="load">重新核对</button><button size="mini" bindtap="changeCustomer">重新选择客户</button></view>

  <sb-state-panel wx:if="{{loading}}" class="loading-state" state="loading" title="正在加载商机信息…" retryNote=""/>

  <view wx:elif="{{customerName}}" class="surface form-card">
    <view class="section-head form-heading">
      <view>
        <view class="card-title">完善商机信息</view>
        <view class="card-description">必填信息完整后即可保存</view>
      </view>
      <view class="step-chip">第 2 步</view>
    </view>
    <opportunity-form id="opportunityForm" customer-id="{{customerId}}" existing="{{existing}}" disabled="{{busy || saveStatus === 'unknown' || saveStatus === 'checking' || saveStatus === 'succeeded'}}"/>
  </view>

  <view wx:if="{{error}}" class="error-card" aria-role="alert">{{error}}<button wx:if="{{customerName && !existing && !createAccessAllowed}}" size="mini" bindtap="recheckCreateAccess">重新核对创建资格</button></view>
  <view wx:if="{{saveRecoveryMessage}}" class="error-card" aria-role="alert">{{saveRecoveryMessage}}</view>

  <view wx:if="{{customerName}}" class="footer">
    <view class="footer-hint">请确认商机名称、阶段、金额和预计关单日期</view>
    <block wx:if="{{saveStatus === 'unknown' || saveStatus === 'checking'}}">
      <button class="submit" loading="{{busy}}" disabled="{{busy}}" bindtap="checkSaveResult">{{busy ? (saveRecoveryAction === 'cancel' ? '正在结束未完成的提交' : '正在查询保存结果') : '查询保存结果'}}</button>
      <button wx:if="{{canRetrySave}}" disabled="{{busy}}" bindtap="retrySave">按原内容重试提交</button>
      <button disabled="{{busy}}" bindtap="cancelSave">结束未完成的提交</button>
    </block>
    <button wx:elif="{{saveStatus === 'succeeded'}}" class="submit" bindtap="openSavedOpportunity">打开已保存商机</button>
    <button wx:else class="submit {{busy ? 'submit-disabled' : ''}}" loading="{{busy}}" disabled="{{busy || (!existing && !createAccessAllowed)}}" bindtap="submit">{{busy ? '正在保存' : '确认保存商机'}}</button>
  </view>
</view>

</block>
