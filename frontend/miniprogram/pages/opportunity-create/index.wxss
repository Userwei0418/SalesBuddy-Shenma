.page{min-height:100vh;padding:24rpx 28rpx 240rpx;padding-bottom:calc(240rpx + constant(safe-area-inset-bottom));padding-bottom:calc(240rpx + env(safe-area-inset-bottom));box-sizing:border-box;color:var(--ui-ink);background:var(--ui-background)}
/* 页面标题：页底色上直接放标题，不用深色横幅 */
.opportunity-create-hero{margin:8rpx 0 32rpx;color:var(--ui-ink);background:var(--ui-background)}
.hero-title{color:var(--ui-ink);font-size:var(--ui-text-page);font-weight:600;line-height:1.3}
.hero-subtitle{margin-top:8rpx;color:var(--ui-secondary);font-size:14px;line-height:1.5}
.customer-context{margin-top:16rpx}
.customer-context-copy{display:flex;align-items:baseline;gap:16rpx;min-width:0}
.customer-context-copy text{flex:0 0 auto;color:var(--ui-secondary);font-size:14px}
.customer-context-copy view{min-width:0;overflow:hidden;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;text-overflow:ellipsis;white-space:nowrap}
/* 白卡放灰底上（.surface 不描边不加阴影），卡内靠分隔线分组 */
.customer-picker-card,.form-card{margin-bottom:24rpx;padding:32rpx}
.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.form-heading{padding-bottom:24rpx;border-bottom:1px solid var(--ui-line)}
.card-title{color:var(--ui-ink);font-size:var(--ui-text-section);font-weight:600;line-height:1.4}
.card-description{margin-top:4rpx;color:var(--ui-secondary);font-size:14px;line-height:1.5}
.step-chip{flex:0 0 auto;height:20px;padding:0 12rpx;border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);line-height:20px}
/* 客户搜索：原生输入框保留（测试锁定 bindinput），外框对齐 sb-search plain：白底、细线、控件圆角、放大镜图标，高 --ui-field-height（44px，不随屏宽缩） */
.search-shell{display:flex;align-items:center;height:var(--ui-field-height);margin-top:24rpx;box-sizing:border-box;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface)}
.search-icon{display:inline-flex;padding-left:24rpx;color:var(--ui-muted)}
.search{height:calc(var(--ui-field-height) - 2px);min-width:0;flex:1;padding:0 24rpx 0 12rpx;color:var(--ui-ink);font-size:var(--ui-text-body)}
.search-placeholder{color:var(--ui-muted)}
.empty-hint{padding:24rpx 0 0;color:var(--ui-secondary);font-size:14px;text-align:center}
/* 搜索结果：列表行 ≥48px（px，不随屏宽缩；长名折行时上下留 8px），按下变灰，分隔线从文字起点开始 */
.customer{display:flex;align-items:center;gap:16rpx;min-height:48px;box-sizing:border-box;padding:8px 0;border-bottom:1px solid var(--ui-line)}
.customer:last-child{border-bottom:0}
/* 搜索框和第一条结果之间隔 8px，两个可点元素不贴在一起 */
.search-shell+.customer{margin-top:8px}
.customer-pressed{background:var(--ui-neutral-soft)}
.customer-result-name{min-width:0;flex:1;color:var(--ui-ink);font-size:var(--ui-text-body);line-height:1.5}
.customer-arrow{flex:0 0 auto;display:inline-flex;color:var(--ui-muted)}
.loading-state{display:block;margin-bottom:24rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
/* 保存失败：就地一行红字，不整块涂红 */
.error-card{margin-top:16rpx;color:var(--ui-danger);font-size:14px;line-height:1.5}
/* 底部操作条：白底一条细线，主按钮主色实底；安全区按 WeUI 两行写 */
.footer{position:fixed;z-index:20;right:0;bottom:0;left:0;padding:16rpx 28rpx;padding-bottom:calc(16rpx + constant(safe-area-inset-bottom));padding-bottom:calc(16rpx + env(safe-area-inset-bottom));border-top:1px solid var(--ui-line);background:var(--ui-surface);box-shadow:none}
.footer-hint{margin-bottom:12rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);text-align:center}
.submit{display:flex;align-items:center;justify-content:center;width:100%;height:var(--ui-touch-target);border-radius:var(--ui-radius-control);color:var(--ui-on-primary);background:var(--ui-primary);box-shadow:none;font-size:var(--ui-text-body);font-weight:600}
.submit-disabled{color:var(--ui-secondary);background:var(--ui-neutral-soft)}
.submit::after{border:0}
