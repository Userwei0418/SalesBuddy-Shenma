<wxs module="opt">
function lab(it,key,suffix){return (key ? it[key] : it) + (suffix || '');}
function idx(list,key,suffix){var out=[];for(var i=0;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function rest(list,key,suffix){var out=[];for(var i=1;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function pick(i){var n=i * 1;return n>0?n:null;}
module.exports={idx:idx,rest:rest,pick:pick};
</wxs>
<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view class="page {{archived ? 'archived-page' : ''}}">
  <view wx:if="{{archived}}" class="card success-card">
    <sb-result status="success" title="拜访记录录入成功" description="{{customerName}}">
    <view slot="extra" class="success-extra">
    <view class="success-ai"><sb-ai-badge state="confirmed" /></view>
    <view class="metrics"><view class="metric-cell"><text class="metric-number">{{archivedCount}}</text><label class="metric-label">字段已归档</label></view><view class="metric-cell"><text class="metric-number">{{score}}分</text><label class="metric-label">AI 评分</label></view><view class="metric-cell"><text class="metric-number">{{grade}}</text><label class="metric-label">质量等级</label></view></view>
    <view class="success-next"><view class="section-title">下一步行动</view><view class="body-text">{{values.next_action}}</view></view>
    <view wx:if="{{archiveWarning}}" class="notice error">{{archiveWarning}}</view>
    <view class="success-actions">
    <button class="v-button primary" bindtap="openVisit"><text>查看本次跟进详情</text><t-icon name="chevron-right" size="36rpx"/></button>
    <button wx:if="{{!isFde && (advice || adviceBusy || adviceError)}}" class="v-button secondary" bindtap="openAdvice">查看本次待办建议</button>
    <button class="v-button secondary {{busy ? 'is-disabled' : ''}}" bindtap="openCustomer"><text>查看客户档案</text><t-icon name="chevron-right" size="36rpx"/></button>
    </view>
    </view>
    </sb-result>
  </view>
  <block wx:else>
    <sb-summary-card class="hero" title="{{editing ? '补充跟进信息' : flowStep === 'edit' ? '核对拜访记录' : flowStep === 'analyzing' ? 'AI 正在分析' : '查看质检结果'}}" subtitle="{{editing ? customerName : '核对内容 · AI 质检 · 确认保存'}}" />
    <view wx:if="{{errorText}}" class="notice error">{{errorText}}</view>
    <view wx:if="{{!editing}}" class="flow-steps"><view class="flow-step {{flowStep==='edit'?'active':'done'}}"><text>1</text>核对内容</view><view class="step-line"></view><view class="flow-step {{flowStep!=='edit'?'active':''}}"><text>2</text>AI 质检</view><view class="step-line"></view><view class="flow-step"><text>3</text>确认保存</view></view>
    <view wx:if="{{flowStep==='analyzing'}}" class="card analyzing-card"><view class="analysis-orbit"><view class="analysis-core">AI</view></view><view class="section-title">正在为这次拜访做质检</view><view class="analysis-caption">{{analysisPhrase}}</view><view class="muted">请稍候，完成后会展示评分与改进建议</view></view>
    <view wx:if="{{!editing && flowStep==='result'}}" class="review-at-top">
      <view class="card quality">
        <view class="quality-top"><view><view class="section-title">AI 质量审核</view><view class="muted">评估本次拜访录入质量，并给出评分与改进建议</view></view><view wx:if="{{score !== null}}" class="score traffic-surface-{{scoreSignal.tone}}">{{score}}<text class="score-label">{{reviewStale ? '修改前评分' : '分 · ' + scoreSignal.label}}</text></view></view>
        <view class="audit-rule">提交标准：质量评分须{{admissionRequirement}}</view>
        <view wx:if="{{quality}}" class="feedback"><view wx:for="{{quality.suggestions}}" wx:key="*this" class="suggestion">• {{item}}</view></view>
        <view wx:if="{{score !== null && !scorePassed && !reviewStale}}" class="notice error">AI 质量审核未通过，请按建议完善内容后重新审核。</view>

      </view>
      <view class="card next-audit">
        <view class="audit-heading"><view><view class="section-title">下一步审核</view><view class="muted">硬性检查下一步计划是否可执行</view></view><view class="audit-status {{nextReviewPassed ? 'passed' : 'blocked'}}">{{nextReviewStatus}}</view></view>
        <view class="audit-rule">必须同时包含具体日期，以及明确的行动计划或目标</view>
        <view wx:if="{{quality && quality.next_action}}" class="feedback"><view wx:for="{{quality.next_action.suggestions}}" wx:key="*this" class="suggestion">• {{item}}</view></view>
        <view wx:if="{{quality && !nextReviewPassed && !reviewStale}}" class="notice error">下一步审核未通过，即使质量评分通过也不能提交。</view>
      </view>
    </view>
    <view hidden="{{!editing && flowStep!=='edit'}}" class="card structured-entry">
      <view class="section-head"><view class="section-title">结构化录入</view><sb-ai-badge wx:if="{{!editing}}" state="pending" /></view>
      <view class="optional-field"><view class="field-label">客户类型</view><picker mode="selector" range="{{customerTypeOptions}}" value="{{customerTypeIndex}}" bindchange="selectCustomerType" disabled="{{busy || editing}}"><view class="picker-row {{busy || editing ? 'is-disabled' : ''}}" hover-class="{{busy || editing ? 'none' : 'picker-row-pressed'}}"><text>{{customerTypeLabel}}</text><t-icon wx:if="{{!(busy || editing)}}" name="chevron-down" size="36rpx" class="picker-arrow"/></view></picker></view>
      <view class="optional-field"><view class="field-label">客户名称</view>
        <view wx:if="{{customerConfirmed}}" class="chosen"><view class="chosen-details"><view class="strong">{{customerName}}</view><view class="muted">已在上一页确认关联</view></view></view>
        <block wx:else><view class="search-box"><sb-search plain value="{{customerQuery}}" placeholder="搜索客户名称" maxlength="{{100}}" disabled="{{busy}}" loading="{{searching}}" bind:change="inputCustomer" bind:clear="inputCustomer"/></view><view wx:if="{{!searching}}" class="muted match-hint">点击匹配结果，确认本次跟进的客户</view><scroll-view scroll-y class="customer-results" wx:if="{{customers.length}}"><view wx:for="{{customers}}" wx:key="id" class="customer-row" hover-class="row-pressed" data-id="{{item.id}}" bindtap="chooseCustomer"><text class="customer-name">{{item.name}}</text><text class="link">确认</text><t-icon name="chevron-right" size="32rpx" class="row-arrow"/></view></scroll-view><view wx:if="{{!searching && !customers.length}}" class="muted">没有找到匹配客户</view></block>
      </view>
      <fde-visit-opportunity wx:if="{{isFde && customerConfirmed && !editing}}" id="fdeVisitOpportunity" customer-id="{{customerId}}" selected-id="{{opportunityId}}" disabled="{{busy}}" bind:change="fdeOpportunityChanged"/>
      <view wx:if="{{customerConfirmed && (!isFde || editing)}}" class="optional-field"><view class="field-label">商机名称 <text class="optional-tag">选填</text><sb-ai-badge wx:if="{{opportunityAIRecognized}}" class="ai-recognized-tag" state="pending" text="AI 已识别" /></view><view wx:if="{{opportunityAIHint}}" class="ai-opportunity-hint">{{opportunityAIHint}}</view><block wx:if="{{!editing}}"><view class="picker-row" hover-class="picker-row-pressed" bindtap="toggleOpportunityPicker"><text class="picker-value">{{opportunityOptions[opportunityIndex].name}}</text><t-icon name="chevron-down" size="36rpx" class="picker-arrow"/></view>
        <view wx:if="{{opportunityLoading && !opportunityPickerOpen}}" class="muted match-hint">正在读取商机…</view><view wx:if="{{opportunityError && !opportunityPickerOpen}}" class="opportunity-error">{{opportunityError}}<text class="link inline-link" hover-class="link-pressed" bindtap="retryOpportunities">重新加载</text></view></block><view wx:else class="readonly-field">{{values.opportunity_name || '未关联商机'}}</view></view>
      <view wx:if="{{(canCreateOpportunity || canUpdateOpportunity) && !editing && customerConfirmed && opportunityEditing}}" class="inline-opportunity"><opportunity-form visit-context="{{true}}" id="visitOpportunityForm" customer-id="{{customerId}}" existing="{{selectedOpportunity}}" saved-draft="{{opportunityDraft}}" disabled="{{busy}}" bind:change="changeOpportunityForm"/></view>
      <view wx:if="{{editing || !opportunityId}}" class="optional-field"><view class="field-label">伙伴名称 <text class="optional-tag">选填</text></view><sb-input class="field-control" layout="stacked" plain value="{{values.partner_name}}" maxlength="{{300}}" placeholder="未涉及伙伴可留空" disabled="{{busy}}" data-key="partner_name" bind:change="inputField"/></view>
      <view wx:elif="{{!opportunityEditing || !(canCreateOpportunity || canUpdateOpportunity)}}" class="optional-field"><view class="field-label">所属伙伴</view><view class="readonly-field">{{linkedPartnerName || '未记录伙伴'}}</view><view class="muted">随关联商机，无需重复填写</view></view>
      <view class="optional-field"><sb-date-picker class="field-control" layout="stacked" plain label="跟进日期" value="{{visitDate}}" placeholder="选择跟进日期" shortcuts="{{['today']}}" disabled="{{busy}}" bind:change="selectVisitDate"/><view wx:if="{{visitDate}}" class="date-clear" hover-class="link-pressed" bindtap="clearVisitDate">清除日期</view></view>
      <view class="optional-field"><view class="field-label">对接人</view><sb-input class="field-control" layout="stacked" plain value="{{values.contact_name}}" maxlength="{{300}}" placeholder="填写本次沟通的客户对接人" disabled="{{busy}}" data-key="contact_name" bind:change="inputField"/></view>
      <view wx:for="{{core}}" wx:key="key" class="core-field"><block wx:if="{{editing}}"><view class="field-label">{{item.label}}</view><view class="body-text">{{item.value || '未记录'}}</view></block><sb-textarea wx:else class="field-control" layout="stacked" plain label="{{item.label}}" value="{{item.value}}" maxlength="{{15000}}" minRows="{{4}}" maxRows="{{0}}" placeholder="{{item.placeholder}}" disabled="{{busy}}" data-key="{{item.key}}" bind:change="inputField"/></view>
      <view wx:if="{{isFirstVisit}}" class="first-visit-section">
        <view class="first-visit-heading"><view><view class="subsection-title">首次拜访补充</view><view class="muted">AI 已尝试识别，未识别到的内容请人工补充</view></view><text>4 项必填</text></view>
        <view wx:for="{{firstVisitFields}}" wx:key="key" class="first-visit-field">
          <view class="field-label">{{item.label}} <text class="required">*</text><text class="ai-tag">AI/系统</text></view>
          <view wx:if="{{item.key === 'contact_role' && catalogError}}" class="error" hover-class="link-pressed" bindtap="loadBusinessOptions">{{catalogError}} · 点击重试</view><sb-select wx:if="{{item.key === 'contact_role'}}" class="field-control" layout="stacked" plain title="{{item.label}}" placeholder="{{item.placeholder}}" options="{{opt.idx(contactRoleOptions)}}" value="{{values.contact_role ? contactRoleIndex : null}}" disabled="{{busy || !contactRoleOptions.length}}" bind:change="selectContactRole"/>
          <sb-textarea wx:elif="{{item.key === 'customer_main_business' || item.key === 'customer_needs'}}" class="field-control" layout="stacked" plain value="{{item.value}}" maxlength="{{3000}}" maxRows="{{0}}" placeholder="{{item.placeholder}}" disabled="{{busy}}" data-key="{{item.key}}" bind:change="inputField"/>
          <sb-input wx:else class="field-control" layout="stacked" plain value="{{item.value}}" maxlength="{{300}}" placeholder="{{item.placeholder}}" disabled="{{busy}}" data-key="{{item.key}}" bind:change="inputField"/>
        </view>
      </view>
      <view class="optional-field"><view class="field-label">是否七天内</view><view class="readonly-field">{{sevenLabel}}</view><view class="muted seven-help">系统按跟进日期判断最近七天，含今天</view></view>
      <view class="optional-field"><sb-date-picker class="field-control" layout="stacked" plain label="创建时间" value="{{createdDate}}" placeholder="选择填写日期" shortcuts="{{['today']}}" disabled="{{busy}}" bind:change="selectCreatedDate"/><view wx:if="{{createdDate}}" class="date-clear" hover-class="link-pressed" bindtap="clearCreatedDate">清除日期</view></view>
      <view class="optional-field"><view class="field-label">跟进人</view><view class="readonly-field">{{recorderName || '未记录'}}</view></view>
      <view wx:if="{{canManageAttendance}}" class="collaborator-row" hover-class="row-pressed" bindtap="toggleColleagues"><view><view class="field-label">协同人 <text class="optional-tag">选填</text></view><view class="muted">{{collaboratorNames || '选择参与本次拜访的同事'}}</view></view><t-icon wx:if="{{showColleagues}}" name="chevron-up" size="36rpx" class="picker-arrow"/><t-icon wx:else name="chevron-down" size="36rpx" class="picker-arrow"/></view>
      <block wx:if="{{canManageAttendance && showColleagues}}"><view class="search-box"><sb-search plain value="{{colleagueQuery}}" placeholder="搜索同事姓名或账号" maxlength="{{100}}" bind:change="inputColleagueQuery" bind:clear="inputColleagueQuery"/></view><t-checkbox-group class="colleague-group" value="{{collaboratorIds}}" disabled="{{busy}}" bind:change="selectColleagues"><scroll-view class="colleagues" scroll-y><t-checkbox icon="rectangle" wx:for="{{colleagues}}" wx:key="id" value="{{item.id}}" label="{{item.name}}"/><view wx:if="{{!colleagues.length}}" class="muted colleague-empty">没有匹配的同事</view></scroll-view></t-checkbox-group></block>
    </view>
    <block wx:if="{{flowStep!=='analyzing'}}">
      <sb-bottom-bar wx:if="{{editing}}" primary-label="保存补充信息" loading="{{busy}}" bind:primary="saveSupplement" />
      <sb-bottom-bar wx:elif="{{flowStep==='edit'}}" primary-label="{{pendingReviewId ? '继续查看质检' : '下一步 · AI 质检'}}" loading="{{busy}}" secondary-label="保存草稿" secondary-disabled="{{busy}}" bind:primary="review" bind:secondary="saveDraft" />
      <sb-bottom-bar wx:else primary-label="下一步 · 确认保存" disabled="{{!canSubmit}}" disabled-reason="{{blockReason}}" loading="{{busy}}" secondary-label="返回完善" secondary-disabled="{{busy}}" bind:primary="archive" bind:secondary="backToEdit" />
    </block>
  </block>
</view>

</block>

<sb-sheet visible="{{opportunityPickerOpen && !isFde && !editing && !archived && !accessBlocked}}" title="选择关联商机" description="{{customerName}}" confirmLabel="确定" confirmDisabled="{{busy || !opportunityPendingOption || opportunityPendingOption.unverified}}" bind:confirm="confirmOpportunityPicker" bind:close="closeOpportunityPicker">
  <view slot="header"><sb-search plain value="{{opportunityQuery}}" maxlength="{{100}}" placeholder="搜索该客户下的商机" disabled="{{busy}}" bind:change="searchOpportunities" bind:clear="searchOpportunities"/></view>
  <view class="opportunity-results">
    <t-cell wx:for="{{opportunityOptions}}" wx:key="id" title="{{item.name}}" description="{{item.unverified ? '待核对，暂不可选' : ''}}" hover="{{!item.unverified}}" data-id="{{item.id}}" right-icon="{{opportunityPendingOption && opportunityPendingOption.id === item.id ? 'check' : ''}}" bind:click="chooseOpportunity"/>
  </view>
  <view wx:if="{{opportunityLoading}}" class="opportunity-sheet-hint">正在读取商机…</view>
  <view wx:elif="{{!opportunityItems.length && !opportunityError}}" class="opportunity-sheet-hint">{{opportunityQuery ? '没有匹配的已有商机，请调整关键词' : '该客户暂无可关联的已有商机'}}</view>
  <view wx:if="{{opportunityError}}" class="opportunity-error">{{opportunityError}}<text class="link inline-link" hover-class="link-pressed" bindtap="retryOpportunities">重新加载</text></view>
  <button wx:if="{{opportunityHasMore}}" class="opportunity-more" hover-class="row-pressed" bindtap="moreOpportunities" disabled="{{busy || opportunityLoading}}">加载更多</button>
</sb-sheet>

<sb-sheet visible="{{!isFde && archived && showAdvice}}" title="本次拜访待办建议" confirmLabel="完成，稍后再看" cancelLabel="" bind:confirm="closeAdvice" bind:close="closeAdvice">
  <view slot="header" class="advice-header" catchtouchstart="startAdviceDrag" catchtouchmove="stopAdviceTap" catchtouchend="endAdviceDrag" catchtouchcancel="cancelAdviceDrag"><view class="muted">拜访已保存，是否创建待办由你决定</view><sb-ai-badge state="advice"/></view>
  <view wx:if="{{adviceBusy}}" class="sheet-status">正在根据本次拜访整理建议…</view><view wx:elif="{{adviceError}}" class="sheet-status">{{adviceError}}<button class="v-button secondary" bindtap="loadAdvice">重新获取建议</button></view><block wx:elif="{{advice}}"><view class="advice-summary">{{advice.summary}}</view><view wx:if="{{!advice.suggestions.length}}" class="sheet-status">本次没有需要补充的待办建议</view><view wx:for="{{advice.suggestions}}" wx:key="id" class="advice-item"><view class="field-label advice-title">{{index+1}}. {{item.title}}</view><view class="muted">{{item.evidence}}</view><view class="advice-action">{{item.action}}</view><advice-actions analysis-id="{{advice.id}}" suggestion="{{item}}" bind:changed="reloadAdvice"/></view></block>
</sb-sheet>
