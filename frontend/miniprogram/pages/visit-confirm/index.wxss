/* 核对拜访记录：灰底上放白卡，卡片不描边、不加阴影（飞书）；表单用部门表单件 stacked＋plain，弹层用 sb-sheet。 */
page{background:var(--ui-background)}
.page{min-height:100vh;box-sizing:border-box;padding:24rpx 32rpx 220rpx;padding-bottom:calc(220rpx + constant(safe-area-inset-bottom));padding-bottom:calc(220rpx + env(safe-area-inset-bottom));background:var(--ui-background);color:var(--ui-ink);font-size:14px}
.page.archived-page{padding-bottom:calc(48rpx + constant(safe-area-inset-bottom));padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}
.card{margin-bottom:24rpx;padding:32rpx;border:0;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}

/* 页面标题：sb-summary-card */
.hero{display:block;margin-bottom:24rpx}

/* 通用文字 */
.section-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.section-title{margin:0;font-size:var(--ui-text-body);font-weight:600;line-height:1.4;color:var(--ui-ink)}
.subsection-title{font-size:var(--ui-text-body);font-weight:600;line-height:1.4;color:var(--ui-ink)}
.muted{font-size:var(--ui-text-small);line-height:1.5;color:var(--ui-secondary)}
.body-text{font-size:14px;line-height:1.6;color:var(--ui-ink);white-space:pre-wrap;word-break:break-all}
.strong{font-size:var(--ui-text-body);font-weight:600;color:var(--ui-ink)}
.link{flex-shrink:0;color:var(--ui-primary);font-size:14px}
/* 行内「重新加载」：上下各 11px 撑到 44px（px 不随屏宽缩放） */
.inline-link{display:inline-block;margin:-11px 0 -11px 16rpx;padding:11px 8rpx}
.link-pressed{opacity:.7}
/* 飞书表单标签：14px 常规字重正文色，下方 8px 是控件 */
.field-label{margin-bottom:16rpx;font-size:14px;font-weight:400;line-height:1.4;color:var(--ui-ink)}
.optional-tag{margin-left:8rpx;font-size:var(--ui-text-small);font-weight:400;color:var(--ui-secondary)}
.required{margin-left:8rpx;font-size:var(--ui-text-small);font-weight:400;color:var(--ui-danger)}
/* 首次拜访字段的来源标识：中性小标签 */
.ai-tag{display:inline-block;height:20px;margin-left:8rpx;padding:0 12rpx;border-radius:4px;background:var(--ui-neutral-soft);color:var(--ui-neutral);font-size:var(--ui-text-small);font-weight:400;line-height:20px;vertical-align:middle}
.ai-recognized-tag{display:inline-block;margin-left:8rpx;vertical-align:middle}
.ai-opportunity-hint{margin:0 0 12rpx;font-size:var(--ui-text-small);line-height:1.5;color:var(--ui-secondary)}

/* 提示 */
.notice{margin-bottom:24rpx;padding:16rpx 24rpx;border-radius:var(--ui-radius-control);font-size:14px;line-height:1.5}
.error{color:var(--ui-danger)}
.notice.error{background:var(--ui-danger-soft)}
.card .notice{margin:16rpx 0 0;padding:0;background:transparent}

/* 步骤 */
.flow-steps{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:0 0 24rpx}
.flow-step{display:flex;align-items:center;gap:8rpx;font-size:14px;color:var(--ui-secondary);white-space:nowrap}
.flow-step>text{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;border-radius:50%;border:1px solid var(--ui-line);background:var(--ui-surface);font-size:var(--ui-text-small)}
.flow-step.active{color:var(--ui-primary);font-weight:600}
.flow-step.active>text{border-color:var(--ui-primary);background:var(--ui-primary);color:var(--ui-on-primary)}
.flow-step.done>text{border-color:var(--ui-primary);background:var(--ui-selected);color:var(--ui-primary)}
.step-line{flex:1;height:1px;background:var(--ui-line)}

/* AI 分析中 */
.analyzing-card{padding:64rpx 32rpx;text-align:center}
.analysis-orbit{position:relative;display:flex;align-items:center;justify-content:center;width:156rpx;height:156rpx;margin:0 auto 40rpx;border:1px solid var(--ui-line);border-radius:50%}
.analysis-orbit::before{content:'';position:absolute;inset:-1px;border:2px solid transparent;border-top-color:var(--ui-primary);border-radius:50%;animation:visit-orbit 2s linear infinite}
.analysis-core{width:100rpx;height:100rpx;line-height:100rpx;border-radius:50%;background:var(--ui-selected);color:var(--ui-primary);font-size:18px;font-weight:600}
.analysis-caption{min-height:88rpx;margin-top:16rpx;font-size:14px;line-height:1.6;color:var(--ui-secondary)}
@keyframes visit-orbit{to{transform:rotate(360deg)}}

/* 质检结果 */
.review-at-top{margin-bottom:24rpx}
.review-at-top .card:last-child{margin-bottom:0}
.quality-top,.audit-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx}
.quality-top .muted,.audit-heading .muted{margin-top:4rpx}
.score{flex-shrink:0;padding:8rpx 16rpx;border-radius:var(--ui-radius-control);font-size:20px;font-weight:600;line-height:1.3;color:var(--ui-ink);white-space:nowrap;text-align:right}
.score-label{display:block;font-size:var(--ui-text-small);font-weight:400}
.audit-rule{margin-top:16rpx;font-size:14px;line-height:1.5;color:var(--ui-ink)}
.audit-status{flex-shrink:0;height:20px;padding:0 12rpx;border-radius:4px;font-size:var(--ui-text-small);font-weight:400;line-height:20px}
.audit-status.passed{background:var(--ui-success-soft);color:var(--ui-success)}
.audit-status.blocked{background:var(--ui-danger-soft);color:var(--ui-danger)}
.feedback{margin-top:16rpx;padding-top:16rpx;border-top:1px solid var(--ui-line)}
.suggestion{margin-top:8rpx;font-size:14px;line-height:1.6;color:var(--ui-secondary)}

/* 结构化录入：每项之间一条细线 */
.structured-entry>.optional-field,.structured-entry>.core-field{margin-top:24rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
/* 部门表单件 plain 自带上下 8px：接在字段标签或分隔线下面时收掉上边 */
.field-control{display:block;margin-top:-8px}
.optional-field{margin-top:24rpx}
.core-field{margin-top:24rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
.search-box{margin-top:16rpx}
/* 保留原生 picker 的选择行（客户类型，测试锁定）与商机选择入口：和 sb-select stacked 同一个框，高 --ui-field-height（44px，不随屏宽缩）；禁用时灰底、去掉箭头 */
.picker-row{box-sizing:border-box;display:flex;justify-content:space-between;align-items:center;gap:16rpx;min-height:var(--ui-field-height);padding:0 24rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface);font-size:var(--ui-text-body);color:var(--ui-ink)}
.picker-row-pressed{background:var(--ui-neutral-soft)}
.picker-row.is-disabled{background:var(--ui-neutral-soft);color:var(--ui-muted)}
.picker-value{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.picker-arrow{flex:0 0 auto;display:inline-flex;color:var(--ui-muted)}
/* 只读框和其他表单控件同高（44px）；长商机名折行时上下留 8px */
.readonly-field{box-sizing:border-box;display:flex;align-items:center;width:100%;min-height:var(--ui-field-height);padding:8px 24rpx;border-radius:var(--ui-radius-control);background:var(--ui-background);font-size:14px;line-height:1.5;color:var(--ui-ink);word-break:break-all}
.match-hint{margin:12rpx 0}
.customer-results{max-height:360rpx}
/* 客户结果行最小 48px（px，不随屏宽缩） */
.customer-row{display:flex;justify-content:space-between;align-items:center;gap:8rpx;min-height:48px;box-sizing:border-box;padding:16rpx 0;border-bottom:1px solid var(--ui-line);font-size:var(--ui-text-body)}
.row-pressed{background:var(--ui-neutral-soft)}
.customer-name{flex:1;min-width:0}
.row-arrow{flex:0 0 auto;display:inline-flex;color:var(--ui-primary)}
.chosen{display:flex;justify-content:space-between;align-items:center;padding:8rpx 0 0}
.chosen-details{flex:1;min-width:0}
.chosen .strong{line-height:1.5;word-break:break-all}
/* 商机读取失败行和上方可点行隔 16px，「重新加载」扩出的点击区不压到它们 */
.opportunity-error{margin-top:16px;color:var(--ui-danger);font-size:var(--ui-text-small);line-height:1.6}
/* 「清除日期」：只有文字本身可点（靠右），伪元素把点击区上下扩到 44px、左右各 8px；在快捷片「今天」的另一侧，不重叠 */
.date-clear{position:relative;display:table;margin:0 0 0 auto;font-size:14px;line-height:20px;color:var(--ui-primary)}
.date-clear::after{content:'';position:absolute;left:-16rpx;right:-16rpx;top:-12px;bottom:-12px}
.seven-help{margin-top:12rpx}

/* 首次拜访补充：不再套底色小卡，用细线和留白分组 */
.first-visit-section{margin-top:24rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
.first-visit-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.first-visit-heading .muted{margin-top:4rpx}
.first-visit-heading>text{flex-shrink:0;height:20px;padding:0 12rpx;border-radius:4px;color:var(--ui-warning);background:var(--ui-warning-soft);font-size:var(--ui-text-small);line-height:20px}
.first-visit-field{margin-top:24rpx}
/* 联系人角色目录失败（整条可点重试）：浅红底横条，上下 13px 撑到 44px */
.first-visit-field .error{margin-bottom:8px;padding:13px 12px;border-radius:var(--ui-radius-control);background:var(--ui-danger-soft);font-size:var(--ui-text-small);line-height:1.5}

/* 协同人 */
.collaborator-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:96rpx;margin-top:24rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
.collaborator-row .field-label{margin-bottom:4rpx}
/* 协同人多选：t-checkbox 圆形勾在左、整行可点；左右各伸出 32rpx，让勾选框与分隔线和卡片内容对齐（TDesign 行内边距 32rpx） */
.colleague-group{display:block;--td-checkbox-bg-color:transparent}
.colleagues{max-height:480rpx;margin:8rpx -32rpx 0;width:auto}
.colleague-empty{padding:16rpx 32rpx}

/* 按钮（归档成功页和弹层内） */
.v-button{display:flex;justify-content:center;align-items:center;box-sizing:border-box;min-height:var(--ui-touch-target);margin:0;padding:0 24rpx;border-radius:var(--ui-radius-control);font-size:var(--ui-text-body);font-weight:600;line-height:1.4}
.v-button::after{border:0}
.primary{flex:1;background:var(--ui-primary);color:var(--ui-on-primary)}
.secondary{border:1px solid var(--ui-line);background:var(--ui-surface);color:var(--ui-ink)}
.v-button.is-disabled{background:var(--ui-background);color:var(--ui-muted)}
.v-button[disabled]{background:var(--ui-background)!important;color:var(--ui-muted)!important;border-color:var(--ui-line)!important}

/* 归档成功 */
.success-card{padding:32rpx}
.success-extra{text-align:left}
.success-ai{display:flex;justify-content:center;margin-top:8rpx}
.metrics{display:flex;margin:24rpx 0;padding:24rpx 0;border-top:1px solid var(--ui-line);border-bottom:1px solid var(--ui-line);text-align:center}
.metric-cell{flex:1;border-right:1px solid var(--ui-line)}
.metrics .metric-cell:last-child{border-right:0}
.metric-number{display:block;font-size:20px;font-weight:600;line-height:1.3;color:var(--ui-ink)}
.metric-label{display:block;margin-top:8rpx;font-size:var(--ui-text-small);color:var(--ui-secondary)}
.success-next .body-text{margin-top:8rpx}
.success-actions{display:flex;flex-direction:column;gap:16rpx;margin-top:32rpx}
.success-actions .v-button{width:100%;flex:none;justify-content:space-between}
.v-button.primary .t-icon,.v-button.secondary .t-icon{flex:0 0 auto}
.success-card .notice{margin-top:16rpx}

/* 选择关联商机弹层（sb-sheet）：t-cell 一行一个，勾在右；行左右与弹层标题对齐 */
.opportunity-results{--td-cell-horizontal-padding:0;--td-cell-right-icon-color:var(--ui-primary);--td-cell-border-color:var(--ui-line)}
.opportunity-sheet-hint{padding:24rpx 0;color:var(--ui-secondary);font-size:14px;line-height:1.6}
/* 「加载更多」：常规字重（盖掉 app.wxss 给原生 button 的 700） */
.opportunity-more{display:flex;align-items:center;justify-content:center;width:100%;min-height:var(--ui-touch-target);margin:16px 0;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface);color:var(--ui-primary);font-size:14px;font-weight:400}
.opportunity-more::after{border:0}

/* 本次拜访待办建议弹层（sb-sheet）：固定头放说明、AI 标识和下滑关闭手势 */
.advice-header{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding-bottom:8rpx}
.advice-header>.muted{flex:1;min-width:0}
.sheet-status{padding:24rpx 0;color:var(--ui-secondary);font-size:14px;line-height:1.6}
.sheet-status .v-button{margin-top:16rpx}
.advice-summary{margin-bottom:16rpx;font-size:14px;line-height:1.6;color:var(--ui-secondary)}
.advice-item{padding:24rpx 0;border-top:1px solid var(--ui-line)}
.advice-title{margin-bottom:8rpx;font-weight:600}
.advice-action{margin:12rpx 0 0;font-size:14px;line-height:1.6;color:var(--ui-ink)}
