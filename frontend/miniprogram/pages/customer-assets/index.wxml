<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view class="actual-page actual-refresh">
  <view wx:if="{{customerId && !originCustomerId}}" class="actual-breadcrumb" bindtap="backToCustomers">‹ 返回客户汇总</view>
  <view class="actual-heading"><view><view class="actual-eyebrow">{{opportunityId ? '商机经营详情' : customerId ? '客户实绩' : '经营总览'}}</view><view class="actual-title">{{opportunity ? opportunity.name : (customerName || '客户资产明细')}}</view><text class="actual-subtitle">{{opportunityId ? '查看商机概览、关联待办、跟进和进展' : customerId ? '查看确收、回款及来源' : '按客户查看已登记的经营成果'}}</text></view><view class="actual-info" bindtap="help" aria-label="实绩口径说明">i</view></view>
  <view wx:if="{{opportunityId && opportunity && (isFde || canCreateDemoHere)}}" class="fde-quick-actions">
    <block>
      <button wx:if="{{isFde && canRecordThisOpportunity}}" size="mini" class="fde-quick-action" bindtap="recordFdeVisit" aria-label="录入拜访">
        <view class="fde-quick-heading"><view class="fde-quick-icon fde-quick-icon-record" aria-hidden="true"><view></view></view><text class="fde-quick-title">录入拜访</text><text class="fde-quick-arrow">›</text></view>
        <text class="fde-quick-description">记录沟通与下一步计划</text>
      </button>
      <button wx:if="{{canCreateDemoHere}}" size="mini" class="fde-quick-action" bindtap="openDemoScenes" aria-label="创建 Demo 场景">
        <view class="fde-quick-heading"><view class="fde-quick-icon fde-quick-icon-demo" aria-hidden="true"><view></view></view><text class="fde-quick-title">创建 Demo</text><text class="fde-quick-arrow">›</text></view>
        <text class="fde-quick-description">添加商机演示场景</text>
      </button>
    </block>
    <text wx:if="{{!canRecordThisOpportunity && !canCreateDemoHere}}" class="fde-quick-readonly">当前商机仅可查看</text>
  </view>

  <view wx:if="{{opportunityId}}" class="op-detail-tabs {{isFde ? 'fde-detail-tabs' : ''}}"><view wx:for="{{opportunityTabs}}" wx:key="key" class="op-detail-tab {{opportunityTab===item.key?'selected':''}}" data-tab="{{item.key}}" bindtap="selectOpportunityTab">{{item.label}}</view></view>
  <view wx:if="{{opportunityId && opportunity && opportunityTab!=='demo' && !detailSummary.loaded}}" class="detail-summary-state"><text class="detail-summary-copy">{{detailSummary.loading ? '经营汇总加载中，其他资料可继续查看' : detailSummary.error ? '经营汇总暂不可用，已加载资料不受影响' : '经营汇总按需加载'}}</text><button class="detail-summary-button" wx:if="{{!detailSummary.loading}}" bindtap="retryOpportunitySummary">{{detailSummary.error ? '重试汇总' : '查看汇总'}}</button></view>
  <view wx:if="{{opportunityId && opportunityTab!=='overview' && opportunityLoading}}" class="op-detail-empty">正在加载商机经营信息…</view>
  <view wx:if="{{opportunityId && opportunityTab!=='overview' && opportunityError}}" class="op-detail-empty" bindtap="loadOpportunity">{{opportunityError}} · 点击重试</view>
  <view wx:if="{{canOpportunityAdvice && opportunityId && opportunity && !opportunityLoading && !opportunityError && opportunityTab!=='demo'}}" class="op-advice">
    <view class="op-advice-head"><view><text class="op-agent-mark">AI</text><text>{{isFde ? 'FDE 专业智能体建议' : '销售专家智能体建议'}}</text></view><text class="op-advice-refresh" bindtap="loadOpportunityAdvice">{{opportunityAdvice[opportunityTab].checking?'检查中':opportunityAdvice[opportunityTab].status==='loading'?'准备中':'检查更新'}}</text></view>
    <view class="op-advice-scope">{{opportunity.name}} · {{opportunityTab==='overview'?'商机概览':opportunityTab==='tasks'?'待办事项':opportunityTab==='visits'?'跟进记录':'商机进展'}}</view>
    <view wx:if="{{opportunityAdvice[opportunityTab].status==='loading'}}" class="op-advice-message">建议正在后台准备，下方资料可直接查看</view>
    <view wx:elif="{{opportunityAdvice[opportunityTab].status==='error'}}" class="op-advice-message">{{opportunityAdvice[opportunityTab].error}}</view>
    <block wx:elif="{{opportunityAdvice[opportunityTab].status==='ready'}}">
      <view class="op-advice-summary {{!adviceExpanded[opportunityTab]?'op-advice-compact':''}}">{{opportunityAdvice[opportunityTab].summary}}</view>
      <view wx:if="{{opportunityAdvice[opportunityTab].checking || opportunityAdvice[opportunityTab].checkError}}" class="op-advice-message">{{opportunityAdvice[opportunityTab].checkError || '正在核对资料变化，暂显示上次建议'}}</view>
      <view class="op-advice-toggle" bindtap="toggleAdvice">{{adviceExpanded[opportunityTab]?'收起建议':'查看完整建议'}} {{adviceExpanded[opportunityTab]?'⌃':'⌄'}}</view>
      <block wx:if="{{adviceExpanded[opportunityTab]}}"><view wx:for="{{opportunityAdvice[opportunityTab].rows}}" wx:key="index" class="op-advice-row"><text>{{index+1}}. {{item.title}}</text><label>{{item.detail}}</label><advice-actions wx:if="{{!opportunityAdvice[opportunityTab].checking && !opportunityAdvice[opportunityTab].needsCheck}}" analysis-id="{{opportunityAdvice[opportunityTab].id}}" suggestion="{{item}}" bind:changed="loadOpportunityAdvice" /></view></block>
      <view class="op-advice-source">基于当前商机关联资料生成 · 建议供参考{{opportunityAdvice[opportunityTab].updatedAt?' · '+opportunityAdvice[opportunityTab].updatedAt:''}}</view>
    </block>
    <view wx:else class="op-advice-message" bindtap="loadOpportunityAdvice">点击生成当前商机建议</view>
  </view>
  <view wx:if="{{canReadDemo && opportunity && !opportunityLoading && !opportunityError && opportunityTab==='demo'}}" class="linked-demos">
    <view class="linked-demo-heading"><view><text class="linked-demo-title">Demo 场景</text><text class="linked-demo-count">{{demoTotal}} 个场景</text></view><text class="linked-demo-badge">已登记</text></view>
    <view class="linked-demo-note">场景关联当前商机，登记人和修改记录可追溯。</view>
    <view wx:if="{{demoError}}" class="op-detail-empty" bindtap="loadDemoScenes">{{demoError}} · 点击重试</view>
    <view wx:elif="{{!demos.length}}" class="op-detail-empty"><text>还没有 Demo 场景</text><label>从上方“创建 Demo”添加该商机的演示场景</label></view>
    <view wx:if="{{demosLoading}}" class="op-detail-empty">正在读取场景…</view>
    <button wx:if="{{demosMore && !demosLoading}}" class="fde-own-more" bindtap="moreDemoScenes">加载更多场景</button>
    <view wx:for="{{demos}}" wx:key="id" class="linked-demo-card linked-demo-compact" data-id="{{item.id}}" bindtap="viewDemoScene" aria-label="查看 {{item.name}}">
      <text class="linked-demo-number">{{index+1}}</text><text class="linked-demo-name">{{item.name}}</text><text class="linked-demo-chevron">›</text>
    </view>
  </view>
  <block wx:if="{{canOpportunityAdvice && opportunityId && opportunity && !opportunityLoading && !opportunityError && opportunityTab==='tasks'}}">
    <view class="op-task-stats"><view><text>{{taskStats.total}}</text><label>全部事项</label></view><view><text class="traffic-text-green">{{taskStats.completed}}</text><label>已完成</label></view><view><text class="traffic-text-yellow">{{taskStats.pending}}</text><label>未完成</label></view></view>
    <view wx:for="{{relatedTasks}}" wx:key="id" class="op-related-card" data-id="{{item.id}}" bindtap="openRelatedTask"><view class="op-related-head"><text>{{item.title}}</text><label class="traffic-badge traffic-{{item.signal.tone}}">{{item.signal.label}} · {{item.statusLabel}}</label></view><view class="op-related-copy">{{item.description || '暂无任务说明'}}</view><view class="op-related-meta">{{item.assigneeName}} · {{item.timelineAt}}</view><view class="op-related-link">查看任务 ›</view></view>
    <detail-pagination empty-text="" state="{{detailPages.tasks}}" data-section="tasks" bind:more="moreOpportunitySection" bind:retry="retryOpportunitySection" />
    <view wx:if="{{detailPages.tasks.loaded && !detailPages.tasks.loading && !detailPages.tasks.error && !relatedTasks.length}}" class="op-detail-empty"><text>当前商机暂无已关联待办</text><label>仅展示明确关联此商机的任务</label></view>
  </block>
  <block wx:if="{{canOpportunityAdvice && opportunityId && opportunity && !opportunityLoading && !opportunityError && opportunityTab==='visits'}}">
    <view wx:if="{{isFde}}" class="fde-visit-segment"><button class="fde-visit-option {{fdeVisitMode==='self'?'selected':''}}" data-mode="self" bindtap="changeFdeVisitMode">我的拜访记录</button><button class="fde-visit-option {{fdeVisitMode==='all'?'selected':''}}" data-mode="all" bindtap="changeFdeVisitMode">全部跟进</button></view>
    <block wx:if="{{isFde && fdeVisitMode==='self'}}">
      <view class="op-section-caption">{{fdeOwnTotal}} 条本人填写并确认归档的记录 · 新老客户均计入</view>
      <view wx:for="{{fdeOwnVisits}}" wx:key="id" class="op-related-card" data-id="{{item.id}}" bindtap="openFdeOwnVisit"><view class="op-related-head"><text>{{item.dateLabel}}</text><label>{{item.recorder_name}}</label></view><view class="op-related-copy">{{item.opportunity_name}}</view><view class="op-related-link">{{item.can_read_detail?'查看我的记录 ›':'本人归档摘要'}}</view></view>
      <view wx:if="{{fdeOwnLoading}}" class="op-detail-empty">正在读取本人归档记录…</view><view wx:elif="{{fdeOwnError}}" class="op-detail-empty" bindtap="retryFdeOwnVisits">{{fdeOwnError}} · 点击重试</view><button wx:elif="{{fdeOwnMore}}" class="fde-own-more" bindtap="moreFdeOwnVisits">加载更多</button><view wx:elif="{{!fdeOwnVisits.length}}" class="op-detail-empty">你还没有在这条商机下确认归档拜访记录</view>
    </block>
    <block wx:else>
    <view class="op-section-caption">{{relatedVisitCount}} 条已关联跟进记录 · 最新录入在前</view>
    <view wx:for="{{relatedVisits}}" wx:key="id" class="op-related-card" data-id="{{item.id}}" bindtap="openRelatedVisit"><view class="op-related-head"><text>录入 {{item.recordedAt}}</text><label class="traffic-badge traffic-{{item.signal.tone}}">{{item.signal.badgeText}}</label></view><view class="op-related-meta">拜访 {{item.date}} · {{item.owner}}</view><view class="op-related-copy">{{item.followUpRecord}}</view><view class="op-next-action"><label>下一步行动</label><text>{{item.nextAction}}</text></view><view class="op-related-link">查看跟进 ›</view></view>
    <detail-pagination empty-text="" state="{{detailPages.visits}}" data-section="visits" bind:more="moreOpportunitySection" bind:retry="retryOpportunitySection" />
    <view wx:if="{{detailPages.visits.loaded && !detailPages.visits.loading && !detailPages.visits.error && !relatedVisits.length}}" class="op-detail-empty"><text>当前商机暂无已关联跟进</text><label>未关联商机的客户跟进不会计入</label></view>
    </block>
  </block>
  <block wx:if="{{canOpportunityAdvice && opportunityId && opportunity && !opportunityLoading && !opportunityError && opportunityTab==='opportunity'}}">
    <view class="op-related-card"><view class="op-related-head"><text>当前商机阶段</text><label class="traffic-badge traffic-{{opportunity.signal.tone}}">{{opportunity.signal.label}} · {{opportunity.statusLabel}}</label></view><view class="op-progress-stage">{{opportunity.stageText}}</view><view class="op-progress-track"><view style="width:{{opportunity.probability || 0}}%"></view></view><view class="op-related-copy">{{opportunity.signal.reason}}</view><view class="op-related-meta">预计签约 {{opportunity.expectedDate}}</view></view>
    <view class="op-related-card"><view class="op-events-head"><text class="op-events-title">已记录动态</text><button size="mini" class="op-events-toggle" bindtap="toggleProgressEvents" aria-expanded="{{progressEventsExpanded}}" aria-label="{{progressEventsExpanded ? '收起已记录动态' : '展开已记录动态'}}">{{progressEventsExpanded ? '收起 ⌃' : '展开全部 ⌄'}}</button></view><view class="op-events-order">{{progressEventsExpanded ? '按时间倒序' : '最新 3 条动态'}}</view><block wx:for="{{progressEvents}}" wx:key="key"><view wx:if="{{progressEventsExpanded || index < 3}}" class="op-event" data-key="{{item.key}}" bindtap="openProgressEvent"><view class="op-event-dot"></view><view><text>{{item.title}}</text><label>{{item.date}}</label><view>{{item.detail}}</view></view></view></block><detail-pagination wx:if="{{progressEventsExpanded || progressEvents.length < 3}}" empty-text="" state="{{detailPages.timeline}}" data-section="timeline" bind:more="moreOpportunitySection" bind:retry="retryOpportunitySection" /><view wx:if="{{detailPages.timeline.loaded && !detailPages.timeline.error && !progressEvents.length}}" class="op-detail-empty"><text>暂无已记录动态</text><label>不根据当前阶段推测历史推进过程</label></view></view>
  </block>
  <block wx:if="{{!opportunityId || opportunityTab==='overview'}}">
  <view wx:if="{{opportunityId}}" class="opportunity-view surface">
    <view wx:if="{{opportunityLoading}}" class="opportunity-view-state">正在加载商机信息…</view>
    <view wx:elif="{{opportunityError}}" class="opportunity-view-state error" bindtap="loadOpportunity">{{opportunityError}}</view>
    <block wx:elif="{{opportunity}}">
      <view class="opportunity-view-head"><view><text>商机完整信息</text><label>{{opportunity.customerName}}</label></view><view class="opportunity-head-tags"><text class="opportunity-grade grade-{{opportunity.grade.code}}">商机等级 {{opportunity.grade ? opportunity.grade.code : '未分级'}}</text><text class="opportunity-status traffic-badge traffic-{{opportunity.signal.tone}}">{{opportunity.signal.label}} · {{opportunity.statusLabel}}</text></view></view>
      <view class="opportunity-view-grid">
        <view><text>商机名称</text><label>{{opportunity.name}}</label></view>
        <view><text>商机阶段</text><label>{{opportunity.stageText}}</label></view>
        <view><text>阶段概率</text><label>{{opportunity.probability}}%</label></view>
        <view><text>ACV（商机金额）</text><label>{{opportunity.amount}}</label></view>
        <view><text>预计签约</text><label>{{opportunity.expectedDate}}</label></view>
        <view><text>关联伙伴</text><label>{{opportunity.associatedPartnersText}}</label></view><view><text>转售伙伴</text><label>{{opportunity.resalePartnerText}}</label></view><view><text>签单方式</text><label>{{opportunity.signingMethodText}}</label></view>
        <view><text>产品线</text><label>{{opportunity.product_line || '未填写'}}</label></view>
        <view><text>负责人</text><label>{{opportunity.ownerLabel}}</label></view>
        <view wx:if="{{opportunity.originalOwnerName}}"><text>原商机负责人</text><label>{{opportunity.originalOwnerName}}</label></view>
        <view wx:if="{{opportunity.ownershipResolutionText}}"><text>当前归属状态</text><label>{{opportunity.ownershipResolutionText}}</label></view>
        <view><text>所属团队</text><label>{{opportunity.teamLabel}}</label></view>
        <view><text>创建时间</text><label>{{opportunity.createdLabel}}</label></view>
        <view><text>更新时间</text><label>{{opportunity.updatedLabel}}</label></view>
      </view>
      <fde-picker hide-optional="{{true}}" title="协助 FDE" selected="{{fdeMembers}}" restrict-to-teams="{{fdeRestrictToTeams}}" allowed-team-ids="{{fdeAllowedTeamIds}}" disabled="{{!canManageFdeRelation || canManageFde === false || fdeRelationSaving}}" bind:change="fdeMembersChanged"/>
      <view wx:if="{{fdeRelationDirty && canManageFdeRelation}}" class="fde-note"><button loading="{{fdeRelationSaving}}" disabled="{{fdeRelationSaving}}" bindtap="saveFdeMembers">保存协助名单</button></view><view wx:if="{{fdeRelationError}}" class="fde-note">{{fdeRelationError}}</view>
      <view class="opportunity-quarter-title">季度预测</view>
      <view wx:if="{{opportunity.quarterDetails.length}}" class="opportunity-quarter-list"><view wx:for="{{opportunity.quarterDetails}}" wx:key="label"><text>{{item.label}}</text><label>含税确收 {{item.recognized}} · 回款 {{item.collection}}<text wx:if="{{item.collectionConfidenceText}}"> · 回款信心度 {{item.collectionConfidenceText}}</text></label></view></view>
      <view wx:else class="opportunity-quarter-empty">未填写季度预测</view>
      <view wx:if="{{opportunity.historicalPeriodRecords.length}}" class="historical-period-records">
        <view class="opportunity-quarter-title">历史季度原始记录</view>
        <view class="opportunity-quarter-empty">保留历史填报值，未计入季度实绩或预测</view>
        <view class="opportunity-quarter-list"><view wx:for="{{opportunity.historicalPeriodRecords}}" wx:key="key"><text>{{item.period}} {{item.kindText}}</text><label>{{item.amountText}} · {{item.taxBasisText}}<text wx:if="{{item.sourceFieldText}}"> · 来源：{{item.sourceFieldText}}</text></label></view></view>
      </view>
      <view class="quarter-actual-section">
        <view class="quarter-actual-head"><text>季度实绩</text><picker wx:if="{{quarterActualOptions.length}}" range="{{quarterActualOptions}}" range-key="label" value="{{quarterActualIndex}}" bindchange="changeActualQuarter"><view>{{quarterActualOptions[quarterActualIndex].label}} ▾</view></picker></view>
        <view wx:if="{{quarterActualLoading}}" class="quarter-actual-note">正在汇总季度实绩…</view>
        <view wx:elif="{{quarterActualError}}" class="quarter-actual-error">{{quarterActualError}}<text bindtap="loadQuarterActuals">重新加载</text></view>
        <block wx:else>
          <view class="quarter-actual-metrics"><view><label>季度累计回款</label><text>{{quarterCollection}}</text></view><view><label>季度累计确收</label><text>{{quarterRecognized}}</text></view></view>
          <view class="quarter-actual-note">{{quarterEntryCount}} 条已确认记录 · 按发生日期归属季度，截至 {{quarterActualAsOf}}</view>
        </block>
      </view>
      <view class="opportunity-readonly-note">商业资料只读；协助名单由有权人员单独维护</view>
    </block>
  </view>
  <view class="actual-summary">
    <view class="actual-summary-top"><view class="actual-kind"><view class="actual-kind-option {{kind==='recognized'?'active':''}}" data-kind="recognized" bindtap="changeKind">确收</view><view class="actual-kind-option {{kind==='collection'?'active':''}}" data-kind="collection" bindtap="changeKind">回款</view></view><view class="actual-period"><view class="actual-period-option {{period==='year'?'active':''}}" data-period="year" bindtap="changePeriod">本年</view><view class="actual-period-option {{period==='all'?'active':''}}" data-period="all" bindtap="changePeriod">历年累计</view></view></view>
    <view class="actual-total-label">{{period==='year'?'本年':'历年累计'}}{{kind==='recognized'?'确收':'回款'}}</view>
    <view class="actual-total">{{loading && !items.length ? '…' : totalText}}<text class="actual-unit">万元</text></view>
    <view class="actual-summary-caption">{{summary.entry_count || 0}} 条记录 · 截至 {{asOf}}</view>
    <view wx:if="{{summary.first_date && period==='all'}}" class="actual-first-date">当前可用记录始于 {{summary.first_date}}</view>
  </view>
  <view wx:if="{{!readOnly && customerId}}" class="actual-context"><view class="actual-context-link" bindtap="openProfile">客户档案 ›</view><view wx:if="{{opportunityId}}" class="actual-context-link" bindtap="showAllOpportunities">查看客户全部实绩</view><view wx:if="{{canManage && basis==='entries'}}" class="actual-add" bindtap="openForm">＋ 登记{{kind==='recognized'?'确收':'回款'}}</view></view>
  <block wx:if="{{!readOnly}}">
  <view class="actual-list-label">{{customerId ? '实绩明细' : '贡献客户'}}<text class="actual-list-unit">{{customerId && opportunityId ? '当前商机' : '按已登记记录统计'}}</text></view>
  <view wx:if="{{error}}" class="actual-empty"><text class="actual-empty-title">数据加载失败</text><text class="actual-empty-copy">{{error}}</text><button class="actual-retry" bindtap="retry">重试</button></view>
  <view wx:elif="{{!loading && !items.length}}" class="actual-empty"><view class="actual-empty-icon">—</view><text class="actual-empty-title">暂无{{kind==='recognized'?'确收':'回款'}}记录</text><text class="actual-empty-copy">{{customerId && canManage ? '确认已有实绩后，可从上方登记。' : '已确认的经营实绩会显示在这里。'}}</text></view>
  <block wx:elif="{{!customerId}}"><view wx:for="{{items}}" wx:key="customer_id" class="actual-customer" data-id="{{item.customer_id}}" bindtap="openCustomer"><view class="actual-customer-identity"><view class="actual-customer-mark">{{item.customerInitial}}</view><view class="actual-customer-main"><view class="actual-customer-top"><view class="actual-customer-name">{{item.customer_name}}</view><view class="actual-customer-arrow">›</view></view><view class="actual-customer-meta">{{item.team_name || '未分组'}} · {{item.owner_name || '待分配'}}</view></view></view><view class="actual-customer-bottom"><text class="actual-customer-amount">{{item.totalText}}<text class="actual-small-unit">万元</text></text><text class="actual-customer-count">{{item.entry_count}} 条记录</text></view></view></block>
  <block wx:else><view wx:for="{{items}}" wx:key="id" class="actual-entry"><view class="actual-entry-top"><text class="actual-entry-date">{{item.period_label || item.occurred_on}}</text><text class="actual-entry-amount">{{item.amountText}}<text class="actual-small-unit">万元</text></text></view><view class="actual-entry-opportunity {{item.opportunity_id?'linked':''}}" data-id="{{item.opportunity_id}}" bindtap="openProfile">{{item.opportunity_name || '暂未关联商机'}}{{item.opportunity_id?' ›':''}}</view><view class="actual-source"><text class="actual-source-label">{{basis==='historical'?'原始字段':'来源编号'}}</text><text class="actual-source-value">{{item.source_ref}}</text></view><view wx:if="{{item.note}}" class="actual-entry-note">{{item.note}}</view><view class="actual-entry-footer"><text class="actual-confirmer">{{basis==='historical' ? item.taxBasisText : (item.confirmed_by || '管理人员') + ' 已确认'}}</text><view wx:if="{{canVoidActual && item.can_void && !readOnly && basis==='entries'}}" class="actual-void" data-id="{{item.id}}" bindtap="voidEntry">作废</view></view></view></block>
  <view wx:if="{{loading}}" class="actual-loading">正在加载…</view><view wx:elif="{{hasMore}}" class="actual-more" bindtap="more">加载更多</view>
  </block>
  <view wx:if="{{formOpen}}" class="actual-form-layer" catchtouchmove="stop"><view class="actual-form-mask" bindtap="closeForm"></view><view class="actual-form-sheet"><view class="actual-form-header"><view class="actual-form-title">登记{{kind==='recognized'?'确收':'回款'}}</view><view class="actual-form-close" bindtap="closeForm">×</view></view><scroll-view class="actual-form-scroll" scroll-y><view class="actual-form-body"><view class="actual-form-customer">{{customerName}}</view><text class="actual-field-label">关联商机 <text class="actual-optional">选填</text></text><view class="actual-selected-opportunity">已选：{{formOpportunity.name}}</view><input class="actual-form-input" placeholder="搜索商机名称" value="{{formQuery}}" bindinput="searchFormOpportunity" disabled="{{saving}}" /><scroll-view class="actual-opportunity-options" scroll-y><view class="actual-opportunity-option {{!formOpportunity.id?'selected':''}}" data-id="" bindtap="selectFormOpportunity"><text>暂不关联商机</text><label>{{!formOpportunity.id?'✓':''}}</label></view><view wx:for="{{formChoices}}" wx:key="id" class="actual-opportunity-option {{formOpportunity.id===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="selectFormOpportunity"><text>{{item.name}}</text><label>{{formOpportunity.id===item.id?'✓':''}}</label></view><detail-pagination state="{{formChoiceState}}" bind:more="moreFormChoices" bind:retry="retryFormChoices" /></scroll-view><view wx:if="{{formTargetLoading}}" class="actual-form-hint">正在确认原关联商机…</view><text class="actual-field-label">金额（万元）</text><input class="actual-form-input" disabled="{{saving}}" type="digit" placeholder="请输入已确认金额" value="{{amount}}" data-field="amount" bindinput="input" /><text class="actual-field-label">{{kind==='recognized'?'确收':'回款'}}日期</text><picker mode="date" value="{{occurredOn}}" start="1900-01-01" end="{{asOf}}" bindchange="pickDate"><view class="actual-form-input actual-select">{{occurredOn}} <text>⌄</text></view></picker><text class="actual-field-label">{{basis==='historical'?'原始字段':'来源编号'}}</text><input class="actual-form-input" disabled="{{saving}}" placeholder="如：财务台账2026-09·第12行" maxlength="160" value="{{sourceRef}}" data-field="sourceRef" bindinput="input" /><text class="actual-field-label">备注 <text class="actual-optional">选填</text></text><textarea class="actual-form-note" disabled="{{saving}}" placeholder="补充来源或本次登记的说明" maxlength="1000" value="{{note}}" data-field="note" bindinput="input" /><view wx:if="{{formError}}" class="actual-form-error">{{formError}}</view><text class="actual-form-hint">确认后计入客户资产；录错可作废后重新登记。</text></view></scroll-view><view class="actual-form-actions"><button class="actual-form-cancel" bindtap="closeForm" disabled="{{saving}}">取消</button><button class="actual-form-submit {{saving ? 'is-saving' : ''}}" bindtap="submit" loading="{{saving}}" disabled="{{saving || formTargetLoading || formSelectionRequired}}">确认登记</button></view></view></view>
  </block>
</view>

</block>
