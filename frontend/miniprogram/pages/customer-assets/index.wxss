/* 按下态：行与卡片压灰底，按钮与文字链接降透明度 */
.row-pressed{background:var(--ui-neutral-soft)!important}
.is-pressed{opacity:.7}
.actual-page{padding:28rpx 26rpx calc(48rpx + constant(safe-area-inset-bottom));padding:28rpx 26rpx calc(48rpx + env(safe-area-inset-bottom));color:var(--ui-ink)}
.actual-breadcrumb{display:inline-flex;align-items:center;min-height:var(--ui-touch-target);font-size:14px;color:var(--ui-primary)}
.actual-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;margin:4rpx 0 26rpx}
.actual-title{font-size:18px;font-weight:600;line-height:1.45;overflow-wrap:anywhere}
.actual-subtitle{display:block;margin-top:8rpx;font-size:var(--ui-text-small);color:var(--ui-secondary)}
.actual-info{width:88rpx;height:var(--ui-touch-target);flex-shrink:0;display:flex;align-items:center;justify-content:center;margin:-16rpx -16rpx 0 0;color:var(--ui-secondary)}
.actual-summary{padding:32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.actual-summary-top{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
.actual-total{font-size:var(--ui-text-metric);color:var(--ui-ink);font-weight:600;margin:32rpx 0 12rpx;line-height:1.2;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.actual-unit{font-size:var(--ui-text-small);font-weight:400;color:var(--ui-secondary);margin-left:12rpx}
.actual-summary-caption,.actual-first-date{color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.7}
.actual-first-date{font-size:var(--ui-text-small);color:var(--ui-muted)}
.actual-context{display:flex;align-items:center;gap:24rpx;padding:20rpx 4rpx;flex-wrap:wrap}
.actual-context-link{display:flex;align-items:center;min-height:var(--ui-touch-target);font-size:14px;color:var(--ui-primary)}
.actual-add{margin-left:auto;padding:0 28rpx;height:var(--ui-touch-target);display:flex;align-items:center;border-radius:var(--ui-radius-control);background:var(--ui-primary);color:var(--ui-on-primary);font-size:14px;font-weight:600}
.actual-list-label{margin:28rpx 3rpx 18rpx;display:flex;justify-content:space-between;align-items:center;font-size:14px;font-weight:600}
.actual-list-unit{font-size:var(--ui-text-small);font-weight:400;color:var(--ui-secondary)}
.actual-customer,.actual-entry{padding:28rpx 32rpx;background:var(--ui-surface);border-radius:var(--ui-radius-panel);margin-bottom:var(--ui-space-2)}
.actual-customer-top{display:flex;align-items:flex-start;justify-content:space-between;gap:22rpx}
.actual-customer-name{font-size:var(--ui-text-body);font-weight:600;line-height:1.5}
.actual-customer-arrow{display:inline-flex;color:var(--ui-muted)}
.actual-customer-meta{font-size:var(--ui-text-small);color:var(--ui-secondary);margin-top:8rpx}
.actual-customer-bottom{display:flex;align-items:baseline;justify-content:space-between;gap:20rpx;margin-top:16rpx}
.actual-customer-amount,.actual-entry-amount{color:var(--ui-ink);font-size:20px;font-weight:600}
.actual-small-unit{font-size:var(--ui-text-small);font-weight:400;color:var(--ui-secondary);margin-left:8rpx}
.actual-customer-count{font-size:var(--ui-text-small);color:var(--ui-secondary)}
.actual-entry-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.actual-entry-date{font-size:var(--ui-text-small);color:var(--ui-secondary)}
.actual-entry-opportunity{display:flex;align-items:center;min-height:var(--ui-touch-target);margin:0;color:var(--ui-secondary);font-size:14px;line-height:1.6}
.actual-entry-opportunity.linked{color:var(--ui-primary)}
.actual-source{display:flex;gap:16rpx;align-items:flex-start;font-size:var(--ui-text-small);line-height:1.6}
.actual-source-label{flex-shrink:0;color:var(--ui-secondary)}
.actual-source-value{color:var(--ui-ink);word-break:break-all}
.actual-entry-note{color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.7;margin-top:15rpx}
.actual-entry-footer{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx;font-size:var(--ui-text-small)}
.actual-confirmer{color:var(--ui-secondary)}
.actual-void{display:flex;align-items:center;min-height:var(--ui-touch-target);margin:-20rpx 0;padding:0 8rpx;color:var(--ui-secondary)}
.actual-empty{padding:0}
.actual-loading{text-align:center;padding:27rpx;font-size:var(--ui-text-small);color:var(--ui-secondary)}
/* 登记实绩（sb-sheet 正文）：飞书表单，标签在上、下方控件；外壳、标题、按钮交给 sb-sheet */
.actual-form-body{padding-bottom:16rpx}
.actual-field-label{display:block;color:var(--ui-ink);font-size:14px;margin:16rpx 0;font-weight:400}
.actual-opportunity-options{--td-cell-right-icon-color:var(--ui-primary);--td-cell-vertical-padding:24rpx;margin:16rpx calc(-1 * var(--ui-page-gutter)) 8rpx;border-top:1px solid var(--ui-line);border-bottom:1px solid var(--ui-line)}
.actual-form-error{color:var(--ui-danger);font-size:14px;line-height:1.6;margin-top:16rpx}
.actual-form-hint{display:block;font-size:var(--ui-text-small);color:var(--ui-secondary);line-height:1.6;margin-top:20rpx}
.quarter-actual-section{margin-top:32rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
.quarter-actual-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx;font-size:var(--ui-text-body);font-weight:600;color:var(--ui-ink)}
.quarter-actual-metrics{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:23rpx}
.quarter-actual-metrics label{display:block;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.quarter-actual-metrics text{display:block;margin-top:8rpx;color:var(--ui-ink);font-size:20px;font-weight:600;word-break:break-all}
.quarter-actual-note{margin-top:18rpx;font-size:var(--ui-text-small);line-height:1.6;color:var(--ui-secondary)}
.quarter-actual-error{margin-top:18rpx;color:var(--ui-danger);font-size:var(--ui-text-small);line-height:1.6}
.quarter-actual-select{display:block;flex:0 0 auto;width:240rpx;font-weight:400}
/* 季度实绩的季度片：季度必有一个值，是查看哪一季、不是筛选，任何季度都按灰底正文色显示（不画「已筛选」蓝底）。
   本页只有这一个 sb-labeled-select，选择器只写组件内部类、不跨组件边界；类名写两遍提高优先级，压过组件自己的选中样式 */
.sb-lselect.sb-lselect.small.on{background:var(--ui-neutral-soft)}
.sb-lselect.sb-lselect.small.on .sb-lselect-text{color:var(--ui-ink);font-weight:400}
.quarter-actual-retry{display:flex;align-items:center;min-height:var(--ui-touch-target);color:var(--ui-primary);font-size:14px}
.op-detail-tabs{margin-bottom:24rpx}
.op-advice{padding:32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface);margin-bottom:24rpx;box-shadow:inset 0 3px 0 var(--ui-primary)} /* 顶部 3px 主色条：卡片始终带「AI 建议，仅供参考」 */
.op-advice-head,.op-advice-head>view{display:flex;align-items:center;gap:12rpx}
.op-advice-head>view{flex-wrap:wrap;min-width:0}
.op-advice-head{justify-content:space-between;font-size:var(--ui-text-body);font-weight:600;color:var(--ui-ink)}
.op-advice-refresh{flex-shrink:0;display:flex;align-items:center;min-height:var(--ui-touch-target);margin:-20rpx 0;font-size:14px;color:var(--ui-primary);font-weight:400}
.op-advice-scope,.op-advice-source{margin-top:12rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.op-advice-summary,.op-advice-message{margin-top:16rpx;color:var(--ui-ink);font-size:14px;line-height:1.6;white-space:pre-wrap}
.op-advice-row{margin-top:18rpx;padding-top:18rpx;border-top:1px solid var(--ui-line)}
.op-advice-row>text{display:block;font-size:14px;font-weight:600;color:var(--ui-ink);line-height:1.6}
.op-advice-row>label{display:block;font-size:14px;line-height:1.6;color:var(--ui-secondary);margin-top:8rpx;white-space:pre-wrap}
.op-task-stats{display:flex;padding:28rpx 12rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface);margin-bottom:24rpx}
.op-task-stats>view{flex:1;text-align:center}
.op-task-stats text{display:block;font-size:20px;font-weight:600}
.op-task-stats label{display:block;margin-top:7rpx;font-size:var(--ui-text-small);color:var(--ui-secondary)}
.op-task-stats>view+view{border-left:1px solid var(--ui-line)}
.op-related-card{padding:28rpx 32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface);margin-bottom:16rpx}
.op-related-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}
.op-related-head>text{font-size:var(--ui-text-body);font-weight:600;line-height:1.5;color:var(--ui-ink)}
.op-related-head>label{font-size:var(--ui-text-small);flex-shrink:0;color:var(--ui-secondary)}
.op-related-copy{font-size:14px;line-height:1.6;color:var(--ui-secondary);margin-top:12rpx;white-space:pre-wrap}
.op-related-meta{font-size:var(--ui-text-small);color:var(--ui-secondary);line-height:1.6;margin-top:12rpx}
.op-related-link{display:flex;align-items:center;justify-content:flex-end;font-size:14px;color:var(--ui-primary);margin-top:12rpx}
.op-next-action{margin-top:16rpx;padding-top:16rpx;border-top:1px solid var(--ui-line)}
.op-next-action>label{display:block;font-size:var(--ui-text-small);color:var(--ui-secondary)}
.op-next-action>text{display:block;margin-top:8rpx;font-size:14px;line-height:1.6;color:var(--ui-ink)}
.op-section-caption{font-size:var(--ui-text-small);color:var(--ui-secondary);margin:12rpx 0 16rpx}
.op-detail-empty{padding:48rpx 24rpx;text-align:center;color:var(--ui-secondary);background:var(--ui-surface);border-radius:var(--ui-radius-panel);margin-bottom:16rpx;font-size:14px;line-height:1.6}
.op-detail-empty>text{display:block;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.op-detail-empty>label{display:block;margin-top:10rpx;color:var(--ui-muted);font-size:var(--ui-text-small)}
.op-progress-stage{margin-top:20rpx;font-size:var(--ui-text-body);color:var(--ui-ink);font-weight:600}
.op-progress-track{height:8rpx;background:var(--ui-background);border-radius:999px;overflow:hidden;margin-top:16rpx}
.op-progress-track>view{height:100%;border-radius:999px;background:var(--ui-primary)}
.op-event{display:flex;gap:18rpx;padding-top:24rpx}
.op-event-dot{width:12rpx;height:12rpx;background:var(--ui-primary);border-radius:50%;margin-top:10rpx;flex-shrink:0}
.op-event>view:last-child{flex:1;border-bottom:1px solid var(--ui-line);padding-bottom:20rpx}
.op-event text{display:block;color:var(--ui-ink);font-size:14px;font-weight:600}
.op-event label{display:block;color:var(--ui-muted);font-size:var(--ui-text-small);margin-top:6rpx}
.op-event>view>view{color:var(--ui-secondary);font-size:14px;line-height:1.6;margin-top:8rpx;white-space:pre-wrap}
.op-events-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.op-events-title{font-size:var(--ui-text-body);font-weight:600;color:var(--ui-ink)}
.op-events-head .op-events-toggle{display:flex;align-items:center;gap:4rpx;width:auto;min-height:var(--ui-touch-target);margin:-16rpx 0;padding:0 8rpx;font-size:14px;font-weight:400;line-height:1.4;color:var(--ui-primary);background:transparent;border:0;border-radius:var(--ui-radius-control)}
/* FDE opportunity actions: equal-width, quiet cards with full-card touch targets. */
.fde-quick-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--ui-space-2);margin:22rpx 0}
.fde-quick-actions .fde-quick-action{display:block;box-sizing:border-box;width:100%;min-width:0;max-width:100%;margin:0;padding:24rpx;border:0;border-radius:var(--ui-radius-panel);background:var(--ui-surface);text-align:left;line-height:1.4;white-space:normal}
.fde-quick-action::after{border:0}
.fde-quick-heading{display:flex;align-items:center;justify-content:space-between;gap:10rpx}
.fde-quick-title{flex:1;font-size:var(--ui-text-body);font-weight:600;color:var(--ui-ink)}
.fde-quick-arrow{display:inline-flex;color:var(--ui-muted)}
.fde-quick-description{display:block;margin-top:8rpx;font-size:var(--ui-text-small);font-weight:400;color:var(--ui-secondary);line-height:1.5}
.fde-quick-readonly{grid-column:1/-1;padding:20rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.linked-demos{margin-bottom:24rpx;}
.linked-demo-heading{display:flex;align-items:center;justify-content:space-between;margin:26rpx 0 10rpx;}
.linked-demo-title{font-size:var(--ui-text-body);font-weight:600;color:var(--ui-ink);}
.linked-demo-count{font-size:var(--ui-text-small);color:var(--ui-secondary);margin-left:14rpx;}
.linked-demo-badge{height:20px;font-size:var(--ui-text-small);line-height:20px;color:var(--ui-neutral);background:var(--ui-neutral-soft);padding:0 var(--ui-space-2);border-radius:4px;}
.linked-demo-note{font-size:var(--ui-text-small);color:var(--ui-secondary);margin-bottom:22rpx;line-height:1.6;}
.linked-demo-card{padding:24rpx 32rpx;background:var(--ui-surface);border-radius:var(--ui-radius-panel);margin-bottom:16rpx;}
.linked-demo-number{flex-shrink:0;height:20px;background:var(--ui-neutral-soft);color:var(--ui-neutral);border-radius:4px;padding:0 var(--ui-space-2);font-size:var(--ui-text-small);line-height:20px;font-weight:600;}
.linked-demo-name{font-size:var(--ui-text-body);font-weight:600;line-height:1.5;color:var(--ui-ink);overflow-wrap:break-word;min-width:0;}
.linked-demo-compact{display:flex;align-items:center;gap:16rpx;}
.linked-demo-compact .linked-demo-name{flex:1;}
.linked-demo-chevron{display:inline-flex;color:var(--ui-muted);flex-shrink:0;}
.fde-quick-icon{display:inline-flex;flex-shrink:0;color:var(--ui-primary);}
.op-advice-compact{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.op-advice-toggle{display:flex;align-items:center;gap:4rpx;min-height:var(--ui-touch-target);font-size:14px;color:var(--ui-primary)}
.op-advice-message.op-advice-generate{display:flex;align-items:center;min-height:var(--ui-touch-target);margin:0 0 -16rpx;color:var(--ui-primary)} /* 点击生成：文字链接，点按区 44px */
.fde-visit-segment{margin-bottom:16rpx}
/* 保存协助名单：原来是原生 button 套在浅蓝提示条里，只有中间 23px 能点、字重 700。改成 t-button 主按钮（有未保存改动时才出现）、撑满一行，高 44px（窄屏不缩）。
   不用描边样式：t-button 的描边画在内部原生 button 的 ::after 上，app.wxss 的 button::after{border:0} 会把它清掉，截图里只剩一行蓝字；
   实底主按钮不依赖描边，保存中（loading + disabled）走桥接的禁用态：中性浅灰底、弱化字 */
.fde-save-row{margin:16rpx 0 8rpx;--td-button-medium-height:44px}
