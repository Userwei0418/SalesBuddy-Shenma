/* FDE opportunity actions: equal-width, quiet cards with full-card touch targets. */
.fde-quick-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:22rpx 0}
.fde-quick-actions .fde-quick-action{display:block;box-sizing:border-box;width:100%;min-width:0;max-width:100%;margin:0;padding:22rpx 20rpx;border:1rpx solid #2b6088;border-radius:20rpx;background:linear-gradient(125deg,#193e60,#245f8b);box-shadow:0 6rpx 16rpx #193e601c;text-align:left;line-height:1.4;white-space:normal}
.fde-quick-action::after{border:0}
.fde-quick-action:active{background:#193e60}
.fde-quick-heading{display:flex;align-items:center;justify-content:space-between;gap:10rpx}
.fde-quick-title{flex:1;font-size:25rpx;font-weight:700;color:#fff}
.fde-quick-arrow{font-size:30rpx;font-weight:400;line-height:1;color:#b6d5ed}
.fde-quick-description{display:block;margin-top:9rpx;font-size:19rpx;font-weight:400;color:#bed3e5;line-height:1.5}
.fde-quick-readonly{grid-column:1/-1;padding:20rpx;color:#8a9bac;font-size:22rpx}

