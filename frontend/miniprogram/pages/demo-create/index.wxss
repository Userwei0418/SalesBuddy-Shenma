page{background:var(--ui-background)}

.demo-overlay{position:fixed;inset:0;z-index:900;background:var(--ui-overlay);display:flex;align-items:flex-end}

.demo-page{min-height:100vh}
.demo-sheet{width:100%;height:100vh;display:flex;flex-direction:column;overflow:hidden;background:var(--ui-background)}

/* 页头：白底标题，不用深色横幅 */
.demo-head{flex-shrink:0;display:flex;justify-content:space-between;align-items:flex-start;gap:16rpx;padding:32rpx;border-bottom:1px solid var(--ui-line);background:var(--ui-surface);color:var(--ui-ink)}
.demo-title{color:var(--ui-ink);font-size:20px;font-weight:600;line-height:1.4}
.demo-context{margin-top:8rpx;color:var(--ui-secondary);font-size:14px;line-height:1.5}

.demo-head .demo-back{flex-shrink:0;margin:4rpx 0 0;padding:8rpx 16rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface);color:var(--ui-ink);line-height:1.5;font-size:14px}

.demo-scroll{flex:1;height:0;padding:32rpx;box-sizing:border-box}

/* 场景卡：白卡放在灰底上，不描边，里面只有控件 */
.demo-scene{padding:32rpx;margin-bottom:24rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}

.demo-scene-head,.demo-scene-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.demo-scene-head{align-items:flex-start}

.demo-scene-number{display:flex;align-items:center;justify-content:center;flex:0 0 48rpx;height:48rpx;border-radius:50%;background:var(--ui-neutral-soft);color:var(--ui-neutral);font-size:var(--ui-text-small);font-weight:600}

.demo-scene-title{display:block;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.demo-scene-caption{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}

/* 删除场景：t-icon close，点击区域 44px */
.demo-remove{padding:0;color:var(--ui-secondary);background:transparent;font-size:var(--ui-text-small)}
.demo-scene-head .demo-remove{display:flex;align-items:center;justify-content:center;flex:0 0 var(--ui-touch-target);width:var(--ui-touch-target);min-width:0;height:var(--ui-touch-target);margin:-20rpx -24rpx 0 0;padding:0;border:0;border-radius:var(--ui-radius-control);background:transparent;color:var(--ui-secondary);line-height:1}
.demo-remove::after{border:0}
.demo-scene-head .demo-remove-pressed{background:var(--ui-neutral-soft)}

.demo-label{margin:32rpx 0 16rpx;color:var(--ui-ink);font-size:14px;font-weight:400}

/* 场景名称 sb-input、场景描述 sb-textarea：飞书表单，标签在上、带框控件（stacked plain） */
.demo-field{display:block;margin-top:16rpx}

/* 语音录入：次按钮样式 */
.demo-scroll .demo-voice{display:flex;align-items:center;justify-content:space-between;gap:16rpx;width:100%;margin:16rpx 0 0;padding:20rpx 24rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface);text-align:left;line-height:1.5}
.demo-voice::after{border:0}
.demo-voice-copy{flex:1;min-width:0}
.demo-voice-title{display:block;color:var(--ui-ink);font-size:14px;font-weight:600}
.demo-voice-caption{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);font-weight:400}
.demo-voice-action{flex-shrink:0;color:var(--ui-primary);font-size:14px;font-weight:600}
.demo-scroll .demo-voice-active{border-color:var(--ui-primary);background:var(--ui-selected)}

.demo-mic{position:relative;flex-shrink:0;width:32rpx;height:42rpx;color:var(--ui-primary)}
.demo-mic-capsule{position:absolute;left:10rpx;top:1rpx;width:12rpx;height:23rpx;border-radius:999px;background:currentColor}
.demo-mic-cradle{position:absolute;left:4rpx;top:13rpx;width:24rpx;height:19rpx;box-sizing:border-box;border:3rpx solid currentColor;border-top:0;border-radius:0 0 999px 999px}
.demo-mic::before{content:"";position:absolute;left:14rpx;top:31rpx;width:3rpx;height:8rpx;background:currentColor}
.demo-mic::after{content:"";position:absolute;left:8rpx;bottom:1rpx;width:16rpx;height:3rpx;border-radius:1px;background:currentColor}

.demo-scroll .demo-add{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;max-width:100%;height:var(--ui-touch-target);margin:0;padding:0;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface);color:var(--ui-primary);font-size:14px;font-weight:600;line-height:var(--ui-touch-target)}
.demo-add::after{border:0}

.demo-note,.demo-error{padding:16rpx 8rpx 24rpx;color:var(--ui-muted);font-size:var(--ui-text-small);line-height:1.6;text-align:center}
.demo-error{color:var(--ui-danger)}


.demo-access{padding:64rpx 32rpx;color:var(--ui-secondary);font-size:14px;text-align:center}

/* 底部操作条用 sb-bottom-bar（固定定位），滚动区留出高度 */
.demo-detail-page{height:100vh;display:flex;flex-direction:column;overflow:hidden}
.demo-detail-page>.demo-head{flex-shrink:0}
.demo-detail-scroll{flex:1;min-height:0;height:0;padding:32rpx;box-sizing:border-box}
.demo-scroll.with-bottom-bar,.demo-detail-scroll.with-bottom-bar{padding-bottom:calc(240rpx + constant(safe-area-inset-bottom));padding-bottom:calc(240rpx + env(safe-area-inset-bottom))}
.demo-detail-copy{display:block;color:var(--ui-ink);font-size:14px;line-height:1.8;white-space:pre-wrap;word-break:break-all}
.demo-detail-meta{margin-top:32rpx;padding-top:24rpx;border-top:1px solid var(--ui-line);color:var(--ui-secondary);font-size:var(--ui-text-small)}
.demo-detail-page .demo-scene .demo-label{margin-top:0}
