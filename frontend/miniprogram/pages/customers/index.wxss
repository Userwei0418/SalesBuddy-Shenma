@import "../../styles/opportunity-edit-entry.wxss";
@import "../../styles/role-controls.wxss";
@import "../../styles/detail-summary.wxss";
@import "./battle-map.wxss";
@import "./filter-bar.wxss";
@import "./opportunity-actual-link.wxss";
.fde-member-filter{--member-trigger-height:32px;--member-trigger-width:100px;flex:0 0 auto;width:100px;height:32px;min-width:0} /* 和同一行的筛选片同宽同高（px，见 filter-bar.wxss） */
/* 按下态：行与卡片压灰底，按钮与文字链接降透明度 */
.row-pressed{background:var(--ui-neutral-soft)!important}
.is-pressed{opacity:.7}
.customer-page{padding-bottom:60rpx}
/* 页头：页面底色上直接放标题，主操作在右 */
.asset-page-heading{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin:8rpx 0 24rpx}
.asset-page-title{color:var(--ui-ink);font-size:var(--ui-text-page);font-weight:600;line-height:1.3}
.asset-page-sub{display:block;margin-top:8rpx;color:var(--ui-secondary);font-size:14px;line-height:1.4}
.map-claim-entry{flex:0 0 auto;display:flex;align-items:center;justify-content:center;box-sizing:border-box;height:var(--ui-touch-target);padding:0 32rpx;border-radius:var(--ui-radius-control);background:var(--ui-primary);color:var(--ui-on-primary);font-size:14px;font-weight:600}
/* 客户资产：白卡，三个指标靠留白和一条竖线分开 */
.asset-overview{padding:32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface);color:var(--ui-ink)}
.asset-overview-head{display:flex;align-items:center;justify-content:space-between;gap:24rpx}
.asset-title-row{display:flex;align-items:center;gap:16rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.asset-period{flex:0 0 auto;width:120px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))} /* 固定 120px（375 宽即 240rpx），320 宽屏「历年累计」不被挤出 */
.asset-period-seg{grid-column:1 / -1}
.asset-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:32rpx}
.asset-metric{min-width:0}
.asset-metric+.asset-metric{padding-left:24rpx;border-left:1px solid var(--ui-line)}
.asset-metric-label{display:flex;align-items:center;gap:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.asset-metric-arrow{display:inline-flex;color:var(--ui-primary)}
.asset-number{margin-top:8rpx;color:var(--ui-ink);font-size:20px;font-weight:600;line-height:1.3;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.asset-number>text{margin-left:6rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);font-weight:400}
.asset-acv-note{margin-top:24rpx;padding-top:16rpx;border-top:1px solid var(--ui-line);color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.asset-overview .asset-retry{display:flex;align-items:center;min-height:var(--ui-touch-target);margin:-14rpx 0 -26rpx;color:var(--ui-danger);font-size:var(--ui-text-small);line-height:1.5} /* 文字 18px，点按区撑到 44px，负外边距抵掉多出的高度 */
.map-toolbar+.asset-acv-note{display:flex;align-items:center;min-height:var(--ui-touch-target);margin:-16rpx 0 0;padding-top:0;border-top:0;color:var(--ui-danger)} /* 目录加载失败，点击重试：点按区 44px */
/* 搜索与筛选 */
.map-toolbar{--td-search-bg-color:var(--ui-surface);margin:24rpx 0 16rpx}
.operating-filters{margin-bottom:24rpx}
.map-load-error{margin:0 0 24rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.map-load-error .sb-state{min-height:0;padding:32rpx}
.map-active-summary{margin:0 0 16rpx;color:var(--ui-secondary);font-size:14px;line-height:1.5}
.map-pending-note{margin:-4rpx 0 16rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
/* 客户列表：一行名字，一行事实，状态只给需要看的客户 */
.asset-list-heading{display:flex;justify-content:space-between;align-items:baseline;margin:48rpx 0 16rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.asset-list-count{color:var(--ui-secondary);font-size:var(--ui-text-small);font-weight:400}
.customer-list{display:flex;flex-direction:column;gap:var(--ui-space-2)}
.customer-card{padding:28rpx 32rpx}
.customer-top{display:flex;align-items:center;gap:24rpx}
.logo{flex:0 0 auto;width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:var(--ui-radius-control);background:var(--ui-neutral-soft);color:var(--ui-primary);font-size:var(--ui-text-body);font-weight:600}
.customer-main{flex:1;min-width:0}
.name-row{display:flex;align-items:center;gap:12rpx;min-width:0}
.name{min-width:0;overflow:hidden;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.level{flex:0 0 auto;height:20px;padding:0 var(--ui-space-2);border-radius:4px;background:var(--ui-neutral-soft);color:var(--ui-neutral);font-size:var(--ui-text-small);line-height:20px}
.meta{margin-top:8rpx;overflow:hidden;color:var(--ui-secondary);font-size:var(--ui-text-small);text-overflow:ellipsis;white-space:nowrap}
.arrow{flex:0 0 auto;display:inline-flex;color:var(--ui-muted)}
.customer-tags{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:16rpx;padding-left:96rpx}
.customer-facts{min-width:0;flex:0 1 auto;overflow:hidden;color:var(--ui-secondary);font-size:14px;text-overflow:ellipsis;white-space:nowrap}
.customer-tags .risk{flex:0 1 auto;min-width:0;max-width:55%;overflow:hidden}
.customer-tags .risk .sb-tag{max-width:100%;overflow:hidden;text-overflow:ellipsis;box-sizing:border-box}
.last{margin-top:8rpx;padding-left:96rpx;color:var(--ui-muted);font-size:var(--ui-text-small)}
.customer-card .fde-tags{display:flex;flex-wrap:wrap;align-items:center;gap:8rpx;margin-top:12rpx;padding-left:96rpx}
.customer-card .fde-tags>text{height:20px;padding:0 var(--ui-space-2);border-radius:4px;background:var(--ui-selected);color:var(--ui-primary);font-size:var(--ui-text-small);line-height:20px}
.empty{padding:8rpx 0}
/* 页内客户经营详情 */
.detail-overlay{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0;background:var(--ui-background)}
.detail-nav{height:var(--ui-touch-target);display:grid;grid-template-columns:80rpx 1fr 80rpx;align-items:center;padding:0 16rpx;border-bottom:1px solid var(--ui-line);background:var(--ui-surface);color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;text-align:center}
.detail-back{width:88rpx;height:var(--ui-touch-target);display:flex;align-items:center;color:var(--ui-ink);font-weight:400;text-align:left}
.detail-nav-space{width:80rpx}
.detail-scroll{height:calc(100vh - var(--ui-touch-target))} /* 和 .detail-nav 同步，导航栏 44px 加滚动区正好一屏 */
.detail-body{padding:24rpx 28rpx calc(50rpx + constant(safe-area-inset-bottom));padding:24rpx 28rpx calc(50rpx + env(safe-area-inset-bottom))}
.detail-hero{padding:32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface);color:var(--ui-ink)}
/* 顶部 3px 色条：只在状态异常时画，颜色和卡内状态标签一致（红＝转差，黄＝需关注）；正常、待评估不画 */
.detail-hero.is-bad{box-shadow:inset 0 3px 0 var(--ui-danger-accent)}
.detail-hero.is-watch{box-shadow:inset 0 3px 0 var(--ui-warning-accent)}
.detail-sync{display:flex;align-items:center;gap:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.detail-sync text{width:12rpx;height:12rpx;border-radius:50%;background:var(--ui-success)}
.detail-identity{display:flex;align-items:center;gap:24rpx;margin-top:24rpx}
.detail-logo{flex:0 0 auto;width:96rpx;height:96rpx;display:flex;align-items:center;justify-content:center;border-radius:var(--ui-radius-control);background:var(--ui-neutral-soft);color:var(--ui-primary);font-size:20px;font-weight:600}
.detail-name{color:var(--ui-ink);font-size:20px;font-weight:600;line-height:1.3}
.detail-identity>view:last-child>text{display:block;margin-top:8rpx;color:var(--ui-secondary);font-size:14px}
.detail-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}
.detail-tags>text{height:20px;padding:0 var(--ui-space-2);border-radius:4px;background:var(--ui-neutral-soft);color:var(--ui-neutral);font-size:var(--ui-text-small);line-height:20px}
.detail-owner{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8rpx 16rpx;margin-top:24rpx;padding-top:16rpx;border-top:1px solid var(--ui-line);color:var(--ui-secondary);font-size:var(--ui-text-small)}
/* 「更新于 日期」整段不折行；一行放不下时整段换到下一行，左边「团队 · 负责人」不再被挤成一两个字的尾巴 */
.detail-owner>text:last-child{flex:0 0 auto;white-space:nowrap}
.detail-score{margin-top:24rpx;padding:32rpx}
.detail-section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.detail-section-head>view:first-child>text{display:block;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.detail-section-head>view:first-child>label{display:block;margin-top:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.detail-section-head>view:last-child{flex:0 0 auto;height:20px;padding:0 var(--ui-space-2);border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);line-height:20px}
.detail-score-row{margin-top:24rpx}
.detail-score-row>view:first-child{display:flex;justify-content:space-between;color:var(--ui-secondary);font-size:14px}
.detail-score-row label{color:var(--ui-ink);font-size:14px;font-weight:600}
.detail-track{height:8rpx;margin-top:12rpx;overflow:hidden;border-radius:999px;background:var(--ui-background)}
.detail-track>text{display:block;height:100%;border-radius:999px;background:var(--ui-primary)}
.detail-evidence{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:12rpx}
.detail-evidence>text{height:20px;padding:0 var(--ui-space-2);border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);line-height:20px}
.detail-rule{margin-top:24rpx;padding-top:16rpx;border-top:1px solid var(--ui-line);color:var(--ui-muted);font-size:var(--ui-text-small);line-height:1.5}
.detail-tabs{margin-top:32rpx}
.detail-metrics{display:grid;grid-template-columns:repeat(3,1fr);margin-top:24rpx;padding:28rpx 8rpx}
.detail-metrics>view{display:flex;flex-direction:column;align-items:center;border-right:1px solid var(--ui-line)}
.detail-metrics>view:last-child{border:0}
.detail-metrics text{color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.detail-metrics label{margin-top:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.detail-ai{margin-top:24rpx;padding:32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.detail-ai-head{display:flex;align-items:center;gap:12rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.detail-ai-copy{margin-top:16rpx;color:var(--ui-ink);font-size:14px;line-height:1.6}
.detail-ai-action{display:flex;align-items:center;justify-content:space-between;min-height:var(--ui-touch-target);margin-top:16rpx;border-top:1px solid var(--ui-line);color:var(--ui-primary);font-size:14px;font-weight:600}
.detail-title{display:flex;align-items:baseline;justify-content:space-between;margin:48rpx 0 16rpx}
.detail-title>text{color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.detail-title label{color:var(--ui-secondary);font-size:var(--ui-text-small)}
.detail-opportunity{padding:32rpx}
.detail-opportunity-top,.detail-opportunity-meta{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.detail-opportunity-top>view{min-width:0}
.detail-opportunity-top>view>text{display:block;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.detail-opportunity-top>view>label{display:inline-block;height:20px;margin-top:8rpx;padding:0 var(--ui-space-2);border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);line-height:20px}
.detail-opportunity-top>text{flex:0 0 auto;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.detail-opportunity .detail-track{margin-top:24rpx}
.detail-opportunity-meta{margin-top:12rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.detail-contacts{padding:0 32rpx}
.detail-contact{display:flex;align-items:center;gap:16rpx;padding:24rpx 0;border-bottom:1px solid var(--ui-line)}
.detail-contact:last-child{border:0}
.detail-contact-logo{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:var(--ui-radius-control);color:var(--ui-primary);background:var(--ui-neutral-soft);font-size:14px;font-weight:600}
.detail-contact>view:nth-child(2){flex:1;min-width:0}
.detail-contact>view:nth-child(2)>text{display:block;color:var(--ui-ink);font-size:14px;font-weight:600}
.detail-contact>view:nth-child(2)>label{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.detail-contact>view:last-child{flex:0 0 auto;height:20px;padding:0 var(--ui-space-2);border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);line-height:20px}
.opportunity-list-card+.opportunity-list-card{margin-top:16rpx}
.detail-visit-order{margin:16rpx 0 0;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.detail-visits{margin-top:16rpx;padding:0 32rpx}
.detail-visit{display:flex;gap:16rpx}
.detail-dot{position:relative;width:16rpx;flex:0 0 auto}
.detail-dot>text{position:absolute;z-index:1;top:32rpx;left:0;width:16rpx;height:16rpx;box-sizing:border-box;border-radius:50%;background:var(--ui-primary)}
.detail-dot::after{content:"";position:absolute;left:7rpx;top:48rpx;bottom:-32rpx;width:1px;background:var(--ui-line)}
.detail-visit:last-child .detail-dot::after{display:none}
.detail-visit-main{flex:1;min-width:0;padding:24rpx 0;border-bottom:1px solid var(--ui-line)}
.detail-visit:last-child .detail-visit-main{border:0}
.detail-visit-head{display:flex;align-items:center;justify-content:space-between}
.detail-visit-head>label{color:var(--ui-secondary);font-size:var(--ui-text-small)}
.detail-visit-arrow{display:inline-flex;color:var(--ui-muted)}
.detail-visit-main>text{display:block;margin-top:8rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.detail-visit-date{margin-top:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.detail-visit-excerpt{margin-top:12rpx;color:var(--ui-secondary);font-size:14px;line-height:1.6;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;word-break:break-word}
.detail-visit-summary{display:flex;align-items:center;justify-content:space-between;margin-top:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.detail-visit-summary>label{color:var(--ui-primary);font-size:var(--ui-text-small)}
.detail-stage-card{margin-top:16rpx;padding:32rpx}
.detail-eyebrow{color:var(--ui-secondary);font-size:var(--ui-text-small);font-weight:600}
.detail-stage-name{margin-top:8rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.detail-pipeline{display:flex;margin-top:32rpx}
.detail-pipeline>view{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;color:var(--ui-muted);font-size:var(--ui-text-small)}
.detail-pipeline>view::after{content:"";position:absolute;left:50%;right:-50%;top:8rpx;height:2rpx;background:var(--ui-line)}
.detail-pipeline>view:last-child::after{display:none}
.detail-pipeline>view>text{z-index:1;width:18rpx;height:18rpx;box-sizing:border-box;border:1px solid var(--ui-line);border-radius:50%;background:var(--ui-surface)}
.detail-pipeline label{margin-top:8rpx;text-align:center}
.detail-pipeline .done>text,.detail-pipeline .current>text{border-color:var(--ui-primary);background:var(--ui-primary)}
.detail-pipeline .done::after{background:var(--ui-primary)}
.detail-pipeline .current label{color:var(--ui-primary);font-weight:600}
.detail-rows{margin-top:24rpx;border-top:1px solid var(--ui-line)}
.detail-rows>view{display:flex;justify-content:space-between;gap:24rpx;padding:16rpx 0;border-bottom:1px solid var(--ui-line);font-size:14px}
.detail-rows text{flex:0 0 auto;color:var(--ui-secondary)}
.detail-rows label{color:var(--ui-ink);text-align:right}
.detail-stage-card .detail-rows+.detail-rows{margin-top:0;border-top:0}
.detail-stage-card.opportunity-focused{box-shadow:inset 0 0 0 1px var(--ui-primary)}
/* 当前风险：白卡，颜色只落在左侧小标记上 */
.detail-risk-card{display:flex;gap:16rpx;margin-top:24rpx;padding:28rpx 32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.detail-risk-card>view:first-child{width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:50%;color:var(--ui-secondary);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);font-weight:600}
.detail-risk-card.risk-tone-green>view:first-child{color:var(--ui-success);background:var(--ui-success-soft)}
.detail-risk-card.risk-tone-yellow>view:first-child{color:var(--ui-warning);background:var(--ui-warning-soft)}
.detail-risk-card.risk-tone-red>view:first-child{color:var(--ui-danger);background:var(--ui-danger-soft)}
.detail-risk-card>view:last-child{min-width:0;flex:1}
.detail-risk-card>view:last-child>text{display:block;color:var(--ui-ink);font-size:14px;font-weight:600}
.detail-risk-card>view:last-child>label{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:14px;line-height:1.5}
/* 客户待办：状态时间轴与商机穿透 */
.customer-task-scope-note{margin:16rpx 0;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.customer-tasks-panel{margin-top:16rpx}
.customer-task-summary{display:flex;padding:28rpx 8rpx}
.customer-task-summary>view{flex:1;text-align:center;border-right:1px solid var(--ui-line)}
.customer-task-summary>view:last-child{border-right:0}
.customer-task-summary text{display:block;color:var(--ui-ink);font-size:20px;font-weight:600}
.customer-task-summary label{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.customer-task-timeline{margin-top:16rpx;padding:0 32rpx}
.customer-task-item{display:flex;gap:16rpx}
.customer-task-rail{position:relative;width:40rpx;flex:0 0 40rpx}
.customer-task-rail::after{content:"";position:absolute;left:19rpx;top:64rpx;bottom:-24rpx;width:1px;background:var(--ui-line)}
.customer-task-item:last-child .customer-task-rail::after{display:none}
.customer-task-rail>view{position:relative;z-index:1;width:40rpx;height:40rpx;margin-top:24rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:var(--ui-on-primary);background:var(--ui-primary)}
.customer-task-rail>view>text{display:flex;width:40rpx;height:40rpx;align-items:center;justify-content:center;color:var(--ui-on-primary);font-size:var(--ui-text-small);font-weight:600;line-height:1;text-align:center}
.task-pending .customer-task-rail>view>text,.task-cancelled .customer-task-rail>view>text,.task-overdue .customer-task-rail>view>text{font-size:0}
.task-pending .customer-task-rail>view::before,.task-pending .customer-task-rail>view::after,.task-cancelled .customer-task-rail>view::before,.task-cancelled .customer-task-rail>view::after,.task-overdue .customer-task-rail>view::before,.task-overdue .customer-task-rail>view::after{content:"";position:absolute;left:50%;top:50%;width:16rpx;height:3rpx;border-radius:999px;background:var(--ui-surface);transform:translate(-50%,-50%) rotate(45deg)}
.task-pending .customer-task-rail>view::after,.task-cancelled .customer-task-rail>view::after,.task-overdue .customer-task-rail>view::after{transform:translate(-50%,-50%) rotate(-45deg)}
.task-completed .customer-task-rail>view{background:var(--ui-success)}
.task-cancelled .customer-task-rail>view,.task-overdue .customer-task-rail>view{background:var(--ui-danger)}
.task-pending .customer-task-rail>view{background:var(--ui-primary)}
.customer-task-card{flex:1;min-width:0;padding:24rpx 0;border-bottom:1px solid var(--ui-line)}
.customer-task-item:last-child .customer-task-card{border-bottom:0}
.customer-task-meta{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.customer-task-meta>text{color:var(--ui-secondary);font-size:var(--ui-text-small)}
.customer-task-meta>label{height:20px;padding:0 var(--ui-space-2);border-radius:4px;color:var(--ui-primary);background:var(--ui-selected);font-size:var(--ui-text-small);line-height:20px}
.task-completed .customer-task-meta>label{color:var(--ui-success);background:var(--ui-success-soft)}
.task-cancelled .customer-task-meta>label,.task-overdue .customer-task-meta>label{color:var(--ui-danger);background:var(--ui-danger-soft)}
.customer-task-title{margin-top:12rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;line-height:1.4}
.customer-task-description{display:-webkit-box;overflow:hidden;margin-top:8rpx;color:var(--ui-secondary);font-size:14px;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.customer-task-owner{display:flex;align-items:center;justify-content:space-between;margin-top:12rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.customer-task-owner>label{display:inline-flex;align-items:center;color:var(--ui-primary)}
.customer-task-opportunity{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:var(--ui-touch-target);margin-top:12rpx;border-top:1px solid var(--ui-line);font-size:var(--ui-text-small)}
.customer-task-opportunity>text{flex:0 0 auto;color:var(--ui-secondary)}
.customer-task-opportunity-link{display:flex;align-items:center;min-width:0;max-width:68%;color:var(--ui-primary)}
.customer-task-opportunity-link>label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.customer-task-empty{margin-top:16rpx;padding:48rpx 32rpx;text-align:center}
.customer-task-empty>view{width:64rpx;height:64rpx;margin:0 auto;display:flex;align-items:center;justify-content:center;border-radius:50%;color:var(--ui-success);background:var(--ui-success-soft);font-size:var(--ui-text-body);font-weight:600}
.customer-task-empty>text{display:block;margin-top:16rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.customer-task-empty>label{display:block;margin-top:8rpx;color:var(--ui-secondary);font-size:14px}
.customer-task-empty>button{width:240rpx;height:var(--ui-touch-target);margin:32rpx auto 0;padding:0;border:0;border-radius:var(--ui-radius-control);color:var(--ui-on-primary);background:var(--ui-primary);font-size:14px;font-weight:600;line-height:var(--ui-touch-target)}
.customer-task-empty>button::after{display:none}
/* AI 建议面板：白卡，AI 只用小标识 */
.customer-agent-panel{margin:24rpx 0;padding:32rpx}
.customer-agent-panel.surface{box-shadow:inset 0 3px 0 var(--ui-primary)} /* AI 建议卡顶部 3px 主色条（面板始终带「AI 建议，仅供参考」，且只在非 FDE 下出现）；两个类名压过 .surface 的 box-shadow:none */
.customer-agent-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.customer-agent-head>view{display:flex;flex-wrap:wrap;gap:12rpx;align-items:center;min-width:0}
.customer-agent-head>.customer-agent-refresh{flex-shrink:0;display:flex;align-items:center;min-height:var(--ui-touch-target);margin:-20rpx 0;padding:0 4rpx;color:var(--ui-primary);font-size:14px;font-weight:400}
.customer-agent-state,.customer-agent-summary{margin-top:16rpx;color:var(--ui-secondary);font-size:14px;line-height:1.6;white-space:pre-wrap}
.customer-agent-state.error{color:var(--ui-danger)}
.customer-agent-row{margin-top:16rpx;padding-top:16rpx;border-top:1px solid var(--ui-line)}
.customer-agent-row>text{display:block;color:var(--ui-ink);font-size:14px;font-weight:600}
.customer-agent-row>label{display:block;margin-top:8rpx;color:var(--ui-secondary);font-size:14px;line-height:1.6;white-space:pre-wrap}
.customer-agent-source{margin-top:16rpx;color:var(--ui-muted);font-size:var(--ui-text-small)}
.customer-signal-row{display:flex;align-items:flex-start;gap:12rpx;margin:16rpx 0;flex-wrap:wrap}
.customer-signal-row>.customer-signal{flex-shrink:0;padding:0 var(--ui-space-2);border-radius:4px;font-size:var(--ui-text-small);line-height:20px}
.customer-signal-row>label{flex:1;min-width:180rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.6}
.signal-red{background:var(--ui-danger-soft);color:var(--ui-danger)}
.signal-yellow{background:var(--ui-warning-soft);color:var(--ui-warning)}
.signal-green{background:var(--ui-success-soft);color:var(--ui-success)}
.signal-gray{background:var(--ui-neutral-soft);color:var(--ui-neutral)}
.customer-signal-legend{margin:16rpx 0;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.6}

/* Palette only: original geometry is preserved. */
.asset-overview { background:var(--sb-hero-bg); color:var(--sb-hero-ink); --ui-neutral-soft:var(--sb-hero-control); }
.asset-overview .asset-title-row,.asset-overview .asset-number { color:var(--sb-hero-ink); }
.asset-overview .asset-metric-label,.asset-overview .asset-number>text,.asset-overview .asset-acv-note { color:var(--sb-hero-muted); }
.asset-overview .asset-metric+.asset-metric,.asset-overview .asset-acv-note { border-color:var(--sb-hero-line); }
.asset-overview .asset-metric-arrow { color:var(--sb-hero-link); }
.asset-overview .asset-retry { color:var(--sb-hero-alert); }
.asset-overview .sb-seg-item { color:var(--sb-hero-muted); }
.asset-overview .sb-seg-item.on { color:var(--ui-primary); background:var(--ui-selected); }
.map-toolbar { --ui-line:var(--sb-input-line); }
.customer-page .operating-picker.filter-level.active,.customer-page .map-level-option.selected,.customer-page .operating-filters .sb-lselect.small.on { background:var(--ui-selected); color:var(--ui-primary); }
.customer-page .operating-picker.active .operating-picker-value,.customer-page .operating-picker.active .operating-picker-caret,.customer-page .operating-filters .sb-lselect.small.on .sb-lselect-text,.customer-page .operating-filters .sb-lselect.small.on .sb-lselect-arrow,.customer-page .operating-filters .sb-lselect.small.on .sb-lselect-clear { color:var(--ui-primary); }
.customer-page .operating-filter-reset { color:var(--sb-link-blue); }

.customer-page .operating-filters .sb-lselect.small.on.disabled { color:var(--ui-muted); background:var(--ui-neutral-soft); }
.customer-page .operating-filters .sb-lselect.small.on.disabled .sb-lselect-text,.customer-page .operating-filters .sb-lselect.small.on.disabled .sb-lselect-label,.customer-page .operating-filters .sb-lselect.small.on.disabled .sb-lselect-arrow,.customer-page .operating-filters .sb-lselect.small.on.disabled .sb-lselect-clear { color:var(--ui-muted); }
