/* Customer assets: quiet hierarchy, compact controls and progressive disclosure. */
.asset-page-heading{display:flex;align-items:center;justify-content:space-between;margin:8rpx 2rpx 20rpx}.asset-page-title{font-size:38rpx;font-weight:750;color:#20374d}.asset-page-sub{display:block;font-size:23rpx;color:#77889b;margin-top:8rpx}.map-claim-entry{flex:0 0 auto;padding:12rpx 19rpx;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#1768b5,#1688e8);box-shadow:0 8rpx 20rpx rgba(20,113,197,.2);font-size:20rpx;font-weight:680}.asset-scope-panel{margin-bottom:20rpx;padding:16rpx;border:1rpx solid rgba(255,255,255,.92);border-radius:24rpx;background:linear-gradient(145deg,rgba(255,255,255,.84),rgba(244,249,254,.72));box-shadow:0 9rpx 26rpx rgba(29,61,101,.07);backdrop-filter:blur(22rpx)}.asset-scope-head,.asset-scope-intro,.asset-scope-select{display:flex;align-items:center}.asset-scope-head{justify-content:space-between;gap:16rpx}.asset-scope-intro{min-width:0;gap:12rpx}.asset-scope-icon{width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:14rpx;color:#176fbd;background:linear-gradient(145deg,#e6f3ff,#d8ebfc);font-size:17rpx;font-weight:750}.asset-scope-title,.asset-scope-note{display:block}.asset-scope-title{color:#344b62;font-size:19rpx;font-weight:720}.asset-scope-note{margin-top:2rpx;color:#8b99a9;font-size:14rpx}.asset-scope-count{flex:0 0 auto;padding:6rpx 11rpx;border-radius:999rpx;color:#267356;background:#e8f6ef;font-size:14rpx}.asset-scope-controls{display:grid;grid-template-columns:1fr;margin-top:13rpx}.asset-scope-controls.is-manager{grid-template-columns:repeat(2,minmax(0,1fr));gap:10rpx}.asset-scope-picker{min-width:0}.asset-scope-select{min-height:60rpx;padding:0 14rpx 0 16rpx;border:1rpx solid rgba(82,121,161,.14);border-radius:17rpx;background:rgba(255,255,255,.75);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}.asset-scope-value{min-width:0;flex:1}.asset-scope-label,.asset-scope-selected{display:block}.asset-scope-label{color:#8b99a9;font-size:13rpx}.asset-scope-selected{margin-top:1rpx;overflow:hidden;color:#29475f;font-size:19rpx;font-weight:680;text-overflow:ellipsis;white-space:nowrap}.asset-scope-caret{width:31rpx;height:31rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:10rpx;color:#3976a9;background:#edf5fb;font-size:18rpx}.asset-overview{padding:28rpx 28rpx 20rpx;border-radius:30rpx;color:#fff;background:radial-gradient(ellipse at top right,rgba(68,149,222,.3),transparent 65%),linear-gradient(125deg,#153b61,#1b639d);box-shadow:0 14rpx 36rpx rgba(20,64,104,.12)}.asset-overview-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.asset-title-row{display:flex;align-items:center;gap:10rpx;font-size:27rpx;font-weight:650}.asset-help{width:44rpx;height:44rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#c5ddf0;font-weight:500}.asset-period{width:202rpx;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding:5rpx;background:rgba(0,25,57,.2);border-radius:24rpx}.asset-period>view{min-width:0;padding:9rpx 6rpx;border-radius:19rpx;color:#c8def0;font-size:22rpx;text-align:center;white-space:nowrap}.asset-period>.selected{background:#f6fbff;color:#205583;font-weight:700;box-shadow:0 3rpx 9rpx rgba(0,0,0,.08)}.asset-metrics{display:grid;grid-template-columns:1fr 1fr;margin:28rpx 0 24rpx}.asset-metric{min-width:0}.asset-metric+.asset-metric{padding-left:26rpx;border-left:1rpx solid rgba(221,238,255,.17)}.asset-metric-label{display:flex;align-items:center;gap:16rpx;color:#d5e5f3;font-size:25rpx}.asset-metric-label>text{font-size:28rpx;opacity:.7}.asset-number{margin-top:10rpx;font-size:49rpx;font-weight:750;line-height:1.25;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.asset-number>text{font-size:21rpx;font-weight:400;margin-left:9rpx;color:#c6dcec}.asset-caption{border-top:1rpx solid rgba(225,239,250,.12);padding-top:16rpx;color:#c4d8ea;font-size:21rpx;line-height:1.5}.asset-retry{color:#ffdfb0}.map-toolbar{margin:28rpx 0 14rpx}.map-search{height:80rpx;padding:0 20rpx;display:flex;align-items:center;gap:12rpx;background:#fff;border:1rpx solid #e1eaf3;border-radius:22rpx;min-width:0}.map-search-icon{font-size:36rpx;color:#7891a8}.map-search input{flex:1;min-width:0;font-size:25rpx;color:#263f55}.operating-filters{padding:16rpx 14rpx 15rpx;margin-bottom:22rpx}.operating-picker-row{display:flex;align-items:stretch;gap:8rpx}.operating-picker{flex:1;min-width:0;overflow:hidden;padding:12rpx 8rpx;border:1rpx solid #e7eef5;border-radius:14rpx;background:#f3f7fb}.operating-picker>view{min-width:0}.operating-picker text{display:block;overflow:hidden;color:#304e68;font-size:19rpx;line-height:1.35;white-space:nowrap;text-overflow:ellipsis}.operating-picker .operating-picker-label{margin-bottom:5rpx;color:#8393a3;font-size:16rpx}.operating-quick{display:flex;gap:8rpx;margin-top:14rpx}.operating-quick>view{min-width:0;flex:1;padding:9rpx 5rpx;border-radius:14rpx;background:#f2f5f8;color:#64798c;font-size:19rpx;text-align:center;white-space:nowrap}.operating-quick>.active{background:#deedfc;color:#176bc0;font-weight:650}.operating-filter-footer{display:flex;align-items:center;gap:18rpx;margin-top:14rpx;color:#1c71ba;font-size:20rpx}.operating-filter-footer>text{flex:1;color:#8191a0;font-size:18rpx}.asset-list-heading{display:flex;justify-content:space-between;align-items:center;margin:26rpx 2rpx 19rpx;font-size:29rpx;font-weight:700;color:#29435c}.asset-list-count{font-size:23rpx;color:#7e90a1;font-weight:400}.customer-context-actions,.opportunity-context-actions{display:flex;align-items:center;gap:12rpx;margin:20rpx 0}.customer-context-actions>view{flex:1;padding:19rpx 6rpx;text-align:center;background:#fff;border:1rpx solid #dce8f2;border-radius:18rpx;color:#246da6;font-size:24rpx}.opportunity-context-actions{border-top:1rpx solid #e5edf5;padding-top:16rpx;margin-bottom:0}.opportunity-context-actions>view{flex:1;text-align:center;font-size:23rpx;color:#2674b2;padding:9rpx 0}.opportunity-related{margin-top:20rpx;padding:0 18rpx;background:#f2f7fc;border-radius:18rpx}.related-record{padding:20rpx 0;border-bottom:1rpx solid #dfe9f2}.related-record:last-child{border-bottom:0}.related-record-kind,.related-record-title,.related-record-next{display:block;font-size:22rpx;line-height:1.6;color:#7a8fa3}.related-record-title{color:#28465f;font-size:25rpx;font-weight:650;margin:5rpx 0}.related-record-next{overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.related-empty{padding:22rpx 0;color:#8395a4;font-size:23rpx}.detail-body{padding-bottom:calc(50rpx + env(safe-area-inset-bottom))}

.customer-agent-panel{padding:24rpx;margin:18rpx 0;border:1rpx solid #d9e9f6;background:linear-gradient(135deg,#f2f8ff,#fff)}.customer-agent-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:#2b5274;font-size:25rpx;font-weight:750}.customer-agent-head>view{display:flex;gap:12rpx;align-items:center}.customer-agent-head>text{font-size:21rpx;color:#267cc1;flex-shrink:0}.customer-agent-icon{display:inline-flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:12rpx;background:#2579bd;color:#fff;font-size:21rpx}.customer-agent-state,.customer-agent-summary{margin-top:18rpx;color:#59748d;font-size:24rpx;line-height:1.7;white-space:pre-wrap}.customer-agent-state.error{color:#ad6049}.customer-agent-row{margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #e5edf5}.customer-agent-row>text{display:block;font-size:24rpx;font-weight:700;color:#345773}.customer-agent-row>label{display:block;font-size:23rpx;line-height:1.7;color:#6a8196;margin-top:8rpx;white-space:pre-wrap}.customer-agent-source{font-size:19rpx;color:#8b9fb1;margin-top:18rpx}.customer-signal-row{display:flex;align-items:flex-start;gap:12rpx;margin:16rpx 0;flex-wrap:wrap}.customer-signal-row>.customer-signal{font-size:21rpx;line-height:1.5;padding:4rpx 11rpx;border-radius:9rpx;flex-shrink:0;font-weight:650}.customer-signal-row>label{font-size:21rpx;line-height:1.6;color:#7d91a3;flex:1;min-width:180rpx}.signal-red{background:#ffebe8;color:#bc5149}.signal-yellow{background:#fff4d9;color:#a77722}.signal-green{background:#e4f6ee;color:#238c68}.signal-gray{background:#eef2f5;color:#8091a0}.customer-signal-legend{font-size:20rpx;color:#899cab;line-height:1.6;margin:16rpx 7rpx}

.detail-risk-card.traffic-surface-green>view:first-child{background:#238c68!important}.detail-risk-card.traffic-surface-yellow>view:first-child{background:#a77722!important}

.customer-page .asset-metrics{grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}.customer-page .asset-metric+.asset-metric{padding-left:18rpx}.customer-page .asset-metric-label{font-size:23rpx;gap:8rpx}.customer-page .asset-number{font-size:36rpx;line-height:1.3}.customer-page .asset-number>text{display:block;font-size:18rpx;margin-left:0;margin-top:4rpx}.asset-acv-note{margin-top:20rpx;padding-top:14rpx;border-top:1rpx solid rgba(221,238,255,.16);color:#c3dbee;font-size:18rpx;line-height:1.5}

/* Opportunity progress uses blue; health remains in the status badge. */
.detail-opportunity .detail-track>text{background:linear-gradient(90deg,#1979ca,#40afe5)}

/* Keep collaboration names separate from wrapping customer status tags. */
.customer-card .fde-tags{display:flex;flex-wrap:wrap;align-items:center;gap:8rpx;margin-top:14rpx;clear:both}
.customer-card .fde-tags>text{display:inline-block;box-sizing:border-box;padding:5rpx 10rpx;border-radius:8rpx;background:#eaf3ff;color:#3979ae;font-size:19rpx;line-height:1.4}

.customer-task-scope-note{margin:12rpx 4rpx;color:#7f94a8;font-size:19rpx;line-height:1.5}
.map-active-summary{margin:4rpx 2rpx 18rpx;color:#3b607f;font-size:23rpx;line-height:1.5}
.map-active-summary>text{display:block;margin-top:3rpx;color:#8194a6;font-size:19rpx}
.map-pending-note{margin:-8rpx 2rpx 18rpx;color:#8194a6;font-size:21rpx;line-height:1.5}
.map-load-error{margin:16rpx 0;padding:20rpx;border-radius:16rpx;background:#fff1ed;color:#ba5439;font-size:23rpx}
.asset-overview .asset-retry{margin-top:16rpx;font-size:21rpx;line-height:1.5}
