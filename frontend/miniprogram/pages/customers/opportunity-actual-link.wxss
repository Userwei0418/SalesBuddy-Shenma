/* 卡内次按钮：白底细线、正文色、高 44px（飞书按钮规格） */
.customer-page .opportunity-actual-link {
  display:flex;
  align-items:center;
  justify-content:center;
  height:var(--ui-touch-target);
  margin-top:24rpx;
  border:1px solid var(--ui-line);
  border-radius:var(--ui-radius-control);
  background:var(--ui-surface);
  color:var(--ui-ink);
  font-size:14px;
  font-weight:400;
}

.customer-page .opportunity-actual-link-active {
  background:var(--ui-neutral-soft);
}
