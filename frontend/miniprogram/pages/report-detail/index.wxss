page{background:var(--ui-background)}
.report-page{min-height:100vh;box-sizing:border-box;padding:32rpx 32rpx 64rpx;background:var(--ui-background)}
.report-hero{padding:8rpx 0 0}
.report-name{color:var(--ui-ink);font-size:20px;font-weight:600;line-height:1.4}
.report-meta{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:16rpx}
.report-meta text{padding:0 12rpx;border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);line-height:20px}
/* 飞书：白卡放在灰底上，不描边；卡内分组用分隔线 */
.section-card{margin-top:32rpx;padding:32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.section-kicker{color:var(--ui-ink);font-size:14px;font-weight:600}
.section-description{margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.detail-title{margin-top:24rpx;padding-top:24rpx;border-top:1px solid var(--ui-line);color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;line-height:1.45}
.detail-copy{margin-top:16rpx;color:var(--ui-ink);font-size:14px;line-height:1.8;white-space:pre-wrap}
.recommendation-block{margin-top:32rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
.recommendation-head{display:flex;align-items:center}
.recommendation-title{margin-top:16rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;line-height:1.45}
.recommendation-copy{margin-top:8rpx;color:var(--ui-ink);font-size:14px;line-height:1.7;white-space:pre-wrap}
.source-card{margin-top:24rpx;padding:0 4rpx}
.source-card text,.source-card label{display:block}
.source-card text{color:var(--ui-secondary);font-size:var(--ui-text-small)}
.source-card label{margin-top:4rpx;color:var(--ui-muted);font-size:var(--ui-text-small)}
