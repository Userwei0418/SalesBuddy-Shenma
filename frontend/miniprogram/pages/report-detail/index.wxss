page{background:#eef5fc}.report-page{min-height:100vh;padding:24rpx 28rpx 60rpx;background:linear-gradient(155deg,#fbfdff,#eef6fd 58%,#e9f3fc)}
.report-hero{padding:31rpx 28rpx;border-radius:30rpx;color:#fff;background:radial-gradient(circle at 90% 0,rgba(80,176,237,.75),transparent 40%),linear-gradient(145deg,#143657,#1779d5);box-shadow:0 20rpx 48rpx rgba(24,91,157,.2)}
.eyebrow{color:rgba(255,255,255,.64);font-size:17rpx;font-weight:700;letter-spacing:2.3rpx}.report-name{margin-top:10rpx;font-size:36rpx;font-weight:780}.report-meta{display:flex;gap:12rpx;margin-top:22rpx}.report-meta text{padding:7rpx 12rpx;border:1rpx solid rgba(255,255,255,.15);border-radius:999rpx;background:rgba(255,255,255,.1);font-size:18rpx}
.section-card{margin-top:20rpx;padding:28rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:28rpx;background:rgba(255,255,255,.88);box-shadow:0 14rpx 38rpx rgba(31,70,110,.08)}.section-kicker{color:#1674d0;font-size:20rpx;font-weight:750}.section-description{margin-top:6rpx;color:#8a98aa;font-size:18rpx}.detail-title{margin-top:25rpx;padding-top:23rpx;border-top:1rpx solid #e8eef5;color:#243950;font-size:30rpx;font-weight:760;line-height:1.45}.detail-copy{margin-top:15rpx;color:#53677e;font-size:24rpx;line-height:1.8;white-space:pre-wrap}
.recommendation-block{position:relative;margin-top:24rpx;padding:23rpx 24rpx;border:1rpx solid rgba(71,161,220,.25);border-radius:22rpx;background:linear-gradient(145deg,rgba(236,248,255,.92),rgba(229,244,255,.72));box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}.recommendation-block::before{content:"";position:absolute;left:31rpx;top:-25rpx;width:2rpx;height:25rpx;background:linear-gradient(#d8e6f3,#6db4e3)}.recommendation-head{display:flex;align-items:center;gap:11rpx;color:#196fb8;font-size:21rpx;font-weight:750}.recommendation-head>text{width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;border-radius:13rpx;color:#fff;background:linear-gradient(145deg,#17568d,#1684e8);font-size:16rpx;font-weight:800}.recommendation-title{margin-top:17rpx;color:#24435f;font-size:25rpx;font-weight:740;line-height:1.45}.recommendation-copy{margin-top:9rpx;color:#4d6b84;font-size:23rpx;line-height:1.72;white-space:pre-wrap}
.source-card{display:flex;align-items:center;gap:14rpx;margin-top:18rpx;padding:20rpx 23rpx;border-radius:22rpx;background:rgba(226,242,255,.8)}.source-dot{width:14rpx;height:14rpx;flex:0 0 auto;border-radius:50%;background:#35bd87;box-shadow:0 0 0 7rpx rgba(53,189,135,.12)}.source-card text,.source-card label{display:block}.source-card text{color:#36546f;font-size:20rpx}.source-card label{margin-top:5rpx;color:#8797a8;font-size:16rpx}
