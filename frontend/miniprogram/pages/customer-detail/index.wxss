@import "../../styles/opportunity-edit-entry.wxss";
@import "../../styles/detail-summary.wxss";
page{background:#eef5fc}.detail-page{min-height:100vh;padding:22rpx 26rpx 190rpx;background:linear-gradient(155deg,#fbfdff 0%,#f2f7fc 50%,#eaf3fc 100%)}
.customer-hero{padding:27rpx;border:1rpx solid rgba(255,255,255,.28);border-radius:32rpx;color:#fff;background:radial-gradient(circle at 88% 0,rgba(77,160,239,.7),transparent 36%),linear-gradient(145deg,#112b4b,#176ec4);box-shadow:0 22rpx 55rpx rgba(20,73,127,.22),inset 0 1rpx 0 rgba(255,255,255,.2)}
.hero-top,.hero-footer,.identity-row,.hero-tags,.card-heading,.opportunity-top,.opportunity-meta,.section-heading,.contact-row,.timeline-meta{display:flex;align-items:center}.hero-top,.hero-footer,.card-heading,.opportunity-top,.opportunity-meta,.section-heading{justify-content:space-between}.sync-state{display:flex;align-items:center;gap:9rpx;color:rgba(255,255,255,.76);font-size:18rpx}.sync-state text{width:9rpx;height:9rpx;border-radius:50%;background:#62e0b1;box-shadow:0 0 0 6rpx rgba(98,224,177,.12)}.level-badge{padding:7rpx 12rpx;border:1rpx solid rgba(255,255,255,.16);border-radius:999rpx;background:rgba(255,255,255,.11);font-size:18rpx}.identity-row{gap:18rpx;margin-top:25rpx}.customer-mark{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border:1rpx solid rgba(255,255,255,.28);border-radius:23rpx;background:rgba(255,255,255,.15);font-size:32rpx;font-weight:800;backdrop-filter:blur(18rpx)}.identity-main{min-width:0}.customer-name{font-size:38rpx;font-weight:780}.customer-meta{margin-top:7rpx;color:rgba(255,255,255,.67);font-size:20rpx}.hero-tags{gap:10rpx;margin-top:22rpx}.hero-tags view{padding:8rpx 13rpx;border-radius:999rpx;font-size:18rpx}.quadrant-tag{background:rgba(218,239,255,.16);color:#d8efff}.risk-tag{background:rgba(255,210,191,.17);color:#ffd2bd}.hero-footer{margin-top:23rpx;padding-top:19rpx;border-top:1rpx solid rgba(255,255,255,.14);color:rgba(255,255,255,.65);font-size:18rpx}
.score-card{margin-top:19rpx;padding:25rpx}.card-eyebrow{color:#7890aa;font-size:15rpx;font-weight:700;letter-spacing:2.3rpx}.card-title{margin-top:6rpx;color:#20344d;font-size:27rpx;font-weight:740}.score-status{padding:8rpx 13rpx;border-radius:999rpx;color:#247957;background:rgba(221,246,235,.86);font-size:18rpx}.quadrant-copy{margin-top:13rpx;color:#6c7e93;font-size:20rpx;line-height:1.5}.score-row{margin-top:21rpx}.score-label{display:flex;align-items:center;justify-content:space-between;color:#465970;font-size:20rpx}.score-label label{color:#176fc9;font-size:23rpx;font-weight:750}.score-track{height:9rpx;margin-top:9rpx;overflow:hidden;border-radius:999rpx;background:#e8eef5}.score-track view{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#1768c1,#38a5f3)}.relation .score-track view{background:linear-gradient(90deg,#2d8067,#5cc99e)}.evidence-list{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:10rpx}.evidence-list text{padding:6rpx 10rpx;border-radius:8rpx;color:#708197;background:rgba(235,241,247,.85);font-size:16rpx}.rule-note{margin-top:19rpx;padding-top:17rpx;border-top:1rpx solid rgba(72,104,138,.1);color:#96a1b0;font-size:16rpx;line-height:1.5}
.detail-tabs{width:100%;margin-top:22rpx;white-space:nowrap}.tab-list{display:flex;padding:7rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:23rpx;background:rgba(255,255,255,.55);box-shadow:0 9rpx 28rpx rgba(25,63,105,.06)}.tab-list view{flex:1;padding:16rpx 22rpx;border-radius:18rpx;color:#768599;font-size:21rpx;text-align:center}.tab-list .active{color:#fff;background:linear-gradient(145deg,#183958,#1778da);box-shadow:0 8rpx 20rpx rgba(26,97,172,.18)}.tab-content{margin-top:19rpx}.metric-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:22rpx 8rpx}.metric-grid>view{display:flex;min-width:0;flex-direction:column;align-items:center;justify-content:center;border-right:1rpx solid rgba(79,108,141,.1)}.metric-grid>view:last-child{border-right:0}.metric-grid text{max-width:100%;overflow:hidden;color:#203750;font-size:27rpx;font-weight:760;line-height:1.2;white-space:nowrap;text-overflow:ellipsis}.metric-grid text.pending{padding:7rpx 14rpx;border-radius:999rpx;color:#557087;background:#eef4f9;font-size:20rpx}.metric-grid label{margin-top:6rpx;color:#8996a7;font-size:17rpx}
.ai-card{margin-top:18rpx;padding:24rpx;border:1rpx solid rgba(144,200,245,.52);border-radius:28rpx;background:linear-gradient(145deg,rgba(247,252,255,.95),rgba(224,241,255,.9));box-shadow:0 15rpx 38rpx rgba(26,91,151,.1)}.ai-head{display:flex;align-items:center;gap:13rpx}.ai-mark{width:51rpx;height:51rpx;display:flex;align-items:center;justify-content:center;border-radius:17rpx;color:#fff;background:linear-gradient(145deg,#184f84,#1684ed);font-size:18rpx;font-weight:750}.ai-head>view:last-child view{color:#29435f;font-size:22rpx;font-weight:700}.ai-head>view:last-child text{display:block;margin-top:4rpx;color:#8695a7;font-size:16rpx}.ai-action-title{margin-top:17rpx;color:#2d4864;font-size:21rpx;line-height:1.65}.ai-link{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid rgba(60,112,162,.1);color:#1674d2;font-size:20rpx;font-weight:680}
.section-heading{margin:28rpx 3rpx 14rpx}.section-heading>text{color:#24384f;font-size:26rpx;font-weight:740}.section-heading label{color:#8995a5;font-size:18rpx}.opportunity-card{padding:23rpx}.opportunity-name{color:#283d54;font-size:24rpx;font-weight:720}.opportunity-stage{display:inline-flex;margin-top:7rpx;padding:6rpx 10rpx;border-radius:8rpx;color:#ad6134;background:#fff0e6;font-size:16rpx}.opportunity-amount{color:#184d80;font-size:28rpx;font-weight:780}.opportunity-progress{height:9rpx;margin-top:20rpx;overflow:hidden;border-radius:999rpx;background:#e7edf4}.opportunity-progress view{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#176fc9,#4ca6ee)}.opportunity-meta{margin-top:11rpx;color:#8290a2;font-size:17rpx}.contact-list{padding:2rpx 22rpx}.contact-row{gap:14rpx;padding:20rpx 0;border-bottom:1rpx solid rgba(73,102,135,.09)}.contact-row:last-child{border-bottom:0}.contact-avatar{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:18rpx;color:#176fc7;background:#e6f1fd;font-size:20rpx;font-weight:750}.contact-main{flex:1;min-width:0}.contact-main>view{color:#32475f;font-size:21rpx;font-weight:680}.contact-main>view text{margin-left:10rpx;color:#8693a4;font-size:17rpx;font-weight:400}.contact-main label{display:block;margin-top:5rpx;color:#8190a2;font-size:17rpx}.strength{padding:6rpx 10rpx;border-radius:999rpx;color:#377a63;background:#e6f5ee;font-size:16rpx}.strength-attention{color:#ac693e;background:#fff0e6}.strength-missing{color:#bd5f50;background:#ffebe8}
.opportunity-list-card+.opportunity-list-card{margin-top:14rpx}.opportunity-empty{color:#8996a7;text-align:center}
.timeline{padding:6rpx 23rpx}.timeline-item{display:flex;gap:17rpx}.timeline-rail{position:relative;width:18rpx;display:flex;flex-direction:column;align-items:center;flex:0 0 auto}.timeline-rail view{z-index:1;width:15rpx;height:15rpx;margin-top:29rpx;border:4rpx solid #dcecff;border-radius:50%;background:#1879d8}.timeline-rail text{position:absolute;top:44rpx;bottom:-29rpx;width:2rpx;background:#dce5ef}.timeline-item:last-child .timeline-rail text{display:none}.timeline-main{flex:1;padding:23rpx 0;border-bottom:1rpx solid rgba(76,106,139,.09)}.timeline-item:last-child .timeline-main{border-bottom:0}.timeline-date{color:#8290a2;font-size:17rpx}.timeline-title{margin-top:8rpx;color:#2e435b;font-size:22rpx;font-weight:690}.timeline-meta{margin-top:11rpx}.timeline-meta text{padding:5rpx 9rpx;border-radius:8rpx;color:#2d7e61;background:#e5f5ed;font-size:16rpx}.timeline-meta label{color:#8996a6;font-size:17rpx}
.opportunity-detail{padding:26rpx}.opportunity-detail-name{margin-top:7rpx;color:#243b54;font-size:28rpx;font-weight:750}.stage-pipeline{display:flex;justify-content:space-between;margin-top:31rpx}.stage-pipeline>view{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;color:#9aa5b3;font-size:15rpx}.stage-pipeline>view::after{content:"";position:absolute;z-index:0;left:50%;right:-50%;top:9rpx;height:2rpx;background:#dce4ee}.stage-pipeline>view:last-child::after{display:none}.stage-pipeline text{z-index:1;width:18rpx;height:18rpx;border:4rpx solid #e2e8ef;border-radius:50%;background:#fff}.stage-pipeline label{margin-top:10rpx}.stage-pipeline .done text,.stage-pipeline .current text{border-color:#b9dafa;background:#1976d2}.stage-pipeline .done::after{background:#69a9e5}.stage-pipeline .current label{color:#176dc3;font-weight:650}.detail-rows{margin-top:27rpx;border-top:1rpx solid rgba(76,107,141,.1)}.detail-rows view{display:flex;justify-content:space-between;padding:17rpx 0;border-bottom:1rpx solid rgba(76,107,141,.08);font-size:20rpx}.detail-rows text{color:#8390a1}.detail-rows label{color:#30455d;font-weight:650}.risk-card{display:flex;gap:14rpx;margin-top:18rpx;padding:22rpx;border:1rpx solid rgba(237,171,144,.45);border-radius:24rpx;background:rgba(255,244,239,.82)}.risk-icon{width:46rpx;height:46rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:15rpx;color:#fff;background:linear-gradient(145deg,#d85e43,#ec8a62);font-weight:800}.risk-card>view:last-child view{color:#6b3d31;font-size:21rpx;font-weight:700}.risk-card>view:last-child text{display:block;margin-top:6rpx;color:#966c60;font-size:18rpx;line-height:1.55}
.bottom-actions{position:fixed;z-index:20;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr;gap:13rpx;padding:14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:rgba(245,249,253,.9);box-shadow:0 -14rpx 42rpx rgba(25,61,103,.08);backdrop-filter:blur(26rpx)}.bottom-actions button{height:88rpx;display:flex;align-items:center;justify-content:center;gap:11rpx;border-radius:24rpx;font-size:22rpx;font-weight:680}.record-button{color:#fff;background:linear-gradient(145deg,#183d61,#147ee4)!important;box-shadow:0 12rpx 27rpx rgba(20,91,166,.22)}.record-wave{height:25rpx;display:flex;align-items:center;gap:4rpx}.record-wave text{width:3rpx;height:12rpx;border-radius:99rpx;background:#fff}.record-wave text:nth-child(2){height:24rpx}
.strength-attention{color:#ac693e;background:#fff0e6}.strength-missing{color:#bd5f50;background:#ffebe8}
.timeline-date{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.timeline-date>text{padding:4rpx 9rpx;border-radius:999rpx;color:#176fc7;background:#e6f1fd;font-size:14rpx}.timeline-meta{display:flex;justify-content:space-between}.timeline-expanded{margin-top:15rpx;padding:15rpx;border:1rpx solid rgba(75,106,140,.09);border-radius:18rpx;background:rgba(245,249,253,.88)}.timeline-expanded>view{padding:10rpx 0;border-bottom:1rpx solid rgba(75,106,140,.08)}.timeline-expanded>view:last-child{border:0}.timeline-expanded text,.timeline-expanded label{display:block}.timeline-expanded text{color:#8190a2;font-size:15rpx}.timeline-expanded label{margin-top:5rpx;color:#40566d;font-size:17rpx;line-height:1.55}.timeline-expanded .ai{margin-top:6rpx;padding:13rpx;border:1rpx solid rgba(130,191,238,.3);border-radius:15rpx;background:#eaf5ff}.timeline-expanded .ai text{color:#285272;font-weight:680}.timeline-expanded .next{margin-top:8rpx;padding:13rpx;border-left:5rpx solid #32866b;border-radius:5rpx 15rpx 15rpx 5rpx;background:#eaf7f1}

.supplement-button{display:flex;align-items:center;justify-content:center;height:72rpx;margin:20rpx 0 0;background:#edf6ff;color:#237abf;font-size:25rpx;line-height:1.4;border-radius:14rpx}.supplement-button::after{border:0}

.opportunity-edit-entry{display:flex;justify-content:space-between;padding:24rpx 8rpx;color:#217fc2;font-size:27rpx}

.detail-context-links{display:flex;gap:16rpx;margin:20rpx 0}.detail-context-link{flex:1;text-align:center;padding:20rpx;background:#fff;border:1rpx solid #dce8f2;border-radius:20rpx;color:#276eaa;font-size:25rpx}

.historical-period-records{margin-top:28rpx}.historical-period-note{margin-top:10rpx;color:#8390a1;font-size:19rpx;line-height:1.6}.historical-period-records .detail-rows{margin-top:12rpx}.historical-period-records .detail-rows>view{gap:16rpx}.historical-period-records .detail-rows>view>text{flex-shrink:0}.historical-period-records label{text-align:right;overflow-wrap:anywhere}
