<root-portal wx:if="{{lightweightDialog}}"><view class="sb-portal-theme"><sb-sheet visible="{{!!lightweightDialog}}" title="{{lightweightDialog.action === 'adopt' ? '接入轻量任务' : '更新任务'}}" closeOnOverlay="{{false}}" cancelLabel="返回" confirmLabel="确认保存" confirmLoading="{{executionBusy}}" bind:confirm="submitLightweight" bind:close="closeLightweightUpdate">
 <view class="execution-sheet-body lightweight-editor-body">
 <view class="completion-help">当前状态：{{task.statusLabel}}{{task.processingLabel ? ' · ' + task.processingLabel : ''}}</view>
 <picker wx:if="{{lightweightDialog.action !== 'adopt'}}" range="{{lightweightActionOptions}}" range-key="label" value="{{lightweightActionIndex}}" disabled="{{executionBusy}}" bindchange="chooseLightweightAction"><view class="execution-form-field"><text class="execution-field-label">本次更新</text><view class="execution-field-control">{{lightweightActionOptions[lightweightActionIndex].label}}　⌄</view></view></picker>
 <block wx:if="{{lightweightDialog.action === 'append_feedback'}}"><sb-textarea layout="stacked" plain fixed label="最新反馈" required value="{{lightweightDialog.text}}" maxlength="{{4000}}" data-key="text" bind:change="inputLightweight" disabled="{{executionBusy}}"/><sb-textarea layout="stacked" plain fixed label="下一步" required="{{task.status === 'in_progress'}}" value="{{lightweightDialog.next_step}}" maxlength="{{2000}}" data-key="next_step" bind:change="inputLightweight" disabled="{{executionBusy}}"/><text class="completion-help">保存反馈保留当前状态，不重复填写已生效的原因和日期。</text></block>
 <block wx:if="{{lightweightDialog.action === 'submit_completion' || lightweightDialog.action === 'review_approve' || lightweightDialog.action === 'review_reject'}}"><view wx:if="{{lightweightDialog.action !== 'submit_completion'}}" class="description">本轮结果：{{execution.currentSubmissionNote}}</view><sb-textarea layout="stacked" plain fixed label="{{lightweightDialog.action === 'submit_completion' ? '完成结果' : lightweightDialog.action === 'review_reject' ? '退回原因' : '验收说明（选填）'}}" required="{{lightweightDialog.action !== 'review_approve'}}" value="{{lightweightDialog.note}}" maxlength="{{4000}}" data-key="note" bind:change="inputLightweight" disabled="{{executionBusy}}"/><text wx:if="{{lightweightDialog.action === 'submit_completion'}}" class="completion-help">{{execution.selfManaged ? '本人自办，填写结果后直接完成。' : '提交后进入需调整（待验收），由下发人验收后完成。'}}</text></block>
 <block wx:if="{{lightweightDialog.action === 'revise'}}"><sb-textarea layout="stacked" plain fixed label="任务内容" required maxlength="{{500}}" value="{{lightweightDialog.description}}" data-key="description" bind:change="inputLightweight" disabled="{{executionBusy}}"/><picker range="{{lightweightRecipients}}" range-key="name" value="{{lightweightExecutorIndex}}" disabled="{{executionBusy || lightweightRecipientsLoading || lightweightRecipientsError}}" bindchange="chooseLightweightExecutor"><view class="execution-form-field"><text class="execution-field-label">执行人</text><view class="execution-field-control">{{lightweightRecipients[lightweightExecutorIndex].name || execution.executorLabel}}　⌄</view></view></picker><text wx:if="{{lightweightRecipientsLoading}}">正在读取人员…</text><button wx:if="{{lightweightRecipientsError}}" bindtap="loadLightweightRecipients">{{lightweightRecipientsError}} · 重试</button><text class="completion-help">实际修改内容、日期或执行人后自动进行中；原结果及历史保留。</text></block>
 <view class="execution-form-notice" wx:if="{{lightweightDialog.action === 'defer'}}">当前截止：{{task.dueLabel}}。请选择更晚的日期或时间。</view>
 <view class="execution-field-pair" wx:if="{{lightweightDialog.action === 'defer' || lightweightDialog.action === 'revise'}}"><picker mode="date" value="{{lightweightDialog.dueDate}}" start="{{lightweightDialog.action === 'defer' ? lightweightDialog.minimumDueDate : '2000-01-01'}}" end="2100-12-31" data-key="dueDate" bindchange="inputLightweight" disabled="{{executionBusy}}"><view class="execution-form-field"><text class="execution-field-label">截止日期</text><view class="execution-field-control">{{lightweightDialog.dueDate || '请选择'}}</view></view></picker><picker mode="time" value="{{lightweightDialog.dueTime}}" data-key="dueTime" bindchange="inputLightweight" disabled="{{executionBusy}}"><view class="execution-form-field"><text class="execution-field-label">时间</text><view class="execution-field-control">{{lightweightDialog.dueTime}}</view></view></picker></view>
 <sb-textarea layout="stacked" plain fixed wx:if="{{lightweightDialog.action === 'defer' || lightweightDialog.action === 'request_adjustment' || lightweightDialog.action === 'pause' || lightweightDialog.action === 'resume' || lightweightDialog.action === 'close' || lightweightDialog.action === 'revise' || lightweightDialog.action === 'continue_original' || lightweightDialog.action === 'adopt'}}" label="{{lightweightDialog.action === 'defer' ? '延期原因' : lightweightDialog.action === 'request_adjustment' ? '实际调整情况' : lightweightDialog.action === 'pause' ? '暂停说明' : lightweightDialog.action === 'resume' ? '恢复说明' : lightweightDialog.action === 'close' ? '结束原因' : lightweightDialog.action === 'adopt' ? '接入说明（选填）' : '处理说明（选填）'}}" required="{{lightweightDialog.action !== 'revise' && lightweightDialog.action !== 'continue_original' && lightweightDialog.action !== 'adopt'}}" maxlength="{{1000}}" value="{{lightweightDialog.reason}}" data-key="reason" bind:change="inputLightweight" disabled="{{executionBusy}}"/>
 <text class="completion-help" wx:if="{{lightweightDialog.action === 'adopt'}}">接入保留原任务、反馈和验收历史，不自动通过旧验收。</text><view class="coordinate-error" wx:if="{{lightweightDialogError}}">{{lightweightDialogError}}</view>
 </view></sb-sheet></view></root-portal>
