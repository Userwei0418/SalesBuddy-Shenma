<wxs module="coord">
function members(list) { var out = []; for (var i = 0; i < (list || []).length; i++) { var m = list[i]; out.push({ value: i, label: m.name + ' · ' + (m.team || m.team_name || '未填写部门') }); } return out; }
module.exports = { members: members };
</wxs>
<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view wx:if="{{task}}" class="detail-page status-{{task.status}} traffic-{{task.signal.tone}}">
  <view class="detail-hero">
    <sb-summary-card appearance="soft" tone="{{task.signal.tone === 'red' ? 'bad' : ''}}" title="{{task.title}}" subtitle="{{task.customer}} · {{task.team}}" tags="{{[{label:task.signal.label + ' · ' + task.statusLabel,tone:task.signal.tone === 'red' ? 'bad' : task.signal.tone === 'yellow' ? 'watch' : task.signal.tone === 'green' ? 'good' : 'pending'},{label:task.priority + '优先级'}]}}" progress="{{task.status === 'completed' ? 100 : task.status === 'pending_confirm' ? 16 : task.status === 'cancelled' ? 100 : 42}}" progressLabel="{{task.status === 'completed' ? '任务已完成，结果已同步' : task.status === 'pending_confirm' ? '等待接收方接受或拒绝' : task.status === 'pending_review' ? '完成说明已提交，等待发起人验收' : task.status === 'cancelled' ? (task.wasCancelled ? '任务已取消，原因和协调记录已保留' : '接收方已拒绝，等待发起人决定是否重新发起') : '任务执行中 · 等待完成反馈'}}" />
  </view>

  <view class="detail-body">
    <view wx:if="{{task.handover_required}}" class="fde-note">原接收人账号或岗位资格已变化，任务待交接；不自动完成或删除。</view>
    <view wx:if="{{(task.can_coordinate || task.canCancel) && task.status !== 'pending_review' && !coordinateOpen}}" class="coordination-entry">
      <t-cell title="协调任务" description="转交负责人或取消任务" arrow hover bordered="{{false}}" bind:click="openCoordination" />
    </view>
    <view wx:if="{{coordinateOpen}}" class="section-card fde-coordinate">
      <view class="section-title">任务协调</view>
      <sb-select wx:if="{{task.can_coordinate}}" layout="stacked" plain label="接手人员" required placeholder="选择接手人员" options="{{coord.members(coordinateMembers)}}" value="{{coordinateIndex >= 0 ? coordinateIndex : null}}" disabled="{{coordinateLoading || !coordinateMembers.length}}" bindchange="coordinateMember" />
      <view wx:if="{{task.can_coordinate && coordinateLoading}}" class="coordinate-hint">正在读取可接手人员…</view><view wx:elif="{{task.can_coordinate && !coordinateMembers.length}}" class="coordinate-hint">当前没有可接手人员，可联系运营或说明原因后取消。</view>
      <sb-textarea layout="stacked" plain label="协调原因" required maxlength="{{500}}" placeholder="请说明转交或取消原因" value="{{coordinateNote}}" bind:change="coordinateNote" />
      <text wx:if="{{coordinateError}}" class="coordinate-error">{{coordinateError}}</text>
      <view class="fde-coordinate-actions"><button class="coordinate-back" disabled="{{submitting}}" bindtap="closeCoordination">返回</button><button wx:if="{{task.canCancel}}" class="coordinate-cancel" disabled="{{submitting}}" data-event="cancel" bindtap="coordinate">取消任务</button><button wx:if="{{task.can_coordinate}}" class="coordinate-submit" disabled="{{submitting || !coordinateMembers.length}}" data-event="reassign" bindtap="coordinate">确认转交</button></view>
    </view>
    <view class="section-card description-card">
      <view class="section-title">任务要求</view>
      <view class="description">{{task.description}}</view>
    </view>

    <view class="section-card info-card">
      <sb-desc-list items="{{[{key:'category',label:'任务类别',value:task.associationLabel},{key:'opportunity',label:'关联商机',value:task.opportunityLabel,tappable:!!(task.opportunity_id && task.customer_id),tone:task.opportunity_id && task.customer_id ? 'primary' : ''},{key:'owner',label:'负责人',value:task.owner},{key:'creator',label:task.task_type === 'visit_follow_up' ? '记录人' : '下发人',value:task.creator},{key:'source',label:'任务来源',value:task.sourceLabel},{key:'due',label:'截止时间',value:task.dueLabel,tone:task.signal.tone === 'red' ? 'danger' : ''},{key:'created',label:'创建时间',value:task.createdLabel},{key:'related',label:'相关方',value:task.relatedText}]}}" layout="grid" bind:tap="onInfoTap" />
    </view>

    <view wx:if="{{task.status === 'completed'}}" class="section-card completed-card">
      <view class="completed-main"><view class="completed-head"><sb-status-tag tone="good" label="已完成" /><text>{{task.completedBy}} 已完成</text></view><label>{{task.completedLabel}}</label><view>{{task.completionNote}}</view></view>
    </view>

    <view wx:elif="{{task.status === 'cancelled'}}" class="section-card closed-card">
      <view class="rejected-copy">
        <view class="rejected-head"><sb-status-tag tone="watch" label="{{task.wasCancelled ? '已取消' : '已拒绝'}}" /><text class="rejected-title">{{task.wasCancelled ? '任务已取消' : '任务已被拒绝'}}</text></view>
        <label class="rejected-kicker">{{task.wasCancelled ? '协调人说明' : '接收方说明'}}</label>
        <view class="rejected-comment">{{task.wasCancelled ? task.cancellationNote : (task.rejectionComment || '暂未填写拒绝原因')}}</view>
      </view>
    </view>

    <view wx:elif="{{task.canRespond}}" class="section-card respond-card"><view class="section-title">接受或拒绝</view><view class="completion-help">确认后进入执行；岗位任务只需一人领取，拒绝仅表示本人不领取。拒绝时必须填写原因，系统会立即通知发起人。</view><sb-textarea layout="stacked" plain maxlength="{{2000}}" value="{{responseComment}}" placeholder="拒绝时必填：说明无法接受的原因或建议调整方式" bind:change="inputResponseComment" /></view>

    <view wx:elif="{{task.status === 'pending_review'}}" class="section-card completion-card">
      <view class="section-title">{{task.canReview ? '待你验收' : '等待发起人确认'}}</view>
      <view class="completion-help">{{task.owner}} 提交的完成说明</view>
      <view class="description review-evidence">{{task.completionNote}}</view>
      <block wx:if="{{task.canReview}}">
        <view class="completion-help">确认完成后任务闭环；驳回时请说明需要补充或改进的内容。</view>
        <sb-textarea layout="stacked" plain maxlength="{{2000}}" value="{{reviewNote}}" placeholder="验收意见（驳回时必填）" bind:change="inputReviewNote" />
      </block>
    </view>
    <view wx:elif="{{task.canComplete}}" class="section-card completion-card">
      <view class="section-title">完成反馈</view><view wx:if="{{task.reviewRejected}}" class="review-rejected">驳回原因：{{task.reviewNote}}</view>
      <view class="completion-help">{{task.selfAssigned ? '填写完成说明后可直接完成。' : '请填写完成说明，提交后由发起人验收，通过才算完成。'}}</view>
      <sb-textarea layout="stacked" plain maxlength="{{2000}}" value="{{completionNote}}" placeholder="必填：说明交付结果、附件位置或后续安排" bind:change="inputCompletionNote" />
    </view>

    <view wx:else class="readonly-tip"><text>该任务由 {{task.owner}} 负责完成，你可以查看最新状态。</text></view>
    <view wx:if="{{task.history.length}}" class="section-card review-history"><view class="section-title">提交与验收记录</view><view wx:for="{{task.history}}" wx:key="id" class="review-history-row"><view>{{item.label}} · {{item.actor_name}}</view><text class="completion-help">{{item.time}}</text><view class="description review-evidence">{{item.note}}</view></view></view>
  </view>

  <view wx:if="{{task.canRespond}}" class="bottom-bar response-actions"><button wx:if="{{task.canDecline}}" class="reject-button {{submitting ? 'disabled' : ''}}" disabled="{{submitting}}" bindtap="rejectTask">拒绝</button><button wx:if="{{task.canAccept}}" class="accept-button {{submitting ? 'disabled' : ''}}" disabled="{{submitting}}" bindtap="acceptTask">{{submitting ? '正在同步' : task.responseLabel}}</button><view>拒绝原因将立即推送给 {{task.creator}}</view></view>
  <sb-bottom-bar wx:elif="{{task.canRetry}}" class="bottom-bar retry-bar" primaryLabel="重新发起新任务" bind:primary="retryTask" note="原任务和拒绝说明会被保留，新任务可重新修改" />
  <sb-bottom-bar wx:elif="{{task.canReview}}" class="bottom-bar response-actions" secondaryLabel="驳回" secondaryDisabled="{{submitting}}" bind:secondary="onRejectCompletion" primaryLabel="确认完成" loading="{{submitting}}" loadingLabel="正在同步" bind:primary="onApproveCompletion" note="验收结果将通知 {{task.owner}}" />
  <sb-bottom-bar wx:elif="{{task.canComplete}}" class="bottom-bar" primaryLabel="{{task.selfAssigned ? '确认完成' : '提交完成'}}" loading="{{submitting}}" loadingLabel="正在同步" bind:primary="markCompleted" note="{{task.selfAssigned ? '填写说明后直接完成' : '提交后由 ' + task.creator + ' 验收'}}" />
</view>

</block>
