<wxs module="opt">
function idx(list){var out=[];for(var i=0;i<(list||[]).length;i++){out.push({value:i,label:list[i].label});}return out;}
module.exports={idx:idx};
</wxs>
<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view class="claim-page">
  <view class="claim-hero">
    <view class="claim-title">选择要认领的客户</view>
    <view class="claim-subtitle">提交申请后由运营审批，通过后加入你的作战地图</view>
  </view>
  <view class="claim-search"><sb-search value="{{query}}" placeholder="客户名称 / 拼音 / 首字母" maxlength="{{100}}" bind:change="inputQuery" bind:clear="inputQuery" /></view>

  <view class="claim-main">
    <view wx:if="{{resultMessage}}" class="claim-result">{{resultMessage}}</view>
    <view class="claim-filters">
      <sb-labeled-select class="claim-filter" size="small" label="行业" allOption="{{false}}" options="{{opt.idx(industryOptions)}}" value="{{industryIndex}}" disabled="{{optionsLoading || !industryOptions.length || submitting}}" bind:change="changeIndustry" />
      <sb-labeled-select class="claim-filter" size="small" label="认领状态" allOption="{{false}}" options="{{opt.idx(statusOptions)}}" value="{{statusIndex}}" disabled="{{optionsLoading || !statusOptions.length || submitting}}" bind:change="changeClaimStatus" />
    </view>
    <view wx:if="{{optionsLoading}}" class="claim-filter-message">正在加载筛选选项…</view>
    <view wx:elif="{{optionsError}}" class="claim-filter-error" bindtap="retryFilterOptions">{{optionsError}} · 点击重试</view>
    <view wx:if="{{hasFilters}}" class="claim-filter-reset" bindtap="clearFilters">清除搜索与筛选</view>
    <view class="claim-section-head"><text>公司客户</text><label>{{query && total !== null ? '共 ' + total + ' 个结果 · ' : ''}}{{loading ? '加载中…' : total !== null ? '已加载 ' + customers.length + ' / 共 ' + total + ' 家' : '暂未加载'}}</label></view>

    <view wx:if="{{customers.length}}" class="claim-list">
      <view wx:for="{{customers}}" wx:key="id" class="claim-card {{selectedCustomerId === item.id ? 'selected' : ''}} {{item.claimEligible ? '' : 'ineligible'}}" hover-class="row-pressed" data-id="{{item.id}}" bindtap="selectCustomer" aria-role="radio" aria-checked="{{selectedCustomerId === item.id}}">
        <view class="claim-radio"><text></text></view>
        <view class="claim-card-main">
          <view class="claim-name"><text>{{item.name}}</text><label wx:if="{{item.level}}">{{item.level}}</label></view>
          <view class="claim-meta">{{item.industry || '行业待补充'}} · {{item.team || '当前部门'}}</view>
          <view class="claim-owner"><text>负责销售：{{item.owner || '未分配'}}</text><sb-status-tag tone="{{item.claimEligible ? 'pending' : 'unset'}}" label="{{item.claimLabel}}" /></view>
        </view>
      </view>
    </view>
    <view wx:elif="{{loading}}" class="claim-empty"><sb-state-panel state="loading" title="正在加载公司客户" /></view>
    <view wx:elif="{{loadError}}" class="claim-empty"><sb-state-panel state="error" title="{{loadError}}" retryLabel="重新加载" bind:retry="refreshCustomers" /></view>
    <view wx:else class="claim-empty"><sb-state-panel state="empty" title="{{hasFilters ? '没有匹配的客户' : '公司客户名单暂为空'}}" description="{{hasFilters ? '请调整搜索词或筛选条件' : '运营完成客户建档后，可在这里申请认领'}}" /></view>
    <view wx:if="{{customers.length && hasMore}}" class="claim-pagination">
      <text wx:if="{{loadMoreError}}" class="claim-page-error">{{loadMoreError}}</text>
      <button class="claim-load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="retryMore">{{loadingMore ? '正在加载' : refreshRequired ? '刷新名单' : loadMoreError ? '重试加载' : '加载更多客户'}}</button>
    </view>
    <view wx:elif="{{customers.length && !loading}}" class="claim-list-end">已显示全部匹配客户</view>
  </view>

  <sb-bottom-bar class="claim-footer" secondaryLabel="刷新名单" bind:secondary="refreshCustomers" primaryLabel="提交认领申请" disabled="{{!selectedCustomerId}}" disabledReason="请先选择要认领的客户" loading="{{submitting}}" loadingLabel="正在提交…" bind:primary="confirmClaim" />
</view>

</block>
