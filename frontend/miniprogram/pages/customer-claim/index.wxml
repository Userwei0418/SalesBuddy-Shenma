<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view class="claim-page">
  <view class="claim-hero">
    <view class="claim-title">选择要认领的客户</view>
    <view class="claim-subtitle">提交申请后由运营审批，通过后加入你的客户经营范围</view>
  </view>
  <view class="claim-search"><sb-search value="{{query}}" maxlength="{{100}}" placeholder="客户名称 / 拼音 / 首字母" bind:change="inputQuery" bind:clear="inputQuery" /></view>
  <view class="claim-search-hint">支持中文、全拼或首字母，例如：神州 / shenzhou / sz</view>
  <view wx:if="{{canOpenCustomerCreate}}" class="claim-create-entry"><text>找不到客户？</text><button bindtap="openCustomerCreate" disabled="{{submitting}}" hover-class="row-pressed">新建客户</button></view>
  <view class="claim-filters">
    <picker class="claim-filter" range="{{identityOptions}}" range-key="label" value="{{identityIndex}}" disabled="{{submitting}}" bindchange="changeBusinessIdentity"><view>{{identityOptions[identityIndex].label}}<text>⌄</text></view></picker>
    <picker class="claim-filter" range="{{industryOptions}}" range-key="label" value="{{industryIndex}}" disabled="{{optionsLoading || !industryOptions.length || submitting}}" bindchange="changeIndustry"><view>{{industryOptions[industryIndex].label || '行业'}}<text>⌄</text></view></picker>
    <picker class="claim-filter" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" disabled="{{optionsLoading || !statusOptions.length || submitting}}" bindchange="changeClaimStatus"><view>{{statusOptions[statusIndex].label || '认领状态'}}<text>⌄</text></view></picker>
  </view><view wx:if="{{optionsLoading}}" class="claim-search-hint">正在加载筛选选项…</view><view wx:elif="{{optionsError}}" class="claim-filter-error" bindtap="retryFilterOptions">{{optionsError}} · 点击重试</view><view wx:if="{{hasFilters}}" class="claim-filter-reset" bindtap="clearFilters">清除搜索与筛选</view>

  <view class="claim-main">
    <view wx:if="{{resultMessage}}" class="claim-result">{{resultMessage}}</view>
    <view class="claim-section-head"><text>企业档案</text><label>{{query && total !== null ? '共 ' + total + ' 个结果 · ' : ''}}{{loading ? '加载中…' : total !== null ? '已加载 ' + customers.length + ' / 共 ' + total + ' 家' : '暂未加载'}}</label></view>

    <view wx:if="{{customers.length}}" class="claim-list">
      <view wx:for="{{customers}}" wx:key="id" class="claim-card {{selectedCustomerId === item.id ? 'selected' : ''}} {{item.claimEligible ? '' : 'ineligible'}}" hover-class="row-pressed" data-id="{{item.id}}" bindtap="selectCustomer" aria-role="radio" aria-checked="{{selectedCustomerId === item.id}}">
        <view class="claim-radio"><text></text></view>
        <view class="claim-card-main">
          <view class="claim-name"><text>{{item.name}}</text><label wx:if="{{item.level}}">{{item.level}}</label></view>
          <view class="claim-meta">{{item.businessIdentityText}} · {{item.industry || '行业待补充'}} · {{item.team || '当前部门'}}</view>
          <view wx:if="{{canReadCustomer && item.can_read_customer}}" class="claim-filter-reset" data-id="{{item.id}}" catchtap="openCustomerDetail">查看档案</view>
          <view class="claim-owner"><text>负责销售：{{item.owner || '未分配'}} · {{item.claimLabel}}</text><sb-status-tag tone="{{item.claimEligible ? 'pending' : 'unset'}}" label="{{item.claimLabel}}" /></view>
        </view>
      </view>
    </view>
    <view wx:elif="{{loading}}" class="claim-empty"><sb-state-panel state="loading" title="正在加载公司客户" /></view>
    <view wx:elif="{{loadError}}" class="claim-empty"><sb-state-panel state="error" title="{{loadError}}" retryLabel="重新加载" bind:retry="refreshCustomers" /></view>
    <view wx:else class="claim-empty"><sb-state-panel state="empty" title="{{query ? '没有匹配的客户' : '公司客户名单暂为空'}}" description="{{query ? '请尝试其他客户名称关键词' : '运营完成客户建档后，可在这里申请认领'}}" /></view>
    <view wx:if="{{customers.length && hasMore}}" class="claim-pagination">
      <text wx:if="{{loadMoreError}}" class="claim-page-error">{{loadMoreError}}</text>
      <button class="claim-load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="retryMore">{{loadingMore ? '正在加载' : refreshRequired ? '刷新名单' : loadMoreError ? '重试加载' : '加载更多客户'}}</button>
    </view>
    <view wx:elif="{{customers.length && !loading}}" class="claim-list-end">已显示全部匹配客户</view>
  </view>

  <sb-bottom-bar class="claim-footer" secondaryLabel="刷新名单" bind:secondary="refreshCustomers" primaryLabel="提交认领申请" disabled="{{!selectedCustomerId}}" disabledReason="请先选择要认领的客户" loading="{{submitting}}" loadingLabel="正在提交…" bind:primary="confirmClaim" />
</view>

</block>
