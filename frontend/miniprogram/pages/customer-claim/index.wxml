<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view class="claim-page">
  <view class="claim-hero">
    <view class="claim-eyebrow">公司客户</view>
    <view class="claim-title">选择要认领的客户</view>
    <view class="claim-subtitle">提交申请后由运营审批，通过后加入你的作战地图</view>
  </view>

  <view class="claim-main">
    <view wx:if="{{resultMessage}}" class="claim-result">{{resultMessage}}</view>
    <view class="claim-search">
      <view class="search-icon"></view>
      <input value="{{query}}" placeholder="搜索客户名称" bindinput="inputQuery" />
      <view wx:if="{{query && total !== null}}" class="search-count">共 {{total}} 个结果</view>
    </view>
    <view class="claim-section-head"><text>公司客户</text><label>{{loading ? '加载中…' : total !== null ? '已加载 ' + customers.length + ' / 共 ' + total + ' 家' : '暂未加载'}}</label></view>

    <view wx:if="{{customers.length}}" class="claim-list">
      <view wx:for="{{customers}}" wx:key="id" class="claim-card {{selectedCustomerId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectCustomer">
        <view class="claim-radio"><text></text></view>
        <view class="claim-card-main">
          <view class="claim-name"><text>{{item.name}}</text><label wx:if="{{item.level}}">{{item.level}}</label></view>
          <view class="claim-meta">{{item.industry || '行业待补充'}} · {{item.team || '当前部门'}}</view>
          <view class="claim-owner">负责销售：{{item.owner || '未分配'}} · {{item.claimLabel}}</view>
        </view>
      </view>
    </view>
    <view wx:elif="{{loading}}" class="claim-empty"><view class="loading-dot"></view><text>正在加载公司客户</text></view>
    <view wx:elif="{{loadError}}" class="claim-empty"><text>{{loadError}}</text><button class="claim-load-more" bindtap="refreshCustomers">重新加载</button></view>
    <view wx:else class="claim-empty"><view class="empty-search"></view><text>{{query ? '没有匹配的客户' : '公司客户名单暂为空'}}</text><label>{{query ? '请尝试其他客户名称关键词' : '运营完成客户建档后，可在这里申请认领'}}</label></view>
    <view wx:if="{{customers.length && hasMore}}" class="claim-pagination">
      <text wx:if="{{loadMoreError}}" class="claim-page-error">{{loadMoreError}}</text>
      <button class="claim-load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="retryMore">{{loadingMore ? '正在加载' : refreshRequired ? '刷新名单' : loadMoreError ? '重试加载' : '加载更多客户'}}</button>
    </view>
    <view wx:elif="{{customers.length && !loading}}" class="claim-list-end">已显示全部匹配客户</view>
  </view>

  <view class="claim-footer">
    <button class="claim-cancel" bindtap="refreshCustomers">刷新名单</button>
    <button disabled="{{!selectedCustomerId || submitting}}" loading="{{submitting}}" class="claim-confirm" bindtap="confirmClaim">提交认领申请</button>
  </view>
</view>

</block>
