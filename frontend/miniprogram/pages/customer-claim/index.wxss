page{background:var(--ui-background)}
.claim-page{min-height:100vh;padding-bottom:calc(240rpx + constant(safe-area-inset-bottom));padding-bottom:calc(240rpx + env(safe-area-inset-bottom));color:var(--ui-ink);background:var(--ui-background)}

/* 顶部白卡 */
.claim-hero{padding:32rpx 32rpx 8rpx;background:var(--ui-surface)}
.claim-search{padding-bottom:8rpx;border-bottom:1px solid var(--ui-line);background:var(--ui-surface)}
.claim-title{color:var(--ui-ink);font-size:var(--ui-text-page);font-weight:600}
.claim-subtitle{margin-top:8rpx;color:var(--ui-secondary);font-size:14px;line-height:1.6}

.claim-main{padding:24rpx 32rpx 32rpx}
.claim-result{margin-bottom:24rpx;color:var(--ui-secondary);font-size:14px;line-height:1.6}
.claim-section-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:16rpx 0 16rpx}
.claim-section-head text{flex:0 0 auto;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.claim-section-head label{color:var(--ui-secondary);font-size:var(--ui-text-small);text-align:right}

.claim-list{display:flex;flex-direction:column;gap:var(--ui-space-2)}
/* 卡片式单选（B-38 只改样式）：灰底上的白卡不描边；选中浅蓝底加一圈主色细线；不可认领的单选圈置灰 */
.row-pressed{background:var(--ui-neutral-soft)!important}
.claim-card{display:flex;align-items:center;gap:24rpx;padding:32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.claim-card.selected{background:var(--ui-selected);box-shadow:inset 0 0 0 1px var(--ui-primary)}
.claim-radio{width:36rpx;height:36rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border:1px solid var(--ui-muted);border-radius:50%;background:var(--ui-surface)}
.claim-radio text{width:18rpx;height:18rpx;border-radius:50%;background:transparent}
.selected .claim-radio{border-color:var(--ui-primary)}
.selected .claim-radio text{background:var(--ui-primary)}
.ineligible .claim-radio{border-color:var(--ui-line);background:var(--ui-neutral-soft)}
.claim-card-main{min-width:0;flex:1}
.claim-name{display:flex;align-items:center;gap:12rpx}
.claim-name>text{min-width:0;overflow:hidden;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.claim-name>label{flex:0 0 auto;height:20px;padding:0 var(--ui-space-2);border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);line-height:20px}
.claim-meta,.claim-owner{margin-top:8rpx;overflow:hidden;color:var(--ui-secondary);font-size:14px;text-overflow:ellipsis;white-space:nowrap}
.claim-owner{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx 16rpx;font-size:var(--ui-text-small);white-space:normal}
.claim-empty{padding:80rpx 0}

.claim-pagination{padding:24rpx 0 8rpx;text-align:center}
.claim-load-more{margin-top:16rpx;padding:0 32rpx;min-width:240rpx;height:var(--ui-touch-target);line-height:var(--ui-touch-target);border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-surface);font-size:14px;font-weight:400}
.claim-load-more::after{border:0}
.claim-page-error{display:block;color:var(--ui-warning);font-size:var(--ui-text-small);line-height:1.5}
.claim-list-end{padding:24rpx 0 8rpx;text-align:center;color:var(--ui-muted);font-size:var(--ui-text-small)}

/* Server-backed claim filters remain available in the new controls. */
.claim-filters{display:flex;gap:14rpx;margin-top:16rpx}
.claim-filter{flex:1;min-width:0}
.claim-filter-message,.claim-filter-error{margin:12rpx 4rpx;font-size:var(--ui-text-small);line-height:1.5;color:var(--ui-secondary)}
.claim-filter-error{color:var(--ui-ink)}
.claim-filter-reset{display:flex;align-items:center;justify-content:flex-end;min-height:var(--ui-touch-target);margin-top:14rpx;color:var(--ui-primary);font-size:var(--ui-text-small);padding:6rpx 0}
