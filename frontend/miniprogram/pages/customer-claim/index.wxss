page{background:#edf5fc}.claim-page{min-height:100vh;padding-bottom:136rpx;color:#20354b;background:radial-gradient(circle at 95% 0,rgba(50,150,236,.16),transparent 28%),linear-gradient(155deg,#fbfdff,#f0f6fd 58%,#eaf3fb)}.claim-hero{padding:31rpx 30rpx 29rpx;color:#fff;background:radial-gradient(circle at 92% 0,rgba(85,177,246,.55),transparent 36%),linear-gradient(135deg,#153b61,#1b70b3);box-shadow:0 16rpx 38rpx rgba(22,83,142,.16)}.claim-eyebrow{color:rgba(255,255,255,.7);font-size:18rpx;font-weight:650;letter-spacing:1rpx}.claim-title{margin-top:8rpx;font-size:37rpx;font-weight:780}.claim-subtitle{margin-top:9rpx;color:rgba(255,255,255,.76);font-size:20rpx;line-height:1.5}.claim-main{padding:24rpx 28rpx 36rpx}.claim-search{height:78rpx;display:flex;align-items:center;gap:14rpx;padding:0 19rpx;border:1rpx solid rgba(72,112,151,.14);border-radius:21rpx;background:rgba(255,255,255,.88);box-shadow:0 8rpx 24rpx rgba(29,68,108,.06)}.claim-search input{min-width:0;flex:1;height:78rpx;color:#29435b;font-size:23rpx}.search-icon{position:relative;width:22rpx;height:22rpx;box-sizing:border-box;flex:0 0 auto;border:3rpx solid #6e8da8;border-radius:50%}.search-icon::after{content:"";position:absolute;right:-8rpx;bottom:-5rpx;width:9rpx;height:3rpx;border-radius:999rpx;background:#6e8da8;transform:rotate(45deg)}.search-count{flex:0 0 auto;color:#7d8ea0;font-size:16rpx}.claim-section-head{display:flex;align-items:center;justify-content:space-between;margin:25rpx 3rpx 14rpx}.claim-section-head text{font-size:23rpx;font-weight:720}.claim-section-head label{color:#8292a4;font-size:18rpx}.claim-list{display:flex;flex-direction:column;gap:13rpx}.claim-card{display:flex;align-items:center;gap:15rpx;padding:21rpx 19rpx;border:1rpx solid rgba(255,255,255,.95);border-radius:24rpx;background:rgba(255,255,255,.8);box-shadow:0 10rpx 28rpx rgba(30,69,111,.07)}.claim-card.selected{border-color:rgba(26,126,216,.48);background:linear-gradient(145deg,#fbfdff,#e6f3ff);box-shadow:0 11rpx 29rpx rgba(27,102,173,.12)}.claim-radio{width:34rpx;height:34rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border:2rpx solid #c6d4e2;border-radius:50%}.claim-radio text{width:17rpx;height:17rpx;border-radius:50%;background:transparent}.selected .claim-radio{border-color:#1680e4}.selected .claim-radio text{background:#1680e4}.claim-card-main{min-width:0;flex:1}.claim-name{display:flex;align-items:center;gap:10rpx}.claim-name>text{min-width:0;overflow:hidden;color:#284057;font-size:23rpx;font-weight:720;text-overflow:ellipsis;white-space:nowrap}.claim-name>label{flex:0 0 auto;padding:4rpx 8rpx;border-radius:7rpx;color:#aa613c;background:#fff0e7;font-size:14rpx}.claim-meta,.claim-owner{margin-top:7rpx;overflow:hidden;color:#7a8b9d;font-size:17rpx;text-overflow:ellipsis;white-space:nowrap}.claim-owner{color:#527493}.claim-empty{display:flex;flex-direction:column;align-items:center;padding:130rpx 24rpx 80rpx}.claim-empty>text{margin-top:19rpx;color:#344b61;font-size:23rpx;font-weight:700}.claim-empty>label{margin-top:8rpx;color:#8796a6;font-size:17rpx}.empty-search{position:relative;width:60rpx;height:60rpx;border:5rpx solid #74a6ca;border-radius:50%}.empty-search::after{content:"";position:absolute;right:-19rpx;bottom:-9rpx;width:27rpx;height:6rpx;border-radius:999rpx;background:#74a6ca;transform:rotate(45deg)}.loading-dot{width:50rpx;height:50rpx;border:5rpx solid #d7e6f3;border-top-color:#1680dc;border-radius:50%}.claim-footer{position:fixed;z-index:10;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 1.55fr;gap:13rpx;padding:14rpx 25rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(77,108,140,.08);background:rgba(247,251,255,.94);box-shadow:0 -10rpx 30rpx rgba(28,61,99,.07);backdrop-filter:blur(26rpx)}.claim-footer button{height:82rpx;display:flex;align-items:center;justify-content:center;border-radius:21rpx;font-size:22rpx;font-weight:680}.claim-cancel{border:1rpx solid rgba(69,111,150,.15);color:#41617d;background:rgba(255,255,255,.82)}.claim-confirm{color:#fff;background:linear-gradient(135deg,#174a78,#1682e8);box-shadow:0 10rpx 24rpx rgba(18,91,166,.19)}.claim-confirm[disabled]{opacity:.42}

.claim-result { margin-bottom:24rpx; padding:24rpx; border-radius:20rpx; background:#eaf5ff; color:#245b86; font-size:26rpx; line-height:1.6; }
.claim-pagination{padding:24rpx 0 4rpx;text-align:center}.claim-load-more{margin-top:18rpx;padding:0 28rpx;min-width:220rpx;height:70rpx;line-height:70rpx;border:1rpx solid #d5e5f4;border-radius:18rpx;color:#23659a;background:#f9fcff;font-size:22rpx}.claim-load-more::after{border:0}.claim-page-error{display:block;color:#9c6847;font-size:21rpx;line-height:1.5}.claim-list-end{padding:26rpx 0 6rpx;text-align:center;font-size:20rpx;color:#8195a8}

.claim-search-hint{margin:12rpx 4rpx;color:#7890a5;font-size:20rpx;line-height:1.6}
.claim-filters{display:flex;gap:14rpx;margin-top:16rpx}.claim-filter{flex:1;min-width:0}
.claim-filter-value{display:flex;align-items:center;gap:10rpx;padding:19rpx 16rpx;border:1rpx solid #d5e5f4;border-radius:16rpx;background:#f9fcff;color:#345d7e;font-size:23rpx}
.claim-filter-value text{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.claim-filter-value label{flex:0 0 auto}
.claim-filter-message,.claim-filter-error{margin:12rpx 4rpx;font-size:21rpx;line-height:1.5;color:#7890a5}.claim-filter-error{color:#a46743}
.claim-filter-reset{margin-top:14rpx;text-align:right;color:#23659a;font-size:22rpx;padding:6rpx 0}
