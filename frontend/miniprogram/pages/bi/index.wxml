<wxs module="ui">
function countdownMetrics(c){if(!c||c.closed)return [];return [{label:'天',value:c.days},{label:'时',value:c.hours},{label:'分',value:c.minutes}];}
module.exports={countdownMetrics:countdownMetrics};
</wxs>
<wxs module="opt">
function lab(it,key,suffix){return (key ? it[key] : it) + (suffix || '');}
function idx(list,key,suffix){var out=[];for(var i=0;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function rest(list,key,suffix){var out=[];for(var i=1;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function pick(i){var n=i * 1;return n>0?n:null;}
module.exports={idx:idx,rest:rest,pick:pick};
</wxs>
<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view wx:if="{{presentationOptions.length > 1}}" class="permission-perspectives"><button wx:for="{{presentationOptions}}" wx:key="value" size="mini" class="{{presentation===item.value?'selected':''}}" data-kind="{{item.value}}" bindtap="changePresentation">{{item.label}}</button></view>
<fde-dashboard id="fdeContent" wx:if="{{isFde}}"/>
<block wx:if="{{!isFde}}">
<view class="bi-page">
  <view class="page-head">
    <view class="page-heading"><text>看板</text></view>
    <view class="quarter-picker {{showQuarterFilter ? 'quarter-picker-open' : ''}} {{quarterFilterDirty || showQuarterFilter ? 'quarter-picker-on' : ''}}" hover-class="quarter-picker-pressed" bindtap="toggleQuarterFilter" aria-role="button" aria-label="统计季度：{{selectedQuarter.label}}"><view class="quarter-chip"><text class="quarter-picker-value">{{selectedQuarter.label || '—'}}</text><t-icon name="chevron-down" size="32rpx" class="quarter-picker-caret"/></view></view>
  </view>

  <view wx:if="{{showQuarterFilter}}" class="dashboard-quarter-filter">
    <sb-select class="quarter-year" plain label="统计年份" options="{{opt.idx(quarterYears,'','年')}}" value="{{quarterYearIndex}}" bind:change="changeQuarterYear"/>
    <view class="dashboard-quarter-head"><text>统计季度 · 可多选</text></view>
    <view class="dashboard-quarter-options"><view wx:for="{{quarterChoices}}" wx:key="key" class="quarter-option {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="toggleQuarter" hover-class="quarter-chip-pressed" aria-role="checkbox" aria-checked="{{item.selected}}"><text class="quarter-chip-face">Q{{item.quarter}}</text></view></view>
    <view class="dashboard-quarter-footer"><view class="quarter-reset" hover-class="quarter-reset-pressed" bindtap="resetQuarters" aria-role="button">重置</view><text class="quarter-reset-hint">恢复本年 Q1 至当前季度</text><view class="footer-action" hover-class="footer-action-pressed" bindtap="closeQuarterFilter"><t-button size="small" theme="primary" hover-stop-propagation bind:tap="closeQuarterFilter">完成</t-button></view></view>
  </view>

  <view class="metrics-section">
    <view class="metrics-heading">
      <text class="metrics-title">经营数据</text>
      <view wx:if="{{canViewTeam}}" class="metrics-controls">
        <view class="metrics-scope-switch-wrap"><sb-segmented size="small" options="{{viewModeOptions}}" value="{{viewMode}}" bind:change="onViewSegment"/></view>
        <view wx:if="{{canViewTeam}}" class="metrics-picker">
          <dashboard-picker wx:if="{{viewMode === 'personal'}}" title="选择成员" subtitle="选择本人或授权范围内的成员" label="{{memberLabel}}" active="{{!!selectedMemberId}}" options="{{memberOptions}}" selected="{{memberSelected}}" loading="{{optionsLoading}}" error="{{optionsError}}" bind:change="selectMember" bind:retry="loadOptions"/>
          <dashboard-picker wx:else title="选择团队" subtitle="单选一个团队；全部团队查看部门合计" selection-kind="team" label="{{teamLabel}}" active="{{selectedTeamChoice !== 'all'}}" options="{{teamOptions}}" selected="{{teamPickerSelected}}" loading="{{optionsLoading}}" error="{{optionsError}}" bind:change="selectTeams" bind:retry="loadOptions"/>
        </view>
      </view>
    </view>
    <view class="metrics-meta">
      <text class="metrics-context">{{viewMode === 'personal' ? memberLabel : teamLabel}} · {{selectedQuarter.label}}</text>
      <view class="freshness"><text class="source-pill">{{dataModeLabel}}</text><text>更新至 {{sourceDate}}</text></view>
    </view>
  <view wx:if="{{loading}}" class="state-card"><sb-state-panel state="loading" title="正在加载经营数据…"/></view>
  <view wx:elif="{{loadError}}" class="state-card"><sb-state-panel state="error" title="经营数据加载失败" description="{{loadError}}" bind:retry="loadFacts"/></view>
  <block wx:else>
    <view class="countdown-card">
      <sb-summary-card appearance="hero" tone="brand" title="{{countdown.sentence}}" subtitle="{{selectedQuarter.quarters.length > 1 ? '所选末季度倒计时' : '季度倒计时'}}" metrics="{{ui.countdownMetrics(countdown)}}">
        <view class="countdown-foot">季度总商机 {{totalAcv}}<text>·</text>{{activeOpportunityCount === null ? '—' : activeOpportunityCount}} 个活跃商机</view>
      </sb-summary-card>
    </view>
    <view class="kpi-grid">
      <block wx:for="{{kpis}}" wx:key="label">
        <view wx:if="{{item.kind === 'ring'}}" class="kpi-card ring-card">
          <view class="mini-ring" style="{{item.style}}"><view><text>{{item.value}}</text><label>完成率</label></view></view>
          <view class="ring-copy"><text>{{item.label}}</text><label>{{item.actual}}</label><view>目标：{{item.target}}</view><text wx:if="{{item.estimated}}" class="planning-tag">规划口径</text></view>
        </view>
        <sb-kpi-card wx:else class="kpi-tile" size="compact" label="{{item.label}}" value="{{item.value === '未登记' || item.value === '未填写' ? '' : item.value}}" missing-text="{{item.value === '未填写' ? '未填写' : '未登记'}}" note="{{item.sub}}"/>
      </block>
    </view>

    <block wx:if="{{!quarterEmpty}}">
    <view class="chart-card">
      <view class="section-head"><view><text>各阶段商机 ACV</text><label>按 90% / 70% / 50% / 30% / 10% 阶段降序展示</label></view><text class="section-total">{{totalAcv}}</text></view>
      <view class="funnel-list">
        <view wx:for="{{funnel}}" wx:key="probability" class="funnel-row">
          <view class="funnel-copy"><text class="funnel-name">{{item.name}} · {{item.probability}}%</text><text class="funnel-amount">{{item.amount}}</text><text class="funnel-count">{{item.count}} 个</text></view>
          <view class="funnel-track"><view wx:if="{{item.value}}" class="funnel-bar" style="width:{{item.width}}"></view></view>
        </view>
      </view>
    </view>

    </block>
    <view class="chart-card">
      <view class="section-head"><view><text>近 7 天跟进节奏</text><label>已确认和已归档的拜访记录</label></view><text class="section-total">近 7 天 {{weeklyVisitCount}} 条</text></view>
      <view class="visit-bars">
        <view wx:for="{{visitDays}}" wx:key="key" class="visit-day {{item.isToday ? 'today' : ''}}"><view class="bar-space"><text class="visit-bar" style="height:{{item.height}}"></text></view><text>{{item.weekday}}</text><label>{{item.count}}条</label></view>
      </view>
    </view>

    <block wx:if="{{!quarterEmpty}}">
    <view class="chart-card">
      <view class="section-head"><view><text>商机季度时间线</text><label>按预计成交月份分布</label></view><view wx:if="{{timeline.length > 3}}" class="timeline-scroll-hint">左右滑动查看<t-icon name="chevron-right" size="28rpx"/></view></view>
      <scroll-view class="timeline-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="timeline" style="width:{{timeline.length > 3 ? timeline.length * 210 + 'rpx' : '100%'}}">
        <view class="timeline-line" style="left:{{50 / timeline.length}}%;right:{{50 / timeline.length}}%"></view>
        <view wx:for="{{timeline}}" wx:key="month" class="timeline-item"><view class="timeline-dot {{item.status==='冲刺月'?'timeline-quarter-end':''}}">{{index + 1}}</view><view class="timeline-status">{{item.status}}</view><text>{{item.month}}</text><label>{{item.amount}}</label><text class="timeline-count">{{item.count}}个 · {{item.share}}%</text></view>
      </view></scroll-view>
    </view>

    </block>
  </block>
  </view>
  <view class="view-scope-note rankings-heading"><text>公共排名</text><label>{{rankingSubjectLabel}}</label></view>
  <dashboard-ranking wx:for="{{rankingCards}}" wx:key="key" title="{{item.title}}" subtitle="{{item.subtitle}}" period="{{item.period}}" symbol="{{item.symbol}}" tone="{{item.tone}}" rows="{{item.rows}}" summary-ids="{{item.summaryIds}}" loading="{{rankingLoading}}" error="{{rankingMessage}}" empty-summary="{{item.emptySummary || '所选对象暂未纳入当前榜单'}}" bind:retry="reloadRankings"/>
  <view class="data-note"><text>数据口径</text><label>经营数据按所选成员或团队汇总；确收、回款按发生季度统计，预测按已填季度计划乘阶段概率计算，包含10%阶段。实际为0与未登记分别展示。商机榜和区域榜按所选季度预计关单的在推商机ACV排名；跟进榜按近7天已确认记录排名。完整榜单只展示授权范围内的汇总数据。</label></view>
</view>
</block>
</block>
