.ranking-scope-tabs{display:flex;gap:5rpx;margin-top:20rpx;padding:5rpx;border-radius:14rpx;background:#eaf1f8}.ranking-scope-tabs>view{flex:1;padding:11rpx 5rpx;border-radius:10rpx;text-align:center;color:#72899d;font-size:20rpx;font-weight:650}.ranking-scope-tabs>view.selected{color:white;background:linear-gradient(110deg,#1d588a,#2784cf);box-shadow:0 4rpx 10rpx #23619c24}
.distinct-ranking .rank-badge{border-radius:50%}.distinct-ranking .rank-name>label{line-height:1.5}.distinct-ranking .ranking-row{padding:17rpx 0}.distinct-ranking .rank-track{height:7rpx}.ranking-permission-note{padding:12rpx 14rpx;margin-top:12rpx;border-radius:12rpx;background:#f0f4f8;font-size:15rpx}.ranking-permission-note>text{display:inline-block;margin:0 0 0 12rpx}
.ranking-followup .ranking-symbol{background:#d9f1e5;color:#23835e}.ranking-followup .rank-track>view{background:linear-gradient(90deg,#26966d,#73c49c)}.ranking-followup .rank-amount,.ranking-followup .ranking-card-total>text{color:#237d5b}.ranking-followup .rank-track{background:#e8f3ed}
.ranking-followup .ranking-scope-tabs{background:#e7f3ed}.ranking-followup .ranking-scope-tabs>view.selected{background:linear-gradient(110deg,#237d5b,#35ad80);box-shadow:0 4rpx 10rpx #237d5b24}
.ranking-region .ranking-symbol{background:#fae9cf;color:#a56a25}.ranking-region .rank-track>view{background:linear-gradient(90deg,#cd8c3b,#e9bb71)}.ranking-region .rank-amount,.ranking-region .ranking-card-total>text{color:#a46d2b}.ranking-region .rank-track{background:#f9efdf}

.dashboard-quarter-filter{padding:22rpx;margin-top:18rpx;border:1rpx solid #d6e6f4;border-radius:22rpx;background:#fff}.dashboard-quarter-head{display:flex;justify-content:space-between;align-items:center;color:#486a86;font-size:23rpx;font-weight:700}.dashboard-quarter-head picker{color:#2878b8;padding:8rpx 12rpx;border-radius:10rpx;background:#edf5fd}.dashboard-quarter-options{display:flex;gap:12rpx;margin-top:20rpx}.dashboard-quarter-options>view{flex:1;padding:16rpx 4rpx;text-align:center;border:1rpx solid #dce7f1;border-radius:13rpx;color:#70879d;background:#f6f9fc;font-size:24rpx;font-weight:700}.dashboard-quarter-options>view.selected{border-color:#8ac1ed;background:#e7f3ff;color:#2077b9}.dashboard-quarter-footer{display:flex;align-items:center;gap:14rpx;margin-top:18rpx;font-size:20rpx}.dashboard-quarter-footer>text{padding:10rpx 0;color:#2879b9;font-weight:700}.dashboard-quarter-footer>label{flex:1;color:#8a9bad;font-size:17rpx}.dashboard-quarter-footer>view{padding:10rpx 20rpx;border-radius:10rpx;background:#267cc1;color:#fff}


.view-scope-note{padding:24rpx 8rpx 18rpx}.view-scope-note>text{display:block;font-size:30rpx;font-weight:700;color:#254766}.view-scope-note>label{display:block;font-size:22rpx;color:#7890a6;margin-top:8rpx;line-height:1.5}

.page-heading{flex-shrink:0}.page-head{gap:24rpx}
.quarter-picker{display:flex;align-items:center;justify-content:center;gap:16rpx;box-sizing:border-box;min-height:72rpx;max-width:440rpx;padding:16rpx 20rpx;border:1rpx solid #d3e3f2;border-radius:18rpx;background:#fff;color:#246ba7;box-shadow:0 4rpx 14rpx rgba(36,85,129,.06);flex-shrink:0}
