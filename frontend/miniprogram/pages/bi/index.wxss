.rank-track{height:6rpx;margin-top:8rpx;overflow:hidden;border-radius:999rpx;background:#edf2f7}
.rank-track view{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#2b7dcc,#55b2eb)}
.ranking-head>picker{flex:0 0 auto}.ranking-picker{padding:10rpx 14rpx;border:1rpx solid #d9e5f1;border-radius:13rpx;background:#f1f7fd;color:#286ca8;font-size:18rpx;font-weight:700}.ranking-picker text{margin-left:6rpx;font-size:13rpx}.ranking-team-row{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-top:16rpx;padding:10rpx 13rpx;border-radius:12rpx;background:#f5f8fc;color:#8293a7;font-size:16rpx}.ranking-team-picker{color:#286ca8;max-width:380rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ranking-scope-note{display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap;color:#8798a9;font-size:14rpx;line-height:1.5}.ranking-scope-note>text{color:#3179b9}.ranking-message{padding:25rpx 8rpx 12rpx;color:#8293a7;font-size:17rpx;line-height:1.7}.ranking-message>text{display:block;margin-top:10rpx;color:#2675b5}
