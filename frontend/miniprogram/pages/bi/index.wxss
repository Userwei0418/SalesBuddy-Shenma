.region-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11rpx;margin-top:18rpx}.region-card{min-width:0;padding:15rpx;border:1rpx solid #e4ecf3;border-radius:18rpx;background:linear-gradient(145deg,#f8fbfe,#f1f7fc)}.region-card>view{gap:7rpx}.region-card>view i{width:10rpx;height:10rpx;flex:0 0 auto;border-radius:50%;font-style:normal}.region-card>view text{min-width:0;flex:1;overflow:hidden;color:#526a81;font-size:16rpx;font-weight:700;white-space:nowrap;text-overflow:ellipsis}.region-card>view label{color:#2a78b9;font-size:15rpx;font-weight:780}.region-card>text{display:block;margin-top:11rpx;color:#1e659f;font-size:21rpx;font-weight:820}.region-card>label{display:block;margin-top:3rpx;color:#95a2af;font-size:13rpx}
