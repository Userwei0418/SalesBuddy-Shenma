.visit-day.today>text{color:#2674b4;font-weight:750}
.timeline-status{display:inline-block;margin-top:9rpx;padding:3rpx 8rpx;border-radius:999rpx;color:#6c8296;background:#edf3f8;font-size:11rpx}
.timeline-status+text{margin-top:5rpx}
.region-card>.region-progress{display:block;height:6rpx;margin-top:10rpx;overflow:hidden;border-radius:999rpx;background:#e6edf4}
.region-card>.region-progress>view{height:100%;border-radius:999rpx}
.ranking-unassigned{margin-top:14rpx;padding:12rpx 14rpx;border-radius:12rpx;background:#fff7e9;color:#92713d;font-size:15rpx;line-height:1.5}.ranking-footnote{margin-top:12rpx;color:#93a1b0;font-size:14rpx;line-height:1.5}

