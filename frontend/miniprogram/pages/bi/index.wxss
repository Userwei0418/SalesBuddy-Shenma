.ring-card{display:flex;align-items:center;gap:12rpx;min-height:164rpx}.mini-ring{width:86rpx;height:86rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:50%}.mini-ring>view{width:62rpx;height:62rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:50%;background:#fff}.mini-ring text{font-size:19rpx;font-weight:850}.mini-ring label{margin-top:1rpx;color:#97a4b2;font-size:10rpx}.ring-copy{min-width:0;flex:1}.ring-copy>text{display:block;color:#41566c;font-size:16rpx;font-weight:720}.ring-copy>label{display:block;margin-top:6rpx;color:#1e354d;font-size:13rpx;font-weight:780;line-height:1.25;white-space:nowrap;letter-spacing:-.4rpx}.ring-copy>view{margin-top:3rpx;color:#8797a7;font-size:12rpx;line-height:1.25;white-space:nowrap;letter-spacing:-.3rpx}.ring-copy>i{display:inline-block;margin-top:6rpx;padding:3rpx 7rpx;border-radius:8rpx;color:#a06b35;background:#fff3df;font-size:12rpx;font-style:normal}
.value-card>label{display:block;color:#60768c;font-size:17rpx}.value-card>text{display:block;margin-top:13rpx;color:#173c63;font-size:29rpx;font-weight:860;line-height:1.05;white-space:nowrap;letter-spacing:-.8rpx}.value-card>text.compact-value{font-size:20rpx;letter-spacing:-.7rpx}.value-card>view{margin-top:12rpx;color:#8b9aab;font-size:15rpx;line-height:1.35}.tone-blue{background:linear-gradient(145deg,#edf6ff,#fff)}.tone-violet{background:linear-gradient(145deg,#f2efff,#fff)}.tone-amber{background:linear-gradient(145deg,#fff7df,#fff)}.tone-mint{background:linear-gradient(145deg,#eaf9f4,#fff)}
.chart-card{padding:22rpx}.section-head{gap:14rpx}.section-head>view{min-width:0}.section-head>view>text{display:block;color:#213b56;font-size:24rpx;font-weight:790}.section-head>view>label{display:block;margin-top:5rpx;color:#93a1b0;font-size:15rpx;line-height:1.4}.section-head>i{flex:0 0 auto;color:#3179b9;font-size:17rpx;font-weight:750;font-style:normal}
.funnel-list{margin-top:19rpx}.funnel-row{position:relative;display:flex;align-items:center;justify-content:center;min-height:62rpx}.funnel-row>i{position:absolute;right:0;color:#8394a5;font-size:14rpx;font-style:normal}.funnel-bar{display:flex;align-items:center;justify-content:space-between;gap:10rpx;box-sizing:border-box;height:48rpx;padding:0 13rpx;border-radius:10rpx;color:#fff}.funnel-bar text{overflow:hidden;font-size:15rpx;font-weight:720;white-space:nowrap;text-overflow:ellipsis}.funnel-bar label{flex:0 0 auto;font-size:14rpx;font-weight:750}.funnel-bar.tone-0{background:linear-gradient(90deg,#ed8361,#f3a268)}.funnel-bar.tone-1{background:linear-gradient(90deg,#e8ad43,#f0ca62)}.funnel-bar.tone-2{background:linear-gradient(90deg,#75b789,#8ed1a4)}.funnel-bar.tone-3{background:linear-gradient(90deg,#5b9fd6,#78b8e4)}.funnel-bar.tone-4{background:linear-gradient(90deg,#5b75ba,#7992d2)}
.ranking-list{margin-top:14rpx}.ranking-row{gap:12rpx;padding:14rpx 0;border-bottom:1rpx solid #edf2f7}.ranking-row:last-child{border:0}.rank-badge{width:39rpx;height:39rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:13rpx;color:#55728d;background:#edf3f8;font-size:17rpx;font-weight:850}.rank-1{color:#946b15;background:#fff0b8}.rank-2{color:#4f7896;background:#e8f1f7}.rank-3{color:#a26d46;background:#f8e6d6}.rank-name{min-width:0;flex:1}.rank-name text{display:block;overflow:hidden;color:#344e68;font-size:19rpx;font-weight:720;white-space:nowrap;text-overflow:ellipsis}.rank-name label{display:block;margin-top:3rpx;color:#92a0ae;font-size:14rpx}.rank-amount{flex:0 0 auto;color:#286eab;font-size:18rpx;font-weight:780}.empty{grid-column:1/-1;padding:28rpx 10rpx;color:#9aa8b5;font-size:17rpx;text-align:center}
.visit-bars{height:205rpx;display:grid;grid-template-columns:repeat(7,1fr);gap:9rpx;margin-top:20rpx}.visit-day{display:flex;flex-direction:column;align-items:center}.bar-space{width:100%;height:137rpx;display:flex;align-items:flex-end;justify-content:center;border-radius:12rpx;background:linear-gradient(180deg,#f6f9fc,#edf3f8)}.bar-space i{width:18rpx;min-height:7rpx;border-radius:999rpx;background:linear-gradient(180deg,#5bd2a4,#22996c);font-style:normal}.visit-day text{margin-top:8rpx;color:#61778d;font-size:14rpx}.visit-day label{margin-top:2rpx;color:#a0acb8;font-size:12rpx}
