.ranking-followup{border-top-color:#25936b;background:linear-gradient(150deg,#eef9f3 0,#fff 44%)}
.ranking-region{border-top-color:#ca8734;background:linear-gradient(150deg,#fff7eb 0,#fff 44%)}
