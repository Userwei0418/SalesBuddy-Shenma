page { background:var(--ui-background); }
.login-page { min-height:100vh; color:var(--ui-ink); background:var(--ui-background); }
.product-hero { position:relative; overflow:hidden; padding:calc(constant(safe-area-inset-top) + 160rpx) 46rpx 86rpx; padding:calc(env(safe-area-inset-top) + 160rpx) 46rpx 86rpx; color:var(--ui-on-primary); background:var(--ui-sidebar); }
/* Use the supplied white RGBA logo directly; no device-dependent blending. */
.brand-row { position:relative; z-index:1; width:550rpx; max-width:100%; }
.brand-logo { display:block; width:100%; }
.welcome-copy { position:relative; z-index:1; margin-top:58rpx; }
.welcome-title { color:var(--ui-on-primary); font-size:20px; font-weight:600; line-height:1.65; }
.login-content { position:relative; z-index:2; margin-top:-40rpx; padding:0 30rpx calc(constant(safe-area-inset-bottom) + 28rpx); padding:0 30rpx calc(env(safe-area-inset-bottom) + 28rpx); }
/* 飞书：白卡放在灰底上，不描边 */
.login-panel { position:relative; padding:40rpx 32rpx; border-radius:var(--ui-radius-panel); background:var(--ui-surface); }
.panel-title { color:var(--ui-ink); font-size:20px; font-weight:600; line-height:1.4; }
.form-area { margin-top:32rpx; }
.field-group + .field-group { margin-top:var(--ui-space-2); }
/* 表单：标签在上 14px 常规字重正文色，下方 8px 是带框控件（与 sb-input stacked 一致；账号行的 8px 由 sb-input plain 自带的上边距给出） */
.field-row { display:flex; align-items:center; justify-content:space-between; gap:12rpx; min-height:20px; }
.field-label { color:var(--ui-ink); font-size:14px; font-weight:400; line-height:20px; }
/* 「切换账号」：视觉高 20px 随标签行，伪元素把点击区向上、两侧扩到 44px（不向下扩，和账号框留 8px）。
   外层与 t-button 都绑 switchAccount：点伪元素目标是外层；落到内层按钮（读屏双击）由 t-button 的 tap 接住，内层 catch:tap 不冒泡，不会触发两次 */
.switch-account { position:relative; flex:0 0 auto; --td-button-small-height:20px; --td-button-small-padding-horizontal:0; --td-button-small-font:400 14px / 20px var(--ui-font); }
.switch-account::after { content:""; position:absolute; left:-12px; right:-12px; top:calc(20px - var(--ui-touch-target)); bottom:0; }
/* 账号、密码、新密码：sb-input stacked plain（框高 40px、字号、眼睛点击区由组件与桥接给出） */
.login-input { display:block; }
.login-pressed { opacity:.7; }
/* 记住账号、同意协议：t-checkbox（默认圆形图标）；两行标题统一 14px 正文色，说明 12px */
.login-checks { margin:8rpx -20rpx 16rpx; --td-checkbox-vertical-padding:calc((var(--ui-touch-target) - 22px) / 2); --td-checkbox-title-color:var(--ui-ink); --td-checkbox-title-font:400 14px / 22px var(--ui-font); --td-checkbox-title-line-height:22px; --td-checkbox-description-color:var(--ui-muted); --td-checkbox-description-font:400 12px / 18px var(--ui-font); --td-checkbox-bg-color:transparent; }
.agreement-label { color:var(--ui-ink); font-size:14px; line-height:22px; }
.privacy-link { margin-left:4rpx; color:var(--ui-primary); }
.login-button { position:relative; display:flex; align-items:center; justify-content:center; width:100%; height:var(--ui-touch-target); padding:0 58rpx; border-radius:var(--ui-radius-control); background:var(--ui-primary); color:var(--ui-on-primary); font-size:var(--ui-text-body); font-weight:600; }
.login-button[disabled] { background:var(--ui-primary); color:var(--ui-on-primary); opacity:.65; }
.button-arrow { position:absolute; right:32rpx; font-size:20px; font-weight:400; line-height:1; }
.security-note { margin-top:32rpx; padding:0 12rpx; text-align:center; color:var(--ui-muted); font-size:var(--ui-text-small); line-height:1.6; }

/* Override native mini-program button sizing within the fixed grid tracks. */
.login-page .login-button[size="mini"] { width:100%; max-width:100%; margin:0; padding:0 58rpx; display:flex; }

.account-suggestions { margin-top:8rpx; overflow:hidden; border:1px solid var(--ui-line); border-radius:var(--ui-radius-control); background:var(--ui-surface); }
.suggestion-caption { padding:16rpx 24rpx 4rpx; color:var(--ui-muted); font-size:var(--ui-text-small); }
.login-page .account-suggestion[size="mini"] { display:flex; align-items:center; justify-content:space-between; gap:12rpx; width:100%; height:var(--ui-touch-target); margin:0; padding:0 20rpx; border-radius:0; background:transparent; color:var(--ui-ink); font-weight:400; line-height:normal; text-align:left; }
.account-suggestion::after { border:0; }
.suggestion-account { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:14px; }
.suggestion-action { flex-shrink:0; color:var(--ui-primary); font-size:14px; }

/* Company entry additions use the A package tokens and existing form rhythm. */
.company-entry-group { margin-bottom:var(--ui-space-2); }
.company-card { margin-top:8px; padding:var(--ui-space-2); border:1px solid var(--ui-line); border-radius:var(--ui-radius-control); background:var(--ui-surface); }
.company-name { color:var(--ui-ink); font-size:14px; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.company-code { margin-top:4px; color:var(--ui-muted); font-size:var(--ui-text-small); line-height:1.6; overflow-wrap:anywhere; }
.company-editor { margin-top:var(--ui-space-2); }
.login-page .company-link[size="mini"] { width:auto; min-height:var(--ui-touch-target); margin:0; padding:0; background:transparent; color:var(--ui-primary); font-size:14px; line-height:var(--ui-touch-target); font-weight:400; }
.company-link::after { border:0; }
.company-link[disabled] { color:var(--ui-muted); }
.company-error { margin-top:8px; color:var(--ui-danger); font-size:var(--ui-text-small); line-height:1.6; }
.company-switch-note { margin-top:var(--ui-space-2); color:var(--ui-ink); font-size:14px; line-height:1.65; }
.company-switch-note .company-link { display:block; text-align:left; margin-top:4px; }

/* Phone-first login and device-encrypted memory controls. */
.company-entry-panel { margin-bottom: 28rpx; }
.login-mode-hint { margin-top: 12rpx; font-size: 21rpx; color: #8290a1; line-height: 1.6; }
.login-mode-hint text,.forget-memory text { color: #225e91; }
.login-alternatives { margin-top: 18rpx; text-align: center; }
.login-help { padding: 18rpx 22rpx; margin-top: 10rpx; border-radius: 14rpx; background: #f6f8fb; font-size: 21rpx; color: #7f8b9b; text-align: left; line-height: 1.6; }
.login-help-actions { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; margin-top: 10rpx; }
.forget-memory { text-align: right; font-size: 20rpx; line-height: 1.6; }
