<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view wx:if="{{risk}}" class="detail-page status-{{risk.status}} traffic-{{risk.signal.tone}}">
  <view class="detail-hero">
    <sb-summary-card appearance="soft" tone="{{risk.signal.tone === 'red' ? 'bad' : risk.signal.tone === 'yellow' ? 'watch' : ''}}" title="{{risk.customerName}}" subtitle="{{risk.title}}" meta="{{risk.owner}} · {{risk.team}}" tags="{{[{label:risk.signal.label + ' · ' + risk.statusLabel,tone:risk.signal.tone === 'red' ? 'bad' : risk.signal.tone === 'yellow' ? 'watch' : risk.signal.tone === 'green' ? 'good' : 'pending'},{label:risk.severity + '风险'}]}}" />
  </view>

  <view class="detail-body">
    <view class="section-card summary-card"><view class="section-title">风险说明</view><view class="summary-text">{{risk.description}}</view><view class="summary-time">识别于 {{risk.openedLabel}}</view></view>

    <view class="section-card evidence-card"><view class="section-title">判断依据</view><view wx:for="{{risk.evidence}}" wx:key="*this" class="evidence-row"><view>{{index + 1}}</view><text>{{item}}</text></view></view>

    <view class="section-card action-card"><view class="section-title">建议下一步</view><view class="action-text">{{risk.nextAction}}</view></view>

    <view wx:if="{{risk.status === 'resolved'}}" class="section-card resolved-card"><view class="resolved-main"><view class="resolved-head"><sb-status-tag tone="good" label="已解除" /><text>{{risk.resolvedBy}} 已解除风险</text></view><label>{{risk.resolvedLabel}}</label><view class="resolved-note">{{risk.resolutionNote}}</view></view></view>

    <view wx:else class="section-card resolution-card"><view class="section-title">解除风险</view><view class="resolution-help">请填写已消除风险的事实依据，便于管理者和后续跟进人员追溯。</view><sb-textarea layout="stacked" plain maxlength="{{500}}" value="{{resolutionNote}}" placeholder="例如：客户已确认下一步方案和时间，原风险事项已闭环" bind:change="inputResolutionNote" /></view>
  </view>

  <sb-bottom-bar wx:if="{{risk.status !== 'resolved' && canResolveRisk}}" class="bottom-bar" primaryLabel="确认解除风险" loading="{{submitting}}" loadingLabel="正在同步" bind:primary="confirmResolve" note="解除记录会保留处理人、时间和依据" inactive="{{noteCount < 5}}" disabledReason="请填写风险解除依据（至少 5 个字）" />
</view>

</block>
