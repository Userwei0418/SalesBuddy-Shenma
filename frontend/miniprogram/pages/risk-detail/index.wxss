page{background:var(--ui-background)}
.detail-page{min-height:100vh;padding-bottom:calc(260rpx + constant(safe-area-inset-bottom));padding-bottom:calc(260rpx + env(safe-area-inset-bottom));color:var(--ui-ink);background:var(--ui-background)}
.detail-hero{margin:24rpx 32rpx 0}
.detail-body{display:flex;flex-direction:column;gap:16rpx;padding:16rpx 32rpx 24rpx}
/* 飞书：白卡放在灰底上，不描边；卡内分组用分隔线 */
.section-card{padding:32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.section-title{margin:0;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;line-height:1.45}
.summary-text{margin-top:16rpx;color:var(--ui-ink);font-size:14px;line-height:1.7;white-space:pre-wrap}
.summary-time{margin-top:16rpx;padding-top:16rpx;border-top:1px solid var(--ui-line);color:var(--ui-secondary);font-size:var(--ui-text-small)}
.evidence-row{display:flex;align-items:flex-start;gap:16rpx;margin-top:16rpx}
.evidence-row>view{flex:0 0 auto;min-width:32rpx;color:var(--ui-secondary);font-size:14px;font-weight:600;line-height:1.55;font-variant-numeric:tabular-nums}
.evidence-row>text{color:var(--ui-ink);font-size:14px;line-height:1.55}
.action-text{margin-top:12rpx;color:var(--ui-ink);font-size:14px;line-height:1.6}
.resolution-help{margin-top:12rpx;color:var(--ui-secondary);font-size:14px;line-height:1.6}
.resolution-card .sb-textarea{margin-top:16rpx}
.resolved-main{min-width:0}
.resolved-head{display:flex;align-items:center;gap:16rpx}
.resolved-head>text{color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.resolved-main>label{display:block;margin-top:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.resolved-main>.resolved-note{margin-top:16rpx;padding-top:16rpx;border-top:1px solid var(--ui-line);color:var(--ui-ink);font-size:14px;line-height:1.6}


/* Palette only: original geometry is preserved. */
.status-open .summary-text { color:var(--sb-alert-ink); }

.risk-load-state{margin:32rpx;padding:32rpx;background:var(--ui-surface);font-size:28rpx;line-height:1.6}
.decision-options{display:flex;gap:16rpx;margin:24rpx 0}
.decision-options button{flex:1;min-width:0;margin:0;padding:0 12rpx;font-size:28rpx}
.decision-options .selected{color:var(--ui-primary);background:var(--ui-primary-soft)}
.decision-notice{margin:16rpx 0;color:var(--ui-secondary);font-size:26rpx;line-height:1.6;word-break:break-all}
.decision-submit{margin-top:24rpx;color:var(--ui-primary);font-size:28rpx}
.risk-history{margin-top:20rpx;padding-top:20rpx;border-top:1px solid var(--ui-line);font-size:26rpx;line-height:1.6;word-break:break-all}
.risk-history text,.risk-history label{display:block;margin-top:8rpx}
.risk-history label{color:var(--ui-secondary);font-size:24rpx}
.summary-text,.action-text,.resolved-note,.evidence-row>text{min-width:0;word-break:break-all;white-space:pre-wrap}
