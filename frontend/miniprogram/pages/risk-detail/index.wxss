page{background:#f7f1ed}.detail-page{min-height:100vh;padding-bottom:175rpx;color:#302a28;background:radial-gradient(circle at 93% 2%,rgba(238,141,85,.18),transparent 30%),linear-gradient(155deg,#fffdfb,#f8f3ef 56%,#f2ece8)}.detail-hero{padding:37rpx 31rpx 33rpx;color:#fff;background:radial-gradient(circle at 93% 0,rgba(255,178,124,.6),transparent 35%),linear-gradient(145deg,#4b2e29,#b85f3e);box-shadow:0 20rpx 46rpx rgba(130,69,45,.2)}.status-resolved .detail-hero{background:radial-gradient(circle at 93% 0,rgba(106,208,163,.55),transparent 36%),linear-gradient(145deg,#183e38,#2b9671)}.hero-top{display:flex;align-items:center;justify-content:space-between}.hero-state{display:flex;align-items:center;gap:8rpx;color:rgba(255,255,255,.86);font-size:18rpx;font-weight:700}.hero-state text{width:9rpx;height:9rpx;border-radius:50%;background:#ffbd93;box-shadow:0 0 13rpx rgba(255,189,147,.8)}.status-resolved .hero-state text{background:#9af0c8}.hero-level{padding:7rpx 12rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:999rpx;background:rgba(255,255,255,.09);font-size:16rpx}.hero-customer{margin-top:23rpx;font-size:36rpx;font-weight:800;line-height:1.35}.hero-title{margin-top:10rpx;color:rgba(255,255,255,.9);font-size:23rpx;font-weight:650}.hero-meta{margin-top:9rpx;color:rgba(255,255,255,.64);font-size:18rpx}.detail-body{display:flex;flex-direction:column;gap:16rpx;padding:24rpx 27rpx}.section-card{border:1rpx solid rgba(255,255,255,.95);border-radius:25rpx;background:rgba(255,255,255,.84);box-shadow:0 14rpx 38rpx rgba(86,56,41,.07);backdrop-filter:blur(25rpx)}.summary-card,.evidence-card,.resolution-card{padding:22rpx}.section-eyebrow{color:#a57e6b;font-size:16rpx;font-weight:700;letter-spacing:2.3rpx}.section-title{margin-top:5rpx;color:#3d332f;font-size:25rpx;font-weight:760}.summary-text{margin-top:15rpx;color:#655952;font-size:21rpx;line-height:1.7;white-space:pre-wrap}.summary-time{margin-top:14rpx;padding-top:13rpx;border-top:1rpx solid rgba(119,83,64,.09);color:#9b8b82;font-size:16rpx}.evidence-row{display:flex;align-items:flex-start;gap:13rpx;margin-top:15rpx}.evidence-row>view{width:37rpx;height:37rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:12rpx;color:#b45c3d;background:#ffebe2;font-size:15rpx;font-weight:740}.evidence-row>text{padding-top:3rpx;color:#62564f;font-size:20rpx;line-height:1.55}.action-card{display:flex;align-items:flex-start;gap:15rpx;padding:21rpx;border-color:rgba(205,127,82,.16);background:linear-gradient(145deg,rgba(255,252,249,.94),rgba(255,239,229,.88))}.action-icon{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:16rpx;color:#fff;background:linear-gradient(145deg,#9c5035,#df805b);font-size:23rpx}.action-card>view:last-child{min-width:0;flex:1}.action-card text{display:block;color:#9a4c32;font-size:20rpx;font-weight:730}.action-card label{display:block;margin-top:5rpx;color:#775f54;font-size:19rpx;line-height:1.55}.resolution-help{margin-top:8rpx;color:#8e7f77;font-size:17rpx;line-height:1.5}.resolution-card textarea{width:100%;min-height:150rpx;box-sizing:border-box;margin-top:16rpx;padding:17rpx;border:1rpx solid rgba(123,84,63,.11);border-radius:18rpx;color:#554943;background:#faf6f3;font-size:20rpx;line-height:1.6}.note-count{margin-top:8rpx;color:#a09289;font-size:15rpx;text-align:right}.resolved-card{display:flex;align-items:flex-start;gap:16rpx;padding:21rpx;border-color:rgba(100,192,149,.2);background:linear-gradient(145deg,rgba(245,255,250,.94),rgba(230,248,239,.88))}.resolved-icon{width:51rpx;height:51rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:17rpx;color:#fff;background:linear-gradient(145deg,#357e62,#63bd92);font-size:22rpx}.resolved-main{min-width:0;flex:1}.resolved-main>text{display:block;color:#2d6f56;font-size:22rpx;font-weight:760}.resolved-main>label{display:block;margin-top:4rpx;color:#79a08e;font-size:16rpx}.resolved-main>view{margin-top:12rpx;padding-top:12rpx;border-top:1rpx solid rgba(73,151,114,.12);color:#4d705f;font-size:20rpx;line-height:1.55}.bottom-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;padding:14rpx 25rpx calc(15rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(255,255,255,.92);background:rgba(252,249,247,.92);box-shadow:0 -10rpx 34rpx rgba(86,56,41,.08);backdrop-filter:blur(28rpx)}.resolve-button{width:100%;height:83rpx;display:flex;align-items:center;justify-content:center;gap:12rpx;border-radius:22rpx;color:#fff;background:linear-gradient(135deg,#245f4b,#42aa7f);box-shadow:0 12rpx 28rpx rgba(43,148,105,.22);font-size:24rpx;font-weight:740}.resolve-button text{font-size:25rpx}.resolve-button.disabled{opacity:.45}.bottom-bar>view{margin-top:8rpx;color:#988a82;font-size:16rpx;text-align:center}
