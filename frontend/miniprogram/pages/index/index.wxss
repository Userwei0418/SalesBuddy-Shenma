.tone-red{border-color:#ecc1bb;background:linear-gradient(145deg,#fffdfd,#fff0ee)}.tone-red .business-action,.tone-red .business-eyebrow{color:#ba5247}.change-status{display:flex;align-items:center;gap:7rpx;white-space:nowrap;border-radius:20rpx;background:#e9f2fb;padding:8rpx 12rpx;color:#387ba9;font-size:19rpx}.change-status>text{width:9rpx;height:9rpx;border-radius:50%;background:currentColor}.tone-green .change-status{color:#258263;background:#e4f5eb}.tone-red .change-status{color:#bc564a;background:#ffe8e3}.tone-orange .change-status{color:#aa6b25;background:#fff1dc}.change-footer{font-size:21rpx;color:#7c91a6;margin:16rpx 0}.business-row>view:first-child{min-width:0}.business-row label{white-space:normal;overflow-wrap:anywhere}

