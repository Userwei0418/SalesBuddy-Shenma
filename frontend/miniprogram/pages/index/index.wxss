te>label{display:block;margin-top:5rpx;color:#627c72;font-size:16rpx;line-height:1.5}.assignment-empty{display:flex;flex-direction:column;align-items:center;padding:70rpx 20rpx}.assignment-empty>view{width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;border-radius:23rpx;color:#fff;background:linear-gradient(145deg,#27805f,#48bb8d);font-size:29rpx}.assignment-empty>text{margin-top:17rpx;color:#345044;font-size:22rpx;font-weight:700}.assignment-empty>label{margin-top:7rpx;color:#8a9a92;font-size:16rpx}.assignment-footer{display:grid;grid-template-columns:1fr 1.45fr;gap:12rpx;flex:0 0 auto;padding:13rpx 25rpx calc(15rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(72,103,137,.08);background:rgba(247,251,255,.94);-webkit-backdrop-filter:blur(22rpx);backdrop-filter:blur(22rpx)}.assignment-footer button{height:82rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;font-size:21rpx;font-weight:680}.assignment-cancel{border:1rpx solid rgba(70,111,153,.15);color:#315875;background:rgba(255,255,255,.78)}.assignment-confirm{color:#fff;background:linear-gradient(145deg,#183d61,#147ee4);box-shadow:0 11rpx 25rpx rgba(20,91,166,.2)}.assignment-confirm.disabled{opacity:.43}
