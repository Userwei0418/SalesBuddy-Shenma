page {
  height: 100%;
  overflow: hidden;
  background: #f3f7fc;
}

.assistant-page {
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 26rpx 28rpx 0;
  color: #172235;
  background:
    linear-gradient(150deg, rgba(255,255,255,.9) 0%, rgba(243,248,254,.96) 48%, rgba(233,242,252,.98) 100%);
}

.overview-fixed {
  position: relative;
  z-index: 3;
  flex: 0 0 auto;
}

.workspace-head {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 8rpx 2rpx 20rpx;
}

.greeting {
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.workspace-meta {
  margin-top: 8rpx;
  color: #77869b;
  font-size: 22rpx;
  line-height: 1.2;
}

.scope-pill {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 9rpx;
  padding: 11rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,.95);
  border-radius: 999rpx;
  color: #2f659d;
  background: rgba(255,255,255,.62);
  box-shadow: 0 8rpx 24rpx rgba(29,69,119,.07);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  font-size: 21rpx;
  font-weight: 600;
}

.scope-pill text {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1682ee;
  box-shadow: 0 0 0 6rpx rgba(22,130,238,.1);
}

.brief-card {
  overflow: hidden;
  padding: 26rpx 26rpx 24rpx;
  color: #fff;
  border: 1rpx solid rgba(255,255,255,.16);
  border-radius: 30rpx;
  background:
    radial-gradient(ellipse at top right, rgba(68,149,222,.3), transparent 65%),
    linear-gradient(125deg,#153b61,#1b639d);
  box-shadow: 0 14rpx 36rpx rgba(20,64,104,.16), inset 0 1rpx 0 rgba(255,255,255,.18);
  -webkit-backdrop-filter: blur(30rpx) saturate(145%);
  backdrop-filter: blur(30rpx) saturate(145%);
}

.brief-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.brief-eyebrow {
  color: #a9cbe7;
  font-size: 17rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
}

.brief-title {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 720;
  color: #fff;
}

.brief-link {
  color: #3977b7;
  font-size: 21rpx;
  font-weight: 600;
}

.brief-link text {
  margin-left: 5rpx;
  font-size: 27rpx;
}

.brief-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(225,239,250,.16);
}

.brief-metric {
  position: relative;
  display: flex;
  flex-direction: column;
  padding-left: 22rpx;
}

.brief-metric:first-child {
  padding-left: 0;
}

.brief-metric + .brief-metric::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 1rpx;
  height: 55rpx;
  background: rgba(221,238,255,.17);
}

.metric-num {
  color: #fff;
  font-size: 38rpx;
  font-weight: 760;
  line-height: 1;
}

.metric-num.risk {
  color: #fff;
}

.metric-label {
  margin-top: 10rpx;
  color: #c6dcec;
  font-size: 20rpx;
}

.conversation-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 2rpx 20rpx;
}

.conversation-title {
  display: flex;
  align-items: center;
  gap: 11rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.online-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #35a77a;
  box-shadow: 0 0 0 7rpx rgba(53,167,122,.1);
}

.conversation-time {
  color: #98a3b2;
  font-size: 19rpx;
}

.chat-stream {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.agent-avatar {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  border: 1rpx solid rgba(255,255,255,.8);
  border-radius: 18rpx;
  color: #fff;
  background: linear-gradient(145deg, #1d4f82, #1683ee);
  box-shadow: 0 9rpx 22rpx rgba(24,101,182,.2), inset 0 1rpx 1rpx rgba(255,255,255,.35);
}

.agent-avatar text {
  font-size: 26rpx;
}

.message-stack {
  max-width: 590rpx;
}

.message-meta {
  margin: 0 0 9rpx 4rpx;
  color: #4f6076;
  font-size: 20rpx;
  font-weight: 650;
}

.message-meta text {
  margin-left: 12rpx;
  color: #a0aab7;
  font-size: 17rpx;
  font-weight: 400;
}

.bubble {
  padding: 21rpx 24rpx;
  border: 1rpx solid rgba(255,255,255,.92);
  border-radius: 8rpx 25rpx 25rpx 25rpx;
  color: #26364b;
  background: rgba(255,255,255,.72);
  box-shadow: 0 10rpx 30rpx rgba(31,68,112,.07), inset 0 1rpx 0 rgba(255,255,255,.72);
  -webkit-backdrop-filter: blur(22rpx);
  backdrop-filter: blur(22rpx);
  font-size: 26rpx;
  line-height: 1.65;
}

.user .bubble {
  border-color: rgba(255,255,255,.14);
  border-radius: 25rpx 8rpx 25rpx 25rpx;
  color: #fff;
  background: linear-gradient(135deg, #183d64, #1675d8);
  box-shadow: 0 10rpx 28rpx rgba(18,91,171,.16);
}

.user-time {
  margin: 8rpx 5rpx 0 0;
  color: #a0aab7;
  font-size: 17rpx;
  text-align: right;
}

/* Customer dispatch stays inside the Agent conversation until confirmed */
