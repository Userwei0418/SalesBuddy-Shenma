.insight-bubble {
  padding: 23rpx 24rpx 22rpx;
  border: 1rpx solid rgba(181,210,240,.72);
  border-radius: 8rpx 26rpx 26rpx 26rpx;
  background: linear-gradient(145deg, rgba(250,253,255,.92), rgba(231,243,255,.78));
  box-shadow: 0 12rpx 32rpx rgba(28,84,143,.09), inset 0 1rpx 0 rgba(255,255,255,.82);
}

.insight-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.insight-badge {
  display: flex;
  align-items: center;
  gap: 9rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #b85432;
  background: rgba(255,235,225,.8);
  font-size: 18rpx;
  font-weight: 650;
}

.insight-badge text {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #dd6c42;
}

.insight-type {
  color: #8190a4;
  font-size: 18rpx;
}

.insight-title {
  margin-top: 18rpx;
  color: #1d2d42;
  font-size: 27rpx;
  font-weight: 720;
  line-height: 1.4;
}

.insight-copy {
  margin-top: 10rpx;
  color: #617188;
  font-size: 23rpx;
  line-height: 1.62;
}

.insight-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid rgba(68,109,152,.1);
  color: #176fca;
  font-size: 22rpx;
  font-weight: 650;
}

.insight-link text {
  font-size: 27rpx;
}

.result-card {
  width: 570rpx;
  padding: 23rpx;
  border: 1rpx solid rgba(183,211,239,.72);
  border-radius: 8rpx 26rpx 26rpx 26rpx;
  background: rgba(255,255,255,.78);
  box-shadow: 0 12rpx 32rpx rgba(28,84,143,.09);
}
.management-result{border-color:rgba(143,209,225,.6);background:linear-gradient(145deg,rgba(250,254,255,.96),rgba(225,246,250,.88))}.management-result .result-action{color:#17799b}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(75,111,149,.1);
}

.result-title {
  font-size: 28rpx;
  font-weight: 720;
}

.result-sub {
  margin-top: 7rpx;
  color: #8492a5;
  font-size: 20rpx;
}

.confidence {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(49,160,113,.14);
  border-radius: 50%;
  color: #21825f;
  background: rgba(228,247,239,.82);
  font-size: 20rpx;
  font-weight: 700;
}

.result-line {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 17rpx;
  color: #4a5a70;
  font-size: 22rpx;
}

.result-line text:first-child {
  color: #8794a6;
}

.positive {
  color: #21825f;
  font-weight: 700;
}

.result-action {
  display: flex;
  justify-content: space-between;
  margin-top: 19rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid rgba(75,111,149,.1);
  color: #176fca;
  font-size: 22rpx;
  font-weight: 650;
}

.prompt-label {
  margin: 0 2rpx 12rpx;
  color: #7b899c;
  font-size: 20rpx;
}

.quick-action-bar {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0;
  width: 100%;
  margin-bottom: 4rpx;
  padding-top: 8rpx;
}
