.quick-action-icon{display:flex;align-items:center;justify-content:center;flex:0 0 auto}.action-visit .quick-action-icon{width:70rpx;height:70rpx;border:1rpx solid rgba(255,255,255,.4);border-radius:50%;background:linear-gradient(145deg,rgba(255,255,255,.25),rgba(255,255,255,.1));box-shadow:inset 0 1rpx 0 rgba(255,255,255,.3)}.visit-entry-microphone{display:block;width:42rpx;height:42rpx}
.quick-action-button.recording{background:linear-gradient(135deg,#a63f35,#e96d52);box-shadow:0 12rpx 28rpx rgba(185,70,53,.26)}.quick-action-button.recording .quick-action-icon{border-color:rgba(255,255,255,.38);background:rgba(255,255,255,.18)}.quick-action-pressed{opacity:.84;transform:scale(.975)}

.greeting-card { padding: 24rpx 25rpx 22rpx; border: 1rpx solid rgba(143,209,225,.58); border-radius: 25rpx; background: linear-gradient(145deg, rgba(250,254,255,.97), rgba(225,246,250,.9)); box-shadow: 0 12rpx 30rpx rgba(31,105,135,.1); }
.greeting-card-eyebrow { color: #6e93a7; font-size: 17rpx; font-weight: 700; letter-spacing: 2.2rpx; }
.greeting-card-title { margin-top: 12rpx; color: #183655; font-size: 30rpx; font-weight: 760; }
.greeting-card-copy { margin-top: 9rpx; color: #4d6b82; font-size: 22rpx; line-height: 1.55; }
.greeting-card-note { margin-top: 17rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(77,145,169,.14); color: #6b8a9d; font-size: 19rpx; }

.composer-wrap {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 24rpx 4rpx;
  background: linear-gradient(180deg, rgba(239,246,253,.3), rgba(239,246,253,.94) 28%);
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
}

.voice-composer {
  display: flex;
  align-items: center;
  height: 96rpx;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 11rpx 13rpx;
  border: 1rpx solid rgba(255,255,255,.96);
  border-radius: 29rpx;
  background: rgba(255,255,255,.78);
  box-shadow: 0 18rpx 46rpx rgba(25,70,120,.13), inset 0 1rpx 0 rgba(255,255,255,.9);
  -webkit-backdrop-filter: blur(30rpx) saturate(150%);
  backdrop-filter: blur(30rpx) saturate(150%);
  transition: border-color .2s ease, background .2s ease, transform .16s ease;
}

.voice-state-icon {
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,.25);
  border-radius: 23rpx;
  background: linear-gradient(145deg,#194a77,#1682ee);
  box-shadow: 0 10rpx 24rpx rgba(18,93,174,.22), inset 0 1rpx 1rpx rgba(255,255,255,.3);
}

.chatbi-mark{color:#fff;font-size:18rpx;font-weight:800;letter-spacing:.6rpx}.voice-toggle.chatbi-voice{min-width:102rpx;padding:0 15rpx}

.voice-composer-copy {
  flex: 1;
  min-width: 0;
  margin-left: 17rpx;
  color: #263d58;
  font-size: 24rpx;
  font-weight: 650;
}

.voice-composer-copy > view {
  height: 32rpx;
  overflow: hidden;
  line-height: 32rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.recording-active .voice-composer-copy {
  cursor: pointer;
}

.voice-composer-copy text {
  display: block;
  height: 24rpx;
  margin-top: 6rpx;
  color: #8493a6;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 24rpx;
  white-space: nowrap;
}

.composer-input-wrap {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  margin-left: 17rpx;
}

.composer-input {
  width: 100%;
  height: 40rpx;
  color: #263d58;
  font-size: 23rpx;
  line-height: 40rpx;
}

.composer-input::placeholder {
  color: #8090a4;
}

.composer-input-wrap > text {
  display: block;
  height: 22rpx;
  margin-top: 4rpx;
  color: #9aa6b5;
  font-size: 16rpx;
  line-height: 22rpx;
  white-space: nowrap;
}

.send-button {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  border-radius: 20rpx;
  color: #fff;
  background: linear-gradient(145deg,#194a77,#1682ee);
  box-shadow: 0 9rpx 22rpx rgba(18,93,174,.22), inset 0 1rpx 1rpx rgba(255,255,255,.3);
  font-size: 31rpx;
  font-weight: 500;
}

.send-button:active {
  transform: scale(.94);
}

.voice-toggle {
  min-width: 72rpx;
  height: 54rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 13rpx;
  padding: 0 13rpx;
  border-radius: 999rpx;
  color: #1677dc;
  background: rgba(225,240,255,.82);
  font-size: 19rpx;
  font-weight: 700;
}

.voice-composer.recording-active {
  border-color: rgba(223,91,72,.28);
  background: rgba(255,249,247,.9);
  box-shadow: 0 18rpx 48rpx rgba(183,75,56,.12), inset 0 1rpx 0 rgba(255,255,255,.95);
}

.recording-active .voice-state-icon,
.stopping .voice-state-icon {
  background: linear-gradient(145deg,#c84942,#eb745b);
  box-shadow: 0 10rpx 26rpx rgba(197,72,58,.25), inset 0 1rpx 1rpx rgba(255,255,255,.3);
}

.recording-active .voice-toggle,
.stopping .voice-toggle {
  color: #c34d43;
  background: rgba(255,229,224,.88);
  font-variant-numeric: tabular-nums;
}

.voice-composer.starting,
.voice-composer.processing {
  opacity: .82;
}

.starting .voice-state-icon,
.processing .voice-state-icon {
  background: linear-gradient(145deg,#52779b,#78a4ce);
}

.starting .voice-toggle,
.processing .voice-toggle {
  color: #53728f;
  background: rgba(230,238,246,.88);
}

.voice-privacy {
  margin-top: 10rpx;
  color: #95a1b1;
  font-size: 16rpx;
  letter-spacing: .4rpx;
  text-align: center;
}

.wave {
  height: 28rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.wave text {
  width: 3rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #fff;
}

.wave text:nth-child(2),.wave text:nth-child(4) { height: 21rpx; }
.wave text:nth-child(3) { height: 28rpx; }
.recording-active .wave text { animation: wave .65s ease-in-out infinite alternate; }
.recording-active .wave text:nth-child(2) { animation-delay: .12s; }
.recording-active .wave text:nth-child(3) { animation-delay: .24s; }
.recording-active .wave text:nth-child(4) { animation-delay: .36s; }
.recording-active .wave text:nth-child(5) { animation-delay: .48s; }

@keyframes wave {
  to { height: 7rpx; opacity: .55; }
}

/* Database response cards */
.business-card{width:590rpx;padding:23rpx;border:1rpx solid rgba(172,207,240,.72);border-radius:8rpx 27rpx 27rpx 27rpx;background:linear-gradient(145deg,rgba(255,255,255,.94),rgba(233,244,255,.84));box-shadow:0 13rpx 34rpx rgba(26,78,132,.1),inset 0 1rpx 0 rgba(255,255,255,.9)}
.business-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.business-eyebrow{color:#6e8aa7;font-size:16rpx;font-weight:700;letter-spacing:2.4rpx}.business-title{margin-top:7rpx;color:#1b2d44;font-size:28rpx;font-weight:750}.database-badge{display:flex;align-items:center;gap:7rpx;flex:0 0 auto;padding:7rpx 10rpx;border-radius:999rpx;background:rgba(226,247,239,.8);color:#3d8367;font-size:15rpx}.database-badge text{width:7rpx;height:7rpx;border-radius:50%;background:#39a777}.business-subtitle{margin-top:10rpx;color:#75869b;font-size:20rpx;line-height:1.45}
.business-metrics{display:grid;gap:1rpx;margin-top:20rpx;overflow:hidden;border:1rpx solid rgba(74,116,158,.09);border-radius:19rpx;background:rgba(73,113,154,.09)}.business-metrics.metrics-2{grid-template-columns:repeat(2,1fr)}.business-metrics.metrics-3{grid-template-columns:repeat(3,1fr)}.business-metrics>view{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:16rpx;background:rgba(255,255,255,.7)}.business-metrics>view>view:first-child{display:flex;flex-direction:column}.business-metrics text{color:#173b62;font-size:29rpx;font-weight:760}.business-metrics label{margin-top:5rpx;color:#8593a5;font-size:17rpx}.business-metrics .metric-drill:active{background:rgba(222,239,255,.92)}.business-metrics .metric-enter{display:flex;align-items:center;gap:4rpx;color:#2d7cc4;font-size:16rpx;font-weight:650}.business-metrics .metric-enter text{font-size:25rpx;font-weight:500}
.business-rows{margin-top:17rpx;border-top:1rpx solid rgba(77,113,151,.1)}.business-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:16rpx 1rpx;border-bottom:1rpx solid rgba(77,113,151,.09)}.business-row.task-row{margin:0 -8rpx;padding-left:8rpx;padding-right:8rpx;border-radius:14rpx}.business-row.task-row:active{background:rgba(218,235,252,.58)}.business-row>view:first-child{flex:1;min-width:0}.business-row text{display:block;overflow:hidden;color:#2b3d53;font-size:22rpx;font-weight:650;white-space:nowrap;text-overflow:ellipsis}.business-row label{display:block;margin-top:6rpx;overflow:hidden;color:#8290a2;font-size:18rpx;white-space:nowrap;text-overflow:ellipsis}.row-tag{flex:0 0 auto;padding:6rpx 10rpx;border-radius:999rpx;background:rgba(228,240,253,.9);color:#3873ad;font-size:16rpx}.row-arrow{flex:0 0 auto;color:#84a0bc;font-size:29rpx;font-weight:500}.business-empty{margin-top:18rpx;padding:24rpx;border-radius:18rpx;background:rgba(240,245,250,.76);color:#8190a3;font-size:21rpx;text-align:center}.business-action{display:flex;align-items:center;justify-content:space-between;margin-top:17rpx;padding-top:17rpx;border-top:1rpx solid rgba(77,113,151,.1);color:#1671cc;font-size:21rpx;font-weight:680}.business-action view{font-size:27rpx}
.business-sections{display:flex;flex-direction:column;gap:14rpx;margin-top:18rpx}.business-section{overflow:hidden;padding:16rpx;border:1rpx solid rgba(74,108,145,.1);border-radius:20rpx;background:rgba(247,251,255,.68)}.business-section.section-personal{background:rgba(255,250,246,.7)}.business-section-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.business-section-head>view:first-child>text{display:block;color:#294158;font-size:20rpx;font-weight:720}.business-section-head>view:first-child>label{display:block;margin-top:4rpx;color:#8795a6;font-size:15rpx}.business-section-head>view:last-child{display:flex;gap:7rpx}.business-section-head>view:last-child>text,.business-section-head>view:last-child>label{padding:5rpx 8rpx;border-radius:999rpx;font-size:14rpx}.business-section-head>view:last-child>text{color:#3476b5;background:#e6f1fd}.business-section-head>view:last-child>label{color:#b56543;background:#fff0e8}.section-rows{margin-top:12rpx}.business-section-empty{margin-top:12rpx;padding:17rpx;border-radius:15rpx;color:#8b98a8;background:rgba(238,244,250,.68);font-size:16rpx;text-align:center}
.tone-orange{border-color:rgba(239,184,145,.55);background:linear-gradient(145deg,rgba(255,253,250,.95),rgba(255,240,230,.82))}.tone-orange .business-eyebrow,.tone-orange .business-action{color:#bd6239}.tone-orange .row-tag{background:rgba(255,232,220,.9);color:#b65632}.tone-green{border-color:rgba(104,199,155,.62);background:linear-gradient(145deg,rgba(249,255,252,.98),rgba(220,246,233,.9));box-shadow:0 13rpx 34rpx rgba(42,139,96,.12),inset 0 1rpx 0 rgba(255,255,255,.92)}.tone-green .business-eyebrow,.tone-green .business-action{color:#25805f}.tone-green .row-tag{background:rgba(216,244,230,.94);color:#26795a}.tone-navy{border-color:rgba(139,175,215,.62);background:linear-gradient(145deg,rgba(247,251,255,.96),rgba(221,235,251,.86))}.tone-navy .business-title{color:#183655}.tone-cyan{border-color:rgba(143,209,225,.58);background:linear-gradient(145deg,rgba(250,254,255,.96),rgba(225,246,250,.86))}
.tone-orange .business-row label{display:-webkit-box;white-space:normal;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.visit-transcript-wrap{display:flex;flex-direction:column;align-items:flex-end;margin:18rpx 0 12rpx;padding-left:76rpx}.visit-transcript-meta{display:flex;align-items:center;gap:11rpx;margin:0 5rpx 8rpx;color:#8090a4;font-size:16rpx}.visit-transcript-meta>text{color:#2879c5;font-weight:700}.visit-transcript-bubble{width:100%;padding:20rpx;border:1rpx solid rgba(51,132,208,.2);border-radius:25rpx 8rpx 25rpx 25rpx;background:linear-gradient(145deg,#f7fbff,#e3f2ff);box-shadow:0 12rpx 30rpx rgba(31,94,156,.1)}.visit-transcript-bubble.live{border-color:rgba(38,141,220,.36);box-shadow:0 12rpx 34rpx rgba(31,111,184,.14)}.visit-transcript-bubble textarea{width:100%;min-height:120rpx;color:#263d55;font-size:22rpx;line-height:1.65;background:transparent}.live-cursor{display:flex;align-items:center;justify-content:flex-end;gap:8rpx;margin-top:10rpx;color:#327fbd;font-size:17rpx}.live-cursor text{width:11rpx;height:11rpx;border-radius:50%;background:#ed6b59;box-shadow:0 0 0 6rpx rgba(237,107,89,.12);animation:livePulse 1.2s ease-in-out infinite}@keyframes livePulse{50%{opacity:.35}}.transcript-actions{display:grid;grid-template-columns:1fr 1.55fr;gap:12rpx;margin-top:16rpx}.transcript-actions button{height:68rpx;display:flex;align-items:center;justify-content:center;border-radius:19rpx;font-size:20rpx;font-weight:680}.transcript-actions button:first-child{border:1rpx solid rgba(61,110,157,.15);color:#567089;background:rgba(255,255,255,.7)}.transcript-actions button:last-child{color:#fff;background:linear-gradient(135deg,#184a78,#1685ed);box-shadow:0 9rpx 22rpx rgba(22,102,181,.2)}.transcript-actions button text{margin-left:8rpx}
.thinking-row .agent-avatar{margin-top:30rpx}.thinking-bubble{display:flex;align-items:center;gap:7rpx;padding:18rpx 21rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:8rpx 22rpx 22rpx 22rpx;background:rgba(255,255,255,.7);box-shadow:0 9rpx 25rpx rgba(29,61,101,.06)}.thinking-bubble>view{width:8rpx;height:8rpx;border-radius:50%;background:#4d91d6;animation:thinking 1s ease-in-out infinite}.thinking-bubble>view:nth-child(2){animation-delay:.15s}.thinking-bubble>view:nth-child(3){animation-delay:.3s}.thinking-bubble text{margin-left:5rpx;color:#74849a;font-size:20rpx}@keyframes thinking{50%{opacity:.3;transform:translateY(-4rpx)}}

.brief-metric-pressed { opacity: .65; }

