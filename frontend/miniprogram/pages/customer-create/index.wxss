ding>view label{display:block;margin-top:4rpx;color:#8a98a9;font-size:17rpx}.section-heading>text{color:#8493a5;font-size:18rpx}.glass-card{border:1rpx solid rgba(255,255,255,.92);border-radius:25rpx;overflow:hidden;background:rgba(255,255,255,.78);box-shadow:0 14rpx 36rpx rgba(34,79,125,.08);backdrop-filter:blur(28rpx)}.field-row{padding:18rpx 20rpx;border-bottom:1rpx solid rgba(72,102,136,.09)}.field-row:last-child{border:0}.field-row:active{background:rgba(225,239,253,.62)}.field-label{display:flex;align-items:center;gap:8rpx}.field-label>text{color:#7d8b9d;font-size:19rpx}.field-label label{padding:2rpx 7rpx;border-radius:999rpx;color:#4f7da8;background:#eaf4fd;font-size:13rpx}.field-value{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;margin-top:6rpx}.field-value>text{flex:1;color:#24374e;font-size:23rpx;line-height:1.5}.field-value>view{flex:0 0 auto;color:#99a6b5;font-size:16rpx}.field-value label{font-size:22rpx}.field-row.missing{background:rgba(255,248,242,.7)}.field-row.missing .field-value>text,.field-row.missing .field-value>view{color:#cf663c}.field-row.system{background:rgba(239,248,244,.72)}.field-row.edited{box-shadow:inset 5rpx 0 0 #63b48f}.field-row.voice-filled:not(.edited){box-shadow:inset 5rpx 0 0 #52a1e9}.bottom-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 1.55fr;gap:13rpx;padding:14rpx 24rpx calc(17rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(255,255,255,.92);background:rgba(248,251,255,.88);box-shadow:0 -10rpx 32rpx rgba(29,61,101,.08);backdrop-filter:blur(28rpx)}.bottom-bar button{width:100%;height:84rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;font-size:23rpx;font-weight:680}.secondary{border:1rpx solid rgba(80,108,139,.15);color:#617388;background:rgba(255,255,255,.82)}.primary{color:#fff;background:linear-gradient(135deg,#164b78,#1685ed);box-shadow:0 12rpx 27rpx rgba(18,94,176,.22)}.disabled{opacity:.46}.editor-