page{background:var(--ui-background)}
.create-page{min-height:100vh;padding-bottom:calc(240rpx + constant(safe-area-inset-bottom));padding-bottom:calc(240rpx + env(safe-area-inset-bottom));color:var(--ui-ink);background:var(--ui-background)}
button::after{border:0}
/* 按下态：行与卡片压灰底，按钮与选项降透明度 */
.row-pressed{background:var(--ui-neutral-soft)!important}
.is-pressed{opacity:.7}

.create-hero{padding:24rpx 32rpx 0}
.create-body{padding:24rpx 32rpx}
.notice{margin-bottom:16rpx;color:var(--ui-secondary);font-size:14px;line-height:1.6}
.notice.orange{color:var(--ui-warning)}

/* 语音填写 */
.voice-card{display:flex;align-items:center;gap:20rpx;padding:32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.voice-card.recording{box-shadow:inset 0 0 0 1px var(--ui-primary)}
.voice-card.parsing{opacity:.72}
.voice-icon{width:80rpx;height:80rpx;flex:0 0 auto;display:flex;align-items:center;justify-content:center;border-radius:var(--ui-radius-control);background:var(--ui-primary)}
.wave{height:30rpx;display:flex;align-items:center;gap:4rpx}
.wave text{width:4rpx;border-radius:999px;background:var(--ui-on-primary)}
.wave text:nth-child(1),.wave text:nth-child(5){height:12rpx}
.wave text:nth-child(2),.wave text:nth-child(4){height:22rpx}
.wave text:nth-child(3){height:30rpx}
.recording .wave text{animation:wave 1s ease-in-out infinite}
.recording .wave text:nth-child(2){animation-delay:.12s}
.recording .wave text:nth-child(3){animation-delay:.24s}
.recording .wave text:nth-child(4){animation-delay:.36s}
@keyframes wave{0%,100%{transform:scaleY(.55)}50%{transform:scaleY(1.12)}}
.voice-copy{min-width:0;flex:1}
.voice-copy view{color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.voice-copy text{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.voice-action{flex:0 0 auto;color:var(--ui-primary);font-size:14px}
.recording .voice-action{font-weight:600}

/* 字段列表 */
.section-heading{display:flex;align-items:flex-end;justify-content:space-between;margin:48rpx 0 16rpx}
.section-heading>view text{display:block;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.section-heading>view label{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.section-heading>text{color:var(--ui-secondary);font-size:var(--ui-text-small)}
.field-list{overflow:hidden}
.field-row{position:relative;padding:24rpx 32rpx;background:var(--ui-surface)}
.field-row+.field-row::before{content:"";position:absolute;left:32rpx;right:0;top:0;border-top:1px solid var(--ui-line)}
.field-label{display:flex;align-items:center;gap:12rpx}
.field-label>text{color:var(--ui-secondary);font-size:14px}
.field-label label{color:var(--ui-muted);font-size:var(--ui-text-small)}
.field-value{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin-top:8rpx}
.field-value>text{flex:1;min-width:0;color:var(--ui-ink);font-size:var(--ui-text-body);line-height:1.5;overflow-wrap:anywhere}
.field-value>view{flex:0 0 auto;display:flex;align-items:center;color:var(--ui-primary);font-size:14px}
.field-row.missing .field-value>text{color:var(--ui-warning)}
.field-row.system .field-value>text{color:var(--ui-secondary)}
.field-row.system .field-value>view{color:var(--ui-muted)}
/* 编辑弹层（sb-sheet 正文）：外壳、标题、关闭、按钮交给 sb-sheet；sb-input 0.9.0 自己是 40px，只剩 sb-textarea 里 t-textarea 自带的 16px 内边距要压掉（等组件库内置） */
.editor-body{padding-bottom:8rpx}
.option-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--ui-space-2);padding-top:8rpx}
.option-item{display:flex;align-items:center;min-height:var(--ui-touch-target);padding:0 24rpx;border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-neutral-soft);font-size:14px}
.option-item.selected{color:var(--ui-primary);background:var(--ui-selected);font-weight:600}
.option-list{--td-cell-right-icon-color:var(--ui-primary);margin:0 calc(-1 * var(--ui-page-gutter));border-bottom:1px solid var(--ui-line)}
.editor-helper{margin-top:24rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.6}

/* S2 客户建档申请：与既有蓝色主操作及白底面板保持一致。 */
.creation-tabs{display:flex;margin:24rpx 32rpx 0;border-bottom:1px solid var(--ui-line,#E2E8F0);gap:32rpx}
.creation-tab{padding:20rpx 4rpx;color:var(--ui-secondary,#5B6C82);font-size:28rpx}
.creation-tab.selected{color:var(--ui-primary,#1677FF);border-bottom:4rpx solid var(--ui-primary,#1677FF);font-weight:600}
.creation-requests{padding:24rpx 32rpx}
.creation-list-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:28rpx;margin-bottom:20rpx}
.creation-list-head>view{color:var(--ui-primary,#1677FF)}
.creation-state{padding:24rpx;color:var(--ui-secondary,#5B6C82);font-size:28rpx;line-height:1.6}
.creation-error{color:var(--ui-danger,#A73F38)}
.creation-request-card{padding:24rpx;margin-bottom:20rpx;border-radius:16rpx;background:var(--ui-surface,#fff);border:1px solid var(--ui-line,#E2E8F0)}
.creation-request-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;font-size:30rpx;font-weight:600}
.creation-request-head>text{flex:1;min-width:0;overflow-wrap:anywhere}
.creation-status{flex:none;padding:4rpx 12rpx;font-size:24rpx;border-radius:8rpx;color:var(--ui-secondary,#5B6C82);background:var(--ui-neutral-soft,#EEF2F7)}
.creation-status.status-approved{color:var(--ui-success,#27694C);background:var(--ui-success-soft,#E8F5EE)}
.creation-status.status-rejected{color:var(--ui-danger,#A73F38);background:var(--ui-danger-soft,#FBE4DF)}
.creation-request-meta,.creation-request-note{margin-top:12rpx;color:var(--ui-secondary,#5B6C82);font-size:26rpx;line-height:1.6;overflow-wrap:anywhere}
.creation-request-reason{margin-top:16rpx;font-size:28rpx;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}
.creation-request-action,.creation-load-more{margin-top:20rpx;font-size:26rpx;color:var(--ui-primary,#1677FF);background:var(--ui-selected,#EDF3FF);line-height:2.8}
