.assignee-picker{display:block}.assignee-select{height:106rpx;box-sizing:border-box;display:flex;align-items:center;gap:15rpx;padding:15rpx 18rpx;border:1rpx solid rgba(65,108,151,.14);border-radius:23rpx;background:rgba(255,255,255,.8);box-shadow:0 10rpx 27rpx rgba(31,77,125,.07)}.assignee-select.selected{border-color:rgba(22,124,226,.32);background:linear-gradient(135deg,rgba(246,251,255,.98),rgba(231,244,255,.94));box-shadow:0 11rpx 29rpx rgba(27,114,201,.11)}.assignee-avatar{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:20rpx;color:#2677bf;background:#e3f1ff;font-size:22rpx;font-weight:750}.assignee-select.selected .assignee-avatar{color:#fff;background:linear-gradient(145deg,#155183,#1687ee);box-shadow:0 7rpx 17rpx rgba(22,111,199,.2)}.assignee-copy{min-width:0;flex:1}.assignee-copy>view{display:flex;align-items:center;gap:9rpx;overflow:hidden;color:#293d54;font-size:23rpx;font-weight:720;white-space:nowrap;text-overflow:ellipsis}.assignee-copy>view>text{padding:4rpx 8rpx;border-radius:999rpx;color:#55728e;background:#eaf1f7;font-size:13rpx;font-weight:650}.assignee-copy>label{display:block;margin-top:6rpx;overflow:hidden;color:#8192a5;font-size:17rpx;white-space:nowrap;text-overflow:ellipsis}.assignee-copy.placeholder>view{color:#526980;font-weight:650}.assignee-copy.placeholder>label{color:#95a2b1}.assignee-chevron{width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:14rpx;color:#2879bf;background:#e8f3fd;font-size:28rpx;line-height:1}

.recipient-switch { margin-bottom: 20rpx; padding: 8rpx; background: #eaf2fa; border-radius: 24rpx; }
.recipient-switch .choice { flex: 1; text-align: center; }
.advice-source{padding:24rpx;margin-bottom:24rpx;border-radius:20rpx;background:#eaf4ff;color:#225780;font-size:27rpx;line-height:1.6}.advice-source-title,.advice-source-note{display:block}.advice-source-note{margin-top:8rpx;font-size:23rpx;color:#63809a}

.task-type-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:12rpx 0 24rpx}
