.setting-label-row{display:flex;align-items:center;justify-content:space-between}.setting-label-row label{color:#4b88bd;font-size:16rpx}.custom-due{margin-top:12rpx;padding:16rpx;border:1rpx solid rgba(70,107,145,.12);border-radius:20rpx;background:linear-gradient(145deg,#f8fbfe,#f1f6fb)}.custom-due.selected{border-color:rgba(22,121,225,.38);background:linear-gradient(145deg,#f5fbff,#e7f4ff);box-shadow:inset 0 0 0 1rpx rgba(22,121,225,.06)}.custom-due-head{display:flex;align-items:center;justify-content:space-between}.custom-due-head>view>text{display:block;color:#40566e;font-size:20rpx;font-weight:700}.custom-due-head>view>label{display:block;margin-top:3rpx;color:#8a99aa;font-size:15rpx}.custom-due-head>text{padding:6rpx 10rpx;border-radius:999rpx;color:#4f789e;background:#e7eff7;font-size:14rpx}.custom-due.selected .custom-due-head>text{color:#1472c7;background:#dcefff}.custom-due-fields{display:grid;grid-template-columns:1.45fr 1fr;gap:10rpx;margin-top:13rpx}.due-field{height:72rpx;box-sizing:border-box;display:flex;align-items:center;gap:10rpx;padding:9rpx 11rpx;border:1rpx solid rgba(72,108,145,.11);border-radius:16rpx;background:rgba(255,255,255,.78)}.custom-due.selected .due-field{border-color:rgba(35,129,219,.2);background:rgba(255,255,255,.9)}.due-field>view:first-child{width:37rpx;height:37rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:12rpx;color:#2478bd;background:#e5f2fd;font-size:16rpx;font-weight:750}.due-field>view:nth-child(2){min-width:0;flex:1}.due-field label{display:block;color:#96a2b0;font-size:13rpx}.due-field>view:nth-child(2)>text{display:block;margin-top:2rpx;overflow:hidden;color:#354d65;font-size:16rpx;font-weight:650;white-space:nowrap;text-overflow:ellipsis}.due-field>text{color:#8b9bae;font-size:25rpx}

