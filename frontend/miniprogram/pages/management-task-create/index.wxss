page{background:var(--ui-background)}
.task-page{min-height:100vh;padding-bottom:calc(260rpx + constant(safe-area-inset-bottom));padding-bottom:calc(260rpx + env(safe-area-inset-bottom));color:var(--ui-ink);background:var(--ui-background)}
button::after{border:0}
.task-pressed{opacity:.7}
.task-hero{margin:24rpx 32rpx 0}
.task-body{padding:16rpx 32rpx 24rpx}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16rpx;margin:32rpx 0 16rpx}
.section-head.compact{margin-top:32rpx}
.section-head>view>text{display:block;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.section-head>view>label{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.section-head>text{flex:0 0 auto;color:var(--ui-muted);font-size:var(--ui-text-small)}
/* 任务类型：卡片式单选保留，白卡无边，选中浅蓝底主色描边 */
.task-type-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--ui-space-2);margin:0 0 16rpx}
.task-type-options .task-type-option{display:block;box-sizing:border-box;width:100%;min-width:0;min-height:0;margin:0;padding:24rpx 32rpx;border:1px solid transparent;border-radius:var(--ui-radius-panel);background:var(--ui-surface);text-align:left;line-height:1.4;white-space:normal}
.task-type-option::after{border:0}
.task-type-options .task-type-option.selected{border-color:var(--ui-primary);background:var(--ui-selected)}
.task-type-top{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.task-type-check{display:flex;align-items:center;justify-content:center;flex:0 0 40rpx;box-sizing:border-box;width:40rpx;height:40rpx;border:1px solid var(--ui-line);border-radius:50%;background:var(--ui-surface)}
.selected .task-type-check{border:0;background:transparent;color:var(--ui-primary)}
.task-type-title{display:block;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600}
.task-type-option.selected .task-type-title{color:var(--ui-primary)}
.task-type-note{display:block;margin-top:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);font-weight:400;line-height:1.5}
.task-type-option[disabled]{opacity:.7}
.task-type-option.selected[disabled]{opacity:1}
/* 客户、商机两行用 t-cell：标签在左、值在右加箭头，行间分隔线从文字起点开始 */
.task-link-card{overflow:hidden;padding-bottom:24rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface);--td-cell-horizontal-padding:32rpx;--td-cell-vertical-padding:24rpx;--td-cell-title-color:var(--ui-ink);--td-cell-note-color:var(--ui-ink);--td-cell-note-font-size:14px;--td-cell-border-color:var(--ui-line);--td-cell-right-icon-color:var(--ui-muted)}
.task-link-card .is-empty{--td-cell-note-color:var(--ui-muted)}
.task-link-note,.task-link-error{display:block;margin:16rpx 32rpx 0;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.task-link-error{display:flex;align-items:center;min-height:var(--ui-touch-target);margin-top:0;color:var(--ui-danger)}
.task-body>.task-link-error{margin:0}
.advice-source{margin-top:16rpx;padding:24rpx 32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface);color:var(--ui-ink);font-size:14px;line-height:1.6}
.advice-source-title,.advice-source-note{display:block}
.advice-source-note{margin-top:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.description-card,.setting-card{border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.description-card{padding:16rpx 32rpx 24rpx}
.task-voice{min-height:48px;box-sizing:border-box;display:flex;align-items:center;gap:16rpx;margin:8rpx 0 16rpx;padding:12rpx 16rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface)}
.task-voice.recording{border-color:var(--ui-danger);background:var(--ui-danger-soft)}
.task-voice.parsing{opacity:.68}
.task-voice-icon{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:var(--ui-radius-control);background:var(--ui-primary)}
.task-voice.recording .task-voice-icon{background:var(--ui-danger)}
.task-voice.filled:not(.recording) .task-voice-icon{background:var(--ui-success)}
.task-wave{height:26rpx;display:flex;align-items:center;gap:4rpx}
.task-wave text{width:4rpx;border-radius:999px;background:var(--ui-on-primary)}
.task-wave text:nth-child(1),.task-wave text:nth-child(5){height:10rpx}
.task-wave text:nth-child(2),.task-wave text:nth-child(4){height:18rpx}
.task-wave text:nth-child(3){height:26rpx}
.task-voice.recording .task-wave text{animation:taskWave .75s ease-in-out infinite alternate}
.task-voice.recording .task-wave text:nth-child(2){animation-delay:.1s}
.task-voice.recording .task-wave text:nth-child(3){animation-delay:.2s}
.task-voice.recording .task-wave text:nth-child(4){animation-delay:.3s}
@keyframes taskWave{from{transform:scaleY(.5)}to{transform:scaleY(1.15)}}
.task-voice-copy{min-width:0;flex:1}
.task-voice-copy>view{overflow:hidden;color:var(--ui-ink);font-size:14px;font-weight:600;line-height:1.5;white-space:nowrap;text-overflow:ellipsis}
.task-voice-copy>text{display:block;margin-top:4rpx;overflow:hidden;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.4;white-space:nowrap;text-overflow:ellipsis}
.task-voice-action{flex:0 0 auto;padding:0 16rpx;color:var(--ui-primary);font-size:14px;text-align:center}
.task-voice.recording .task-voice-action{color:var(--ui-danger);font-weight:600}
.task-voice.filled:not(.recording) .task-voice-action{color:var(--ui-success)}
.description-tip{display:flex;align-items:center;gap:8rpx;padding-top:16rpx;border-top:1px solid var(--ui-line);color:var(--ui-secondary);font-size:var(--ui-text-small)}
/* 任务负责人：原生 picker 保留（测试锁定），触发器是白卡 */
.assignee-picker{display:block}
.assignee-select{min-height:112rpx;box-sizing:border-box;display:flex;align-items:center;gap:16rpx;padding:16rpx 32rpx;border:1px solid transparent;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.assignee-avatar{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:50%;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:14px;font-weight:600}
.assignee-select.selected .assignee-avatar{color:var(--ui-on-primary);background:var(--ui-primary)}
.assignee-copy{min-width:0;flex:1}
.assignee-copy>view{display:flex;align-items:center;gap:8rpx;overflow:hidden;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;white-space:nowrap;text-overflow:ellipsis}
.assignee-copy>view>text{padding:0 12rpx;border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);font-weight:400;line-height:20px}
.assignee-copy>label{display:block;margin-top:4rpx;overflow:hidden;color:var(--ui-secondary);font-size:var(--ui-text-small);white-space:nowrap;text-overflow:ellipsis}
.assignee-copy.placeholder>view{color:var(--ui-secondary);font-weight:400}
.assignee-copy.placeholder>label{color:var(--ui-muted)}
.assignee-chevron{flex:0 0 auto;color:var(--ui-muted)}
/* 执行设置：优先级分段、截止时间日期时刻一个控件，组间一条分隔线 */
.setting-card{padding:0 32rpx}
.setting-block{padding:24rpx 0}
.setting-due{padding:8rpx 0 16rpx}
.setting-label{margin-bottom:16rpx;color:var(--ui-ink);font-size:14px;font-weight:400}
.divider{height:1px;background:var(--ui-line)}
.delivery-preview{display:flex;align-items:center;gap:16rpx;margin-top:16rpx;padding:24rpx 32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.preview-icon{flex:0 0 auto;color:var(--ui-success)}
.delivery-preview>view:last-child{min-width:0}
.delivery-preview>view:last-child text{display:block;color:var(--ui-ink);font-size:14px;font-weight:600}
.delivery-preview>view:last-child label{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small)}
/* 选择客户／商机：sb-sheet 底部弹层，列表行 t-cell，选中行右侧打勾 */
.task-selector-list{--td-cell-horizontal-padding:0;--td-cell-vertical-padding:24rpx;--td-cell-title-color:var(--ui-ink);--td-cell-border-color:var(--ui-line);--td-cell-right-icon-color:var(--ui-primary)}
.task-selector-state{padding:32rpx;color:var(--ui-secondary);font-size:14px;line-height:1.5;text-align:center}
.task-selector-state.task-link-error{justify-content:center;margin:0;color:var(--ui-danger)}
.task-selector-more{display:flex;align-items:center;justify-content:center;min-height:var(--ui-touch-target);padding:0;color:var(--ui-primary)}


/* Multi-recipient task state retained from the current customer version. */
.selected-recipients{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}
.selected-recipients>view{display:flex;align-items:center;min-height:var(--ui-touch-target);box-sizing:border-box;max-width:100%;overflow-wrap:anywhere;padding:12rpx 16rpx;border-radius:var(--ui-radius-control);background:var(--ui-neutral-soft);color:var(--ui-primary);font-size:var(--ui-text-small)}
.submission-notice{margin:0 27rpx 32rpx;padding:20rpx;border-radius:var(--ui-radius-control);background:var(--ui-neutral-soft);color:var(--ui-ink);font-size:var(--ui-text-body);line-height:1.6}
