page{background:#edf5fc}.task-page{min-height:100vh;padding-bottom:170rpx;color:#18283c;background:radial-gradient(circle at 94% 4%,rgba(74,166,244,.2),transparent 28%),linear-gradient(155deg,#fbfdff,#eff6fd 58%,#e9f2fb)}button::after{border:0}.task-hero{padding:40rpx 32rpx 32rpx;color:#fff;background:radial-gradient(circle at 90% 5%,rgba(88,181,255,.72),transparent 35%),linear-gradient(145deg,#102a47,#126dca);box-shadow:0 18rpx 45rpx rgba(20,79,148,.2)}.hero-eyebrow{color:rgba(255,255,255,.62);font-size:18rpx;letter-spacing:2.8rpx}.hero-title{margin-top:10rpx;font-size:42rpx;font-weight:800}.hero-subtitle{width:84%;margin-top:10rpx;color:rgba(255,255,255,.74);font-size:20rpx;line-height:1.55}.hero-scope{display:inline-flex;align-items:center;gap:8rpx;margin-top:22rpx;padding:8rpx 13rpx;border:1rpx solid rgba(255,255,255,.15);border-radius:999rpx;color:rgba(255,255,255,.76);background:rgba(255,255,255,.09);font-size:17rpx;backdrop-filter:blur(16rpx)}.hero-scope text{width:8rpx;height:8rpx;border-radius:50%;background:#76dfb4;box-shadow:0 0 10rpx rgba(118,223,180,.8)}.task-body{padding:24rpx 27rpx}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin:8rpx 2rpx 14rpx}.section-head.compact{margin-top:29rpx}.section-head>view>text{display:block;font-size:25rpx;font-weight:760}.section-head>view>label{display:block;margin-top:4rpx;color:#8998aa;font-size:17rpx}.section-head>text{color:#8a98aa;font-size:17rpx}.description-card,.setting-card{border:1rpx solid rgba(255,255,255,.94);border-radius:25rpx;background:rgba(255,255,255,.82);box-shadow:0 13rpx 35rpx rgba(31,77,125,.08);backdrop-filter:blur(28rpx)}.description-card{padding:26rpx 24rpx 22rpx;margin-bottom:26rpx}.description-card textarea{box-sizing:border-box;width:100%;min-height:320rpx;color:#24384f;font-size:24rpx;line-height:1.65}.description-tip{display:flex;align-items:center;gap:10rpx;padding-top:14rpx;border-top:1rpx solid rgba(74,103,136,.09);color:#8191a4;font-size:17rpx}.description-tip view{width:32rpx;height:32rpx;display:flex;align-items:center;justify-content:center;border-radius:11rpx;color:#fff;background:linear-gradient(145deg,#175488,#1686ec);font-size:15rpx}.member-list{display:flex;flex-direction:column;gap:11rpx}.member-card{display:flex;align-items:center;gap:14rpx;padding:17rpx 18rpx;border:1rpx solid rgba(255,255,255,.93);border-radius:23rpx;background:rgba(255,255,255,.78);box-shadow:0 9rpx 24rpx rgba(31,77,125,.06)}.member-card.selected{border-color:rgba(22,124,226,.4);background:linear-gradient(135deg,rgba(236,247,255,.96),rgba(226,242,255,.92));box-shadow:0 10rpx 28rpx rgba(27,114,201,.12)}.member-avatar{width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;border-radius:19rpx;color:#2677bf;background:#e3f1ff;font-size:23rpx;font-weight:750}.selected .member-avatar{color:#fff;background:linear-gradient(145deg,#155183,#1687ee)}.member-copy{min-width:0;flex:1}.member-copy text{display:block;color:#293d54;font-size:23rpx;font-weight:700}.member-copy label{display:block;margin-top:4rpx;color:#8796a8;font-size:17rpx}.member-check{width:38rpx;height:38rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #d1dce7;border-radius:50%;color:#fff;font-size:18rpx}.selected .member-check{border-color:#1682e8;background:#1682e8}.setting-card{padding:5rpx 20rpx}.setting-block{padding:18rpx 0}.setting-label{margin-bottom:12rpx;color:#7e8d9f;font-size:19rpx}.choice-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.choice,.due-choice{display:flex;align-items:center;justify-content:center;min-height:64rpx;border:1rpx solid rgba(69,105,143,.13);border-radius:17rpx;color:#607287;background:#f7fafc;font-size:20rpx}.choice.selected,.due-choice.selected{border-color:rgba(22,121,225,.36);color:#126fc3;background:#e8f4ff;font-weight:680}.divider{height:1rpx;background:rgba(71,103,137,.1)}.due-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10rpx}.delivery-preview{display:fl