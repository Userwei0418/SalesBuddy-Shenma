.task-type-top{display:flex;align-items:center;justify-content:space-between;gap:10rpx;margin-bottom:0}.task-type-check{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:27rpx;height:27rpx;border:2rpx solid #d2dfeb;border-radius:50%;color:transparent;background:#fff;font-size:18rpx;line-height:1}.selected .task-type-check{border-color:#2686d0;background:#2686d0;color:white}
.task-type-title{display:block;font-size:24rpx;font-weight:700;color:#35536d}.task-type-option.selected .task-type-title{color:#196dab}.task-type-note{display:block;margin-top:6rpx;font-size:18rpx;font-weight:400;line-height:1.5;color:#879db1}.task-type-option[disabled]{opacity:.7}.task-type-option.selected[disabled]{opacity:1}
.task-link-card{padding:6rpx 20rpx 18rpx;border:1rpx solid #dce8f4;border-radius:20rpx;background:#f8fbff}.task-link-row{display:flex;align-items:center;gap:16rpx;min-height:78rpx;border-bottom:1rpx solid #e6eef6}.task-link-label{flex:0 0 60rpx;font-size:23rpx;color:#6f879c}.task-link-value{flex:1;min-width:0;font-size:23rpx;color:#294b68;line-height:1.5}.task-link-arrow{flex-shrink:0;color:#2880c4;font-size:21rpx}.task-link-note,.task-link-error{display:block;margin-top:12rpx;font-size:19rpx;line-height:1.5;color:#879bad}.task-link-error{color:#b56246}.task-link-row.muted{opacity:.55}
.task-selector-layer{position:fixed;inset:0;z-index:1000;display:flex;align-items:flex-end;background:rgba(25,46,68,.35)}.task-selector-sheet{box-sizing:border-box;width:100%;height:76vh;padding:26rpx 26rpx calc(24rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;border-radius:28rpx 28rpx 0 0;background:#f8fbfe}.task-selector-head{display:flex;align-items:center;justify-content:space-between;color:#284862;font-size:29rpx;font-weight:650}.task-selector-head button{margin:0;padding:0 20rpx;line-height:2;font-size:22rpx;color:#2b7bb8;background:#eaf3fc}.task-selector-head button::after{border:0}.task-selector-search{box-sizing:border-box;flex-shrink:0;height:72rpx;margin:20rpx 0;padding:0 18rpx;border:1rpx solid #dae6f2;border-radius:16rpx;background:#fff;font-size:24rpx}.task-selector-list{height:0;flex:1}.task-selector-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 18rpx;margin-bottom:12rpx;border:1rpx solid #e0ebf4;border-radius:16rpx;background:white;font-size:24rpx;color:#294b68;line-height:1.5}.task-selector-state{padding:28rpx;text-align:center;font-size:22rpx;color:#7892a7}

.selected-recipients{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}.selected-recipients>view{max-width:100%;overflow-wrap:anywhere;padding:12rpx 16rpx;border-radius:14rpx;background:#e5f2fd;color:#256493;font-size:22rpx}.task-selector-list .member-card{margin-bottom:12rpx}.submission-notice{margin:0 27rpx 32rpx;padding:20rpx;border-radius:16rpx;background:#fff3df;color:#875b23;font-size:24rpx;line-height:1.6}
.task-selector-list .member-copy text,.task-selector-list .member-copy label{overflow-wrap:anywhere;word-break:break-all}.task-selector-list .member-check{flex-shrink:0}
