<import src="../../templates/opportunity-list-card.wxml"/>
<wxs module="opt">
function lab(it,key,suffix){return (key ? it[key] : it) + (suffix || '');}
function idx(list,key,suffix){var out=[];for(var i=0;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function rest(list,key,suffix){var out=[];for(var i=1;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function pick(i){var n=i * 1;return n>0?n:null;}
module.exports={idx:idx,rest:rest,pick:pick};
</wxs>
<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<fde-projects id="fdeContent" wx:if="{{isFde}}" initial-scope="{{fdeScope}}" member-id="{{fdeMemberId}}" customer-id="{{fdeCustomerId}}"/>
<block wx:if="{{!isFde}}">
<view class="page-shell workbench">
  <sb-state-panel wx:if="{{loading && !dataReady}}" class="workbench-state" state="loading" title="正在读取经营数据…"/>
  <sb-state-panel wx:elif="{{loadError && !dataReady}}" class="workbench-state" state="error" title="经营数据加载失败" description="{{loadError}}" retryNote="" bind:retry="loadData"/>
  <block wx:if="{{dataReady}}">
  <view class="page-head">
    <view><view class="title">商机管理</view><view class="eyebrow">{{roleName}} · {{scope}}</view></view>
    <view wx:if="{{canCreateOpportunity}}" class="head-side"><view class="workbench-create-opportunity head-create-opportunity" hover-class="workbench-create-opportunity-active" bindtap="createOpportunity"><label>新增商机</label></view></view>
  </view>

  <view class="overview-board opportunity-overview opportunity-summary-card surface">
    <view class="opportunity-summary-head"><view class="opportunity-summary-head-main"><view class="opportunity-summary-title">商机总览</view><view class="opportunity-summary-scope">{{scope}}</view></view><text class="metric-help" hover-class="metric-help-pressed" bindtap="showOpportunityMetricHelp">统计口径 ⓘ</text></view>
    <view class="opportunity-summary-metrics">
      <view class="opportunity-summary-metric opportunity-summary-won"><view class="opportunity-summary-value">{{opportunityDataReady ? opportunityBoard.won : '—'}}<text class="opportunity-summary-unit">个</text></view><view class="opportunity-summary-label">已成单商机</view></view>
      <view class="opportunity-summary-metric"><view class="opportunity-summary-value">{{opportunityDataReady ? opportunityBoard.total : '—'}}<text class="opportunity-summary-unit">个</text></view><view class="opportunity-summary-label">全部商机</view></view>
      <view class="opportunity-summary-metric"><view class="opportunity-summary-value">{{opportunityDataReady ? opportunityBoard.active : '—'}}<text class="opportunity-summary-unit">个</text></view><view class="opportunity-summary-label">活跃商机</view></view>
      <view class="opportunity-summary-metric"><view class="opportunity-summary-value">{{opportunityDataReady ? opportunityBoard.newCount : '—'}}<text class="opportunity-summary-unit">个</text></view><view class="opportunity-summary-label">新增商机</view></view>
    </view>
    <view class="summary-data-note">全部商机为当前存量（含丢单）；成单、活跃、新增按所选时间统计。</view>
    <view class="quarter-filter quarter-filter-summary">
      <view class="quarter-filter-head"><view class="quarter-filter-head-main"><text class="quarter-filter-title">统计时间</text><text class="quarter-selection-label">{{summaryQuarter.label}}</text></view></view>
      <sb-select class="quarter-year-select" plain label="统计年份" placeholder="选择年份" options="{{opt.idx(summaryYearOptions,'label')}}" value="{{summaryYearIndex}}" defaultValue="{{summaryYearIndex}}" data-scope="summary" bindchange="changeQuarterYear"/>
      <view wx:if="{{!summaryQuarter.isAllYears}}" class="quarter-options">
        <view class="quarter-option {{summaryQuarter.isFullYear ? 'selected' : ''}}" hover-class="quarter-option-pressed" data-scope="summary" data-value="all" bindtap="toggleQuarter">全年</view>
        <view wx:for="{{summaryQuarter.options}}" wx:key="value" class="quarter-option {{item.selected ? 'selected' : ''}}" hover-class="quarter-option-pressed" data-scope="summary" data-value="{{item.value}}" bindtap="toggleQuarter">{{item.label}}</view>
      </view>
      <view class="quarter-filter-foot"><text>{{summaryQuarter.isAllYears ? '跨年历史统计' : '全年等于四季全选 · 季度可多选'}} · 全部商机不随季度变化</text></view>
    </view>
    <view wx:if="{{summaryQuarter.isAllYears}}" class="summary-data-note">跨年已成单数量包含成单时间待补记录；按年或季度查看时不计入已成单统计。</view>
    <view wx:if="{{opportunityOverviewLoading}}" class="summary-data-note">正在更新商机总览…</view>
    <view wx:if="{{opportunityDataError}}" class="summary-data-note summary-data-error">{{opportunityDataError}}<text class="summary-retry" hover-class="summary-retry-pressed" bindtap="applyOpportunitySummary">重试</text></view>
    <view wx:if="{{opportunityDataReady && !summaryQuarter.isAllYears && (opportunityBoard.missingWonDates || opportunityBoard.missingCreatedDates)}}" class="summary-data-note">
      <view wx:if="{{opportunityBoard.missingWonDates}}">另有 {{opportunityBoard.missingWonDates}} 个商机成单时间待补，未计入所选期间的已成单统计</view>
      <view wx:if="{{opportunityBoard.missingCreatedDates}}">{{opportunityBoard.missingCreatedDates}} 个商机缺少原始建单日期，未计入新增的年度或季度统计</view>
    </view>
  </view>

  <view id="workbench-opportunity-list" class="workbench-opportunity-tools">
    <view class="workbench-opportunity-filter">
      <view class="workbench-filter-line">
        <text class="workbench-filter-title">列表筛选</text>
        <scroll-view class="workbench-filter-scroll" scroll-x enhanced show-scrollbar="false">
          <view class="workbench-filter-row">
            <view wx:if="{{canViewAuthorized}}" class="workbench-filter-item filter-scope"><sb-labeled-select size="small" label="范围" placeholder="我的" allOption="{{false}}" options="{{opt.idx(executionScopeOptions,'label')}}" value="{{executionScopeIndex}}" bindchange="changeExecutionScope"/></view>
            <view wx:if="{{canViewTeam}}" class="workbench-filter-item filter-team"><sb-labeled-select size="small" label="团队" placeholder="全部团队" options="{{opt.rest(executionTeamOptions,'label')}}" value="{{opt.pick(executionTeamIndex)}}" bindchange="changeExecutionTeam"/></view>
            <view wx:if="{{canViewTeam}}" class="workbench-filter-item filter-owner"><sb-labeled-select size="small" label="负责人" placeholder="{{opportunityOwnerOptions[0].label}}" options="{{opt.rest(opportunityOwnerOptions,'label')}}" value="{{opt.pick(opportunityOwnerIndex)}}" data-key="Owner" bindchange="changeOpportunityFilter"/></view>
            <view class="workbench-filter-item filter-stage {{opportunitySelectedStages.length ? 'active' : ''}} workbench-filter-trigger" hover-class="workbench-filter-pressed" bindtap="toggleOpportunityStageFilter"><view class="workbench-filter-control"><text wx:if="{{!opportunitySelectedStages.length}}" class="workbench-filter-value">商机阶段</text><text wx:else class="workbench-filter-value">{{opportunityStageLabel}}</text><t-icon wx:if="{{showOpportunityStageFilter}}" name="chevron-up" size="32rpx" class="workbench-filter-chevron"/><t-icon wx:else name="chevron-down" size="32rpx" class="workbench-filter-chevron"/></view></view>
            <view class="workbench-filter-item filter-close {{listQuarter.quarters.length || opportunityCloseIndex ? 'active' : ''}} workbench-filter-trigger" hover-class="workbench-filter-pressed" bindtap="toggleOpportunityQuarterFilter"><view class="workbench-filter-control"><text wx:if="{{!listQuarter.quarters.length && !opportunityCloseIndex}}" class="workbench-filter-value">关单时间</text><text wx:else class="workbench-filter-value">{{opportunityCloseIndex ? opportunityCloseOptions[opportunityCloseIndex].label : listQuarter.label}}</text><t-icon wx:if="{{showOpportunityQuarterFilter}}" name="chevron-up" size="32rpx" class="workbench-filter-chevron"/><t-icon wx:else name="chevron-down" size="32rpx" class="workbench-filter-chevron"/></view></view>
            <view class="workbench-filter-item filter-grade"><sb-labeled-select size="small" label="商机等级" placeholder="全部等级" options="{{opt.rest(opportunityGradeOptions,'label')}}" value="{{opt.pick(opportunityGradeIndex)}}" data-key="Grade" bindchange="changeOpportunityFilter"/></view>
            <view class="workbench-filter-item filter-activity"><sb-labeled-select size="small" label="跟进时间" placeholder="全部跟进" options="{{opt.rest(activityWindowOptions,'label')}}" value="{{opt.pick(activityWindowIndex)}}" data-key="Activity" bindchange="changeOpportunityFilter"/></view>
          </view>
        </scroll-view>
        <text wx:if="{{opportunityFilterActive}}" class="workbench-filter-reset" hover-class="workbench-filter-reset-pressed" bindtap="resetOpportunityFilters">重置</text>
      </view>
      <view wx:if="{{showOpportunityQuarterFilter}}" class="quarter-filter quarter-filter-list">
        <view class="quarter-filter-head"><view class="quarter-filter-head-main"><text class="quarter-filter-title">关单时间</text><text class="quarter-selection-label">{{opportunityCloseIndex ? opportunityCloseOptions[opportunityCloseIndex].label : listQuarter.label}}</text></view></view>
        <sb-select class="quarter-year-select" plain label="关单年份" placeholder="选择年份" options="{{opt.idx(summaryYearOptions,'label')}}" value="{{listYearIndex}}" defaultValue="{{listYearIndex}}" data-scope="list" bindchange="changeQuarterYear"/>
        <view class="close-period-shortcuts"><block wx:for="{{opportunityCloseOptions}}" wx:key="value"><view wx:if="{{index > 0}}" class="close-period-shortcut {{opportunityCloseIndex === index ? 'selected' : ''}}" hover-class="quarter-option-pressed" data-index="{{index}}" bindtap="selectOpportunityClosePeriod">{{item.label}}</view></block></view>
        <view wx:if="{{!listQuarter.isAllYears && !opportunityCloseIndex}}" class="quarter-options">
          <view class="quarter-option {{listQuarter.isFullYear && !opportunityCloseIndex ? 'selected' : ''}}" hover-class="quarter-option-pressed" data-scope="list" data-value="all" bindtap="toggleQuarter">全年</view>
          <view wx:for="{{listQuarter.options}}" wx:key="value" class="quarter-option {{item.selected ? 'selected' : ''}}" hover-class="quarter-option-pressed" data-scope="list" data-value="{{item.value}}" bindtap="toggleQuarter">{{item.label}}</view>
        </view>
        <view class="quarter-filter-foot"><text>按预计关单时间 · {{opportunityTotal}} 个筛选结果 · {{opportunityCloseIndex ? '按快捷日期范围' : (listQuarter.isAllYears ? '跨年，可切换年份' : '全年等于四季全选')}}</text><view class="quarter-filter-done"><t-button size="small" theme="primary" bindtap="toggleOpportunityQuarterFilter">完成</t-button></view></view>
      </view>
      <view wx:if="{{showOpportunityStageFilter}}" class="workbench-stage-panel">
        <view class="workbench-stage-panel-title"><text>商机阶段</text><text class="workbench-stage-panel-hint">可多选</text></view>
        <view class="workbench-stage-option {{!opportunitySelectedStages.length ? 'selected' : ''}}" hover-class="quarter-option-pressed" data-value="all" bindtap="toggleOpportunityStage"><label class="workbench-stage-name">全部阶段</label></view>
        <block wx:for="{{opportunityStageOptions}}" wx:key="value"><view wx:if="{{item.value !== 'all'}}" class="workbench-stage-option {{item.selected ? 'selected' : ''}}" hover-class="quarter-option-pressed" data-value="{{item.value}}" bindtap="toggleOpportunityStage"><label class="workbench-stage-name">{{item.label}}</label></view></block>
      </view>
      <opportunity-period-filters value="{{opportunityPeriods}}" bind:change="changeOpportunityPeriods"/>
      <view class="opportunity-search-box"><sb-search plain value="{{opportunityQuery}}" maxlength="{{100}}" placeholder="搜索客户、商机或产品线" bind:change="searchOpportunities" bind:search="applyOpportunityFilters" bind:clear="searchOpportunities"/></view>
    </view>
  </view>

  <sb-state-panel wx:if="{{opportunityListLoading && !filteredOpportunities.length}}" class="workbench-list-state" state="loading" title="正在读取商机列表…"/>
  <sb-state-panel wx:elif="{{opportunityListError && !filteredOpportunities.length}}" class="workbench-list-state" state="error" title="商机列表加载失败" description="{{opportunityListError}}" bind:retry="loadAllOpportunities"/>
  <view wx:if="{{filteredOpportunities.length}}" class="summary-data-note">
    <text wx:if="{{opportunityListLoading}}">正在更新列表，已加载内容仍可查看</text>
    <text wx:elif="{{opportunityListError}}" class="summary-data-error">{{opportunityListError}}</text>
    <text wx:else>已显示 {{filteredOpportunities.length}} / {{opportunityTotal}} 个商机</text>
    <text wx:if="{{!opportunityListLoading}}" class="summary-retry" hover-class="summary-retry-pressed" bindtap="loadAllOpportunities">刷新列表</text>
  </view>
  <view wx:if="{{filteredOpportunities.length}}" class="workbench-opportunity-list">
    <view class="opportunity-order-note">按预计关单季度分组 · 季度内按阶段进度降序</view>
    <view wx:for="{{opportunityGroups}}" wx:for-item="group" wx:key="key" class="opportunity-quarter-group">
      <view class="opportunity-quarter-heading"><text class="opportunity-quarter-heading-title">{{group.label}}</text><label class="opportunity-quarter-heading-count">已显示 {{group.items.length}} 个商机</label></view>
      <view wx:for="{{group.items}}" wx:key="id" class="workbench-opportunity-card surface" hover-class="workbench-opportunity-card-pressed" data-customer-id="{{item.customer_id}}" data-opportunity-id="{{item.id}}" bindtap="openOpportunity">
      <template is="opportunity-list-card" data="{{item: item}}"/>
      </view>
    </view>
  </view>
  <sb-state-panel wx:elif="{{!opportunityListLoading && !opportunityListError}}" class="workbench-opportunity-empty" state="empty" title="当前筛选条件下没有商机" description="换一个条件试试，或点筛选行的「重置」。"/>
  <view wx:if="{{opportunityMoreError}}" class="summary-data-note summary-data-error">{{opportunityMoreError}}<text class="summary-retry" hover-class="summary-retry-pressed" bindtap="loadMoreOpportunities">{{opportunityListChanged ? '刷新列表' : '重试'}}</text></view>
  <sb-pagination wx:if="{{opportunityHasMore}}" class="workbench-pager" plain mode="more" summary="已显示 {{filteredOpportunities.length}} / {{opportunityTotal}} 个商机" total="{{opportunityTotal}}" loading="{{opportunityLoadingMore}}" bind:more="loadMoreOpportunities"/>

  </block>
</view>

</block>
</block>
