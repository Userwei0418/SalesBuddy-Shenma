.quarter-filter-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:12rpx}.quarter-filter-head>view{display:flex;align-items:center;gap:12rpx;min-width:0}.quarter-filter-title{flex:0 0 auto;font-size:19rpx;font-weight:700}.quarter-selection-label{font-size:17rpx;opacity:.76}.quarter-year{display:flex;align-items:center;gap:10rpx;padding:8rpx 12rpx;border-radius:10rpx;background:rgba(255,255,255,.1);font-size:19rpx;white-space:nowrap}
