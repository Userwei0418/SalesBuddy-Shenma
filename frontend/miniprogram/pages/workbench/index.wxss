.summary-data-note{margin-top:12rpx;color:#d0e1ee;font-size:16rpx;line-height:1.6}.summary-data-error{color:#ffe2b4}.summary-data-error>text{display:inline-block;margin-left:16rpx;padding:5rpx 12rpx;border:1rpx solid rgba(255,226,180,.5);border-radius:8rpx}
.quarter-filter-list{margin-top:13rpx;padding:16rpx 6rpx 5rpx;border-top:1rpx solid #e6edf4;color:#405d76}.quarter-filter-list .quarter-year{background:#f0f6fc;color:#305d82}.quarter-filter-list .quarter-option{border-color:#dde8f2;color:#587188;background:#f7fafc}.quarter-filter-list .quarter-option.selected{border-color:#9ecbf0;background:#e6f3ff;color:#126caf}.quarter-filter-list .quarter-filter-foot{color:#7e91a4}.quarter-filter-list .quarter-selection-label{color:#6d87a0;opacity:1}

