.progress { background: #e5edf6; }.progress view { background: linear-gradient(90deg,#55a3ff,#1677ff); }
.insight-actions { color: #1677ff; }.insight-actions text{padding:7rpx 0}.insight-actions text:active{opacity:.55}.insight-actions text.done{color:#2c8062}
