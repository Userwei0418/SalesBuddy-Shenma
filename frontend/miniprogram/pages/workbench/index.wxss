/* Independent scope filters for quadrant and execution sections */
.section-title-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin:32rpx 0 20rpx}.section-title-row .section-title{flex:0 0 auto;margin:0}.section-filters{display:flex;align-items:center;justify-content:flex-end;gap:8rpx;min-width:0}.filter-chip{display:flex;align-items:center;justify-content:center;gap:6rpx;max-width:150rpx;padding:9rpx 12rpx;border:1rpx solid rgba(255,255,255,.92);border-radius:999rpx;color:#4e6680;background:rgba(255,255,255,.66);box-shadow:0 6rpx 18rpx rgba(28,65,109,.06);font-size:16rpx;line-height:1.2;white-space:nowrap}.filter-chip>text{color:#1878d4;font-size:18rpx}.filter-chip:active{border-color:rgba(57,143,222,.35);background:rgba(231,243,255,.85)}.execution-title-row{margin-top:31rpx;margin-bottom:14rpx}
.map-filter-scroll{width:100%;margin:-8rpx 0 13rpx;white-space:nowrap}.map-filter-list{display:inline-flex;min-width:100%;box-sizing:border-box;justify-content:flex-start;padding:3rpx 1rpx 7rpx}.map-filter-list .filter-chip{max-width:190rpx;background:rgba(255,255,255,.78)}.customer-filter-chip{max-width:300rpx!important;justify-content:flex-start;padding:8rpx 11rpx 8rpx 8rpx}.customer-filter-chip label{max-width:210rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.filter-chip>.customer-filter-icon{width:30rpx;height:30rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:10rpx;color:#fff;background:linear-gradient(145deg,#195183,#1682e7);font-size:14rpx;font-weight:750}

