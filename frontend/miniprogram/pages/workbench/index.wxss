@import "../../styles/opportunity-list-card.wxss";
.workbench { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.page-head { min-height: 84rpx; display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin: 8rpx 2rpx 20rpx; }
.page-head .title { margin: 0; color: #20374d; font-size: 38rpx; font-weight: 750; line-height: 1.2; }
.page-head .eyebrow { margin-top: 8rpx; color: #77889b; font-size: 22rpx; font-weight: 500; line-height: 1.2; }
.date { color: #79869a; font-size: 24rpx; }
.head-side{display:flex;flex-direction:column;align-items:flex-end;gap:10rpx}.assignment-entry{display:flex;align-items:center;gap:9rpx;padding:10rpx 14rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:999rpx;color:#176fc9;background:rgba(255,255,255,.68);box-shadow:0 7rpx 20rpx rgba(28,65,109,.07);font-size:19rpx;font-weight:680}.assignment-entry text{min-width:28rpx;height:28rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;color:#fff;background:#177add;font-size:15rpx}
.summary { padding: 28rpx; background: linear-gradient(145deg,#182f5d,#2758ba); color: #fff; }
.summary-top { display: flex; justify-content: space-between; }
.summary-label { opacity: .7; font-size: 23rpx; }
.summary-value { margin-top: 8rpx; font-size: 52rpx; font-weight: 800; }
.trend { align-self: flex-start; padding: 8rpx 13rpx; border-radius: 999rpx; background: rgba(255,255,255,.14); color: #bdebd8; font-size: 21rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.15); }
.metric-grid view { display: flex; flex-direction: column; }
.metric-grid text { font-size: 34rpx; font-weight: 750; }.metric-grid label { margin-top: 5rpx; opacity: .65; font-size: 21rpx; }.risk-num { color: #ffc1a9; }
.map-axis-legend{display:flex;align-items:center;gap:10rpx;margin:-7rpx 0 13rpx}.map-axis-legend>view{display:flex;align-items:center;gap:7rpx;padding:8rpx 12rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:999rpx;color:#50647b;background:rgba(255,255,255,.58);box-shadow:0 6rpx 18rpx rgba(29,61,101,.05);font-size:16rpx}.map-axis-legend>view>text{color:#1978d3;font-size:19rpx;font-weight:700}.map-axis-legend label{font-weight:650}.map-axis-legend small{color:#93a0af;font-size:14rpx}
.battle-map{position:relative;height:560rpx;overflow:hidden;border:1rpx solid rgba(77,111,150,.16);background:rgba(248,251,255,.84)}
.overview-board.opportunity-overview{margin-top:8rpx;padding:26rpx 27rpx;color:#fff;border-color:rgba(255,255,255,.16);border-radius:30rpx;background:radial-gradient(ellipse at top right,rgba(63,154,229,.34),transparent 62%),linear-gradient(125deg,#153b61,#176dad);box-shadow:0 15rpx 38rpx rgba(20,64,104,.18),inset 0 1rpx 1rpx rgba(255,255,255,.2)}.opportunity-summary-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.opportunity-summary-title{font-size:29rpx;font-weight:720;letter-spacing:.5rpx}.opportunity-summary-scope{padding:8rpx 16rpx;border-radius:999rpx;color:#d6e9f8;background:rgba(4,43,83,.28);font-size:19rpx;white-space:nowrap}.opportunity-summary-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:24rpx 0 0}.opportunity-summary-metric{min-width:0}.opportunity-summary-metric+.opportunity-summary-metric{padding-left:14rpx;border-left:1rpx solid rgba(221,238,255,.18)}.opportunity-summary-label{display:flex;align-items:center;gap:7rpx;color:#d7e8f5;font-size:18rpx;white-space:nowrap}.opportunity-summary-label text{font-size:23rpx;opacity:.68}.opportunity-summary-value{margin-top:8rpx;overflow-wrap:anywhere;font-size:38rpx;font-weight:790;line-height:1.2;font-variant-numeric:tabular-nums}.opportunity-summary-value>text{margin-left:6rpx;color:#c8deef;font-size:17rpx;font-weight:450}
.map-zone{position:absolute;width:50%;height:50%;box-sizing:border-box}.zone-attack{left:0;top:0;background:linear-gradient(145deg,rgba(255,247,241,.72),rgba(247,249,255,.64))}.zone-asset{right:0;top:0;background:linear-gradient(145deg,rgba(244,249,255,.7),rgba(239,248,255,.82))}.zone-order{left:0;bottom:0;background:linear-gradient(145deg,rgba(250,250,251,.86),rgba(246,248,252,.82))}.zone-resource{right:0;bottom:0;background:linear-gradient(145deg,rgba(247,249,255,.82),rgba(240,245,254,.88))}
.map-divider{position:absolute;z-index:2;background:rgba(77,105,139,.14)}.map-divider-x{left:50%;top:0;bottom:0;width:1rpx}.map-divider-y{left:0;right:0;top:50%;height:1rpx}
.map-quadrant-name{position:absolute;z-index:3;display:flex;flex-direction:column;pointer-events:none}.map-quadrant-name text{color:#536579;font-size:18rpx;font-weight:700}.map-quadrant-name label{margin-top:5rpx;color:#9aa5b3;font-size:13rpx}.name-attack{left:24rpx;top:21rpx}.name-asset{right:24rpx;top:21rpx;align-items:flex-end}.name-order{left:24rpx;bottom:22rpx}.name-resource{right:24rpx;bottom:22rpx;align-items:flex-end}
.plot-hit-area{position:absolute;z-index:6;width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;margin-left:-29rpx;margin-bottom:-29rpx;border-radius:50%}.plot-hit-area:active{background:rgba(22,119,255,.12)}.plot-point{width:20rpx;height:20rpx;border:4rpx solid rgba(255,255,255,.96);border-radius:50%;background:#1680ee;box-shadow:0 0 0 3rpx rgba(22,128,238,.18),0 5rpx 12rpx rgba(17,91,169,.28)}.risk-point .plot-point{box-shadow:0 0 0 4rpx rgba(235,118,70,.26),0 5rpx 12rpx rgba(17,91,169,.28)}.map-empty{position:absolute;z-index:4;left:50%;top:50%;transform:translate(-50%,-50%);color:#98a4b2;font-size:18rpx}.map-axis{position:absolute;z-index:4;color:#8090a2;font-size:13rpx;letter-spacing:1rpx;pointer-events:none}.map-axis-y{left:8rpx;top:50%;transform:translate(-28%,-50%) rotate(-90deg)}.map-axis-x{left:50%;bottom:6rpx;transform:translateX(-50%)}
.quadrant-note { margin: 10rpx 5rpx 0; color: #909dad; font-size: 15rpx; line-height: 1.45; }
.member-list { padding: 4rpx 24rpx; }
.member-row { display:flex; align-items:center; gap:18rpx; padding:22rpx 0; border-bottom:1rpx solid #edf0f5; }.member-row:last-child{border-bottom:0}
.member-clickable:active{opacity:.62}.member-arrow{flex:0 0 auto;color:#8da0b5;font-size:34rpx;font-weight:300}
.member-avatar { width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;border-radius:22rpx;background:#e9f0ff;color:#2457d6;font-weight:750; }
.member-main { flex:1 }.member-name { font-weight:650 }.member-name text { margin-left:12rpx;color:#8b96a7;font-size:20rpx;font-weight:400 }
.progress { height:8rpx;margin-top:13rpx;border-radius:999rpx;background:#edf1f6;overflow:hidden }.progress view { height:100%;border-radius:999rpx;background:#3a6ee8 }
.member-score { display:flex;flex-direction:column;align-items:flex-end }.member-score text{font-weight:700}.member-score label{margin-top:4rpx;color:#8b96a7;font-size:19rpx}
.insight { display:flex;gap:18rpx;padding:24rpx }.insight-icon{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;border-radius:17rpx;background:#fff0e7;color:#d65f2f;font-weight:800}.insight-content{flex:1}.insight-title{font-weight:700}.insight-text{margin-top:10rpx;color:#68758a;line-height:1.6;font-size:24rpx}.insight-actions{display:flex;gap:28rpx;margin-top:18rpx;color:#2457d6;font-size:24rpx;font-weight:600}

/* Glass / editorial visual layer */
.summary { border-color: rgba(255,255,255,.16); background: linear-gradient(145deg,rgba(18,42,70,.97),rgba(20,102,196,.94)); box-shadow: 0 22rpx 50rpx rgba(16,70,139,.22), inset 0 1rpx 1rpx rgba(255,255,255,.22); }
