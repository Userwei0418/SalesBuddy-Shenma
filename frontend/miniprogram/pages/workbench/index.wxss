.sheet-status{display:flex;align-items:center;gap:10rpx;padding:0 27rpx 17rpx}.sheet-status>view,.sheet-status>text{padding:7rpx 12rpx;border-radius:999rpx;font-size:16rpx}.sheet-status>view{color:#207454;background:#e3f5ec}.sheet-attack .sheet-status>view{color:#ad6235;background:#fff0e5}.sheet-order .sheet-status>view{color:#627085;background:#edf1f5}.sheet-resource .sheet-status>view{color:#34679e;background:#e7f0fb}.sheet-status>text{color:#607186;background:#edf2f7}.sheet-status>text.has-risk{color:#bd5b42;background:#ffebe6}
.sheet-scores{display:grid;grid-template-columns:repeat(3,1fr);margin:0 27rpx 18rpx;padding:18rpx 5rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:23rpx;background:rgba(255,255,255,.62);box-shadow:0 10rpx 28rpx rgba(28,66,108,.07)}.sheet-scores>view{display:flex;flex-direction:column;align-items:center;border-right:1rpx solid rgba(75,105,139,.09)}.sheet-scores>view:last-child{border:0}.sheet-scores text{color:#1d456c;font-size:29rpx;font-weight:780}.sheet-scores label{margin-top:5rpx;color:#8996a6;font-size:15rpx}
