.overview-board{overflow:hidden;padding:24rpx 24rpx 0;transition:transform .15s ease,opacity .15s ease}.overview-board:active{transform:scale(.985);opacity:.82}.overview-head{display:flex;align-items:center;gap:15rpx}.overview-head>view:nth-child(2){flex:1;min-width:0}.overview-head>view:nth-child(2)>view{color:#2b4057;font-size:23rpx;font-weight:730}.overview-head>view:nth-child(2)>text{display:block;margin-top:5rpx;color:#8795a7;font-size:16rpx}.overview-icon{width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:18rpx;font-size:23rpx;font-weight:800}.task-overview-icon{color:#1677ff;background:linear-gradient(145deg,#e6f3ff,#ddecff)}.risk-overview-icon{color:#cc6744;background:linear-gradient(145deg,#fff3eb,#ffe7dc)}.overview-total{display:flex;align-items:baseline;gap:5rpx;color:#175f9f}.overview-total text{font-size:38rpx;font-weight:800}.overview-total label{font-size:15rpx}.risk-total{color:#ba6043}.overview-metrics{display:grid;grid-template-columns:repeat(3,1fr);margin-top:22rpx;overflow:hidden;border:1rpx solid rgba(74,107,143,.09);border-radius:20rpx;background:rgba(246,250,254,.7)}.overview-metrics>view{display:flex;flex-direction:column;padding:17rpx 14rpx;border-right:1rpx solid rgba(74,107,143,.09)}.overview-metrics>view:last-child{border:0}.overview-metrics text{color:#2a4d70;font-size:27rpx;font-weight:780}.overview-metrics label{margin-top:4rpx;color:#8997a8;font-size:15rpx}.overview-metrics .warning-number{color:#d56d48}.overview-link{display:flex;align-items:center;justify-content:space-between;margin-top:19rpx;padding:18rpx 2rpx;border-top:1rpx solid rgba(61,105,150,.09);color:#1677ff;font-size:19rpx;font-weight:680}.overview-link label{font-size:30rpx;font-weight:400}.risk-link{color:#c16243}.risk-overview{background:linear-gradient(145deg,rgba(255,255,255,.92),rgba(255,247,241,.86))}
