.workbench-opportunity-tools{margin-top:14rpx}.workbench-create-row{display:flex;justify-content:flex-end;margin:0 2rpx 12rpx}.workbench-create-opportunity{display:flex;align-items:center;gap:8rpx;padding:12rpx 20rpx;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#1768b5,#1688e8);box-shadow:0 8rpx 20rpx rgba(20,113,197,.2)}.workbench-create-opportunity>text{font-size:24rpx;line-height:1}.workbench-create-opportunity>label{font-size:18rpx;font-weight:680}.workbench-create-opportunity-active{opacity:.82;transform:scale(.98)}
.head-create-opportunity{margin-bottom:2rpx;padding:13rpx 21rpx;box-shadow:0 9rpx 22rpx rgba(20,113,197,.24)}
.workbench-create-opportunity{min-width:136rpx;height:56rpx;justify-content:center;box-sizing:border-box;padding:0 20rpx;gap:0}.head-create-opportunity{margin:0}.workbench-create-opportunity>label{font-size:18rpx}
.workbench-opportunity-filter{margin-bottom:18rpx;padding:8rpx 10rpx;border:1rpx solid rgba(73,111,148,.1);border-radius:20rpx;background:rgba(255,255,255,.9)}.workbench-filter-line{display:flex;align-items:center;gap:8rpx;min-width:0}.workbench-filter-title{flex:0 0 auto;color:#405d76;font-size:19rpx;font-weight:700}.workbench-filter-scroll{width:0;min-width:0;flex:1;white-space:nowrap}.workbench-filter-row{display:inline-flex;align-items:center;gap:7rpx;padding-right:6rpx}.workbench-filter-item{width:188rpx;height:50rpx;box-sizing:border-box;flex:0 0 auto;overflow:hidden;border:1rpx solid #dfe9f2;border-radius:12rpx;background:#f6f9fc}.workbench-filter-control{display:flex;align-items:center;gap:6rpx;height:48rpx;min-width:0;padding:0 10rpx}.workbench-filter-control>label{flex:0 0 auto;color:#8a99a8;font-size:15rpx}.workbench-filter-control>text:nth-child(2){min-width:0;flex:1;overflow:hidden;color:#304e68;font-size:17rpx;font-weight:650;white-space:nowrap;text-overflow:ellipsis}.workbench-filter-chevron{flex:0 0 auto;color:#86a0b7;font-size:15rpx}.workbench-filter-reset{flex:0 0 auto;padding:8rpx 4rpx;color:#2477b9;font-size:18rpx}
.workbench-opportunity-list{display:flex;flex-direction:column;gap:16rpx}.workbench-opportunity-empty{padding:64rpx 20rpx;text-align:center;color:#8292a3;font-size:20rpx}
.workbench-filter-item.filter-stage.active{border-color:#8fc8f2;background:#eaf5ff}.workbench-stage-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9rpx;margin-top:11rpx;padding-top:12rpx;border-top:1rpx solid #e6edf4}.workbench-stage-option{display:flex;align-items:center;gap:8rpx;min-width:0;min-height:50rpx;padding:0 12rpx;border:1rpx solid #dfe8f1;border-radius:14rpx;color:#557087;background:#f8fafc;font-size:16rpx}.workbench-stage-option>text{width:15rpx;flex:0 0 auto;color:#1778ca}.workbench-stage-option>label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.workbench-stage-option.selected{border-color:#92c9f1;color:#176fb7;background:#eaf5ff;font-weight:680}

/* Independent quarter filters for the summary and the opportunity list. */
