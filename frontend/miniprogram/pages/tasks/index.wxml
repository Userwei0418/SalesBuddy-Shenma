<wxs module="opt">
function lab(it, key, suffix) { return (key ? it[key] : it) + (suffix || ''); }
function idx(list, key, suffix) { var out = []; for (var i = 0; i < (list || []).length; i++) { out.push({ value: i, label: lab(list[i], key, suffix) }); } return out; }
function rest(list, key, suffix) { var out = []; for (var i = 1; i < (list || []).length; i++) { out.push({ value: i, label: lab(list[i], key, suffix) }); } return out; }
function pick(i) { var n = i * 1; return n > 0 ? n : null; }
module.exports = { idx: idx, rest: rest, pick: pick };
</wxs>
<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view wx:if="{{completedYear}}" class="fde-note">已完成记录按 {{completedYear}} 年{{completedQuarters.length?'所选季度':'全年'}}筛选；未完成任务为当前状态。</view>
<view class="tasks-page">
  <view class="tasks-hero">
    <sb-summary-card appearance="hero" wx:if="{{overviewFilter}}" title="{{opportunityOnly ? '商机待办' : overviewTitle || '我的待办'}}" subtitle="{{opportunityOnly ? '待办项均绑定商机，可直接返回查看商机卡片' : overviewDescription || '每一项都可进入详情、追踪状态并反馈完成结果'}}" meta="{{loading ? '正在同步任务…' : loadError ? '任务数量暂未加载' : '共 ' + filteredTotal + ' 项任务'}}" scope="{{scope}}" />
    <sb-summary-card appearance="hero" wx:else title="{{opportunityOnly ? '商机待办' : overviewTitle || '我的待办'}}" subtitle="{{opportunityOnly ? '待办项均绑定商机，可直接返回查看商机卡片' : overviewDescription || '每一项都可进入详情、追踪状态并反馈完成结果'}}" scope="{{scope}}" metrics="{{[{label:'未完成',value:loading || loadError ? '' : pendingCount,missingText:'—'},{label:'已完成',value:loading || loadError ? '' : completedCount,missingText:'—'},{label:'全部任务',value:loading || loadError ? '' : totalCount,missingText:'—'}]}}" />
  </view>

  <view wx:if="{{isFde && canViewTeam}}" class="task-view-switch">
    <sb-segmented block emitSame options="{{taskViewOptions}}" value="{{taskView}}" bind:change="onTaskViewChange" />
    <view wx:if="{{taskView === 'team' && fdeTaskMemberId}}" class="member-scope" hover-class="task-row-pressed" data-view="team" bindtap="changeTaskView" aria-role="button" aria-label="当前仅看所选成员的任务，点击查看全部团队任务"><text>仅看所选成员的任务</text><view class="task-link">查看全部团队<t-icon name="chevron-right" size="32rpx" /></view></view>
  </view>

  <view wx:if="{{!overviewFilter}}" class="task-tabs">
    <sb-tabs items="{{[{key:tabs[0].key,label:tabs[0].label,count:pendingCount},{key:tabs[1].key,label:tabs[1].label},{key:tabs[2].key,label:tabs[2].label},{key:tabs[3].key,label:tabs[3].label}]}}" activeKey="{{activeTab}}" bind:change="onTabChange" />
  </view>

  <view wx:if="{{loadError}}" class="task-state"><sb-state-panel state="error" title="待办加载未完成" description="{{loadError}}" bind:retry="loadTasks" /></view>

  <view class="sort-toolbar">
    <view class="sort-row">
      <text class="sort-count">{{loading ? '加载中…' : loadError ? '加载未完成' : '共 ' + filteredTotal + ' 项'}}</text>
      <view class="sort-select-wrap"><sb-labeled-select size="small" label="排序" allOption="{{false}}" options="{{opt.idx(sortOptions,'label')}}" value="{{sortIndex}}" bind:change="changeSort" /></view>
    </view>
    <view class="sort-hint">{{sortOptions[sortIndex].hint}}</view>
  </view>

  <view wx:if="{{filteredTasks.length}}" class="task-list">
    <view wx:for="{{filteredTasks}}" wx:key="id" class="task-card status-{{item.status}} traffic-{{item.signal.tone}}" hover-class="task-card-pressed" data-id="{{item.id}}" bindtap="openTask">
      <view class="task-main">
        <view class="task-top"><sb-status-tag class="task-status" tone="{{item.signal.tone === 'red' ? 'bad' : item.signal.tone === 'yellow' ? 'watch' : item.signal.tone === 'green' ? 'good' : 'pending'}}" label="{{item.signal.label}} · {{item.statusLabel}}" /><view class="priority priority-{{item.priorityClass}}">{{item.priority}}</view></view>
        <view class="task-title">{{item.title}}</view>
        <view class="task-description">{{item.description}}</view>
        <view wx:if="{{item.opportunityId}}" class="task-opportunity" data-customer-id="{{item.customerId}}" data-opportunity-id="{{item.opportunityId}}" hover-class="task-row-pressed" hover-stop-propagation catchtap="openOpportunity"><view><text>关联商机</text><label>{{item.opportunityName || '查看对应商机'}}</label></view><view class="task-link">查看商机<t-icon name="chevron-right" size="32rpx" /></view></view>
        <view class="task-meta"><view><text>负责人</text><label>{{item.owner}}</label></view><view><text>{{item.status === 'completed' ? '完成时间' : '截止时间'}}</text><label>{{item.status === 'completed' ? item.completedLabel : item.dueLabel}}</label></view></view>
        <view class="task-source"><text>{{item.customer}}</text><label>{{item.sourceLabel}}</label><view class="task-link">查看详情<t-icon name="chevron-right" size="32rpx" /></view></view>
      </view>
    </view>
  </view>
  <view wx:elif="{{!loadError}}" class="task-state empty-state"><sb-state-panel state="{{loading ? 'loading' : 'empty'}}" title="{{loading ? '正在同步任务' : overviewEmptyTitle || (activeTab === 'pending' ? '当前没有未完成任务' : '暂无对应任务')}}" description="{{overviewFilter ? '任务更新后，返回页面即可查看最新结果' : '新的任务会自动同步到这里'}}" /></view>
  <view wx:if="{{moreError}}" class="task-pagination"><text>{{moreError}}</text><button size="mini" hover-class="task-row-pressed" bindtap="loadMore">重试下一页</button></view>
  <view wx:elif="{{filteredTasks.length && !loading}}" class="task-pager"><sb-pagination mode="more" plain summary="已显示 {{filteredTasks.length}}／{{filteredTotal}} 项" total="{{filteredTotal}}" loading="{{loadingMore}}" end="{{!hasMore}}" bind:more="loadMore" /></view>
</view>

</block>
