page{background:var(--ui-background)}
.tasks-page{min-height:100vh;padding-bottom:48rpx;color:var(--ui-ink);background:var(--ui-background)}
.tasks-hero{margin:24rpx 32rpx 0}
.task-view-switch{margin:16rpx 32rpx 0}
/* 从成员下钻进来时的筛选说明：整行可点（44px），点了回到整个团队；原方法 changeTaskView 复位成员 */
.member-scope{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:var(--ui-touch-target);margin-top:var(--ui-space-2);padding:0 var(--ui-space-3);border-radius:var(--ui-radius-panel);background:var(--ui-surface);color:var(--ui-secondary);font-size:14px}
.member-scope>text{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.task-tabs{position:sticky;z-index:5;top:0;margin-top:var(--ui-space-2);padding:0 32rpx;background:var(--ui-background)}
.task-state{padding:16rpx 32rpx}
/* 排序：飞书筛选片（sb-labeled-select size=small），宽度由外层决定；用 px 固定 150px，320 宽屏也放得下「按截止时间倒序」加箭头，不截断 */
.sort-toolbar{padding:24rpx 32rpx 16rpx}
.sort-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.sort-count{flex-shrink:0;color:var(--ui-secondary);font-size:14px}
.sort-select-wrap{flex:0 0 150px;width:150px;min-width:0}
.sort-hint{margin-top:8rpx;color:var(--ui-muted);font-size:var(--ui-text-small);line-height:1.5;text-align:right}
/* 任务卡：白卡放在灰底上，不描边；卡内分组用分隔线 */
.task-list{display:flex;flex-direction:column;gap:16rpx;padding:0 32rpx 32rpx}
.task-card{border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.task-card-pressed{background:var(--ui-neutral-soft)}
.task-row-pressed{opacity:.7}
.task-main{min-width:0;padding:28rpx 32rpx}
.task-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.priority{flex:0 0 auto;padding:0 12rpx;border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);line-height:20px}
.priority-high,.priority-urgent{color:var(--ui-danger);background:var(--ui-danger-soft)}
.task-title{margin-top:16rpx;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;line-height:1.45}
.task-description{display:-webkit-box;margin-top:8rpx;overflow:hidden;color:var(--ui-secondary);font-size:14px;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.task-opportunity{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:var(--ui-touch-target);margin-top:24rpx;padding-top:20rpx;border-top:1px solid var(--ui-line)}
.task-opportunity>view:first-child{min-width:0;flex:1}
.task-opportunity>view:first-child text,.task-opportunity>view:first-child label{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.task-opportunity>view:first-child text{color:var(--ui-secondary);font-size:var(--ui-text-small)}
.task-opportunity>view:first-child label{margin-top:4rpx;color:var(--ui-ink);font-size:14px;font-weight:600}
.task-link{display:flex;align-items:center;flex:0 0 auto;color:var(--ui-primary);font-size:14px}
.task-meta{display:grid;grid-template-columns:1fr 1.35fr;gap:16rpx;margin-top:24rpx}
.task-meta text{display:block;color:var(--ui-muted);font-size:var(--ui-text-small)}
.task-meta label{display:block;margin-top:4rpx;overflow:hidden;color:var(--ui-ink);font-size:14px;white-space:nowrap;text-overflow:ellipsis}
.task-source{display:flex;align-items:center;gap:12rpx;margin-top:24rpx;padding-top:20rpx;border-top:1px solid var(--ui-line);color:var(--ui-secondary);font-size:var(--ui-text-small)}
.task-source text{max-width:42%;overflow:hidden;color:var(--ui-ink);white-space:nowrap;text-overflow:ellipsis}
.task-source label{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.task-pager{padding:0 32rpx 32rpx}
.task-pagination{display:flex;align-items:center;justify-content:center;gap:16rpx;padding:0 32rpx 32rpx;color:var(--ui-secondary);font-size:14px}
.task-pagination button{display:flex;align-items:center;min-height:var(--ui-touch-target);margin:0;padding:0 24rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-surface);font-size:14px;font-weight:400}
.task-pagination button::after{border:0}


