/* 建议处理：主按钮实底、次按钮白底细线；已采纳显示为链接。 */
.actions{display:flex;flex-wrap:wrap;gap:12px 8px;margin-top:16rpx;align-items:center}
.adopt,.dismiss,.done{display:flex;align-items:center;justify-content:center;width:auto;min-width:0;margin:0;padding:0 24rpx;height:64rpx;min-height:64rpx;box-sizing:border-box;font-size:14px;line-height:1.3;border-radius:var(--ui-radius-control);font-weight:600}
.done::after{border:0}
/* 采纳、无需待办：看起来 32px；原生按钮自带的 ::after 边框改作点击区，上下各扩到 44px（按钮本身不裁切），视觉不变 */
.adopt,.dismiss{position:relative;overflow:visible}
.adopt::after,.dismiss::after{content:'';position:absolute;left:0;right:0;top:calc(50% - 22px);bottom:calc(50% - 22px);width:auto;height:auto;border:0;border-radius:0;transform:none}
.adopt{background:var(--ui-primary);color:var(--ui-on-primary)}
.dismiss{border:1px solid var(--ui-line);background:var(--ui-surface);color:var(--ui-ink);font-weight:400}
/* 已采纳 · 查看待办：点按区固定 44px，负外边距让它在行里只占 64rpx */
.done{gap:4rpx;height:44px;min-height:44px;margin:calc(32rpx - 22px) 0;padding:0;background:transparent;color:var(--ui-primary);font-weight:400}
.adopt-pressed{background:var(--ui-primary-hover)}
.dismiss-pressed{background:var(--ui-neutral-soft)}
.done-pressed{opacity:.7}
.handled{font-size:var(--ui-text-small);line-height:1.6;color:var(--ui-secondary)}
.adopt[disabled],.dismiss[disabled]{border:1px solid var(--ui-line);background:var(--ui-background);color:var(--ui-muted)}
.actions>.handled{width:100%}

/* Each accepted recipient retains an independent task link. */
.adopted-tasks{display:flex;flex-wrap:wrap;gap:12px 16px;align-items:center}
.adopted-tasks .done{white-space:normal;text-align:left;overflow-wrap:anywhere}
