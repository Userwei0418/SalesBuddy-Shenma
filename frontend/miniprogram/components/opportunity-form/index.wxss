.opp-form{color:#223b53}
.field{margin:16rpx 0}
.label{display:flex;align-items:center;font-size:20rpx;font-weight:650;line-height:1.4;color:#28445e}
.required,.optional{display:inline-flex;align-items:center;margin-left:8rpx;padding:2rpx 7rpx;border-radius:999rpx;font-size:15rpx;font-weight:500;line-height:1.4}
.required{color:#b9683d;background:#fff1e8}
.optional{color:#71899f;background:#eef3f7}
.control{box-sizing:border-box;display:block;width:100%;height:68rpx;margin-top:8rpx;padding:0 16rpx;border:1rpx solid #d8e5f1;border-radius:17rpx;color:#254562;background:#f6f9fd;font-size:22rpx;transition:border-color .2s,background .2s}
.row{display:flex;align-items:center;justify-content:space-between}
.chevron{color:#4f83af;font-size:25rpx}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}
.grid .field{min-width:0;margin:7rpx 0 10rpx}
.grid .label{min-height:42rpx;align-items:flex-end;font-size:19rpx}
.grid .required{font-size:14rpx}
.grid .control{padding:0 13rpx;font-size:21rpx}
.hint,.error{margin-top:9rpx;font-size:17rpx;line-height:1.5}
.hint{color:#7d91a5}
.error{color:#bf583e}
.track{display:flex;gap:6rpx;margin-top:10rpx}
.step{height:6rpx;flex:1;border-radius:4rpx;background:#e2eaf3}
.step.active{background:#2b93c7}
.step.lost{background:#eaaea6}
.fold{display:flex;align-items:center;justify-content:space-between;min-height:64rpx;margin-top:10rpx;padding:0 14rpx;border:1rpx solid #e1eaf3;border-radius:17rpx;color:#304d67;background:#f8fbfe;font-size:19rpx;font-weight:600}
.fold-text{color:#267fc1;font-size:18rpx;font-weight:500}
.forecast{margin:10rpx 0 18rpx;padding:18rpx;border:1rpx solid #dceaf6;border-radius:18rpx;background:#f1f7fd}
.quarter{display:flex;align-items:center;justify-content:space-between;padding:4rpx 0 11rpx;color:#2675b3;font-size:24rpx;font-weight:650}
.quarter-text{font-size:20rpx;font-weight:400}

.forecast-results{margin-top:14rpx;padding:16rpx;border:1rpx solid #d8e7f5;border-radius:16rpx;background:#fff}
.forecast-results-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx;color:#3574a8;font-size:18rpx;font-weight:600}
.forecast-results-head>label{color:#7b91a7;font-size:17rpx;font-weight:400}
.forecast-result{min-width:0}.forecast-result>text{display:block;color:#647e95;font-size:18rpx}.forecast-result>label{display:block;margin-top:8rpx;color:#216faa;font-size:28rpx;font-weight:750;overflow-wrap:anywhere}

.partner-name{margin-top:14rpx}

.partner-results{margin-top:16rpx;padding:20rpx;background:#f5f9fe;border:1rpx solid #d9e7f5;border-radius:18rpx}.partner-option{display:flex;justify-content:space-between;gap:16rpx;padding:24rpx 4rpx;border-bottom:1rpx solid #e2eaf3;color:#233f5c;font-size:26rpx}.partner-more{text-align:center;padding:20rpx;color:#1678d6;font-size:24rpx}
