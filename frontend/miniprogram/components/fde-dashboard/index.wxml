<wxs module="ui">
function heroMetrics(s){if(!s)return [];return [{label:'协助商机',value:s.opportunities,unit:'个'},{label:'客户',value:s.customers,unit:'个'},{label:'在推',value:s.open_opportunities,unit:'个'}];}
function amount(v){return v==='未登记'?'':v;}
module.exports={heroMetrics:heroMetrics,amount:amount};
</wxs>
<wxs module="opt">
function lab(it,key,suffix){return (key ? it[key] : it) + (suffix || '');}
function idx(list,key,suffix){var out=[];for(var i=0;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function rest(list,key,suffix){var out=[];for(var i=1;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function pick(i){var n=i * 1;return n>0?n:null;}
module.exports={idx:idx,rest:rest,pick:pick};
</wxs>
<view class="fde-board">
<block wx:if="{{!recordsOnly}}">
  <view class="page-head"><view class="page-heading"><text class="page-title">{{memberId ? (memberLabel || '成员') + '的看板' : '协作看板'}}</text><text class="page-subtitle">项目进展与工作记录</text></view><view class="quarter-picker {{filterOpen?'quarter-picker-open':''}} {{filterOpen || quarters.length || yearIndex !== 5 ? 'quarter-picker-on' : ''}}" hover-class="quarter-picker-pressed" bindtap="toggleFilter" aria-role="button" aria-label="选择统计周期，当前{{periodLabel}}"><view class="quarter-chip"><text class="quarter-picker-value">{{periodLabel}}</text><t-icon name="chevron-down" size="32rpx" class="quarter-picker-caret"/></view></view></view>
  <view wx:if="{{filterOpen}}" class="period-filter"><sb-select class="period-year" plain label="统计年份" options="{{opt.idx(yearOptions,'','年')}}" value="{{draftYearIndex}}" bind:change="year"/><view class="filter-head"><text>统计季度 · 可多选</text></view><view class="quarter-options"><view class="quarter-option filter-reset {{draftQuarters.length ? '' : 'selected'}}" data-q="0" bindtap="quarter" hover-class="quarter-option-pressed" aria-role="checkbox" aria-checked="{{!draftQuarters.length}}"><text class="quarter-chip-face">全年</text></view><view wx:for="{{quarterOptions}}" wx:key="value" class="quarter-option {{item.selected?'selected':''}}" data-q="{{item.value}}" bindtap="quarter" hover-class="quarter-option-pressed" aria-role="checkbox" aria-checked="{{item.selected}}"><text class="quarter-chip-face">Q{{item.value}}</text></view></view><view class="filter-footer"><text class="filter-hint">不选季度即统计全年，确定后生效</text><view class="footer-action" hover-class="footer-action-pressed" bindtap="applyPeriod"><t-button size="small" theme="primary" hover-stop-propagation bind:tap="applyPeriod">确定</t-button></view></view></view>
  <view class="metrics-section">
    <view class="metrics-heading">
      <text class="metrics-title">经营数据</text>
      <view wx:if="{{canViewTeam && !personal && !memberId}}" class="metrics-controls">
        <view class="metrics-scope-switch-wrap"><sb-segmented size="small" options="{{scopeOptions}}" value="{{scope}}" bind:change="onScopeSegment"/></view>
        <view wx:if="{{scope==='self'}}" class="metrics-picker"><dashboard-picker title="选择成员" subtitle="选择本人或授权范围内的 FDE" label="{{memberOptions[memberIndex].name}}" active="{{memberIndex > 0}}" options="{{pickerOptions}}" selected="{{pickerSelected}}" bind:change="selectMember"/></view>
      </view>
    </view>
    <view class="metrics-meta"><text class="metrics-context">{{memberLabel || scopeLabel}}{{periodLabel ? ' · ' + periodLabel : ''}}</text></view>
  </view>
  <view wx:if="{{loading}}" class="loading-card"><sb-state-panel state="loading" title="正在更新看板…"/></view><view wx:elif="{{error}}" class="loading-card"><sb-state-panel state="error" title="看板加载失败" description="{{error}}" bind:retry="load"/></view>
  <block wx:elif="{{ready}}">
    <view class="hero-card" hover-class="card-pressed" bindtap="openProjects"><sb-summary-card appearance="hero" tone="brand" title="当前协助商机" subtitle="{{memberLabel || scopeLabel}}" metrics="{{ui.heroMetrics(summary)}}"><view class="hero-link">查看项目<t-icon name="chevron-right" size="28rpx"/></view></sb-summary-card></view>
    <view class="kpi-grid">
      <view class="kpi-cell" hover-class="card-pressed" bindtap="openProjects"><sb-kpi-card size="compact" label="在推商机金额" value="{{ui.amount(summary.openAcvText)}}" unit="万" note="当前参与项目"/></view>
      <view class="kpi-cell" hover-class="card-pressed" bindtap="openActivity"><sb-kpi-card size="compact" label="跟进记录" value="{{summary.period_visits}}" unit="条" note="{{summary.active_recorders}} 人填报 · 查看记录"/></view>
      <view class="kpi-cell" hover-class="card-pressed" bindtap="openProjects"><sb-kpi-card size="compact" label="确收金额" value="{{ui.amount(summary.recognizedText)}}" unit="万" note="所选周期 · 协助项目"/></view>
      <view class="kpi-cell"><sb-kpi-card size="compact" label="Demo 数量" value="{{summary.demo_scene_count}}" unit="个" note="所选周期 · 场景登记"/></view>
    </view>
    <view class="chart-card task-card"><view class="section-head"><text class="section-title">任务进展</text><text class="section-note">{{periodLabel}}</text></view><view class="task-metrics"><view class="task-metric" hover-class="cell-pressed" data-status="completed" bindtap="openTasks"><text class="task-value">{{summary.completed_tasks}}</text><view class="task-label">已完成<t-icon name="chevron-right" size="24rpx"/></view></view><view class="task-metric" hover-class="cell-pressed" data-status="pending" bindtap="openTasks"><text class="task-value">{{summary.pending_tasks}}</text><view class="task-label">待完成<t-icon name="chevron-right" size="24rpx"/></view></view><view class="task-metric" hover-class="cell-pressed" data-status="pending" bindtap="openTasks"><text class="task-value attention">{{summary.overdue_tasks}}</text><view class="task-label">已逾期<t-icon name="chevron-right" size="24rpx"/></view></view></view></view>
    <view wx:if="{{!compact}}" class="chart-card"><view class="section-head"><view><text class="section-title">商机阶段</text><text class="section-subtitle">当前参与商机 · 按数量</text></view><view class="section-link" hover-class="link-pressed" bindtap="openProjects">全部<t-icon name="chevron-right" size="28rpx"/></view></view><view class="funnel-list"><view wx:for="{{stages}}" wx:key="code" class="funnel-row" hover-class="cell-pressed" bindtap="openProjects"><view class="funnel-copy"><text class="funnel-name">{{item.label}}</text><text class="funnel-amount">{{item.amountText}} 万元</text><text class="funnel-count">{{item.count}} 个</text></view><view class="funnel-track"><view class="funnel-bar tone-{{item.tone}}" style="width:{{item.width}}%"></view></view></view></view><view wx:if="{{!stages.length}}" class="empty">参与商机后，在这里查看项目进展</view></view>
    <view wx:if="{{!compact}}" class="chart-card"><view class="section-head"><view><text class="section-title">拜访节奏</text><text class="section-subtitle">{{rhythmMode==='day'?'最近 7 天':'最近 12 周'}} · {{summary.period_customers}} 个客户</text></view><view class="section-link" hover-class="link-pressed" bindtap="openActivity">明细<t-icon name="chevron-right" size="28rpx"/></view></view><view class="rhythm-switch"><sb-segmented size="small" options="{{rhythmOptions}}" value="{{rhythmMode}}" bind:change="onRhythmSegment"/></view><text wx:if="{{rhythmMode==='week'}}" class="rhythm-note">周一至周日 · 仅统计所选周期内记录</text><scroll-view wx:if="{{rhythm.length}}" scroll-x enhanced show-scrollbar="false" class="rhythm-scroll"><view class="visit-bars"><view wx:for="{{rhythm}}" wx:key="date" class="visit-day" hover-class="cell-pressed" bindtap="openActivity"><text class="bar-value">{{item.visits===null?'—':item.visits}}</text><view class="bar-space"><view class="visit-bar" style="height:{{item.height}}%"></view></view><text class="bar-date">{{item.dateLabel}}</text><text wx:if="{{rhythmMode==='week'}}" class="bar-week-end">至 {{item.endLabel}}</text></view></view></scroll-view><view wx:else class="empty">本人确认归档后，将形成拜访节奏</view></view>
    <view wx:if="{{scope==='team' && !compact}}" class="chart-card ranking-card"><view class="section-head"><view><text class="section-title">团队工作分布</text><text class="section-subtitle">{{rankingPeriodLabel || periodLabel}}</text></view></view><view class="team-periods ranking-control"><text class="ranking-control-label">周期</text><sb-segmented block size="small" options="{{rankingPeriodOptions}}" value="{{rankingPeriod}}" bind:change="onRankingPeriodSegment"/></view><view class="ranking-control"><text class="ranking-control-label">排序</text><sb-segmented block size="small" options="{{opt.idx(sortOptions,'name')}}" value="{{sortIndex}}" bind:change="sortRanking"/></view><view wx:if="{{rankingPeriodLoading}}" class="empty">正在加载团队统计…</view><view wx:elif="{{rankingPeriodError}}" class="empty error">{{rankingPeriodError}}</view><button wx:for="{{ranking}}" wx:key="user_id" class="ranking-row" data-id="{{item.user_id}}" bindtap="openMember" hover-class="ranking-row-pressed" aria-label="查看{{item.name}}的协作看板{{item.is_active===false?'，已离组':''}}"><view class="rank-badge rank-{{item.rank}}">{{item.rank}}</view><view class="rank-person"><text class="rank-name">{{item.name}}{{item.is_active===false?' · 已离组':''}}</text><text class="rank-meta">{{item.team}} · {{item.opportunities}} 个商机</text><view class="rank-track"><view class="rank-progress" style="width:{{item.width}}%"></view></view></view><view class="rank-result"><view class="rank-value">{{item.value}}<t-icon name="chevron-right" size="28rpx" class="rank-arrow"/></view><text class="rank-unit">{{sortOptions[sortIndex].name}}</text></view></button><view wx:if="{{!ranking.length && !rankingPeriodLoading && !rankingPeriodError}}" class="empty">当前范围暂无成员记录</view></view>
    <block wx:if="{{!compact}}"><view class="public-rankings-heading"><text class="metrics-title">公共排名</text></view><dashboard-ranking wx:for="{{companyCards}}" wx:key="key" title="{{item.title}}" subtitle="{{rankingCohort}}" period="{{periodLabel}}" symbol="{{item.symbol}}" tone="{{item.tone}}" rows="{{item.rows}}" summary-ids="{{ownIds}}" empty-summary="所选对象暂未纳入当前榜单" error="{{item.error}}" bind:retry="load"/></block>
  </block>
</block>
  <view wx:if="{{activityOpen}}" class="activity-layer">
    <view class="activity-head"><view class="activity-heading"><view class="activity-title-line"><text class="activity-title">跟进记录</text><text class="activity-count">{{activityTotal}} 条</text></view><text class="activity-subtitle">{{periodLabel ? periodLabel + ' · ' : ''}}{{memberLabel || scopeLabel}}</text></view></view>
    <scroll-view scroll-y enhanced show-scrollbar="false" class="activity-scroll">
      <view class="activity-list">
        <view wx:for="{{activity}}" wx:key="id" class="activity-card" data-id="{{item.id}}" bindtap="openVisit" hover-class="activity-card-active">
          <view class="activity-card-head"><view class="visit-copy"><text class="activity-customer">{{item.customer_name}}</text><text class="activity-project">{{item.opportunity_name || '未关联商机'}}</text></view><t-icon wx:if="{{item.can_read_detail}}" name="chevron-right" size="36rpx" class="activity-arrow"/></view>
          <view class="activity-card-foot"><text class="activity-date">{{item.dateText}}</text><text class="activity-recorder">{{item.recorder_name || '未记录填报人'}}</text><text wx:if="{{!item.can_read_detail}}" class="activity-history">历史摘要</text></view>
        </view>
        <sb-state-panel wx:if="{{activityLoading}}" size="{{activity.length ? 'compact' : 'default'}}" state="loading" title="正在加载跟进记录…"/>
        <sb-state-panel wx:elif="{{activityError}}" size="{{activity.length ? 'compact' : 'default'}}" state="error" title="{{activity.length ? activityError : '跟进记录加载失败'}}" description="{{activityError}}" retryNote="" bind:retry="loadActivity"/>
        <sb-pagination wx:elif="{{activityMore}}" mode="more" plain loading="{{activityLoading}}" end="{{!activityMore}}" summary="已显示 {{activity.length}}／{{activityTotal}} 条" bind:more="loadActivity"/>
        <sb-state-panel wx:elif="{{!activity.length}}" state="empty" title="暂无跟进记录" description="所选周期内的已归档记录会显示在这里"/>
        <sb-pagination wx:else mode="more" plain end summary="已显示 {{activity.length}}／{{activityTotal}} 条"/>
      </view>
    </scroll-view>
  </view>
</view>
