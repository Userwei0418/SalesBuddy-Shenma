.picker-trigger.picker-trigger{display:flex;align-items:center;justify-content:center;gap:12rpx;box-sizing:border-box;width:176rpx;max-width:176rpx;min-width:0;min-height:0;height:56rpx;margin:0;padding:0 18rpx;border:1rpx solid #c9deef;border-radius:14rpx;background:#f6fbff;color:#2678b6;font-size:22rpx;font-weight:600;line-height:1;white-space:nowrap}
.picker-trigger::after{border:0}
.trigger-title{line-height:1.2}
.trigger-caret{width:9rpx;height:9rpx;margin-top:-4rpx;border-right:2rpx solid #5286ae;border-bottom:2rpx solid #5286ae;transform:rotate(45deg);flex-shrink:0}
.sheet-layer{position:fixed;inset:0;z-index:2000}.sheet-mask{position:absolute;inset:0;background:rgba(25,48,70,.38)}.sheet-panel{position:absolute;bottom:0;left:0;right:0;background:#f7fbff;border-radius:32rpx 32rpx 0 0;overflow:hidden;padding-bottom:env(safe-area-inset-bottom)}.sheet-handle-area{height:48rpx;display:flex;align-items:center;justify-content:center}.sheet-handle{width:68rpx;height:7rpx;border-radius:10rpx;background:#bdcddb}.sheet-heading{padding:10rpx 30rpx 22rpx}.sheet-heading>text{display:block;font-size:34rpx;font-weight:600;color:#203d56}.sheet-heading>label{display:block;margin-top:10rpx;font-size:24rpx;color:#7990a4;line-height:1.5}.sheet-search{margin:0 30rpx 18rpx;height:76rpx;padding:0 22rpx;border:1rpx solid #dae6f1;border-radius:16rpx;background:#fff;font-size:28rpx;color:#28465e}.sheet-scroll{height:44vh}.option-group{padding:0 30rpx 18rpx}.group-name{display:block;color:#7a91a5;font-size:23rpx;font-weight:600;padding:16rpx 2rpx 12rpx}.option-row{display:flex;align-items:center;gap:20rpx;background:#fff;border:1rpx solid #e2ebf3;border-radius:16rpx;padding:22rpx;margin-bottom:12rpx}.option-copy{flex:1;min-width:0}.option-copy>text{display:block;font-size:29rpx;color:#25445e;line-height:1.4}.option-copy>label{display:block;font-size:22rpx;color:#7b91a3;margin-top:6rpx}.option-check{flex-shrink:0;width:34rpx;height:34rpx;border:2rpx solid #c4d6e5;border-radius:50%;line-height:34rpx;text-align:center;font-size:24rpx;color:#fff}.option-check.square{border-radius:9rpx}.selected{border-color:#9dcaed;background:#edf7ff}.selected .option-check{background:#1b81cc;border-color:#1b81cc}.sheet-empty{padding:50rpx 30rpx;text-align:center;font-size:27rpx;color:#8096aa;line-height:1.6}.sheet-footer{padding:20rpx 30rpx 24rpx;border-top:1rpx solid #e2ecf4}.sheet-footer>text{display:block;font-size:22rpx;color:#8095a8;text-align:center;margin-bottom:16rpx}.sheet-confirm.sheet-confirm{display:flex;align-items:center;justify-content:center;width:100%;height:86rpx;margin:0;border:0;border-radius:18rpx;background:#197fca;color:#fff;font-size:29rpx;font-weight:600}.sheet-confirm:after{border:0}.sheet-confirm[disabled]{background:#e2ebf2;color:#9badbc}
