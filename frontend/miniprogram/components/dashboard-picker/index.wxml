<button size="mini" class="picker-trigger {{active ? 'picker-trigger-on' : ''}}" hover-class="picker-trigger-pressed" bindtap="open" aria-label="{{title}}，当前{{label || '未选择'}}"><view class="trigger-chip"><text class="trigger-title">{{label || title}}</text><t-icon name="chevron-down" size="32rpx" class="trigger-caret"/></view></button>
<sb-sheet visible="{{open}}" title="{{title}}" description="{{subtitle || (multiple ? '可选择多个团队' : '选择一位成员查看经营数据')}}" confirmLabel="确认选择" confirmDisabled="{{!canApply || loading || !!error}}" bind:confirm="apply" bind:close="close">
  <view slot="header" class="sheet-fixed" bindtouchstart="touchStart" bindtouchend="touchEnd">
    <sb-search wx:if="{{!multiple}}" plain maxlength="{{20}}" value="{{query}}" placeholder="{{selectionKind === 'team' ? '搜索团队' : '搜索姓名、账号或团队'}}" bind:change="search" bind:clear="search"/>
  </view>
  <view class="option-list">
    <sb-state-panel wx:if="{{loading}}" size="compact" state="loading" title="正在加载可选范围…"/>
    <sb-state-panel wx:elif="{{error}}" size="compact" state="error" title="{{error}}" bind:retry="retry"/>
    <block wx:else>
      <view wx:for="{{groups}}" wx:key="name" class="option-group">
        <text wx:if="{{!multiple && selectionKind !== 'team'}}" class="group-name">{{item.name}}</text>
        <t-cell wx:for="{{item.rows}}" wx:for-item="option" wx:key="id" title="{{option.name}}" description="{{option.meta}}" hover data-id="{{option.id}}" right-icon="{{option.checked ? 'check' : ''}}" aria-label="{{option.name}}{{option.checked ? '，已选中' : ''}}" bind:click="select"/>
      </view>
      <view wx:if="{{!groups.length}}" class="sheet-empty">{{selectionKind === 'team' ? '没有匹配的团队' : '没有匹配的成员'}}</view>
    </block>
    <view class="sheet-note">{{selectionKind === 'team' ? '选择全部团队查看部门合计，或选择一个具体团队' : multiple ? '全部选中时查看部门合计' : '仅切换经营数据，排名保持独立'}}</view>
  </view>
</sb-sheet>
