.rank-card,.sheet-layer{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.rank-card{margin-top:22rpx;padding:26rpx;background:#fff;border:1rpx solid #e0eaf4;border-top:5rpx solid #338bca;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(41,79,112,.04);color:#25445f}.rank-heading{display:flex;align-items:center;gap:14rpx}.rank-symbol{display:flex;align-items:center;justify-content:center;flex:0 0 48rpx;height:52rpx;border-radius:14rpx;background:#e4f2fd;color:#2881c0;font-size:22rpx;font-weight:700}.rank-copy{flex:1;min-width:0}.rank-copy>text{display:block;font-size:24rpx;font-weight:700;line-height:1.4}.rank-copy>label{display:block;margin-top:6rpx;font-size:17rpx;color:#7e94a7;line-height:1.5}.rank-details{flex-shrink:0;padding:12rpx 0 12rpx 10rpx;font-size:18rpx;color:#2181c9}.rank-details.disabled{color:#a0b0be}.rank-period{margin-top:20rpx;padding-bottom:16rpx;border-bottom:1rpx solid #e7eff6;color:#8a9ead;font-size:17rpx;line-height:1.5}.rank-row{display:flex;align-items:center;gap:14rpx;padding:22rpx 0}.rank-row+.rank-row{border-top:1rpx solid #edf2f7}.rank-badge{display:flex;align-items:center;justify-content:center;flex:0 0 42rpx;height:42rpx;border-radius:50%;background:#fff2c7;color:#ac8626;font-size:18rpx;font-weight:600}.rank-person{min-width:0;flex:1}.rank-person>text{display:block;font-size:22rpx;font-weight:700;line-height:1.4;word-break:break-all}.rank-person>label{display:block;margin-top:6rpx;color:#8a9faf;font-size:17rpx;line-height:1.4}.rank-track{margin-top:10rpx;background:#eaf1f7;border-radius:8rpx;height:6rpx;overflow:hidden}.rank-track>view{height:100%;background:linear-gradient(90deg,#3285c9,#63b5dc);border-radius:8rpx}.rank-value{flex-shrink:0;max-width:220rpx;text-align:right;font-size:22rpx;font-weight:700;font-variant-numeric:tabular-nums;color:#347fac;word-break:break-all}.rank-empty{padding:28rpx 8rpx;font-size:20rpx;color:#8da1b2;line-height:1.6;text-align:center}.tone-mint.rank-card{border-top-color:#339e7b}.tone-mint .rank-symbol{background:#e0f5ed;color:#319674}.tone-mint .rank-track>view{background:linear-gradient(90deg,#359c7b,#79c9a7)}.tone-mint .rank-value{color:#31896c}.tone-amber.rank-card{border-top-color:#d29a43}.tone-amber .rank-symbol{background:#fff0d5;color:#b08338}.tone-amber .rank-track>view{background:linear-gradient(90deg,#cd9445,#e3bd78)}.tone-amber .rank-value{color:#af8037}.self-label{margin-left:10rpx;padding:2rpx 8rpx;border-radius:8rpx;background:#e3f2ff;color:#3185c0;font-size:16rpx;font-weight:400}
.sheet-layer{position:fixed;inset:0;z-index:2000}.sheet-mask{position:absolute;inset:0;background:rgba(25,48,70,.38)}.sheet-panel{position:absolute;bottom:0;left:0;right:0;background:#f7fbff;border-radius:32rpx 32rpx 0 0;overflow:hidden;padding-bottom:env(safe-area-inset-bottom)}.sheet-handle-area{height:48rpx;display:flex;align-items:center;justify-content:center}.sheet-handle{width:68rpx;height:7rpx;border-radius:10rpx;background:#bdcddb}.sheet-heading{padding:10rpx 30rpx 24rpx}.sheet-heading>text{display:block;font-size:28rpx;font-weight:700;color:#203d56}.sheet-heading>label{display:block;margin-top:10rpx;font-size:18rpx;color:#7990a4;line-height:1.5}.sheet-scroll{height:52vh}.sheet-rows{padding:0 24rpx 20rpx}.sheet-rows .rank-row{padding:24rpx 18rpx;background:#fff}.sheet-rows .rank-self{background:#edf7ff}.sheet-footer{padding:22rpx 30rpx;border-top:1rpx solid #e2ecf4}.sheet-footer>button{display:flex;align-items:center;justify-content:center;height:82rpx;width:100%;margin:0;border:1rpx solid #c9dfef;border-radius:18rpx;background:#f3f9ff;color:#2d82c1;font-size:22rpx;font-weight:700}.sheet-footer>button:after{border:0}
