<import src="../../templates/opportunity-list-card.wxml"/>
<wxs module="opt">
function lab(it,key,suffix){return (key ? it[key] : it) + (suffix || '');}
function idx(list,key,suffix){var out=[];for(var i=0;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function rest(list,key,suffix){var out=[];for(var i=1;i<(list||[]).length;i++){out.push({value:i,label:lab(list[i],key,suffix)});}return out;}
function pick(i){var n=i * 1;return n>0?n:null;}
module.exports={idx:idx,rest:rest,pick:pick};
</wxs>
<view class="fde-ui-view fde-projects-view projects"><view class="fde-ui-view fde-projects-view heading">商机</view><view class="fde-ui-view fde-projects-view sub">{{customerId?'当前客户业务全景，包含本人未参与项目':'有效协助商机，按项目去重'}} · {{count}} 个项目</view>
<view wx:if="{{membersLoading}}" class="fde-ui-view fde-projects-view sub">正在加载团队成员…</view><view wx:elif="{{membersError}}" class="fde-ui-view fde-projects-view sub error" hover-class="fde-pressed" bindtap="retryMembers">{{membersError}} · 重试成员目录</view>
<view wx:if="{{!customerId}}" class="fde-ui-view overview-board opportunity-overview opportunity-summary-card">
  <view class="fde-ui-view opportunity-summary-head"><view class="fde-ui-view opportunity-summary-head-main"><view class="fde-ui-view opportunity-summary-title">商机总览</view><view class="fde-ui-view opportunity-summary-scope">{{memberId ? memberContextLabel : scope === 'team' ? '团队' : '本人'}}</view></view><text class="fde-ui-text metric-help" hover-class="metric-help-pressed" bindtap="showOpportunityMetricHelp">统计口径 ⓘ</text></view>
  <view class="fde-ui-view opportunity-summary-metrics">
    <view class="fde-ui-view opportunity-summary-metric opportunity-summary-won"><view class="fde-ui-view opportunity-summary-value">{{overviewReady ? overview.won : '—'}}<text class="fde-ui-text opportunity-summary-unit">个</text></view><view class="fde-ui-view opportunity-summary-label">已成单商机</view></view>
    <view class="fde-ui-view opportunity-summary-metric"><view class="fde-ui-view opportunity-summary-value">{{overviewReady ? overview.total : '—'}}<text class="fde-ui-text opportunity-summary-unit">个</text></view><view class="fde-ui-view opportunity-summary-label">全部商机</view></view>
    <view class="fde-ui-view opportunity-summary-metric"><view class="fde-ui-view opportunity-summary-value">{{overviewReady ? overview.active : '—'}}<text class="fde-ui-text opportunity-summary-unit">个</text></view><view class="fde-ui-view opportunity-summary-label">活跃商机</view></view>
    <view class="fde-ui-view opportunity-summary-metric"><view class="fde-ui-view opportunity-summary-value">{{overviewReady ? overview.demo_scene_count : '—'}}<text class="fde-ui-text opportunity-summary-unit">个</text></view><view class="fde-ui-view opportunity-summary-label">Demo 场景</view></view>
  </view>
  <view class="fde-ui-view fde-summary-note">全部商机为当前存量（含丢单）；成单、活跃和 Demo 按所选时间统计。</view>
  <view class="fde-ui-view quarter-filter quarter-filter-summary">
    <view class="fde-ui-view quarter-filter-head"><view class="fde-ui-view quarter-filter-head-main"><text class="fde-ui-text quarter-filter-title">统计时间</text><text class="fde-ui-text quarter-selection-label">{{summaryQuarter.label}}</text></view></view>
    <sb-select class="quarter-year-select" plain label="统计年份" placeholder="选择年份" options="{{opt.idx(summaryYears,'label')}}" value="{{summaryYearIndex}}" defaultValue="{{summaryYearIndex}}" bindchange="summaryYear"/>
    <view wx:if="{{!summaryQuarter.isAllYears}}" class="fde-ui-view quarter-options"><view class="fde-ui-view quarter-option {{summaryQuarter.isFullYear?'selected':''}}" hover-class="quarter-option-pressed" data-q="all" bindtap="summaryQuarterChange">全年</view><view wx:for="{{summaryQuarter.options}}" wx:key="value" class="fde-ui-view quarter-option {{item.selected?'selected':''}}" hover-class="quarter-option-pressed" data-q="{{item.value}}" bindtap="summaryQuarterChange">{{item.label}}</view></view>
    <view class="fde-ui-view quarter-filter-foot"><text class="fde-ui-text">{{summaryQuarter.isAllYears ? '跨年历史统计' : '全年等于四季全选 · 季度可多选'}} · 全部商机不随季度变化</text></view>
  </view>
  <view wx:if="{{overviewLoading}}" class="fde-ui-view fde-summary-note">正在更新商机总览…</view>
  <view wx:if="{{overviewError}}" class="fde-ui-view fde-summary-note fde-summary-error" hover-class="fde-pressed" bindtap="loadOverview">商机总览暂不可用 · 点击重试</view>
  <view wx:if="{{summaryQuarter.isAllYears}}" class="fde-ui-view fde-summary-note">跨年已成单数量包含成单时间待补记录；按年或季度查看时不计入已成单统计。</view>
  <view wx:if="{{overviewReady && !summaryQuarter.isAllYears && (overview.missingWonDates || overview.missingCreatedDates)}}" class="fde-ui-view fde-summary-note"><view class="fde-ui-view" wx:if="{{overview.missingWonDates}}">另有 {{overview.missingWonDates}} 个商机成单时间待补，未计入所选期间的已成单统计</view><view class="fde-ui-view" wx:if="{{overview.missingCreatedDates}}">{{overview.missingCreatedDates}} 个商机缺少原始建单日期，未计入新增的年度或季度统计</view></view>
</view>
<view class="fde-ui-view workbench-opportunity-tools"><view class="fde-ui-view workbench-opportunity-filter">
  <view class="fde-ui-view workbench-filter-line"><text class="fde-ui-text workbench-filter-title">列表筛选</text><scroll-view class="workbench-filter-scroll" scroll-x enhanced show-scrollbar="false"><view class="fde-ui-view workbench-filter-row">
    <view wx:if="{{canViewTeam && !customerId && !memberId}}" class="fde-ui-view fde-member-filter"><view class="fde-ui-view workbench-filter-control" hover-class="workbench-filter-pressed" bindtap="openMemberPicker"><text class="fde-ui-text workbench-filter-value">{{memberIds.length ? '已选 ' + memberIds.length + ' 人' : '全部成员'}}</text><t-icon name="chevron-down" size="32rpx" class="workbench-filter-chevron"/></view></view>
    <view class="fde-ui-view workbench-filter-item {{selectedStages.length?'active':''}} workbench-filter-trigger" hover-class="workbench-filter-pressed" bindtap="toggleStages"><view class="fde-ui-view workbench-filter-control"><text wx:if="{{!selectedStages.length}}" class="fde-ui-text workbench-filter-value">商机阶段</text><text wx:else class="fde-ui-text workbench-filter-value">{{'已选 '+selectedStages.length+' 项'}}</text><t-icon wx:if="{{showStages}}" name="chevron-up" size="32rpx" class="workbench-filter-chevron"/><t-icon wx:else name="chevron-down" size="32rpx" class="workbench-filter-chevron"/></view></view>
    <view class="fde-ui-view workbench-filter-item {{quarters.length?'active':''}} workbench-filter-trigger" hover-class="workbench-filter-pressed" bindtap="toggleQuarters"><view class="fde-ui-view workbench-filter-control"><text wx:if="{{!quarters.length}}" class="fde-ui-text workbench-filter-value">关单时间</text><text wx:else class="fde-ui-text workbench-filter-value">{{listQuarter.label}}</text><t-icon wx:if="{{showQuarters}}" name="chevron-up" size="32rpx" class="workbench-filter-chevron"/><t-icon wx:else name="chevron-down" size="32rpx" class="workbench-filter-chevron"/></view></view>
    <view class="fde-ui-view workbench-filter-item"><sb-labeled-select size="small" label="商机等级" placeholder="{{gradeOptions[0]}}" options="{{opt.rest(gradeOptions)}}" value="{{opt.pick(gradeIndex)}}" bindchange="grade"/></view>
    <view class="fde-ui-view workbench-filter-item"><sb-labeled-select size="small" label="产品线" placeholder="{{productOptions[0]}}" options="{{opt.rest(productOptions)}}" value="{{opt.pick(productIndex)}}" bindchange="product"/></view>
  </view></scroll-view><text wx:if="{{memberIds.length || query || selectedStages.length || quarters.length || gradeIndex || productIndex}}" class="fde-ui-text workbench-filter-reset" hover-class="workbench-filter-reset-pressed" bindtap="resetFilters">重置</text></view>
  <view wx:if="{{showStages}}" class="fde-ui-view workbench-stage-panel"><view class="fde-ui-view workbench-stage-panel-title"><text class="fde-ui-text">商机阶段</text><text class="fde-ui-text workbench-stage-panel-hint">可多选</text></view><view class="fde-ui-view workbench-stage-option {{!selectedStages.length?'selected':''}}" hover-class="quarter-option-pressed" data-code="all" bindtap="stage"><label class="fde-ui-label workbench-stage-name">全部阶段</label></view><view wx:for="{{stages}}" wx:key="code" class="fde-ui-view workbench-stage-option {{item.selected?'selected':''}}" hover-class="quarter-option-pressed" data-code="{{item.code}}" bindtap="stage"><label class="fde-ui-label workbench-stage-name">{{item.label}}</label></view></view>
  <view wx:if="{{showQuarters}}" class="fde-ui-view quarter-filter quarter-filter-list"><view class="fde-ui-view quarter-filter-head"><view class="fde-ui-view quarter-filter-head-main"><text class="fde-ui-text quarter-filter-title">关单时间</text><text class="fde-ui-text quarter-selection-label">{{listQuarter.label}}</text></view></view><sb-select class="quarter-year-select" plain label="关单年份" placeholder="选择年份" options="{{opt.idx(summaryYears,'label')}}" value="{{yearIndex}}" defaultValue="{{yearIndex}}" bindchange="year"/><view wx:if="{{!listQuarter.isAllYears}}" class="fde-ui-view quarter-options"><view class="fde-ui-view quarter-option {{listQuarter.isFullYear?'selected':''}}" hover-class="quarter-option-pressed" data-q="all" bindtap="quarter">全年</view><view wx:for="{{quarterOptions}}" wx:key="value" class="fde-ui-view quarter-option {{item.selected?'selected':''}}" hover-class="quarter-option-pressed" data-q="{{item.value}}" bindtap="quarter">Q{{item.value}}</view></view><view class="fde-ui-view quarter-filter-foot"><text class="fde-ui-text">按预计关单时间 · {{count}} 个筛选结果 · {{listQuarter.isAllYears ? '跨年，可切换年份' : '全年等于四季全选'}}</text><view class="fde-ui-view quarter-filter-done"><t-button size="small" theme="primary" bindtap="toggleQuarters">完成</t-button></view></view></view>
  <view class="fde-ui-view opportunity-search-box"><sb-search plain value="{{query}}" maxlength="{{100}}" placeholder="搜索客户、商机或产品线" bind:change="search" bind:clear="search"/></view>
</view></view>
<view class="fde-ui-view fde-result-note"><text class="fde-ui-text">当前筛选 · {{count}} 个商机</text><text class="fde-ui-text">在推项目 ACV {{acv}} 万元</text></view>
<sb-state-panel wx:if="{{loading}}" class="fde-projects-state" state="loading" title="正在读取真实协助商机…"/><sb-state-panel wx:elif="{{error}}" class="fde-projects-state" state="error" title="协助商机加载失败" description="{{error}}" bind:retry="load"/><sb-state-panel wx:elif="{{!filtered.length}}" class="fde-projects-state" state="empty" title="{{query || selectedStages.length || quarters.length || productIndex ? '当前筛选没有匹配项目' : customerId ? '当前客户暂无商机' : '尚无有效协助项目'}}" description="{{query || selectedStages.length || quarters.length || productIndex ? '换一个条件试试，或点筛选行的「重置」。' : customerId ? '这个客户还没有商机。' : '由有权销售或负责人加入名单后显示'}}"/>
<view wx:else class="fde-ui-view fde-projects-view fde-projects-list"><view wx:for="{{filtered}}" wx:key="id" class="fde-ui-view workbench-opportunity-card" hover-class="workbench-opportunity-card-pressed" data-id="{{item.id}}" bindtap="open"><template is="opportunity-list-card" data="{{item: item}}"/></view></view><view wx:if="{{moreError}}" class="fde-ui-view fde-projects-view fde-more-error">{{moreError}}<text class="fde-ui-text fde-more-retry" hover-class="fde-pressed" bindtap="loadMore">重试</text></view><sb-pagination wx:if="{{hasMore}}" class="fde-projects-pager" plain mode="more" summary="已显示 {{filtered.length}} / {{count}} 个项目" total="{{count}}" loading="{{loadingMore}}" bind:more="loadMore"/></view>

<person-picker id="personPicker" open="{{memberPickerOpen}}" title="选择成员" members="{{members}}" teams="{{memberTeams}}" default-team-id="{{memberDefaultTeamId}}" selected="{{memberIds}}" multiple="{{true}}" allow-all="{{true}}" all-label="全部成员" loading="{{membersLoading}}" error="{{membersError}}" bind:confirm="confirmMemberPicker" bind:close="closeMemberPicker" bind:retry="retryMembers"/>
