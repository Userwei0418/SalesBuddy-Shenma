.period-filters{margin-top:20rpx;border-top:1px solid var(--ui-line);font-size:28rpx;color:var(--ui-ink)}
.period-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;width:100%;min-height:48px;margin:0;padding:20rpx 0;border:0;background:transparent;text-align:left;line-height:1.5;font-size:28rpx}.period-heading::after{border:0}.period-heading>view{flex:1;min-width:0}.period-heading>text{flex-shrink:0;color:var(--ui-primary);font-size:26rpx}.period-heading label{display:block;color:var(--ui-secondary);font-size:24rpx;margin-top:4rpx;white-space:normal}
.period-body{padding-bottom:16rpx}.period-toggle{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:16rpx 0}.period-toggle>view{flex:1;min-width:0}.period-toggle label{display:block;color:var(--ui-secondary);font-size:24rpx;margin-top:4rpx}.period-selects{display:flex;gap:16rpx;margin:8rpx 0 24rpx}.period-selects>picker{flex:1;min-width:0}.period-selects>picker>view{padding:16rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);font-size:24rpx;color:var(--ui-secondary);line-height:1.5}.period-selects text{display:block;margin-top:8rpx;color:var(--ui-ink);font-size:28rpx}.period-note{display:block;font-size:24rpx;line-height:1.6;color:var(--ui-secondary)}
