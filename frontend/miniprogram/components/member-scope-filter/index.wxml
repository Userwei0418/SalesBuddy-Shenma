<view class="member-trigger {{selected.length ? 'member-trigger-selected' : ''}} {{disabled ? 'member-trigger-disabled' : ''}}" bindtap="toggle" hover-class="{{disabled ? 'none' : 'member-trigger-pressed'}}" aria-role="button" aria-disabled="{{disabled}}" aria-label="筛选团队成员，{{label}}"><text wx:if="{{!selected.length}}" class="member-trigger-label">人员</text><text wx:else class="member-trigger-value">{{label}}</text><t-icon name="chevron-down" size="32rpx" class="member-trigger-caret" /></view>
<root-portal><sb-sheet visible="{{open}}" title="筛选团队成员" secondaryLabel="全部成员" confirmLabel="确定{{draft.length ? '（' + draft.length + '人）' : ''}}" bind:secondary="clear" bind:confirm="apply" bind:close="cancel"><sb-search slot="header" plain value="{{query}}" placeholder="搜索同事姓名" maxlength="{{30}}" bind:change="search" bind:clear="search" /><view class="member-options"><t-checkbox icon="rectangle" wx:for="{{options}}" wx:key="id" data-id="{{item.id}}" checked="{{item.checked}}" label="{{item.name}}" bind:change="select" /><view wx:if="{{!options.length}}" class="member-empty">没有匹配的成员</view></view></sb-sheet></root-portal>
