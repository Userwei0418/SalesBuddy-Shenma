<view class="detail-page-state"><text wx:if="{{state.loading && !state.loaded}}" class="detail-page-note">正在加载…</text><view wx:elif="{{state.error}}" class="detail-page-error"><text>{{state.error}}</text><view class="detail-page-retry" hover-class="detail-page-retry-pressed" bindtap="retry" aria-role="button" aria-label="重新加载"><t-button size="small" variant="outline">重新加载</t-button></view></view><sb-pagination wx:elif="{{state.loaded && state.hasMore}}" mode="more" plain summary="已显示 {{state.count}} 条" loading="{{state.loading}}" end="{{!state.hasMore}}" bind:more="more" /><text wx:elif="{{state.loaded && !state.count && emptyText}}" class="detail-page-note">{{emptyText}}</text></view>
