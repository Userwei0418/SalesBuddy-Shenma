<wxs module="scope">
function teamTabs(teams){var out=[{key:'',label:'全部团队'}];for(var i=0;i<(teams||[]).length;i++){out.push({key:teams[i].id,label:teams[i].name});}return out;}
module.exports={teamTabs:teamTabs};
</wxs>
<view class="scope-toolbar"><sb-segmented size="small" options="{{modes}}" value="{{mode}}" bind:change="onModeSegment"/><button wx:if="{{mode==='person' || (mode==='team' && teams.length>1)}}" size="mini" class="subject-trigger {{active ? 'subject-trigger-on' : ''}}" hover-class="subject-trigger-pressed" bindtap="show" aria-label="{{mode==='person'?'选择成员':'选择团队'}}，当前{{label || '未选择'}}"><view class="subject-chip"><text class="subject-trigger-text">{{label || (mode==='person'?'选择成员':'选择团队')}}</text><t-icon name="chevron-down" size="32rpx" class="subject-caret"/></view></button></view><view wx:if="{{!(mode==='person' || (mode==='team' && teams.length>1))}}" class="subject-caption">{{label}}</view>
<sb-sheet visible="{{open && selecting==='team'}}" title="选择团队" bind:close="close"><view class="selector-rows"><t-cell wx:for="{{teams}}" wx:key="id" title="{{item.name}}" hover data-id="{{item.id}}" right-icon="{{teamId===item.id ? 'check' : ''}}" bind:click="select"><view slot="left-icon" class="scope-avatar">{{item.initial || '团'}}</view></t-cell><view class="selector-bottom">仅显示当前账号可查看的对象</view></view></sb-sheet>
<person-picker id="personPicker" open="{{open && selecting==='person'}}" members="{{members}}" teams="{{teams}}" default-team-id="{{defaultTeamId}}" selected="{{personSelected}}" loading="{{loading}}" error="{{error}}" bind:confirm="confirmPerson" bind:close="close" bind:retry="retry"/>
