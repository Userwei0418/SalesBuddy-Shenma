@import "../../styles/role-controls.wxss";
.scope-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:54rpx}.role-scope-switch{max-width:100%;padding:4rpx;gap:4rpx}.role-scope-option.role-scope-option{flex:0 0 80rpx;width:80rpx;min-width:0;height:44rpx;min-height:44rpx;padding:0;font-size:20rpx;line-height:1.3}.subject-trigger.subject-trigger{display:flex;align-items:center;justify-content:center;flex:0 0 auto;width:168rpx;height:54rpx;min-height:0;gap:12rpx;margin:0;padding:0 14rpx;box-sizing:border-box;white-space:nowrap;line-height:1.4;border:1rpx solid #ccdfef;border-radius:14rpx;background:#f6fbff;color:#267aba;font-size:21rpx;font-weight:600}.subject-trigger::after,.subject-row::after,.team-chip::after{border:0}.subject-caption{margin-top:8rpx;color:#8196a9;font-size:20rpx;line-height:1.4}.selector-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:1150;background:rgba(19,43,66,.38);display:flex;align-items:flex-end}.selector-sheet{width:100%;box-sizing:border-box;padding:0 28rpx;background:#f6faff;border-radius:32rpx 32rpx 0 0;max-height:82vh}.selector-grip{height:42rpx;display:flex;align-items:center;justify-content:center}.selector-grip-line{width:66rpx;height:7rpx;border-radius:8rpx;background:#c3d3e0}.selector-heading{font-size:32rpx;font-weight:700;color:#284963;margin:12rpx 0 24rpx}.selector-search{height:76rpx;padding:0 20rpx;border:1rpx solid #dfebf4;background:#fff;border-radius:16rpx;font-size:24rpx;color:#365670}.selector-team-scroll{margin-top:18rpx;white-space:nowrap}.selector-team-list{display:inline-flex;gap:12rpx}.team-chip.team-chip{display:inline-flex;align-items:center;justify-content:center;width:auto;min-width:0;flex:0 0 auto;margin:0;padding:10rpx 18rpx;line-height:1.4;font-size:21rpx;border-radius:14rpx;background:#e8f0f7;color:#768da2}.team-chip.selected{color:#267abb;background:#dff0ff}.selector-rows{height:49vh;min-height:140rpx;max-height:49vh;margin-top:14rpx}.subject-row.subject-row{display:flex;align-items:center;gap:18rpx;width:100%;margin:0 0 12rpx;padding:20rpx;text-align:left;line-height:1.5;background:#fff;border:1rpx solid #e0ebf4;border-radius:18rpx}.subject-row.selected{background:#ebf6ff;border-color:#9fcdf0}.subject-avatar{width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:17rpx;background:#dfedfa;color:#287dbd;font-size:25rpx;font-weight:600}.subject-copy{flex:1;min-width:0}.subject-name{display:block;font-size:25rpx;color:#30526c;font-weight:600}.subject-team{display:block;margin-top:5rpx;font-size:20rpx;color:#869aae}.subject-check{color:#2686cc;font-size:26rpx}.selector-empty{padding:50rpx 20rpx;text-align:center;color:#8096aa;font-size:24rpx}.selector-bottom{padding:20rpx 0 calc(24rpx + env(safe-area-inset-bottom));font-size:20rpx;text-align:center;color:#92a4b4}
