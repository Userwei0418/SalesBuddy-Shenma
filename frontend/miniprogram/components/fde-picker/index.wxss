/* Match opportunity-form fields without shrinking the member selection sheet. */
.compact-form.field{margin:16rpx 0}
.compact-form .heading{align-items:center;gap:0;font-size:20rpx;font-weight:650;line-height:1.4;color:#28445e}
.compact-form .heading .fde-picker-label{display:inline-flex;align-items:center;margin-left:8rpx;padding:2rpx 7rpx;border-radius:999rpx;font-size:15rpx;font-weight:500;line-height:1.4;color:#71899f;background:#eef3f7}
.compact-form .chosen{box-sizing:border-box;width:100%;min-height:68rpx;margin-top:8rpx;padding:12rpx 16rpx;border:1rpx solid #d8e5f1;border-radius:17rpx;background:#f6f9fd;color:#254562;font-size:22rpx;line-height:1.5;gap:12rpx}
.compact-form .chosen>.fde-picker-label{flex-shrink:0;color:#267fc1;font-size:18rpx;font-weight:500}
.compact-form .chosen .tags{min-width:0;flex:1;gap:6rpx}
.compact-form .chosen .tags .fde-picker-text{padding:3rpx 8rpx;border-radius:8rpx;font-size:20rpx;line-height:1.5}
.compact-form .hint{margin-top:9rpx;font-size:17rpx;line-height:1.5;color:#7d91a5}
