t-align:center;color:#7b8da3;font-size:25rpx}.error{color:#bc624f}.more{color:#225e91}.footer{display:flex;flex-shrink:0;justify-content:space-between;align-items:center;gap:24rpx;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #e1ebf4;font-size:25rpx;line-height:1.5;color:#6e8096}.footer>.fde-picker-text{flex:1;white-space:nowrap}.sheet .footer .fde-picker-button{display:flex;align-items:center;justify-content:center;flex:0 0 56%;width:56%;min-width:0;height:88rpx;min-height:88rpx;margin:0;padding:0 20rpx;box-sizing:border-box;border:0;border-radius:20rpx;background:#225e91;color:#fff;font-size:28rpx;font-weight:600;line-height:1.4}.sheet .footer .fde-picker-button::after{border:0}.sheet .footer .confirm-pressed{background:#1c507d}.disabled{opacity:.6}
