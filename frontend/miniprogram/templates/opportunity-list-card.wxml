<template name="opportunity-list-card">
      <view class="card-view workbench-opportunity-card-top"><view class="card-view workbench-opportunity-head"><view class="card-view workbench-opportunity-name"><text class="card-text workbench-opportunity-title">{{item.name}}</text><label wx:if="{{item.gradeLabel}}" class="card-label opportunity-grade grade-{{item.gradeCode}}">{{item.gradeLabel}}</label></view><label class="card-label workbench-opportunity-customer">{{item.customer_name}}</label></view><view wx:if="{{item.canEdit}}" class="opportunity-card-edit" hover-class="opportunity-card-edit-active" hover-stop-propagation role="button" aria-label="编辑商机" data-customer-id="{{item.customer_id}}" data-opportunity-id="{{item.id}}" catchtap="editOpportunity">编辑</view></view>
      <view class="card-view workbench-opportunity-stage"><text class="card-text">{{item.stageName}} · {{item.probabilityText}}</text><label class="card-label">ACV {{item.amount || item.amount === 0 ? item.amountLabel : '未登记'}}</label></view>
      <view class="card-view workbench-opportunity-progress"><text class="card-text" style="width:{{item.progressPercent}}%"></text></view>
      <view wx:if="{{item.signal.tone === 'red' || item.signal.tone === 'yellow'}}" class="card-view workbench-status"><sb-status-tag tone="{{item.signal.tone === 'red' ? 'bad' : 'watch'}}" label="{{item.signal.label}}"/><text class="card-text workbench-status-detail">{{item.signal.detail}}</text></view>
      <view class="card-view workbench-opportunity-meta"><view class="card-view"><text class="card-text">累计确收</text><label class="card-label">{{item.recognizedLabel}}</label></view><view class="card-view"><text class="card-text">累计回款</text><label class="card-label">{{item.collectionLabel}}</label></view><view class="card-view"><text class="card-text">预计关单</text><label class="card-label">{{item.closeLabel}}</label></view><view class="card-view"><text class="card-text">产品线</text><label class="card-label">{{item.productLineLabel}}</label></view></view>
      <view class="card-view workbench-opportunity-owner"><text class="card-text workbench-opportunity-team">{{item.team}} · {{item.owner}}</text><view class="card-view workbench-opportunity-open"><text class="card-text">查看此商机</text><t-icon name="chevron-right" size="32rpx"/></view></view>
</template>
