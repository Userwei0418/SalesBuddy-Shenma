/* Application palette based on the approved LBS reference. ui/ stays generated.
 * Blue is interactive, ink is structural; explicit labels and red reasons identify abnormal states.
 */
page {
  --ui-background:#E9EDF3;
  --ui-ink:#192842;
  --ui-primary:#2863CD;
  --ui-primary-hover:#2055B5;
  --ui-secondary:#4F6078;
  --ui-muted:#56677E;
  --ui-selected:#EDF3FF;
  --ui-focus:#5786DC;
  --ui-line:#D5DCE7;
  --ui-neutral:#56677E;
  --ui-neutral-soft:#EDF0F5;
  --ui-danger:#A73F38;
  --ui-danger-soft:#FBE4DF;
  --ui-danger-accent:#A73F38;
  --ui-warning:#192842;
  --ui-warning-soft:#EDF0F5;
  --ui-warning-accent:#192842;
  --ui-success:#4F6078;
  --ui-success-soft:#EDF0F5;
  --ui-chart-1:var(--ui-primary);
  --ui-overlay:#19284273;
  --sb-link-blue:var(--ui-primary);
  --sb-hero-bg:#192842;
  --sb-hero-ink:#FFFFFF;
  --sb-hero-muted:#D5DEEB;
  --sb-hero-control:#33435D;
  --sb-hero-line:#45546B;
  --sb-hero-link:#A9C7FF;
  --sb-hero-alert:#F3B8B1;
  --sb-input-line:#AAB6C8;
  --sb-summary-soft:#FFFFFF;
  --sb-group-bg:#FFFFFF;
  --sb-status-bg:#1F2329;
  --sb-status-ink:#FFFFFF;
  --sb-alert-ink:#A73F38;
  --sb-alert-soft:#FBE4DF;
  --td-brand-color-1:#EDF3FF;
  --td-brand-color-2:#E2ECFF;
  --td-brand-color-3:#C7D9FC;
  --td-brand-color-4:#A6C3F5;
  --td-brand-color-5:#7CA4EB;
  --td-brand-color-6:#5786DC;
  --td-brand-color-7:#2863CD;
  --td-brand-color-8:#2055B5;
  --td-brand-color-9:#1945A6;
  --td-brand-color-10:#123580;
}
