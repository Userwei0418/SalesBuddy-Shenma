.detail-summary-state{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:24rpx 0;padding:24rpx 32rpx;border:0;border-radius:var(--ui-radius-panel);background:var(--ui-surface);color:var(--ui-secondary);font-size:14px;line-height:1.6}.detail-summary-copy{flex:1;min-width:0}.detail-summary-button{flex-shrink:0;margin:0;padding:0 24rpx;height:72rpx;line-height:72rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface);color:var(--ui-primary);font-size:14px;font-weight:400}.detail-summary-button::after{border:0}
/* 按钮看起来 36px；原生 button 默认 overflow:hidden，放开后用 ::before 把点按区上下扩到 44px */
.detail-summary-button{position:relative;overflow:visible}.detail-summary-button::before{content:"";position:absolute;left:0;right:0;top:calc(50% - 22px);bottom:calc(50% - 22px)}
