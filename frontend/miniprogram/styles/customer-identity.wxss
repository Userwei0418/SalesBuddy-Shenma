.identity-card{margin:24rpx 0;padding:28rpx;background:#fff;border-radius:20rpx;color:#182a45}.identity-title{font-size:30rpx;font-weight:600;margin-bottom:12rpx}.identity-title text,.identity-note{font-size:24rpx;line-height:1.6;color:#64748b;font-weight:400}.identity-link{margin-top:20rpx;border-top:1rpx solid #edf0f5;padding-top:20rpx;font-size:28rpx}.identity-choice{padding:18rpx 0;color:#2863ce;min-height:44rpx;line-height:44rpx}.identity-clear{display:inline-block;padding:12rpx 0;font-size:26rpx;color:#64748b;min-height:44rpx;line-height:44rpx}
