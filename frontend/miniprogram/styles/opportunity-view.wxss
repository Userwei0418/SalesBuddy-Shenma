/* 商机完整信息（只读）与经营实绩页外观。本文件由 app.wxss 引入，类名只在经营实绩页使用。 */
.opportunity-view {
  margin-bottom:24rpx;
  padding:32rpx;
}

.opportunity-view-state {
  padding:32rpx 8rpx;
  color:var(--ui-secondary);
  font-size:14px;
  text-align:center;
}

.opportunity-view-state.error {
  color:var(--ui-danger);
}

.opportunity-view-head {
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:24rpx;
  padding-bottom:24rpx;
  border-bottom:1px solid var(--ui-line);
}

.opportunity-view-head text,
.opportunity-view-head label {
  display:block;
}

.opportunity-view-head text {
  color:var(--ui-ink);
  font-size:var(--ui-text-body);
  font-weight:600;
}

.opportunity-view-head label {
  margin-top:8rpx;
  color:var(--ui-secondary);
  font-size:var(--ui-text-small);
}

.opportunity-head-tags {
  display:flex;
  align-items:flex-end;
  gap:8rpx;
  flex-direction:column;
}

.opportunity-view-head .opportunity-grade,
.opportunity-view-head .opportunity-status {
  margin:0;
  height:20px;
  padding:0 var(--ui-space-2);
  border-radius:4px;
  background:var(--ui-neutral-soft);
  color:var(--ui-neutral);
  font-size:var(--ui-text-small);
  line-height:20px;
  white-space:nowrap;
}

.opportunity-view-grid {
  margin-top:8rpx;
}

.opportunity-view-grid>view,
.opportunity-quarter-list>view {
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:24rpx;
  padding:16rpx 0;
  border-bottom:1px solid var(--ui-line);
  font-size:14px;
  line-height:1.5;
}

.opportunity-view-grid text,
.opportunity-quarter-list text {
  flex:0 0 auto;
  color:var(--ui-secondary);
}

.opportunity-view-grid label,
.opportunity-quarter-list label {
  color:var(--ui-ink);
  text-align:right;
  overflow-wrap:anywhere;
}

/* 列表最后一行不画底线：下面的「季度实绩」自带顶部分隔线，避免两条线叠在一起 */
.opportunity-quarter-list>view:last-child {
  border-bottom:0;
}

.opportunity-quarter-title {
  margin-top:32rpx;
  color:var(--ui-ink);
  font-size:var(--ui-text-body);
  font-weight:600;
}

.opportunity-quarter-empty {
  padding:16rpx 0;
  color:var(--ui-muted);
  font-size:var(--ui-text-small);
}

.opportunity-readonly-note {
  margin-top:24rpx;
  color:var(--ui-muted);
  font-size:var(--ui-text-small);
  text-align:center;
}

.actual-page.actual-refresh {
  min-height:100vh;
  padding:24rpx 28rpx calc(96rpx + constant(safe-area-inset-bottom));
  padding:24rpx 28rpx calc(96rpx + env(safe-area-inset-bottom));
  background:var(--ui-background);
  color:var(--ui-ink);
}

.actual-refresh .actual-breadcrumb { display:inline-flex; align-items:center; min-height:var(--ui-touch-target); margin:-16rpx 0 0; padding:0; color:var(--ui-primary); font-size:14px; }
.actual-refresh .actual-heading { align-items:center; margin:4rpx 0 24rpx; }
.actual-refresh .actual-eyebrow { margin-bottom:4rpx; color:var(--ui-secondary); font-size:var(--ui-text-small); }
.actual-refresh .actual-title { color:var(--ui-ink); font-size:var(--ui-text-page); font-weight:600; line-height:1.3; }
.actual-refresh .actual-subtitle { margin-top:8rpx; color:var(--ui-secondary); font-size:14px; }
.actual-refresh .actual-info { width:88rpx; height:var(--ui-touch-target); border:0; background:transparent; color:var(--ui-secondary); }

/* 实绩汇总：白卡，数字深色 */
.actual-refresh .actual-summary { padding:32rpx; border:0; border-radius:var(--ui-radius-panel); color:var(--ui-ink); background:var(--ui-surface); }
.actual-refresh .actual-summary-top { align-items:center; gap:16rpx; }
.actual-refresh .actual-kind, .actual-refresh .actual-period { flex:0 0 auto; }
.actual-refresh .actual-total-label { margin-top:32rpx; color:var(--ui-secondary); font-size:14px; }
.actual-refresh .actual-total { margin:8rpx 0 8rpx; color:var(--ui-ink); font-size:var(--ui-text-metric); font-weight:600; line-height:1.2; }
.actual-refresh .actual-unit { margin-left:8rpx; color:var(--ui-secondary); font-size:14px; font-weight:400; }
.actual-refresh .actual-summary-caption, .actual-refresh .actual-first-date { color:var(--ui-secondary); font-size:var(--ui-text-small); line-height:1.5; }
.actual-refresh .actual-first-date { margin-top:4rpx; color:var(--ui-muted); }

.actual-refresh .actual-context { gap:var(--ui-space-2); padding:16rpx 0 0; }
.actual-refresh .actual-context-link { display:flex; align-items:center; min-height:var(--ui-touch-target); padding:0; color:var(--ui-primary); font-size:14px; }
.actual-refresh .actual-add { margin-left:auto; height:var(--ui-touch-target); display:flex; align-items:center; padding:0 28rpx; border:0; border-radius:var(--ui-radius-control); color:var(--ui-on-primary); background:var(--ui-primary); font-size:14px; font-weight:600; }
.actual-refresh .actual-list-label { margin:48rpx 0 16rpx; align-items:baseline; color:var(--ui-ink); font-size:var(--ui-text-body); font-weight:600; }
.actual-refresh .actual-list-unit { color:var(--ui-secondary); font-size:var(--ui-text-small); font-weight:400; }

/* 列表：灰底上的白卡，不描边；卡内靠留白和一条细线分组 */
.actual-refresh .actual-customer, .actual-refresh .actual-entry { margin-bottom:var(--ui-space-2); padding:28rpx 32rpx; border:0; border-radius:var(--ui-radius-panel); background:var(--ui-surface); }
.actual-refresh .actual-customer-identity { display:flex; align-items:center; gap:24rpx; }
.actual-refresh .actual-customer-mark { width:72rpx; height:72rpx; display:flex; align-items:center; justify-content:center; flex:0 0 auto; border-radius:var(--ui-radius-control); color:var(--ui-primary); background:var(--ui-neutral-soft); font-size:var(--ui-text-body); font-weight:600; }
.actual-refresh .actual-customer-main { min-width:0; flex:1; }
.actual-refresh .actual-customer-top { align-items:center; gap:16rpx; }
.actual-refresh .actual-customer-name { min-width:0; overflow:hidden; color:var(--ui-ink); font-size:var(--ui-text-body); font-weight:600; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.actual-refresh .actual-customer-arrow { flex:0 0 auto; display:inline-flex; color:var(--ui-muted); }
.actual-refresh .actual-customer-meta { margin-top:8rpx; color:var(--ui-secondary); font-size:var(--ui-text-small); }
.actual-refresh .actual-customer-bottom { margin-top:16rpx; padding:0 0 0 96rpx; border-top:0; }
.actual-refresh .actual-customer-amount, .actual-refresh .actual-entry-amount { color:var(--ui-ink); font-size:20px; font-weight:600; }
.actual-refresh .actual-small-unit { margin-left:6rpx; color:var(--ui-secondary); font-size:var(--ui-text-small); font-weight:400; }
.actual-refresh .actual-customer-count { color:var(--ui-secondary); font-size:var(--ui-text-small); }
.actual-refresh .actual-demo { margin-left:8rpx; padding:0 var(--ui-space-2); border-radius:4px; color:var(--ui-neutral); background:var(--ui-neutral-soft); font-size:var(--ui-text-small); line-height:20px; }

.actual-refresh .actual-entry-top { padding-bottom:16rpx; border-bottom:1px solid var(--ui-line); }
.actual-refresh .actual-entry-date { color:var(--ui-secondary); font-size:14px; }
.actual-refresh .actual-entry-opportunity { min-height:var(--ui-touch-target); margin:-7rpx 0 -15rpx; color:var(--ui-secondary); font-size:14px; line-height:1.5; } /* 文字 21px，点按区撑到 44px，负外边距让版面间距不变 */
.actual-refresh .actual-entry-opportunity.linked { color:var(--ui-primary); }
.actual-refresh .actual-source { gap:16rpx; padding:0; background:transparent; font-size:var(--ui-text-small); line-height:1.5; }
.actual-refresh .actual-source-label { color:var(--ui-secondary); }
.actual-refresh .actual-source-value { color:var(--ui-ink); }
.actual-refresh .actual-entry-note { margin-top:12rpx; color:var(--ui-secondary); font-size:14px; line-height:1.6; }
.actual-refresh .actual-entry-footer { margin-top:16rpx; color:var(--ui-secondary); font-size:var(--ui-text-small); }
.actual-refresh .actual-confirmer { color:var(--ui-secondary); }
.actual-refresh .actual-void { display:flex; align-items:center; min-height:var(--ui-touch-target); margin:-20rpx 0; padding:0 8rpx; color:var(--ui-danger); }

.actual-refresh .actual-empty { padding:0; border:0; background:transparent; }
.actual-refresh .actual-loading { padding:24rpx; color:var(--ui-secondary); font-size:14px; }
