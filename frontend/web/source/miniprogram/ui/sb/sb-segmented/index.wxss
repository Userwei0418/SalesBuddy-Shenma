.sb-seg { display: inline-flex; align-items: stretch; padding: var(--ui-space-1); border-radius: var(--ui-radius-control); background: var(--ui-neutral-soft); max-width: 100%; }
.sb-seg-item { flex: 1 0 auto; display: inline-flex; align-items: center; justify-content: center; position: relative; min-height: 36px; padding: 0 var(--ui-space-3); border-radius: var(--ui-radius-control); font-size: var(--ui-text-body); color: var(--ui-secondary); white-space: nowrap; }
.sb-seg.block { display: flex; width: 100%; }
.sb-seg.block .sb-seg-item { flex: 1 1 0; min-width: 0; }
.sb-seg.small .sb-seg-item { min-height: 36px; padding: 0 var(--ui-space-2); font-size: var(--ui-text-small); }
.sb-seg-item.on { background: var(--ui-surface); color: var(--ui-primary); font-weight: 600; box-shadow: var(--ui-shadow-popup); }
.sb-seg-item.disabled { color: var(--ui-muted); }
.sb-seg.is-disabled { opacity: .55; }
/* 小程序体验：点击区不小于 44px（项 36px + 轨道上下 4px，高度写 px 不随屏宽缩）；轨道那 4px 用伪元素并进项的点击区；small 只缩字号与左右内边距，不缩点击高度 */
.sb-seg-item::after { content: ''; position: absolute; left: 0; right: 0; top: calc(-1 * var(--ui-space-1)); bottom: calc(-1 * var(--ui-space-1)); }
.sb-seg-hover { opacity: .7; }
