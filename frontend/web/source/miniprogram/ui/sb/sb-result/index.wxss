.sb-result { display: flex; flex-direction: column; gap: var(--ui-space-4); padding: var(--ui-space-8) var(--ui-page-gutter); background: var(--ui-surface); }
.sb-result .sb-result-title { font-size: var(--ui-text-page); font-weight: 600; color: var(--ui-ink); }
.sb-result .sb-result-desc { font-size: var(--ui-text-body); color: var(--ui-secondary); }
.sb-result-success .t-result__icon { color: var(--ui-success); }
.sb-result-error .t-result__icon { color: var(--ui-danger); }
.sb-result-info .t-result__icon { color: var(--ui-primary); }
.sb-result-warning .t-result__icon { color: var(--ui-warning); }
.sb-result-extra:empty { display: none; }
.sb-result-actions { display: flex; flex-direction: column; gap: var(--ui-space-2); }
