.sb-dpick { display: flex; flex-direction: column; gap: var(--ui-space-2); padding: var(--ui-space-2) var(--ui-page-gutter); background: var(--ui-surface); }
.sb-dpick-row { display: flex; align-items: center; gap: var(--ui-space-2); min-height: var(--ui-field-height); }
.sb-dpick-label { flex: 0 0 auto; font-size: var(--ui-text-body); color: var(--ui-secondary); }
.sb-req { color: var(--ui-danger); }
.sb-dpick-value { flex: 1; text-align: right; font-size: var(--ui-text-body); color: var(--ui-ink); font-variant-numeric: tabular-nums; }
.sb-dpick-value.placeholder { color: var(--ui-muted); }
.sb-dpick.disabled .sb-dpick-value { color: var(--ui-muted); }
.sb-dpick-arrow { color: var(--ui-muted); display: inline-flex; }
.sb-dpick-chips { display: flex; gap: var(--ui-space-2); flex-wrap: wrap; }
.sb-chip { padding: 0 var(--ui-space-3); min-height: 32px; line-height: 32px; border: 1px solid transparent; border-radius: var(--ui-radius-control); font-size: var(--ui-text-small); color: var(--ui-ink); background: var(--ui-neutral-soft); } /* 飞书：灰底无边框 */

/* stacked：标签在上 14px，下面控件框高 var(--ui-field-height)（小程序 44px）、一圈细线、控件圆角（和页面手写表单一致）；plain：不带白底与页边距 */
.sb-dpick.is-plain { padding: var(--ui-space-2) 0; background: transparent; }
.sb-dpick.is-stacked { flex-direction: column; align-items: stretch; gap: var(--ui-space-2); }
.sb-dpick.is-stacked .sb-dpick-label { font-size: 14px; font-weight: 400; color: var(--ui-ink); } /* 飞书表单标签：常规字重、正文色、下方 8px */
.sb-dpick.is-stacked .sb-dpick-row { padding: 0 var(--ui-space-3); border: 1px solid var(--ui-line); border-radius: var(--ui-radius-control); background: var(--ui-surface); }
.sb-dpick.is-stacked .sb-dpick-value { text-align: left; }
.sb-dpick.is-stacked.disabled .sb-dpick-row { background: var(--ui-background); }
.sb-chip.on { background: var(--ui-selected); color: var(--ui-primary); font-weight: 600; }
.sb-dpick-clear { position: relative; display: inline-flex; color: var(--ui-muted); padding: 0 var(--ui-space-1); }
.sb-dpick-clear::after { content: ''; position: absolute; left: calc(50% - 22px); right: calc(50% - 22px); top: calc(50% - 22px); bottom: calc(50% - 22px); } /* 清除图标点击区 44px */
.sb-form-tips { font-size: var(--ui-text-small); line-height: 1.5; color: var(--ui-muted); }
.sb-form-tips.is-error { color: var(--ui-danger); }
.sb-dpick.is-stacked.is-error .sb-dpick-row { border-color: var(--ui-danger); }
.sb-chip { position: relative; }
.sb-chip::after { content: ''; position: absolute; left: 0; right: 0; top: calc(50% - 22px); bottom: calc(50% - 22px); } /* 点击区扩到 44px */
