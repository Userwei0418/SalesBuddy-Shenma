.sb-search { padding: var(--ui-space-2) var(--ui-page-gutter); background: var(--ui-surface); }
.sb-search.off { opacity: .55; }
.sb-search.is-plain { padding: 0; background: transparent; --td-search-bg-color: var(--ui-surface); }
.sb-search.is-plain .sb-search-inner { border: 1px solid var(--ui-line); border-radius: var(--ui-radius-control); }
.sb-search-inner { min-height: var(--ui-field-height); }
.sb-search-loading { margin-left: var(--ui-space-2); font-size: var(--ui-text-small); color: var(--ui-secondary); white-space: nowrap; }
