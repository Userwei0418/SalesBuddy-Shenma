<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<view class="create-page">
  <view class="create-hero"><sb-summary-card title="{{requestMode ? '客户建档申请' : '创建新客户'}}" subtitle="{{requestMode ? '审批通过后建立未认领客户，需要另行申请认领' : role === 'sales' ? '手动填写或语音生成草案，创建后仅归属本人' : '手动填写或语音生成草案，确认后进入待分配客户池'}}" meta="{{roleName}} · {{creatorName}}" progress="{{progressPercent}}" progressLabel="必填 {{completedRequiredCount}} / {{requiredCount}}" /></view>

  <view class="create-body">
    <include src="../../templates/customer-identity.wxml" />
    <view wx:if="{{creationOptionsError}}" class="notice submission-error" role="alert">
      <view>{{creationOptionsError}}。已填写内容仍保留，可先保存草稿。</view>
      <button class="refresh-options" bindtap="refreshCreationOptions" loading="{{creationOptionsRefreshing}}" disabled="{{creationOptionsRefreshing || loading || submitting}}">刷新选项</button>
    </view>
    <view wx:if="{{submissionError}}" class="notice submission-error" role="alert">{{submissionError}}</view>
    <view wx:if="{{draftRestored}}" class="notice blue">已恢复你上次保存的建档草稿，可继续编辑。</view>
    <view wx:if="{{voiceParsed}}" class="notice green">语音草案已填入，请重点核对客户名称、客户类型和联系人信息。</view>
    <view wx:elif="{{missingCount}}" class="notice orange">还有 {{missingCount}} 个必填项待补充，所有内容提交前均可修改。</view>

    <view wx:if="{{voiceRecoveryText}}" class="notice">{{voiceRecoveryText}}<button wx:if="{{voiceRecoveryReady}}" disabled="{{isParsing}}" bindtap="resumeVoiceDraft">继续查看结果</button><button wx:else bindtap="resolveUnknownVoice">核对后处理</button></view>
    <view wx:for="{{voiceOtherRecoveries}}" wx:key="key" class="notice">其他表单的语音任务，当前录入可继续。
      <button wx:if="{{!item.runId}}" data-key="{{item.key}}" bindtap="resolveUnknownVoice">核对旧任务</button>
      <button wx:elif="{{item.phase === 'completed'}}" data-key="{{item.key}}" bindtap="discardVoiceResult">放弃旧结果</button>
      <button wx:else data-key="{{item.key}}" disabled="{{isParsing}}" bindtap="resumeVoiceDraft">查询旧任务</button>
    </view>
    <view class="voice-card {{isRecording ? 'recording' : ''}} {{isParsing ? 'parsing' : ''}}" hover-class="row-pressed" bindtap="toggleVoice" aria-role="button">
      <view class="voice-icon"><view class="wave"><text></text><text></text><text></text><text></text><text></text></view></view>
      <view class="voice-copy">
        <view>{{isStarting ? '正在启动录音' : isStopping ? '正在结束录音' : isParsing ? '正在识别并填充字段' : isRecording ? '正在语音录入 ' + recordingTime : voiceParsed ? '重新语音填写客户信息' : '语音填写客户信息'}}</view>
        <text>{{isRecording ? '再次点击即可结束录入' : isParsing ? '请稍候，识别结果只会生成待确认草案' : '点击开始，描述客户、行业、来源和联系人'}}</text>
      </view>
      <view class="voice-action">{{isRecording ? '结束' : isParsing ? '识别中' : voicePendingKey ? '继续查看' : '开始'}}</view>
    </view>

    <view class="section-heading"><view><text>客户基本信息</text><label>点击任一字段手动编辑</label></view><text>{{fields.length}} 项</text></view>
    <view class="field-list surface">
      <view wx:for="{{fields}}" wx:key="key" wx:if="{{!item.hidden}}" class="field-row {{item.validationError ? 'invalid' : ''}} {{item.missing ? 'missing' : ''}} {{item.system ? 'system' : ''}} {{item.edited ? 'edited' : ''}} {{item.voiceFilled ? 'voice-filled' : ''}}" hover-class="row-pressed" data-index="{{index}}" bindtap="openEditor">
        <view class="field-label"><text>{{item.label}}</text><label wx:if="{{item.required}}">必填</label><label wx:elif="{{item.system}}">自动</label><label wx:else>选填</label></view>
        <view class="field-value"><text>{{item.value || (item.required ? '待补充' : '未填写')}}</text><view>{{item.readonly ? (role === 'sales' ? '仅本人' : '本团队') : item.missing ? '补充' : '编辑'}}<t-icon name="chevron-right" size="32rpx" /></view></view>
        <view wx:if="{{item.validationError}}" class="field-error">{{item.validationError}}</view>
      </view>
    </view>
  </view>

  <sb-bottom-bar class="bottom-bar" secondaryLabel="保存草稿" bind:secondary="saveDraft" primaryLabel="{{requestMode ? '提交建档申请' : '创建客户'}}" inactive="{{!creationOptionsReady || missingCount > 0 || invalidFieldCount > 0}}" disabledReason="{{!creationOptionsReady ? '创建选项目录暂不可用' : missingCount > 0 ? '还有 ' + missingCount + ' 个必填项待补充' : '请修改标出的字段后重新提交'}}" bind:primary="submitCustomer" />

  <sb-sheet visible="{{editorVisible}}" title="{{editorTitle}}" confirmLabel="保存修改" bind:confirm="saveEditor" bind:close="closeEditor">
    <view class="editor-body">
      <sb-input wx:if="{{editorType === 'text'}}" layout="stacked" plain value="{{editorValue}}" placeholder="{{editorPlaceholder}}" maxlength="{{140}}" focus="{{editorVisible}}" bind:change="inputEditor" />
      <sb-textarea wx:if="{{editorType === 'textarea'}}" layout="stacked" plain fixed maxRows="{{0}}" focus="{{editorVisible}}" value="{{editorValue}}" placeholder="{{editorPlaceholder}}" maxlength="{{500}}" bind:change="inputEditor" />
      <block wx:if="{{editorType === 'select'}}">
        <view wx:if="{{editorOptions.length <= 8}}" class="option-grid"><view wx:for="{{editorOptions}}" wx:key="label" class="option-item {{item.selected ? 'selected' : ''}}" hover-class="is-pressed" data-index="{{index}}" bindtap="selectOption" aria-role="radio" aria-checked="{{!!item.selected}}">{{item.label}}</view></view>
        <view wx:else class="option-list"><t-cell wx:for="{{editorOptions}}" wx:key="label" title="{{item.label}}" hover data-index="{{index}}" right-icon="{{item.selected ? 'check' : ''}}" bind:click="selectOption" /></view>
      </block>
      <view class="editor-helper">{{requestMode ? '修改只会更新当前草案；提交后等待运营审批，通过后仍需另行申请认领。' : role === 'sales' ? '修改只会更新当前草案；创建后客户负责人自动设为本人。' : '修改只会更新当前草案，点击“创建客户”后才会写入待分配客户池。'}}</view>
    </view>
  </sb-sheet>
</view>

</block>
