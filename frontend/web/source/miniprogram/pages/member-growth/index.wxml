<wxs module="growth">
function tabs(list){var out=[];for(var i=0;i<(list?list.length:0);i++){out.push({key:list[i].code,label:list[i].name});}return out;}
module.exports={tabs:tabs};
</wxs>
<view wx:if="{{accessBlocked}}" class="access-empty"><text>此功能暂不可用</text><label>{{accessMessage}}</label></view>
<block wx:else>
<fde-dashboard id="fdeContent" wx:if="{{isFde}}" member-id="{{fdeMemberId}}"/>
<block wx:if="{{!isFde}}">
<view class="page-shell member-growth-page">
  <view class="member-hero surface"><view class="member-avatar">{{subject.initial}}</view><view><view>{{subject.name}}</view><text>{{subjectRoleName}} · {{subject.team}}</text></view><text class="review-badge">每日复盘</text></view>
  <view wx:if="{{loading}}" class="state-card surface"><sb-state-panel state="loading" title="{{statusText}}"/></view>
  <view wx:elif="{{!ready}}" class="empty-card surface"><sb-state-panel state="empty" title="暂无能力画像" description="{{statusText}}"/></view>
  <block wx:if="{{ready}}">
    <view class="section-heading"><view><text>六维能力画像</text><label>基于近30天真实拜访记录</label></view><view class="overall"><text>{{overallScore}}</text><label>综合得分</label></view></view>
    <view class="capability-card surface">
      <canvas canvas-id="memberAbilityRadar" class="radar-canvas"></canvas>
      <view class="review-summary">{{reviewSummary}}</view>
      <view class="review-meta"><text>{{statusText}}</text><label>{{visitCount}} 次拜访 · {{reviewDate}}</label></view>
      <view class="dimension-grid"><view wx:for="{{dimensions}}" wx:key="code" class="dimension-item"><view><text>{{item.name}}</text><label>{{item.score}}</label></view><view class="score-track"><view style="width:{{item.score}}%"></view></view><text>{{item.coachingAction}}</text></view></view>
      <view class="ai-advice-card"><view class="ai-advice-top"><text class="ai-advice-title">资深销售教练建议</text><sb-ai-badge state="advice"/></view><text class="ai-advice-note">围绕六项能力给出提升方法</text><view class="ai-advice-list"><view wx:for="{{aiAdvice}}" wx:key="*this" class="ai-advice-row"><text class="ai-advice-index">{{index + 1}}</text><label class="ai-advice-text">{{item}}</label></view></view></view>
    </view>
    <view class="section-heading growth-heading"><view><text>成长趋势</text><label>综合评分与单项能力变化</label></view><view class="history-count">{{history.length}} 个快照</view></view>
    <view class="growth-card surface"><sb-tabs wx:if="{{growthOptions.length}}" size="small" items="{{growth.tabs(growthOptions)}}" activeKey="{{selectedGrowthCode}}" bind:change="onGrowthTab"/><view class="chart-title">{{selectedGrowthName}}变化</view><canvas canvas-id="memberGrowthLine" class="growth-canvas"></canvas></view>
  </block>
</view>

</block>
</block>
