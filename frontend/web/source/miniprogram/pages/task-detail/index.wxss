@import "../../styles/portal-theme.wxss";
page{background:var(--ui-background)}
.detail-page{min-height:100vh;padding-bottom:calc(260rpx + constant(safe-area-inset-bottom));padding-bottom:calc(260rpx + env(safe-area-inset-bottom));color:var(--ui-ink);background:var(--ui-background)}
.detail-page.has-execution{padding-bottom:calc(24rpx + constant(safe-area-inset-bottom));padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}
.detail-hero{margin:24rpx 32rpx 0}
.detail-body{display:flex;flex-direction:column;gap:16rpx;padding:16rpx 32rpx 24rpx}
.detail-body>.section-card{width:100%;min-width:0;box-sizing:border-box}
/* 飞书：白卡放在灰底上，不描边；卡内分组用分隔线 */
.section-card{border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.description-card,.respond-card,.completion-card,.fde-coordinate,.completed-card,.closed-card,.review-history{padding:32rpx}
.section-title{margin:0;color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;line-height:1.45}
.description{margin-top:16rpx;color:var(--ui-ink);font-size:14px;line-height:1.7;white-space:pre-wrap;word-break:break-word}
.info-card{padding:32rpx}
.completed-main{min-width:0}
.completed-head,.rejected-head{display:flex;align-items:center;gap:16rpx}
.completed-head>text,.rejected-copy .rejected-title{color:var(--ui-ink);font-size:var(--ui-text-body);font-weight:600;line-height:1.45}
.completed-main>label,.rejected-copy .rejected-kicker{display:block;margin-top:8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.completed-main>view,.rejected-copy .rejected-comment{margin-top:16rpx;padding-top:16rpx;border-top:1px solid var(--ui-line);color:var(--ui-ink);font-size:14px;line-height:1.65;word-break:break-all}
.rejected-copy{min-width:0}
.completion-help{margin-top:12rpx;color:var(--ui-secondary);font-size:14px;line-height:1.6}
.readonly-tip{padding:0 8rpx;color:var(--ui-secondary);font-size:14px;line-height:1.6}
.review-rejected{margin-top:12rpx;color:var(--ui-danger);font-size:14px;line-height:1.6}
.review-evidence{margin-top:12rpx}
.review-history-row{margin-top:24rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
.review-history-row>view:first-child{color:var(--ui-ink);font-size:14px;font-weight:600}
.detail-body .fde-note{margin:0}
/* 协调入口：白卡里一行 t-cell（标题、说明、右箭头、按下态） */
.coordination-entry{overflow:hidden;border-radius:var(--ui-radius-panel);background:var(--ui-surface);--td-cell-horizontal-padding:32rpx;--td-cell-vertical-padding:28rpx;--td-cell-title-color:var(--ui-ink);--td-cell-description-color:var(--ui-secondary);--td-cell-right-icon-color:var(--ui-muted)}
/* 任务协调：接手人员 sb-select、协调原因 sb-textarea（stacked plain） */
.fde-coordinate .sb-select,.fde-coordinate .sb-textarea{margin-top:16rpx}
.coordinate-hint{margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.6}
.coordinate-error{display:block;margin-top:12rpx;color:var(--ui-danger);font-size:var(--ui-text-small);line-height:1.5}
.respond-card .sb-textarea,.completion-card .sb-textarea{margin-top:16rpx}
.fde-coordinate-actions{display:flex;gap:var(--ui-space-2);margin-top:32rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
.fde-coordinate-actions button{display:flex;align-items:center;justify-content:center;flex:1;min-width:0;height:var(--ui-touch-target);margin:0;padding:0 8rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-surface);font-size:var(--ui-text-body);font-weight:400;line-height:1.3;white-space:nowrap}
.fde-coordinate-actions button::after{border:0}
.fde-coordinate-actions .coordinate-cancel{color:var(--ui-danger)}
.fde-coordinate-actions .coordinate-submit{flex:1.25;color:var(--ui-on-primary);background:var(--ui-primary);border-color:var(--ui-primary);font-weight:600}
.fde-coordinate-actions button[disabled]{opacity:.45}


/* Change comparison uses the same muted and selected surfaces as other forms. */
.execution-help{font-size:13px;line-height:1.6;color:var(--ui-secondary,#64748b);margin:12rpx 0;overflow-wrap:anywhere}
.execution-diff{padding:20rpx 0;border-top:1px solid var(--ui-line,#e5e7eb);min-width:0}.execution-diff-title{font-size:14px;font-weight:600}
.execution-diff-before,.execution-diff-after{padding:12rpx;margin-top:8rpx;border-radius:8rpx;white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px;line-height:1.6}
.execution-diff-before{background:var(--ui-page,#f3f4f6);color:var(--ui-secondary,#64748b)}.execution-diff-after{background:var(--ui-primary-soft,#eef4ff);color:var(--ui-ink,#182b49)}

/* Execution actions reuse the task page's white cards and shared bottom sheet. */
.execution-actions-card,.execution-status-card{padding:32rpx}
.execution-status-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.execution-primary-actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}
.execution-action-btn{box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex:1;min-width:0;min-height:44px;margin:0;padding:12rpx 20rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-surface);font-size:14px;font-weight:500;line-height:1.4;white-space:normal}
.execution-action-btn::after,.execution-management-row::after,.execution-text-action::after,.execution-candidate::after{border:0}
.execution-action-btn.is-primary{background:var(--ui-primary);border-color:var(--ui-primary);color:var(--ui-on-primary);font-weight:600}
.execution-action-btn[disabled],.execution-action-btn.is-primary[disabled]{color:var(--ui-muted);background:var(--ui-neutral-soft);border-color:var(--ui-line);opacity:1}
.execution-management-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;width:100%;min-height:64px;margin:0;padding:24rpx 0;border-top:1px solid var(--ui-line);border-radius:0;background:var(--ui-surface);text-align:left;font-size:14px;line-height:1.5;font-weight:400}
.execution-management-row>view{flex:1;min-width:0}.execution-management-row[disabled]{opacity:.55}
.execution-actions-card>.execution-management-row:first-of-type{margin-top:16rpx}
.execution-row-title{display:block;color:var(--ui-ink);font-size:14px;font-weight:500;line-height:1.5;overflow-wrap:anywhere}
.execution-row-hint{display:block;margin-top:4rpx;color:var(--ui-secondary);font-size:12px;font-weight:400;line-height:1.5;overflow-wrap:anywhere}
.execution-row-arrow{flex-shrink:0;color:var(--ui-muted);font-size:22px;line-height:1}
.execution-status-card>.execution-action-btn{margin-top:16rpx}
.execution-text-action{display:flex;align-items:center;justify-content:center;min-height:44px;margin:12rpx 0 0;padding:8rpx 16rpx;border:0;background:transparent;color:var(--ui-primary);font-size:14px;font-weight:500;line-height:1.4}
.execution-text-action.is-danger{color:var(--ui-danger)}.execution-text-action[disabled]{color:var(--ui-muted)}
.execution-sheet-body{padding:8rpx 0 24rpx;min-width:0}
.execution-sheet-task{margin-bottom:24rpx;color:var(--ui-ink);font-size:14px;font-weight:600;line-height:1.6;overflow-wrap:anywhere}
.execution-form-notice{margin-bottom:24rpx;padding:20rpx 24rpx;border-radius:var(--ui-radius-control);background:var(--ui-neutral-soft);color:var(--ui-secondary);font-size:13px;line-height:1.6;overflow-wrap:anywhere}
.execution-form-input{display:block;margin-bottom:24rpx}
.execution-form-field{margin:0 0 24rpx;min-width:0}.execution-field-label{display:block;margin-bottom:12rpx;font-size:14px;font-weight:500;line-height:1.5;color:var(--ui-ink)}.execution-required{color:var(--ui-danger)}
.execution-field-control{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:44px;padding:16rpx 20rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface);color:var(--ui-ink);font-size:14px;line-height:1.5}.execution-field-control.is-placeholder{color:var(--ui-muted)}
.execution-field-pair{display:flex;gap:24rpx}.execution-field-pair>picker{flex:1;min-width:0}
.execution-check-row{display:flex;align-items:flex-start;gap:16rpx;min-height:44px;padding:16rpx 0;border-bottom:1px solid var(--ui-line);font-size:14px;line-height:1.6}.execution-check-row>text{flex:1;min-width:0;overflow-wrap:anywhere}
.execution-search-row{display:flex;align-items:center;gap:16rpx;margin-bottom:24rpx}.execution-search-input{flex:1;min-width:0}.execution-search-row>.execution-action-btn{flex:0 0 64px;min-height:44px;padding:8rpx}
.execution-candidates{margin-bottom:24rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);overflow:hidden}.execution-candidate{display:flex;align-items:center;gap:20rpx;width:100%;min-height:56px;margin:0;padding:20rpx 24rpx;background:var(--ui-surface);border-radius:0;border-bottom:1px solid var(--ui-line);text-align:left}.execution-candidate:last-child{border-bottom:0}.execution-candidate.is-selected{background:var(--ui-selected)}.execution-candidate-copy{flex:1;min-width:0}.execution-candidate-check{flex:0 0 24px;color:var(--ui-primary);text-align:center;font-size:18px}.execution-empty{padding:32rpx 24rpx;text-align:center;color:var(--ui-secondary);font-size:14px;line-height:1.6}
.execution-form-section{display:flex;flex-direction:column;gap:8rpx;margin:32rpx 0 24rpx}.execution-form-section>.execution-help{margin:0}
.execution-checklist-editor{margin:0 0 24rpx;padding:24rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-panel)}.execution-item-number{margin-bottom:20rpx;color:var(--ui-secondary);font-size:12px;font-weight:600}.execution-add-item{margin-bottom:32rpx;width:100%;color:var(--ui-primary)}

.lightweight-page{padding:24rpx}.lightweight-heading,.lightweight-secondary{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap;margin-bottom:20rpx}.lightweight-secondary{margin-top:20rpx}.lightweight-page .section-card{margin-bottom:24rpx}.lightweight-page .description{white-space:pre-wrap;word-break:break-word}

/* Mobile task updates retain native date/time pickers and comfortable tap areas. */
.lightweight-page .section-card{padding:28rpx;border-radius:var(--ui-radius-panel)}
.lightweight-page .section-title{font-size:32rpx;line-height:1.5;margin-bottom:24rpx;overflow-wrap:anywhere}
.lightweight-page .description{font-size:28rpx;line-height:1.7;overflow-wrap:anywhere}
.lightweight-refresh{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:0 0 20rpx;color:var(--ui-secondary);font-size:24rpx}
.lightweight-refresh>text{flex:1;min-width:0}.lightweight-refresh>button{margin:0;min-height:44px;line-height:44px;padding:0 24rpx;color:var(--ui-primary);background:var(--ui-surface)}
.lightweight-secondary>button{flex:1 1 40%;margin:0;min-height:44px;line-height:1.4;padding:20rpx 16rpx;font-size:28rpx}
.lightweight-editor-body>sb-textarea,.lightweight-editor-body>block>sb-textarea{display:block;margin-bottom:24rpx}
.lightweight-editor-body .completion-help{display:block;margin:16rpx 0 24rpx;line-height:1.6}
.lightweight-editor-body .execution-field-control{min-height:48px;box-sizing:border-box}
.lightweight-page .review-history-row{padding:24rpx 0;border-top:1px solid var(--ui-line)}
