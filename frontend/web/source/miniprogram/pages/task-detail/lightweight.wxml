<view class="detail-page lightweight-page" wx:if="{{task}}">
 <view class="lightweight-refresh"><text>{{executionSynced ? '更新于 ' + executionSynced : '下拉刷新任务'}}</text><button size="mini" loading="{{loading || executionLoading}}" disabled="{{loading || executionLoading || executionBusy || lightweightDialog}}" bindtap="refreshTask">刷新</button></view>
 <view class="section-card"><view class="lightweight-heading"><sb-status-tag label="{{task.statusLabel}}" tone="{{task.isSuccessful ? 'good' : 'pending'}}"/><text wx:if="{{execution.processingLabel}}">{{execution.processingLabel}}</text><text wx:if="{{execution.selfManaged}}">本人自办</text></view><view class="section-title">{{task.description || task.title}}</view>
 <sb-desc-list items="{{[{label:'执行人',value:execution.executorLabel || task.owner},{label:'下发人',value:execution.creatorLabel || task.creator},{label:'截止时间',value:task.dueLabel},{label:'关联客户',value:task.customer}]}}" layout="grid"/>
 <view wx:if="{{task.signal.tone === 'red'}}" class="coordinate-error">{{task.signal.reason}}</view></view>
 <view wx:if="{{executionLoading && !execution}}" class="section-card">正在读取任务…</view>
 <view wx:if="{{executionError}}" class="section-card"><text class="coordinate-error">{{executionError}}</text><button bindtap="refreshTask">重新读取</button></view>
 <block wx:if="{{execution}}">
 <view class="section-card" wx:if="{{execution.processingLabel}}"><view class="section-title">{{execution.processingLabel}}</view><view class="description">{{execution.processingLabel === '待验收' ? execution.currentSubmissionNote : execution.processingNote}}</view><text class="completion-help" wx:if="{{execution.processingLabel === '待验收'}}">当前完成提交等待下发人验收；补充反馈不会覆盖本轮结果。</text><text class="completion-help" wx:if="{{execution.processingLabel === '已暂停'}}">暂停不会延后截止日期，需要明确恢复后继续推进。</text></view>
 <view wx:if="{{execution.latestFeedback || execution.nextStep}}" class="section-card"><view class="section-title">最新反馈</view><view class="description">{{execution.latestFeedback || '暂无反馈'}}</view><view wx:if="{{execution.nextStep}}" class="description"><text>下一步：{{execution.nextStep}}</text></view></view>
 <view wx:if="{{task.status === 'completed'}}" class="section-card"><view class="section-title">{{execution.completionLabel}}</view><view class="description">{{execution.completionResult || execution.currentSubmissionNote || '结果见任务记录'}}</view></view>
 <view wx:if="{{execution.canUpdate}}" class="section-card"><button type="primary" disabled="{{executionBusy || executionLoading || executionError}}" bindtap="openLightweightUpdate">更新任务</button><view class="lightweight-secondary"><button wx:if="{{execution.caps.review_completion}}" size="mini" data-action="review_approve" bindtap="openLightweightUpdate">验收通过</button><button wx:if="{{execution.caps.review_completion}}" size="mini" data-action="review_reject" bindtap="openLightweightUpdate">退回继续</button><button wx:if="{{execution.caps.revise}}" size="mini" data-action="revise" bindtap="openLightweightUpdate">调整安排</button><button wx:if="{{execution.caps.resume}}" size="mini" data-action="resume" bindtap="openLightweightUpdate">恢复推进</button></view></view>
 </block>
 <view class="section-card review-history"><view class="section-title">任务记录</view><view wx:for="{{task.history}}" wx:key="id" class="review-history-row"><view>{{item.label}} · {{item.actor_name || '参与人'}}</view><text class="completion-help">{{item.time}}</text><view class="description">{{item.note}}</view><view wx:if="{{item.nextStep}}" class="description">下一步：{{item.nextStep}}</view><view wx:for="{{item.changes}}" wx:for-item="change" wx:key="field" class="description">{{change.label}}：{{change.before}} → {{change.after}}</view></view><button wx:if="{{executionHistoryCursors.events !== null}}" loading="{{executionHistoryLoading}}" data-kind="events" bindtap="loadExecutionHistory">加载更早记录</button><text class="coordinate-error" wx:if="{{executionHistoryError}}">{{executionHistoryError}}</text></view>
</view>
