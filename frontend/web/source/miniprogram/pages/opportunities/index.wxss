@import "../../styles/opportunity-list-card.wxss";
.page{min-height:100vh;padding:24rpx 28rpx 56rpx;box-sizing:border-box;background:var(--ui-background);color:var(--ui-ink)}
/* 页面标题：页底色上直接放标题，新增商机放标题行右侧 */
.page-head{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin:8rpx 0 32rpx}
.page-head-main{min-width:0}
.title{color:var(--ui-ink);font-size:var(--ui-text-page);font-weight:600;line-height:1.3}
.subtitle{margin-top:8rpx;color:var(--ui-secondary);font-size:14px;line-height:1.4}
.create-row{flex:0 0 auto}
.create-opportunity{display:flex;align-items:center;justify-content:center;box-sizing:border-box;height:var(--ui-touch-target);padding:0 32rpx;border-radius:var(--ui-radius-control);color:var(--ui-on-primary);background:var(--ui-primary);box-shadow:none;font-size:var(--ui-text-body);font-weight:600;white-space:nowrap}
.create-opportunity-active{background:var(--ui-primary-hover)}
/* 筛选：一张白卡；飞书筛选片灰底无边框，选中浅蓝底主色字，和 sb-labeled-select size=small 同尺寸同箭头 */
.filter-card{margin-bottom:24rpx;padding:24rpx 24rpx 24rpx 32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.filter-line{display:flex;align-items:center;gap:8px;min-width:0}
.filter-title{flex:0 0 auto;color:var(--ui-ink);font-size:14px;font-weight:600}
/* 横向滚动区上下各留 9px，片扩出的点击区（每边 6px）不被裁掉；负外边距抵掉占位 */
.filter-scroll{width:0;min-width:0;flex:1;margin:-9px 0;white-space:nowrap}
.filter-row{display:inline-flex;align-items:center;gap:8px;padding:9px 8rpx 9px 0}
.filter-item{width:104px;height:32px;position:relative;flex:0 0 auto;box-sizing:border-box;border:0;border-radius:var(--ui-radius-control);background:var(--ui-neutral-soft)}
.filter-item.active{background:var(--ui-selected)}
.filter-item-pressed{opacity:.7}
/* 筛选片高 32px，和 sb-labeled-select size=small 同高，不随屏宽缩；伪元素以中线为准上下各 22px，点击区 44px（带组件的外层不加）；阶段片行距 17px，点击区不重叠 */
.filter-trigger::after,.stage-option::after{content:'';position:absolute;left:0;right:0;top:calc(50% - 22px);bottom:calc(50% - 22px)}
.filter-control{display:flex;align-items:center;gap:8rpx;height:32px;min-width:0;padding:0 16rpx 0 24rpx}
.filter-value{min-width:0;flex:1;overflow:hidden;color:var(--ui-ink);font-size:14px;white-space:nowrap;text-overflow:ellipsis}
.filter-item.active .filter-value{color:var(--ui-primary);font-weight:600}
.filter-control .chevron{flex:0 0 auto;display:inline-flex;color:var(--ui-muted)}
.filter-reset{flex:0 0 auto;padding:12px 8rpx;margin:-12px 0;color:var(--ui-primary);font-size:14px;line-height:20px}
.filter-reset-pressed{opacity:.7}
/* 商机阶段多选面板：同一套筛选片，选中只靠底色和主色字 */
/* 标题下外边距 -5px：贴近自己的片（12px），和上方筛选行隔 16px */
.stage-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px 8px;margin-top:16px}
.stage-panel-title{grid-column:1 / -1;display:flex;align-items:baseline;gap:16rpx;margin-bottom:-5px;color:var(--ui-ink);font-size:14px;font-weight:600}
.stage-panel-hint{color:var(--ui-secondary);font-size:var(--ui-text-small);font-weight:400}
.stage-option{position:relative;display:flex;align-items:center;min-width:0;min-height:32px;box-sizing:border-box;padding:0 24rpx;border:0;border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-neutral-soft);font-size:14px}
.stage-option-pressed{opacity:.7}
.stage-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.stage-option.selected{color:var(--ui-primary);background:var(--ui-selected);font-weight:600}
/* 列表 */
.list{display:flex;flex-direction:column;gap:16rpx}
.opportunity-order-note{color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.opportunity-quarter-group{display:flex;flex-direction:column;gap:16rpx}
.opportunity-quarter-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin-top:32rpx}
.opportunity-quarter-heading-title{color:var(--ui-ink);font-size:var(--ui-text-section);font-weight:600;line-height:1.4}
.opportunity-quarter-heading-count{color:var(--ui-secondary);font-size:var(--ui-text-small)}
.list-state{display:block}
/* 「重试」上下各 13px 撑到 44px；错误行和上面的卡片隔 16px */
.more-error{margin-top:16px;color:var(--ui-danger);font-size:var(--ui-text-small);line-height:1.5}
.more-retry{display:inline-block;margin:-13px 0 -13px 16rpx;padding:13px 8rpx;color:var(--ui-primary)}
.more-retry-pressed{opacity:.7}
.pager{display:block;margin-top:8rpx}
