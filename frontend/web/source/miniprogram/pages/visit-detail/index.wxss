/* 拜访记录详情：顶部 sb-summary-card，区块 sb-section，结构化信息 sb-desc-list（两列）。 */
page{background:var(--ui-background)}
.fde-note{margin:0;padding:24rpx 32rpx 0;border-radius:0;background:transparent;color:var(--ui-secondary);font-size:14px;line-height:1.5}
.visit-page{min-height:100vh;box-sizing:border-box;padding:24rpx 32rpx 48rpx;padding-bottom:calc(48rpx + constant(safe-area-inset-bottom));padding-bottom:calc(48rpx + env(safe-area-inset-bottom));color:var(--ui-ink);background:var(--ui-background)}
.state-card{padding:48rpx 32rpx;border:0;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.visit-hero{display:block}
.section-card{display:block;margin-top:24rpx}
/* AI 建议卡顶部 3px 主色条：只在显示「AI 建议，仅供参考」时加。sb-section 的白卡在组件内部、页面样式够不到，
   所以建议生成后让组件走 plain（无内边距、无底色、无圆角），由宿主节点画整张卡：同内边距、同圆角、同白底，
   色条压在原内边距里，内容位置与「生成中」一致，不下移 */
.advice-card{padding:var(--ui-card-padding);border-radius:var(--ui-radius-panel);background:var(--ui-surface);box-shadow:inset 0 3px 0 var(--ui-primary)}

/* 区块内容 */
.opportunity-link{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:var(--ui-touch-target);box-sizing:border-box;padding-top:8rpx;border-top:1px solid var(--ui-line);color:var(--ui-primary);font-size:14px}
.opportunity-link-more{flex:0 0 auto;display:flex;align-items:center;gap:4rpx}
.advice-refresh{justify-content:flex-end;gap:4rpx}
.opportunity-link text{min-width:0;overflow:hidden;color:var(--ui-ink);font-size:14px;font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.opportunity-link label{flex:0 0 auto;color:var(--ui-primary);font-size:14px}
.opportunity-link-active{opacity:.7}
.content-row{padding-bottom:24rpx;border-bottom:1px solid var(--ui-line)}
.content-row:last-child{padding-bottom:0;border-bottom:0}
.content-row text,.next-action text{display:block;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.content-row label,.next-action label{display:block;margin-top:8rpx;color:var(--ui-ink);font-size:14px;line-height:1.6;overflow-wrap:anywhere}
.next-action label{font-weight:600}
.readonly-note{padding:24rpx 8rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.6;text-align:center}
.narrative .readonly-note{padding:0;font-size:14px;text-align:left}
