/* 商机总览白卡、统计时间、列表筛选与季度分组标题。商机 Tab（workbench）与 FDE 商机页（fde-projects）共用。飞书：白卡放灰底上，不描边不加阴影。 */
.overview-board.opportunity-overview{margin-top:0;padding:32rpx;color:var(--ui-ink);border:0;border-radius:var(--ui-radius-panel);background:var(--ui-surface);box-shadow:none}
.opportunity-summary-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.opportunity-summary-head-main{display:flex;align-items:center;gap:16rpx;min-width:0}
.opportunity-summary-title{flex:0 0 auto;color:var(--ui-ink);font-size:var(--ui-text-section);font-weight:600;line-height:1.4}
.opportunity-summary-scope{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;height:20px;padding:0 12rpx;border-radius:4px;color:var(--ui-neutral);background:var(--ui-neutral-soft);font-size:var(--ui-text-small);line-height:20px;white-space:nowrap}
.opportunity-summary-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:32rpx}
.opportunity-summary-metric{min-width:0}
.opportunity-summary-metric+.opportunity-summary-metric{padding-left:20rpx;border-left:1px solid var(--ui-line)}
.opportunity-summary-label{margin-top:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5;white-space:nowrap}
.opportunity-summary-value{color:var(--ui-ink);font-size:20px;font-weight:600;line-height:1.3;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.opportunity-summary-unit{margin-left:4rpx;color:var(--ui-secondary);font-size:var(--ui-text-small);font-weight:400}
/* 统计时间、关单时间面板：标题一行，年份用 sb-select（inline＋plain）一行，季度用灰底筛选片 */
.quarter-filter{min-width:0}
.quarter-filter-summary{margin-top:32rpx;padding-top:32rpx;border-top:1px solid var(--ui-line)}
.quarter-filter-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.quarter-filter-head-main{display:flex;align-items:baseline;flex-wrap:wrap;gap:4rpx 16rpx;min-width:0}
.quarter-filter-title{flex:0 0 auto;color:var(--ui-ink);font-size:14px;font-weight:600}
.quarter-selection-label{color:var(--ui-secondary);font-size:var(--ui-text-small)}
/* 年份行整行可点，和季度片隔 12px，片扩出的点击区不压到它 */
.quarter-year-select{display:block;margin-bottom:12px}
/* 五片一行：「全部时间」占 1.5 份，Q1～Q4 各 1 份；列距 8px，320 宽屏「全部时间」片宽约 64px */
.quarter-options{display:grid;grid-template-columns:minmax(0,1.5fr) repeat(4,minmax(0,1fr));gap:8px}
.quarter-option,.close-period-shortcut{position:relative;display:flex;align-items:center;justify-content:center;min-width:0;min-height:32px;box-sizing:border-box;padding:0 8rpx;border:0;border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-neutral-soft);font-size:14px;white-space:nowrap}
/* 筛选片高 32px，和 sb-labeled-select size=small 同高，不随屏宽缩；伪元素以中线为准上下各 22px，点击区 44px；多行片行距、片下一行间距 17px（≥44px 减片高），点击区不重叠 */
.quarter-option::after,.close-period-shortcut::after,.workbench-stage-option::after,.workbench-filter-trigger::after{content:'';position:absolute;left:0;right:0;top:calc(50% - 22px);bottom:calc(50% - 22px)}
.quarter-option.selected,.close-period-shortcut.selected{color:var(--ui-primary);background:var(--ui-selected);font-weight:600}
.quarter-option-pressed{opacity:.7}
.quarter-filter-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:17px;color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
/* 「统计口径 ⓘ」在总览标题行右侧，上下都不可点；透明内边距上下各 12px 撑到 44px，负外边距抵掉占位 */
.metric-help{flex:0 0 auto;padding:12px 0;margin:-12px 0;color:var(--ui-primary);font-size:14px;line-height:20px;white-space:nowrap}
.metric-help-pressed{opacity:.7}
.quarter-filter-list{margin-top:12px;padding-top:12px;border-top:1px solid var(--ui-line)}
/* 「完成」：t-button small 外包一层 view，伪元素以中线为准上下各 22px（在按钮后面，按钮照常响应），外层绑定同一收起方法 */
.quarter-filter-done{position:relative;z-index:0;flex:0 0 auto;display:flex}
.quarter-filter-done::after{content:'';position:absolute;z-index:-1;left:0;right:0;top:calc(50% - 22px);bottom:calc(50% - 22px)}
.close-period-shortcuts{display:flex;gap:8px;margin-bottom:17px}
.close-period-shortcut{flex:1}
/* 列表筛选：放进一张白卡（灰底筛选片只在白底上看得清）；飞书筛选片灰底无边框、选中浅蓝底主色字，和 sb-labeled-select size=small 同尺寸同箭头；未筛选只显示标签，筛选后显示值 */
.workbench-opportunity-tools{margin-top:24rpx}
.workbench-opportunity-filter{margin-bottom:24rpx;padding:24rpx 24rpx 24rpx 32rpx;border-radius:var(--ui-radius-panel);background:var(--ui-surface)}
.workbench-filter-line{display:flex;align-items:center;gap:8px;min-width:0}
.workbench-filter-title{flex:0 0 auto;color:var(--ui-ink);font-size:14px;font-weight:600}
/* 横向滚动区上下各留 9px，片扩出的点击区（每边 6px）不被裁掉；负外边距抵掉占位 */
.workbench-filter-scroll{width:0;min-width:0;flex:1;margin:-9px 0;white-space:nowrap}
.workbench-filter-row{display:inline-flex;align-items:center;gap:8px;padding:9px 8rpx 9px 0}
.workbench-filter-item{position:relative;flex:0 0 auto;width:104px;height:32px;box-sizing:border-box;border:0;border-radius:var(--ui-radius-control);background:var(--ui-neutral-soft)}
.workbench-filter-item.active{background:var(--ui-selected)}
.workbench-filter-pressed{opacity:.7}
.workbench-filter-control{display:flex;align-items:center;gap:8rpx;height:32px;min-width:0;padding:0 16rpx 0 24rpx}
.workbench-filter-value{min-width:0;flex:1;overflow:hidden;color:var(--ui-ink);font-size:14px;white-space:nowrap;text-overflow:ellipsis}
.workbench-filter-item.active .workbench-filter-value{color:var(--ui-primary);font-weight:600}
.workbench-filter-chevron{flex:0 0 auto;display:inline-flex;color:var(--ui-muted)}
.workbench-filter-reset{flex:0 0 auto;padding:12px 8rpx;margin:-12px 0;color:var(--ui-primary);font-size:14px;line-height:20px}
.workbench-filter-reset-pressed{opacity:.7}
/* 商机阶段多选面板：同一套筛选片，选中只靠底色和主色字 */
/* 标题下外边距 -5px：贴近自己的片（12px），和上方筛选行隔 16px */
.workbench-stage-panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px 8px;margin-top:16px}
.workbench-stage-panel-title{grid-column:1 / -1;display:flex;align-items:baseline;gap:16rpx;margin-bottom:-5px;color:var(--ui-ink);font-size:14px;font-weight:600}
.workbench-stage-panel-hint{color:var(--ui-secondary);font-size:var(--ui-text-small);font-weight:400}
.workbench-stage-option{position:relative;display:flex;align-items:center;min-width:0;min-height:32px;box-sizing:border-box;padding:0 24rpx;border:0;border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-neutral-soft);font-size:14px}
.workbench-stage-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.workbench-stage-option.selected{color:var(--ui-primary);background:var(--ui-selected);font-weight:600}
/* sb-search plain 自带白底细线；和上方筛选片隔 12px，片扩出的点击区不压到搜索框 */
.opportunity-search-box{margin-top:12px}
/* 季度分组 */
.opportunity-order-note{color:var(--ui-secondary);font-size:var(--ui-text-small);line-height:1.5}
.opportunity-quarter-group{display:flex;flex-direction:column;gap:16rpx}
.opportunity-quarter-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin-top:32rpx}
.opportunity-quarter-heading-title{color:var(--ui-ink);font-size:var(--ui-text-section);font-weight:600;line-height:1.4}
.opportunity-quarter-heading-count{color:var(--ui-secondary);font-size:var(--ui-text-small)}

/* Palette only: original geometry is preserved. */
/* Dark overview, light filters, and explicit selection; all original geometry stays. */
.overview-board.opportunity-overview { background:var(--sb-hero-bg); color:var(--sb-hero-ink); }
.opportunity-overview .opportunity-summary-title,.opportunity-overview .opportunity-summary-value,.opportunity-overview .quarter-filter-title { color:var(--sb-hero-ink); }
.opportunity-overview .opportunity-summary-label,.opportunity-overview .opportunity-summary-unit,.opportunity-overview .summary-data-note,.opportunity-overview .fde-summary-note,.opportunity-overview .quarter-selection-label,.opportunity-overview .quarter-filter-foot { color:var(--sb-hero-muted); }
.opportunity-overview .opportunity-summary-scope { color:var(--sb-hero-ink); background:var(--sb-hero-control); }
.opportunity-overview .opportunity-summary-metric+.opportunity-summary-metric,.opportunity-overview .quarter-filter-summary { border-color:var(--sb-hero-line); }
.opportunity-overview .metric-help,.opportunity-overview .summary-retry { color:var(--sb-hero-link); }
.opportunity-overview .summary-data-error,.opportunity-overview .fde-summary-error { color:var(--sb-hero-alert); }
.opportunity-overview .sb-select-label,.opportunity-overview .sb-select-value,.opportunity-overview .sb-select-value.placeholder,.opportunity-overview .sb-select.disabled .sb-select-value,.opportunity-overview .sb-select-arrow { color:var(--sb-hero-muted); }
.opportunity-overview .quarter-option { color:var(--sb-hero-muted); background:var(--sb-hero-control); }
.opportunity-overview .quarter-option.selected { color:var(--ui-primary); background:var(--ui-selected); }
.workbench-opportunity-filter { background:var(--ui-surface); }
.workbench-opportunity-filter .quarter-option,.workbench-filter-item,.workbench-stage-option { color:var(--ui-ink); background:var(--ui-neutral-soft); }
.workbench-opportunity-filter .quarter-option.selected,.workbench-stage-option.selected,.workbench-filter-item.active,.workbench-opportunity-filter .close-period-shortcut.selected,.workbench-opportunity-filter .sb-lselect.small.on { color:var(--ui-primary); background:var(--ui-selected); }
.workbench-filter-item.active .workbench-filter-value,.workbench-filter-item.active .workbench-filter-chevron,.workbench-opportunity-filter .sb-lselect.small.on .sb-lselect-text,.workbench-opportunity-filter .sb-lselect.small.on .sb-lselect-arrow,.workbench-opportunity-filter .sb-lselect.small.on .sb-lselect-clear { color:var(--ui-primary); }
.workbench-filter-reset { color:var(--sb-link-blue); }
.opportunity-search-box { --ui-line:var(--sb-input-line); }

.workbench-opportunity-filter .sb-lselect.small.on.disabled { color:var(--ui-muted); background:var(--ui-neutral-soft); }
.workbench-opportunity-filter .sb-lselect.small.on.disabled .sb-lselect-text,.workbench-opportunity-filter .sb-lselect.small.on.disabled .sb-lselect-label,.workbench-opportunity-filter .sb-lselect.small.on.disabled .sb-lselect-arrow,.workbench-opportunity-filter .sb-lselect.small.on.disabled .sb-lselect-clear { color:var(--ui-muted); }
