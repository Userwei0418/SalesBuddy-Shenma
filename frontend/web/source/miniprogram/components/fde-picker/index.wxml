<view class="fde-picker-view field {{compactForm ? 'compact-form' : ''}}"><view class="fde-picker-view heading"><text class="fde-picker-text">{{title}}</text><label wx:if="{{!hideOptional}}" class="fde-picker-label">选填</label></view><view class="fde-picker-view chosen {{disabled?'disabled':''}}" hover-class="{{disabled ? 'none' : 'chosen-pressed'}}" bindtap="open"><view wx:if="{{selected.length}}" class="fde-picker-view tags"><text wx:for="{{selectedRows}}" wx:key="id" class="fde-picker-text">{{item.name}}{{item.locked?' · 只读':''}}</text></view><text wx:else class="fde-picker-text">暂未选择</text><label wx:if="{{!disabled}}" class="fde-picker-label">选择<t-icon name="chevron-right" size="28rpx" /></label></view><view class="fde-picker-view hint">{{hint}}</view></view>
<sb-sheet visible="{{open}}" title="{{title}}" description="已选 {{draft.length}} 人" confirmLabel="确认选择" bind:confirm="confirm" bind:close="cancel"><view slot="header" class="picker-header"><sb-search plain value="{{query}}" maxlength="{{100}}" placeholder="搜索姓名，支持多选" bind:change="search" bind:clear="search" /><scroll-view wx:if="{{draft.length}}" scroll-x class="selected"><view class="selected-tags"><view wx:for="{{draft}}" wx:key="id" data-id="{{item.id}}" bindtap="toggle" hover-class="{{item.locked ? 'none' : 'chip-pressed'}}" class="selected-chip {{item.locked ? 'locked' : ''}}" aria-role="button" aria-label="{{item.locked ? item.name + '，只读' : '移除 ' + item.name}}"><view class="selected-chip-body"><text class="fde-picker-text">{{item.name}}{{item.locked?' · 只读':''}}</text><t-icon wx:if="{{!item.locked}}" name="close" size="28rpx" /></view></view></view></scroll-view></view><view class="results"><t-checkbox icon="rectangle" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" checked="{{item.selected}}" disabled="{{item.locked || item.excluded}}" label="{{item.name}}" content="{{item.team || '未标注部门'}} · {{item.role === 'fde_lead' ? 'FDE主管' : 'FDE'}}{{item.locked ? ' · 其他部门，只读' : item.excluded ? ' · 已作普通协同人' : ''}}" bind:change="toggle" /><view wx:if="{{loading}}" class="fde-picker-view status">正在读取成员…</view><view wx:elif="{{error}}" class="fde-picker-view status error" hover-class="status-pressed" bindtap="load">{{error}} · 点击重试</view><view wx:elif="{{!rows.length}}" class="fde-picker-view status">没有匹配的 FDE 成员</view><sb-pagination wx:elif="{{offset<total}}" mode="more" plain summary="已显示 {{rows.length}}／{{total}} 人" loading="{{loading}}" end="{{offset >= total}}" data-more="true" bind:more="load" /></view></sb-sheet>
