/* 商机表单（新增商机页、拜访确认页共用）：飞书表单，标签在上 14px 常规字重，下方 8px 是 40px 高白底细线框；部门表单件 layout=stacked plain 自带这套版式 */
.opp-form{color:var(--ui-ink)}
.field{margin:0}
.field-block{padding:8px 0}
.label{display:flex;align-items:center;margin-bottom:8px;color:var(--ui-ink);font-size:14px;font-weight:400;line-height:1.4}
.req{color:var(--ui-danger)}
.required,.optional{margin-left:8rpx;font-size:var(--ui-text-small);font-weight:400;line-height:1.4}
.required{color:var(--ui-danger)}
.optional{color:var(--ui-muted)}
/* 伙伴触发行：和 sb-select stacked 同一个框（白底、细线、6px 圆角、40px 高、chevron-down） */
.control{box-sizing:border-box;display:block;width:100%;min-height:var(--ui-field-height);padding:0 24rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-surface);font-size:var(--ui-text-body)}
.row{display:flex;align-items:center;justify-content:space-between;gap:8rpx}
.control-pressed{background:var(--ui-neutral-soft)}
.control.is-disabled{color:var(--ui-muted);background:var(--ui-background)}
.placeholder{color:var(--ui-muted)}
.chevron{flex:0 0 auto;display:inline-flex;color:var(--ui-muted)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.hint,.error,.warning{margin-top:8rpx;font-size:var(--ui-text-small);line-height:1.5}
.hint{color:var(--ui-secondary)}
.error{color:var(--ui-danger)}
.warning{color:var(--ui-warning)}
/* 名称下可点的错误：上下各 13px 撑到 44px；上外边距 -8px 只抵掉输入框自带的下留白，下方不抵 */
.error-retry{margin-top:-8px;padding:13px 0}
.track{display:flex;gap:8rpx;margin:4rpx 0 8rpx}
.step{height:6rpx;flex:1;border-radius:999px;background:var(--ui-neutral-soft)}
.step.active{background:var(--ui-primary)}
.step.lost{background:var(--ui-danger)}
/* 折叠入口：次按钮样式，白底一圈细线 */
.fold{display:flex;align-items:center;justify-content:space-between;min-height:var(--ui-touch-target);box-sizing:border-box;margin-top:24rpx;padding:0 24rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);color:var(--ui-ink);background:var(--ui-surface);font-size:14px;font-weight:600}
.fold-pressed{background:var(--ui-neutral-soft)}
.fold-text{display:flex;align-items:center;gap:4rpx;color:var(--ui-primary);font-size:var(--ui-text-small);font-weight:400}
/* 季度预测：不套框，靠留白与细线和表单其余部分分开 */
.forecast{margin:16rpx 0 8rpx}
.forecast-results{margin-top:16rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
.forecast-results-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx;color:var(--ui-ink);font-size:14px;font-weight:600}
.forecast-results-head>label{color:var(--ui-secondary);font-size:var(--ui-text-small);font-weight:400}
.forecast-result{min-width:0}
.forecast-result>text{display:block;color:var(--ui-secondary);font-size:var(--ui-text-small)}
.forecast-result>label{display:block;margin-top:4rpx;color:var(--ui-ink);font-size:20px;font-weight:600;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.partner-label{margin-top:24rpx}
/* 伙伴目录弹层：t-cell 一行一个，勾在右；行左右与弹层标题对齐 */
.partner-list{--td-cell-horizontal-padding:0;--td-cell-right-icon-color:var(--ui-primary);--td-cell-border-color:var(--ui-line)}
.sheet-hint{padding:12px 0;color:var(--ui-secondary);font-size:14px;line-height:1.5}
.sheet-hint.error{color:var(--ui-danger)}
.text-pressed{opacity:.7}

.material-section{margin-top:24rpx;padding-top:24rpx;border-top:1px solid var(--ui-line)}
.material-title{display:flex;justify-content:space-between;gap:16rpx;font-size:var(--ui-text-body);font-weight:600;line-height:1.6;overflow-wrap:anywhere}
.material-action{flex-shrink:0;font-weight:400;color:var(--ui-primary);padding:0 8rpx;min-height:44rpx}
.material-line,.material-directory{margin-top:20rpx;padding:20rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control)}
.material-directory-list{height:440rpx;box-sizing:border-box}
.product-lines{margin-top:16rpx}
.product-line-label{max-width:100%;padding:12rpx 16rpx;background:var(--ui-neutral-soft);border-radius:var(--ui-radius-control);font-size:var(--ui-text-body);overflow-wrap:anywhere;box-sizing:border-box}
.product-line-options{height:240rpx;margin-top:16rpx;box-sizing:border-box}
.material-trace{min-width:0;font-size:var(--ui-text-small);line-height:1.6}
.trace-summary,.trace-heading{font-weight:600;color:var(--ui-ink);overflow-wrap:anywhere}
.trace-line{margin-top:20rpx;padding:20rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);min-width:0}
.trace-toggle{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:var(--ui-touch-target)}
.trace-name{min-width:0;font-size:var(--ui-text-body);font-weight:600;overflow-wrap:anywhere}
.trace-action{flex-shrink:0;color:var(--ui-primary)}
.trace-section{margin-top:20rpx;padding-top:16rpx;border-top:1px solid var(--ui-line)}
.trace-text{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word}
.trace-row{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8rpx 16rpx;padding:6rpx 0;min-width:0}
.trace-label{flex:1 1 44%;color:var(--ui-secondary);min-width:0;overflow-wrap:anywhere}
.trace-value{flex:1 1 44%;min-width:0;overflow-wrap:anywhere;word-break:break-word;text-align:right;font-variant-numeric:tabular-nums}
.trace-example{margin-top:12rpx;padding-left:16rpx;border-left:2px solid var(--ui-line)}
.trace-months{height:480rpx;max-width:100%;box-sizing:border-box}
.trace-month{padding:12rpx 0;border-bottom:1px solid var(--ui-line)}

.extra-section{padding-top:16rpx}
.extra-multi,.extra-text,.extra-people{padding:16rpx 0}
.extra-chips{display:flex;flex-wrap:wrap;gap:12rpx}
.extra-chip{box-sizing:border-box;min-height:var(--ui-touch-target);padding:16rpx 20rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);font-size:var(--ui-text-body);line-height:1.5;overflow-wrap:anywhere}
.extra-chip.is-selected{color:var(--ui-primary);border-color:var(--ui-primary);background:var(--ui-selected)}
.extra-chip.is-disabled{opacity:.55}
.extra-textarea{box-sizing:border-box;width:100%;min-height:96rpx;padding:20rpx 24rpx;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control);background:var(--ui-surface);font-size:var(--ui-text-body);line-height:1.5}
.extra-person{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:16rpx 0;border-bottom:1px solid var(--ui-line)}
.extra-person-copy{min-width:0;overflow-wrap:anywhere;font-size:var(--ui-text-body)}
