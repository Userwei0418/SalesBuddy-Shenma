<view class="quarter-target-bar">
 <view class="target-period">{{quarterLabel}} · 季度目标</view><button wx:if="{{canEdit}}" class="target-edit-button" size="mini" disabled="{{loading || pending.length}}" bindtap="show">{{pending.length ? '变更待审批' : '设置目标'}}<t-icon wx:if="{{!pending.length}}" name="chevron-right" size="28rpx" class="target-edit-icon"/></button>
</view>
<view wx:if="{{notice}}" class="target-notice">{{notice}}<block wx:for="{{rows}}" wx:key="kind"><view wx:if="{{item.pending}}" class="pending-row"><text>{{item.name}}</text><text>{{item.currentText}} → {{item.proposedText}}</text></view></block></view>
<view wx:if="{{decision && !pending.length}}" class="target-decision decision-{{decision.status}}"><text>最近目标调整 · {{decision.label}}</text><text class="decision-detail">{{decision.reviewer}}{{decision.date?' · '+decision.date:''}}</text><view wx:if="{{decision.reason}}">{{decision.reason}}</view></view>
<sb-state-panel wx:if="{{error && !open}}" size="compact" state="error" title="{{error}}" bind:retry="load"/>
<root-portal wx:if="{{open}}"><view class="sheet-mask" catchtap="close" catchtouchmove="noop"><view class="target-sheet" catchtap="noop"><view class="sheet-grip" bindtap="close"><view class="sheet-grip-line"></view></view><view class="sheet-heading"><text class="sheet-title">季度目标</text><label class="sheet-subtitle">{{subjectLabel || '本人'}} · {{quarterLabel}}</label></view>
<scroll-view scroll-y class="target-form"><view class="form-note">记录已与负责人商定的目标。首次填写直接生效，后续调整由运营审核。</view>
<view wx:for="{{rows}}" wx:key="kind" class="form-field"><sb-amount-input layout="stacked" plain label="{{item.name}}目标" required unit="万元" valueType="string" precision="{{6}}" maxlength="{{20}}" value="{{item.kind==='collection'?collection:recognized}}" placeholder="填写{{item.name}}目标" data-field="{{item.kind}}" bind:change="input"/><view class="field-hint">当前生效：{{item.currentText}}</view></view>
<view class="form-field"><sb-textarea layout="stacked" plain fixed label="{{isChange ? '调整原因' : '商定依据'}}" required maxlength="{{2000}}" placeholder="说明与负责人的约定，或本次目标调整的原因" value="{{reason}}" data-field="reason" bind:change="input"/></view><view wx:if="{{error}}" class="form-error">{{error}}</view></scroll-view>
<view class="sheet-footer"><button class="target-footer-button target-cancel" disabled="{{saving}}" bindtap="close">取消</button><button class="target-footer-button target-submit" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{isChange?'提交目标调整':'确认并生效'}}</button></view></view></view></root-portal>
