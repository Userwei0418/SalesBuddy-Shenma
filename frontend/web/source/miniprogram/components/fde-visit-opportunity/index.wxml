<view class="fde-choice">
  <view class="fde-choice-head"><view class="fde-choice-heading"><text class="fde-choice-title">选择商机</text><text class="fde-choice-required">必填</text></view><button wx:if="{{selected || selectedId}}" class="fde-choice-change" hover-class="fde-choice-pressed" disabled="{{disabled}}" bindtap="change">更换</button></view>
  <view class="fde-choice-hint">仅可选择本人参与的商机</view>
  <view wx:if="{{selected}}" class="fde-choice-selected"><text class="fde-choice-name">{{selected.name}}</text><text class="fde-choice-status">已选择</text></view>
  <block wx:elif="{{!selectedId}}">
    <view class="fde-choice-search"><sb-search plain value="{{query}}" maxlength="{{100}}" placeholder="搜索该客户下本人参与的商机" disabled="{{disabled}}" loading="{{loading && !!query}}" bind:change="search" bind:clear="search"/></view>
    <scroll-view class="fde-choice-list {{disabled ? 'is-disabled' : ''}}" scroll-y>
      <t-cell wx:for="{{items}}" wx:key="id" title="{{item.name}}" arrow hover="{{!disabled}}" data-id="{{item.id}}" bind:click="choose"/>
      <button wx:if="{{hasMore}}" class="fde-choice-more" hover-class="fde-choice-pressed" disabled="{{loading || disabled}}" bindtap="more">加载更多</button>
    </scroll-view>
  </block>
  <block wx:if="{{loading}}"><view wx:if="{{!query}}" class="fde-choice-state">正在核对商机协助关系…</view></block>
  <view wx:elif="{{error}}" class="fde-choice-error">{{error}}<button class="fde-choice-retry" hover-class="fde-choice-pressed" bindtap="retry" disabled="{{disabled}}">重新加载</button></view>
  <view wx:elif="{{!selected && !items.length}}" class="fde-choice-state">{{query ? '没有匹配的本人商机，请调整关键词。' : '该客户暂无你参与的商机，请先由销售添加协助 FDE。'}}</view>
</view>
