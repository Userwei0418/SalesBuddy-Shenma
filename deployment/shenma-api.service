[Unit]
Description=Shenma SalesBuddy api
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
User=shenma-sales
Group=shenma-sales
WorkingDirectory=/opt/shenma-sales/current/backend
EnvironmentFile=/etc/shenma-sales/runtime.env
ExecStart=/opt/shenma-sales/current/backend/.venv/bin/python -m uvicorn sales_backend.main:app --host 127.0.0.1 --port 8080 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sales-backend
[Install]
WantedBy=multi-user.target
